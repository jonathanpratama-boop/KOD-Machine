__pycache__/
*.pyc
.pytest_cache/
*.lock

# KOD scratch databases (the ledger itself is kod-machine/var/kod.db and is committed)
kod-machine/var/*.db
!kod-machine/var/kod.db

# IDX price data: large, rebuilt from sources. Provenance manifests under
# idx-signals/data/manifests/ are committed instead.
idx-signals/data/raw/
idx-signals/data/panel/

# Local analyst workstation state is separate from the frozen research ledger.
/runtime/
kod-machine/.venv/
.venv-workstation/

# Runtime credentials are supplied through the environment, never repository data.
.env
.env.*
!.env.example
