+from idxsig.rules import moonshot_e5
+from idxsig.rules.audit import audit_module
+from tests.rulekit import module_rule, with_rule
+from tests.support import flat_market, synthetic_registry
+
+ROOT = Path(__file__).resolve().parents[1]
+PROTO, PROTO_SHA = e5.protocol()
+W, WF = moonshot_e5.FEATURE_WARMUP, moonshot_e5.WARMUP
+FORMATS = {"IDX": "panel-v2", "US": "panel-global-v2-units", "CRYPTO": "panel-global-v1"}
+
+
+# ------------------------------------------------------------------------------------------- fixtures
+def e5_panel(market="IDX", n=30, start="2020-03-02", end="2023-12-29", seed=3, reset=None):
+    """A random-walk panel in the market's shape with planted +20%x3 (U) and -9%x3 (D) runs; `reset`
+    {ticker index: session index} plants a x25 unit reset (crypto) at that session."""
+    rng = np.random.default_rng(seed)
+    dates = pd.to_datetime(np.arange(np.datetime64(start, "D"), np.datetime64(end, "D") + 1, dtype="datetime64[D]"))
+    dates = dates[dates.weekday < 5]
+    idx = market == "IDX"
+    rows = []
+    for i in range(n):
+        price = float(rng.choice([150, 480, 1500] if idx else [0.5, 3.0, 12.0, 50.0]))
+        up = down = 0
+        for d in range(len(dates)):
+            prev = price
+            if up == 0 and down == 0:
+                r = rng.random()
+                if r < 0.004:
+                    up = 3
+                elif r < 0.008:
+                    down = 3
+            if up:
+                step, up = 0.20, up - 1
+            elif down:
+                step, down = -0.09, down - 1
+            else:
+                step = float(np.clip(rng.normal(0, 0.02), -0.06, 0.06))
+            if (reset or {}).get(i) == d:
+                step = 24.0
+            price = prev * (1 + step)
+            if idx:
+                price = float(min(max(floor_tick(np.array([price]))[0], 60.0), 4500.0))
+            else:
+                price = round(max(price, 0.01), 4)
+            vol = int(rng.integers(100_000, 1_000_000))
+            rows.append({"date": dates[d], "ticker": f"S{i:03d}", "source": "synthetic", "previous": prev,
+                         "open": pd.NA if idx else prev, "high": max(prev, price), "low": min(prev, price),
+                         "close": price, "volume": vol, "value": vol * price, "frequency": 100,
+                         "listed_shares": 10 ** 9 if idx else np.nan, "tradable_shares": 10 ** 9 if idx else np.nan})
+    df = pd.DataFrame(rows)
+    if idx:
+        for c in ("previous", "open", "high", "low", "close", "volume", "value", "frequency", "listed_shares",
+                  "tradable_shares"):
+            df[c] = df[c].astype("Int64")
+    else:
+        df["open"] = df["open"].astype(float)
+    if market == "US":
+        df["unit_factor"] = 1.0
+    meta = {"sha256": f"synthetic-{market}", "panel": "synthetic", "source_boundary": end, "format": FORMATS[market],
+            "default_start": start, "quality_tiers": [], "known_limitations": [], "survivorship": "synthetic",
+            "unit_quarantine": {"tickers": {}, "reason_counts": {}}, "unit_schedule": None, "preprocessing": None,
+            "first_session": str(dates[0].date()), "last_session": end}
+    return df, meta
+
+
+def test_proto(over: dict | None = None) -> dict:
+    """The draft protocol with synthetic panel hashes and reduced draw / resample counts; `over` maps
+    dotted keys to replacement values."""
+    p = copy.deepcopy(PROTO)
+    for mk in e5.MARKETS:
+        p["markets"][mk]["panel_sha256"] = f"synthetic-{mk}"
+    p["matched_controls"]["detection_stage"]["draws"] = 20
+    p["matched_controls"]["paired_statistic"]["resamples"] = 200
+    p["stages"]["1_information"]["univariate"]["auc_bootstrap"] = 20
+    p["harness"]["random_draws"] = 8
+    p["harness"]["lookahead_cuts"] = 2
+    for k, v in (over or {}).items():
+        node = p
+        keys = k.split(".")
+        for key in keys[:-1]:
+            node = node[key]
+        node[keys[-1]] = v
+    return p
+
+
+def fake_reproduce(out: Path, meta: dict, status="REPRODUCED"):
+    (out.parent / "reproduce").mkdir(parents=True, exist_ok=True)
+    e3.write_json(out.parent / "reproduce" / "result.json", {"panel_sha256": meta["sha256"], "status": status})
+
+
+def frame_from_arrays(tickers, dates, a, opens=None, idx=True):
+    rows = []
+    for i, t in enumerate(tickers):
+        for d, day in enumerate(dates):
+            rows.append({"date": pd.Timestamp(day), "ticker": str(t), "source": "synthetic", "previous": a["prev"][i, d],
+                         "open": (opens[i, d] if opens is not None else pd.NA), "high": a["high"][i, d],
+                         "low": a["low"][i, d], "close": a["close"][i, d], "volume": a["volume"][i, d],
+                         "value": a["value"][i, d], "frequency": 100, "listed_shares": 10 ** 9 if idx else np.nan,
+                         "tradable_shares": 10 ** 9 if idx else np.nan})
+    return pd.DataFrame(rows)
+
+
+class Discovered:
+    """One synthetic discovery per market, shared by the tests that need a fitted model (built lazily)."""
+    cache = {}
+
+    @classmethod
+    def get(cls, market):
+        if market not in cls.cache:
+            warnings.simplefilter("ignore")
+            df, meta = e5_panel(market, n=30, seed={"IDX": 3, "US": 4, "CRYPTO": 5}[market],
+                                reset={2: 300} if market == "CRYPTO" else None)
+            proto = test_proto()
+            out = Path(tempfile.mkdtemp(prefix="idxsig-e5-")) / market / "discovery"
+            fake_reproduce(out, meta)
+            registry = synthetic_registry(df, meta) if market == "IDX" else None
+            summary = e5.run_discovery(df, meta, registry, out, proto, "synthetic-sha", market, log=lambda *_: None)
