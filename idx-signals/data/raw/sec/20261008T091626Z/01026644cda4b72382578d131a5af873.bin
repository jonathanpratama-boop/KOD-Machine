    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 22%; text-align: center">141,930</td><td style="width: 1%; text-align: center">&#160;</td><td style="text-align: center; width: 2%">&#160;</td>
    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 22%; text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">n/a</span></td><td style="width: 1%; text-align: center">&#160;</td></tr>
