  <TR STYLE="font: 10pt Times New Roman, Times, Serif; vertical-align: top; background-color: rgb(204,238,255)">
    <TD STYLE="text-align: justify; font: 10pt Times New Roman, Times, Serif; background-color: White"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">Proposal
    3 &mdash; <BR>
    Auditor Ratification<BR>
    Proposal</FONT></TD>
