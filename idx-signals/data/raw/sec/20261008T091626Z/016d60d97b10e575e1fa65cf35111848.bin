    <TD STYLE="width: 1%; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: left">&nbsp;</TD><TD STYLE="width: 10%; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: right">6,539,393</TD><TD STYLE="width: 1%; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: left">&nbsp;</TD><TD STYLE="width: 1%; font: 10pt Times New Roman, Times, Serif; color: Black">&nbsp;</TD>
    <TD STYLE="width: 1%; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: left">&nbsp;</TD><TD STYLE="width: 10%; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: right">69.90</TD><TD STYLE="width: 1%; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: left">%</TD></TR>
