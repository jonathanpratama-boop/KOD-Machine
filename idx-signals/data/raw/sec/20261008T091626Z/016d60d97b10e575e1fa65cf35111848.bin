    <TD STYLE="border-bottom: Black 1pt solid; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1pt solid; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: right">1,265,755</TD><TD STYLE="padding-bottom: 1pt; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: left">&nbsp;</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; color: Black; padding-bottom: 1pt">&nbsp;</TD>
    <TD STYLE="border-bottom: Black 1pt solid; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1pt solid; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: right">13.53</TD><TD STYLE="padding-bottom: 1pt; font: 10pt Times New Roman, Times, Serif; color: Black; text-align: left">%</TD></TR>
