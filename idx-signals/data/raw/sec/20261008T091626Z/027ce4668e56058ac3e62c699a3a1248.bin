    <TD STYLE="white-space: nowrap; border-right: Black 1pt solid; border-bottom: Black 1pt solid; border-left: Black 1pt solid; text-align: center; text-indent: 0.25in"><FONT STYLE="font-size: 9pt">105.00</FONT></TD>
    <TD STYLE="white-space: nowrap; border-right: Black 1pt solid; border-bottom: Black 1pt solid; text-align: center; text-indent: 0.25in"><FONT STYLE="font-size: 9pt">5%</FONT></TD>
