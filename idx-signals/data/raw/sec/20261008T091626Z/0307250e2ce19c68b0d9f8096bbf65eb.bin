    <td colspan="2" id="xdx_496_20250331_zRBIboHpX3rd" style="border-bottom: Black 1pt solid; font-weight: bold; text-align: center">March 31, 2025</td><td style="padding-bottom: 1pt; font-weight: bold">&#160;</td><td style="font-weight: bold; padding-bottom: 1pt">&#160;</td>
    <td colspan="2" id="xdx_491_20241231_zG3HW9lohw9g" style="border-bottom: Black 1pt solid; font-weight: bold; text-align: center">December 31, 2024</td><td style="padding-bottom: 1pt; font-weight: bold">&#160;</td></tr>
  <tr style="vertical-align: bottom">
    <td style="padding-bottom: 1pt; font-weight: bold; font-style: italic">(in thousands)</td><td style="font-weight: bold; padding-bottom: 1pt">&#160;</td>
