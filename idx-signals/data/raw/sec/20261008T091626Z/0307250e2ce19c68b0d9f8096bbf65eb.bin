    <td style="font: 10pt Times New Roman, Times, Serif; width: 36%"><span style="font-size: 10pt">Accelerated filer</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; width: 5%"><span style="font-family: Segoe UI Symbol,sans-serif; font-size: 10pt">&#9744;</span></td></tr>
  <tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
    <td style="font: 10pt Times New Roman, Times, Serif"><span style="font-size: 10pt"><span id="xdx_90A_edei--EntityFilerCategory_c20250101__20250331_zogBJioA5mt7"><ix:nonNumeric contextRef="From2025-01-01to2025-03-31" format="ixt-sec:entityfilercategoryen" id="Fact000034" name="dei:EntityFilerCategory">Non-accelerated filer</ix:nonNumeric></span></span></td>
