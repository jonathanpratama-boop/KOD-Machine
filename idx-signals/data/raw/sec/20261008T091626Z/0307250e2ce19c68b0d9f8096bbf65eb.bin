    <td style="text-align: left">$</td><td style="text-align: right"><ix:nonFraction name="us-gaap:StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest" contextRef="AsOf2025-03-31_us-gaap_AccumulatedOtherComprehensiveIncomeMember" id="Fact000921" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">265</ix:nonFraction><span style="font-size: 10pt"></span></td><td style="text-align: left"/></tr>
