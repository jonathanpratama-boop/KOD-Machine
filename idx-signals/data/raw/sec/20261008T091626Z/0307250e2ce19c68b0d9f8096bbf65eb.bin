    <td style="text-align: left">$</td><td style="text-align: right"><ix:nonFraction name="us-gaap:StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest" contextRef="AsOf2024-12-31_us-gaap_AccumulatedOtherComprehensiveIncomeMember" id="Fact000909" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">265</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
