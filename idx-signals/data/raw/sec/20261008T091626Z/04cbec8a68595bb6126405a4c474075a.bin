principal amount of $<span id="xdx_90F_eus-gaap--DebtInstrumentFaceAmount_iI_c20211126__us-gaap--TypeOfArrangementAxis__custom--SecuritiesPurchaseAgreementMember__dei--LegalEntityAxis__custom--OneThousandEightHundredDiagonalLendingMember_zhDSFe7qR0Ea" title="Debt instrument face amount"><ix:nonFraction name="us-gaap:DebtInstrumentFaceAmount" contextRef="AsOf2021-11-26_custom_SecuritiesPurchaseAgreementMember_custom_OneThousandEightHundredDiagonalLendingMember" format="ixt:numdotdecimal" decimals="0" unitRef="USD">53,750</ix:nonFraction></span>,
