    <td style="border-bottom: Black 1.5pt solid; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="border-bottom: Black 1.5pt solid; text-align: right"><span style="font-family: Times New Roman, Times, Serif">(<ix:nonFraction name="us-gaap:LesseeOperatingLeaseLiabilityUndiscountedExcessAmount" contextRef="AsOf2023-03-31" format="ixt:numdotdecimal" decimals="0" unitRef="USD">4,103</ix:nonFraction></span></td><td style="padding-bottom: 1.5pt; text-align: left"><span style="font-family: Times New Roman, Times, Serif">)</span></td></tr>
