            <td style="margin-top: 0pt; margin-bottom: 0pt;">
                <p>3. <b>Appointment of Auditor</b></p>
            </td>
            <td style="width: 6%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle;">
                <p style="text-align: center; margin-top: 0pt; margin-bottom: 0pt;"><font style="color: #ffffff; background-color: #000000;"><b>For</b></font></p>
