<P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0">&nbsp;</P>

<P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: center"><B>PROSPECTUS</B></P>

<P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: center">&nbsp;</P>

<TABLE CELLSPACING="0" CELLPADDING="0" STYLE="font: 10pt Times New Roman, Times, Serif; width: 100%; border-collapse: collapse">
  <TR>
    <TD STYLE="vertical-align: top; width: 91%">&nbsp;</TD>
    <TD STYLE="border-bottom: black 1.5pt solid; vertical-align: bottom; width: 9%; text-align: center"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt"><B>Page</B></FONT><FONT STYLE="font-size: 10pt">&nbsp;<FONT STYLE="font-family: Times New Roman, Times, Serif"></FONT></FONT></TD></TR>
  <TR>
    <TD STYLE="vertical-align: top">&nbsp;</TD>
