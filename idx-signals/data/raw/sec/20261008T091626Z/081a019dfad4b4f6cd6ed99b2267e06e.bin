gsPerShareBasic" scale="0" format="ixt:num-dot-decimal" decimals="INF" sign="-">0.95</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding: 0px 0px 3px; margin: 0px;">)</td></tr>
