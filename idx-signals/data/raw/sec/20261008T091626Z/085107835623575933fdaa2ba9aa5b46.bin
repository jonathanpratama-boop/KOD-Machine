    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 21%; text-align: center">2,841</td><td style="width: 1%; text-align: center">&#160;</td><td style="text-align: center; width: 2%">&#160;</td>
    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 21%; text-align: center">275,345</td><td style="width: 1%; text-align: center">&#160;</td></tr>
