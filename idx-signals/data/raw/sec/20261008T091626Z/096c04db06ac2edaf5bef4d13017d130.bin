            <td style="margin-top: 0pt; margin-bottom: 0pt; width: 50%;"><b>May 10, 2023</b></td>
            <td style="width: 50%; padding-left: 5.4pt; vertical-align: top; text-align: right;"><font style="color: #000000;"><u><b>www.integraresources.com</b></u></font></td>
