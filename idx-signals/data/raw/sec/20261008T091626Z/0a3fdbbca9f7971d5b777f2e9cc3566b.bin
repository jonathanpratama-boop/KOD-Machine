font-size: 10pt; margin-left: 0pt;"><ix:nonFraction id="c105714672" contextRef="i_2022-12-31_ClassesOfAssetsAxis-EquipmentAndHardwareMember_SegmentsAxis-SionCGUMember" unitRef="EUR" name="sev:AssetsAfterImpairment" scale="3" format="ixt:fixed-zero" decimals="-3">-</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt;">&#xa0;</td></tr>
<tr style="vertical-align: bottom; background-color: rgb(204, 238, 255);"><td style="font-family: &quot;Times New Roman&quot;; font-size: 10pt;"> <p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt;">Construction in progress</p> </td><td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt;">&#xa0;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt;">&#xa0;</td><td style="width: 12%; text-align: right; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt;"><ix:nonFraction id="c105714673" contextRef="i_2022-12-31_ClassesOfAssetsAxis-ConstructionInProgressMember_SegmentsAxis-SionCGUMember" unitRef="EUR" name="sev:AssetsBeforeImpairment" scale="3" format="ixt:num-dot-decimal" decimals="-3">38,473</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt;">&#xa0;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt;">&#xa0;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt;">&#xa0;</td><td style="width: 12%; text-align: right; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt;">(<ix:nonFraction id="c105714674" contextRef="d_2022-01-01_2022-12-31_ClassesOfAssetsAxis-ConstructionInProgressMember_SegmentsAxis-SionCGUMember" unitRef="EUR" name="ifrs-full:ImpairmentLoss" scale="3" format="ixt:num-dot-decimal" decimals="-3">38,473</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt;"> <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">)</p> </td><td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt;">&#xa0;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt;">&#xa0;</td><td style="width: 12%; text-align: right; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt;"><ix:nonFraction id="c105714675" contextRef="i_2022-12-31_ClassesOfAssetsAxis-ConstructionInProgressMember_SegmentsAxis-SionCGUMember" unitRef="EUR" name="sev:AssetsAfterImpairment" scale="3" format="ixt:fixed-zero" decimals="-3">-</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt;">&#xa0;</td></tr>
