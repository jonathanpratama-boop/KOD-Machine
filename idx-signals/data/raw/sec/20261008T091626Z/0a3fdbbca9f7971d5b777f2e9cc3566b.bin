    </div>
   </ix:exclude>
   <ix:exclude>&#xa0;</ix:exclude>
   <p style="font-family: Times New Roman; font-size: 10pt; font-variant: normal; text-align: justify; margin: 0pt;">The table below summarizes the maturity profile of Sono Group&#x2019;s financial liabilities based on contractual undiscounted payments:</p>
   <p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;">&#xa0;</p>
   <ix:nonNumeric contextRef="d_2022-01-01_2022-12-31" name="ifrs-full:MaturityAnalysisForNonderivativeFinancialLiabilities" id="c364ADDCB-AB3D-4F5D-A456-8032CA5FED6D" escape="true" continuedAt="c7377560F-9129-46A1-B937-249F6928AAE7">
