    <td style="width: 1%; text-align: left">$</td><td style="width: 16%; text-align: right">499,678</td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 2%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 16%; text-align: right">-</td><td style="width: 1%; text-align: left">&#160;</td></tr>
