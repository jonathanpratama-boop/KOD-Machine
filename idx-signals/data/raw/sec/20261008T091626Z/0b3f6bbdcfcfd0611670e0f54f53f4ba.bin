</ix:nonNumeric><ix:nonNumeric contextRef="From2023-05-01to2024-01-31" escape="true" id="Fact003434" name="us-gaap:SubsequentEventsTextBlock"><p id="xdx_801_eus-gaap--SubsequentEventsTextBlock_zzLPtBCRnf7c" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>Note
