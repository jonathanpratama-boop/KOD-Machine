    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif; text-align: right">(<ix:nonFraction name="CNXA:DeferredTaxAssetsInProcessResearchAndDevelopmentCosts" contextRef="AsOf2022-04-30_country_IL" id="Fact001564" format="ixt:numdotdecimal" decimals="0" unitRef="USD">113,000</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">)</td></tr>
