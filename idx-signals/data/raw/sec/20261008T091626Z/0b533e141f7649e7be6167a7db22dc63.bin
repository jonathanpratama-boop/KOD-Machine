    <TD STYLE="border-bottom: black 4.5pt double; text-align: right"><FONT STYLE="font-size: 10pt"><B>13,881,659</B></FONT></TD>
    <TD STYLE="padding-bottom: 4pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
    <TD STYLE="padding-bottom: 4pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
