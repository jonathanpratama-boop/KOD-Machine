    <TD STYLE="vertical-align: bottom; padding-bottom: 1.5pt; text-align: right"><FONT STYLE="font-size: 10pt"><B>4</B></FONT></TD>
    <TD STYLE="vertical-align: bottom; padding-bottom: 1.5pt"><FONT STYLE="font-size: 10pt"><B>%</B></FONT></TD></TR>
