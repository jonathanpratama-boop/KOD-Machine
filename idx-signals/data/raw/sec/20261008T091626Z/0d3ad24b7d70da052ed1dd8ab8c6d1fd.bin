    <td style="background-color:rgba(255,255,255,1);word-break:break-word;white-space:pre-wrap;vertical-align:middle;border-bottom:0.5pt solid rgba(0,0,0,1);"><p style="text-indent:0.0pt;font-size:8.5pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:left;"><font style="white-space:pre-wrap;font-size:8.5pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;">&#160;</font></p></td>
