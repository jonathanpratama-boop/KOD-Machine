    <td style="border-bottom: black 1pt solid; font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="border-bottom: black 1pt solid; font: 10pt Times New Roman, Times, Serif; text-align: right">(<ix:nonFraction name="WNW:AccumulatedAmortizationOperatingLeaseRightOfUseAsset" contextRef="AsOf2023-12-31" id="Fact002908" format="ixt:numdotdecimal" decimals="0" unitRef="USD">174,935</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; padding-bottom: 1.5pt; text-align: left">)</td><td style="font: 10pt Times New Roman, Times, Serif; padding-bottom: 1.5pt">&#160;</td>
