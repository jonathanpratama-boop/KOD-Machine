    <td style="border-bottom: black 1pt solid; font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="border-bottom: black 1pt solid; font: 10pt Times New Roman, Times, Serif; text-align: right"><ix:nonFraction name="us-gaap:AccountsPayableCurrent" contextRef="AsOf2022-12-31" id="Fact002891" format="ixt:numdotdecimal" decimals="0" unitRef="USD">4,990,647</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; padding-bottom: 1.5pt; text-align: left">&#160;</td></tr>
  </table>

