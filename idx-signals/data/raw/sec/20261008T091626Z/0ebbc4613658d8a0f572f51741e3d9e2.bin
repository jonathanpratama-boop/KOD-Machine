<P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0"><B>&nbsp;</B></P>

<TABLE CELLSPACING="0" CELLPADDING="0" STYLE="font: 10pt Times New Roman, Times, Serif; width: 100%; border-collapse: collapse">
  <TR STYLE="vertical-align: top">
    <TD STYLE="width: 49%; font-weight: bold; text-align: center; font-size: 12pt">STATUTEN</TD>
    <TD STYLE="width: 2%; font-weight: bold; text-align: center; font-size: 12pt">&nbsp;</TD>
    <TD STYLE="width: 49%; font-weight: bold; text-align: center; font-size: 12pt">ARTICLES OF ASSOCIATION</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: center">&nbsp;</TD>
    <TD STYLE="font-weight: bold; text-align: center; font-size: 12pt">&nbsp;</TD>
    <TD STYLE="text-align: center">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: center"><FONT STYLE="font-family: Times New Roman, Times, Serif">der</FONT></TD>
    <TD STYLE="font-weight: bold; text-align: center; font-size: 12pt">&nbsp;</TD>
    <TD STYLE="text-align: center"><FONT STYLE="font-family: Times New Roman, Times, Serif">of</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
