  <div style="font-size:10pt;font-family:Times New Roman;"><ix:nonNumeric id="F_5f5aa9f3-b743-4f8e-8cc7-8abc77e93596" contextRef="C_08b7d10d-a221-4c07-9c6c-5c876d717f91" name="us-gaap:SubsequentEventsTextBlock" escape="true"><p style="font-size:10pt;margin-top:6pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-weight:bold;font-size:10pt;font-family:Times New Roman;min-width:fit-content;">13. SUBSEQUENT EVENTS</span><span style="color:#000000;white-space:pre-wrap;font-weight:bold;font-size:10pt;font-family:Times New Roman;min-width:fit-content;"> </span></p><p style="font-size:10pt;margin-top:12pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;min-width:fit-content;">The Company has evaluated subsequent events through the date on which the unaudited interim condensed consolidated financial statements were issued. The Company has concluded that no subsequent events have occurred that require disclosure to the unaudited interim condensed consolidated financial statements.</span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;min-width:fit-content;"> </span></p></ix:nonNumeric></div>
