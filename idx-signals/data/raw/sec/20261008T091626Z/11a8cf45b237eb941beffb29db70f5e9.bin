    <td>&#160;</td><td>&#160;</td>
    <td colspan="6">&#160;</td><td>&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 76%"><span style="font-size: 10pt">Audit fees<sup>(1)</sup></span></td><td style="width: 1%">&#160;</td>
