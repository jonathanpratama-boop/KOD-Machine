    <td style="padding-bottom: 1.5pt; text-align: left">&#160;</td><td style="padding-bottom: 1.5pt; text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction contextRef="c129" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" unitRef="usdPershares" id="ixv-20084">4.85</ix:nonFraction>-<ix:nonFraction contextRef="c130" decimals="1" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" unitRef="usdPershares" id="ixv-20085">12.5</ix:nonFraction></span></td><td style="padding-bottom: 1.5pt; text-align: left">&#160;</td><td style="padding-bottom: 1.5pt">&#160;</td>
