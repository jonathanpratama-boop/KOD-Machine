                                    <td style="width: 40%; vertical-align: top; border-left: 2px solid rgb(0, 0, 0); border-bottom: 2px solid rgb(0, 0, 0);">
                                      <div style="margin-left: 2pt; color: rgb(0, 0, 0);">437,500.0000</div>
                                    </td>
                                    <td style="width: 40%; vertical-align: top; border-left: 2px solid rgb(0, 0, 0); border-right: 2px solid rgb(0, 0, 0); border-bottom: 2px solid rgb(0, 0, 0);">
                                      <div style="margin-left: 2pt;">27-Oct-2023</div>
