            <td valign="bottom" nowrap="nowrap" style="vertical-align: bottom; width: 1%; background-color: #CCEEFF;" colspan="1" class="cftfncell">
              <div><font style="color: rgb(0, 0, 0);">%</font></div>
            </td>
