            <td valign="bottom" style="vertical-align: bottom; text-align: right; width: 9%;" colspan="1" class="cftnumcell">
              <div><font style="color: #000000;">17</font></div>
            </td>
            <td valign="bottom" nowrap="nowrap" style="vertical-align: bottom; width: 1%;" colspan="1" class="cftfncell">
              <div><font style="color: rgb(0, 0, 0);">%</font></div>
            </td>
          </tr>
          <tr>
            <td valign="bottom" style="vertical-align: bottom; width: 64%; background-color: #CCEEFF;">
              <div style="text-indent: -7.2pt; margin-left: 7.2pt; color: rgb(0, 0, 0);">Customer C</div>
            </td>
