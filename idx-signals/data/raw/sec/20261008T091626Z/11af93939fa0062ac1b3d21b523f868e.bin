              <div style="color: rgb(0, 0, 0);">8,143,304</div>
            </td>
            <td valign="bottom" nowrap="nowrap" style="vertical-align: bottom; width: 1%; padding-bottom: 4px; background-color: #CCEEFF;" colspan="1" class="cftfncell">&#160;</td>
