    <td style="border-bottom: Black 2.5pt double; text-align: left">&#160;</td><td style="border-bottom: Black 2.5pt double; text-align: right"><ix:nonFraction name="BON:AdvanceToSuppliersNet" contextRef="AsOf2023-09-30" id="Fact003660" format="ixt:numdotdecimal" decimals="0" unitRef="USD">15,117,191</ix:nonFraction></td><td style="padding-bottom: 2.5pt; text-align: left">&#160;</td></tr>
  </table>

