    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction name="us-gaap:ShortTermBorrowings" contextRef="AsOf2024-03-31_custom_PostalSavingsBankOfChinaMember" id="Fact003804" format="ixt:numdotdecimal" decimals="0" unitRef="USD">426,852</ix:nonFraction></span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
