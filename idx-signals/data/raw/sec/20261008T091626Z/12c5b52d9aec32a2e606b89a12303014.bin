    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 16%; text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">US$<span id="xdx_903_eus-gaap--ForeignCurrencyExchangeRateTranslation1_iI_c20230930__us-gaap--VariableRateAxis__custom--PeriodEndSpotRateMember_zthTB1xfT0Lb" title="Exchange rate"><ix:nonFraction name="us-gaap:ForeignCurrencyExchangeRateTranslation1" contextRef="AsOf2023-09-30_custom_PeriodEndSpotRateMember" id="Fact003409" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">1</ix:nonFraction></span>=RMB<span id="xdx_900_eus-gaap--ForeignCurrencyExchangeRateTranslation1_iI_c20230930__us-gaap--VariableRateAxis__custom--PeriodEndSpotRateMember__us-gaap--AwardTypeAxis__custom--RMBMember_zUUhGcCezJC2" title="Exchange rate"><ix:nonFraction name="us-gaap:ForeignCurrencyExchangeRateTranslation1" contextRef="AsOf2023-09-30_custom_PeriodEndSpotRateMember_custom_RMBMember" id="Fact003411" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">7.2960</ix:nonFraction></span></span></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td>Average rate</td><td>&#160;</td>
