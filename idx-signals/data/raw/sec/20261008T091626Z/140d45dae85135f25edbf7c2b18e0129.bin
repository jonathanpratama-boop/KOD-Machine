mdotdecimal" name="us-gaap:FiniteLivedIntangibleAssetsAmortizationExpenseYearFour" scale="0" id="Narr_JPmH2xp8x06NSlfGjh4RFg">104,000</ix:nonFraction></span><span style="font-size:10pt;"> and </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2022_SDmIfAnEKEWKh2bTnplXEQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:FiniteLivedIntangibleAssetsAmortizationExpenseAfterYearFive" scale="0" id="Narr_00715OMP0kC1nLuw-KFIyw">288,000</ix:nonFraction></span><span style="font-size:10pt;">, respectively.</span></p></ix:nonNumeric><a id="Tc_qKRrMVmC9EeXEUWjkuQkeg_1_2"></a><a id="Tc_aNVvCGNVRUSoDuX3hI7qZw_1_5"></a><a id="Tc_Uhe4B-JcdUu-Qtjyq3YY3g_2_2"></a><a id="Tc_0EN4kG8cgkuJrcMjBCE_mQ_2_5"></a><a id="Tc_Pqk2RDHNY0a2o-CZQcl5WQ_3_0"></a><a id="Tc_B0bMebrp5UCXaDcHFjn5Jw_3_2"></a><a id="Tc_wMOOvzPIBUePc-tP2U5ClQ_3_5"></a><a id="Tc_hOVdcknvjkqfYGNCvjdgZw_4_0"></a><a id="Tc_Yg8-iA9p3UiCJIROFcXZpg_5_0"></a><a id="Tc_z9oIXjfk9EqgTUctBkmWEQ_5_2"></a><a id="Tc_1qq1Ts-_GUCvso92C4RMQA_5_5"></a><a id="Tc_5UEMyfJpmE2xTxplvsx9Og_6_0"></a><a id="Tc_NzNmvM6N0EqRTCKi_0SnrA_7_0"></a><a id="Tc_s_huVt5PMECLHNPTbbAF4w_7_2"></a><a id="Tc_pWT59cTdg06hXhuN89cBZg_7_5"></a><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_MjGK2CkTR0aSuL2-VrcrTA" name="us-gaap:RelatedPartyTransactionsDisclosureTextBlock" id="Tb_ySHJwsqTv0yFAkAXL2YmcQ" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;margin:0pt 0pt 12pt 0pt;">NOTE&#160;12&#160;&#8211; RELATED PARTY TRANSACTIONS</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;margin:0pt 0pt 12pt 0pt;">Employment Agreements and Due to Officers/Founders:</p><p style="font-family:'Times New Roman','Times','serif';font-size:12pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><span style="font-size:10pt;">Due to the limited funding of Quoin Inc. prior to the consummation of the Merger, the compensation, including salary, office and car allowances and other benefits, due to Dr. Myers and Ms. Carter under their respective employment agreements, as well as reimbursement of expenses and other amounts paid by Dr. Myers and Ms. Carter to third parties on behalf of Quoin Inc., were not paid by Quoin Inc. to Dr. Myers and Ms. Carter, and were accrued as indebtedness to Dr. Myers and Ms. Carter. Following the closing of the Merger, Quoin Inc. began making </span><span style="-sec-ix-hidden:Hidden__NAv90Mvc0qLmD3e05D4Cw;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">payments</span></span><span style="font-size:10pt;"> of </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_qnrx_Ms.CarterMember_ZjnVez1lEEWZtFsAddr0Jg" decimals="0" format="ixt:numdotdecimal" name="qnrx:PaymentToRelatedPartyPerMonth" scale="0" id="Narr_9fsD9ppDW0uO_-thhoiHIg">25,000</ix:nonFraction></span><span style="font-size:10pt;"> per month to each of Dr. Myers and Ms. Carter to repay the above-described non-interest-bearing indebtedness. The Company repaid </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_qnrx_Dr.MyersMember_VvkE5wvqUUKKLd55fPemlg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RepaymentsOfRelatedPartyDebt" scale="0" id="Narr_3NBQ0TYS4EajrMJubwgsgQ">300,000</ix:nonFraction></span><span style="font-size:10pt;"> and </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_qnrx_Dr.MyersMember_AWXCRNF7i0qvlSFLnsmn1A" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RepaymentsOfRelatedPartyDebt" scale="0" id="Narr_VV9P8_mw8ke-M2lLjIMYdA">125,000</ix:nonFraction></span><span style="font-size:10pt;"> of such indebtedness to Dr. Myers and </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_qnrx_Ms.CarterMember_ZjnVez1lEEWZtFsAddr0Jg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RepaymentsOfRelatedPartyDebt" scale="0" id="Narr_vasA63RXCE-8dI7HgPg-FQ">300,000</ix:nonFraction></span><span style="font-size:10pt;"> and </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_qnrx_Ms.CarterMember_SO7mn6ZpTE2i3XE6cq20LQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RepaymentsOfRelatedPartyDebt" scale="0" id="Narr_7j-c2iQY7UiI6WFwcZguEw">160,000</ix:nonFraction></span><span style="font-size:10pt;"> to Ms. Carter in the year ending December 31, 2022 and 2021, respectively. As of December 31, 2022, approximately </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2022_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_qnrx_Dr.MyersMember_ZVhseIpsA0ScsswFxxEL_g" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionDueFromToRelatedParty" scale="0" id="Narr_XCvPQ_kKcEqnaSvxD9ohGg">2,259,000</ix:nonFraction></span><span style="font-size:10pt;"> and </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2022_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_qnrx_Ms.CarterMember_1WaDX4T2606-qnuNMEeTHw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionDueFromToRelatedParty" scale="0" id="Narr_eGDZKSY_Jk6LHNVl4mwlTQ">1,865,000</ix:nonFraction></span><span style="font-size:10pt;"> of such indebtedness was outstanding to Dr. Myers and Ms. Carter, respectively.</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">Amounts due to officers at December 31, 2022 and 2021 consisted of the following:</p><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_MjGK2CkTR0aSuL2-VrcrTA" name="us-gaap:ScheduleOfRelatedPartyTransactionsTableTextBlock" id="Tb_OKFNbxb_pUqdBQ-OM2hkNA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:12pt;text-align:justify;margin:0pt;"><span style="font-size:10pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:73.88%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2.34%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:1.48%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:1