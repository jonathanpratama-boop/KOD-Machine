:nowrap;width:1.48%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.24%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2022_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_OfficerMember_hZEbQtcQUkibm19X1ly6tA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToOfficersOrStockholdersCurrentAndNoncurrent" scale="0" id="Tc__KBuu7-ALUm3kc5gEvWu-w_5_3">4,123,732</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.34%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.48%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.22%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2021_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_OfficerMember_ti8g_Nm4sUaVKgI1JcDuUw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToOfficersOrStockholdersCurrentAndNoncurrent" scale="0" id="Tc_vTw3PW5El0OAmpKmI4bLJg_5_6">4,723,732</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:73.88%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Less: Short-term portion</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.34%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.48%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.24%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 0pt 0.05pt 0pt;"> (<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2022_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_OfficerMember_hZEbQtcQUkibm19X1ly6tA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToOfficersOrStockholdersCurrent" scale="0" id="Tc_Fro-mWeRtkGWmDwYKbN1WA_6_3">600,000</ix:nonFraction>)</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.34%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.48%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.22%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 0pt 0.05pt 0pt;"> (<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2021_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_OfficerMember_ti8g_Nm4sUaVKgI1JcDuUw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToOfficersOrStockholdersCurrent" scale="0" id="Tc_6UBvINjTd0WY3CUNSqxfoQ_6_6">600,000</ix:nonFraction>)</p></td></tr><tr><td style="vertical-align:bottom;width:73.88%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Long-term portion</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.34%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.48%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.24%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2022_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_OfficerMember_hZEbQtcQUkibm19X1ly6tA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToOfficersOrStockholdersNoncurrent" scale="0" id="Tc_-qBSCarEZUeayXRSakW8QA_7_3">3,523,733</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.34%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.48%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.22%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2021_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_OfficerMember_ti8g_Nm4sUaVKgI1JcDuUw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToOfficersOrStockholdersNoncurrent" scale="0" id="Tc_4CEmemo89U2lq6vNSPEnBw_7_6">4,123,732</ix:nonFraction></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:12pt;text-align:justify;margin:0pt;"><span style="font-size:10pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><b style="font-weight:bold;">Expenses:</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:12pt;text-align:justify;margin:0pt;"><span style="font-size:10pt;font-weight:bold;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">In 2021, the Company paid $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_RelatedPartyTransactionAxis_qnrx_ConsultingExpenseMember_tfIU4-M0DE68pKTXELdQSg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_WtEADRc_XEGmiECImiZCtw">100,000</ix:nonFraction> of consulting expenses to a company controlled by Dennis Langer, our director, and approximately $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RelatedPartyTransactionAxis_us-gaap_ResearchAndDevelopmentExpenseMember_dOZdg_xIzECea_wZOskrHw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_N3LjtrKHUUOoTFTJV5wDuA">48,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_RelatedPartyTransactionAxis_us-gaap_ResearchAndDevelopmentExpenseMember_8H9suwkybEmUQvvr0YOXSw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_nz4y5NuHnECXwM8zlLMf7Q">8,000</ix:nonFraction> were paid during the years ended December 31, 2022 and 2021, respectively, to Dr. Myers&#8217; son, who has been consulting for the Company on research and development matters from time to time.</p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:12pt;text-align:justify;margin:0pt;"><span style="font-size:10pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-19</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><b style="font-weight:bold;">QUOIN PHARMACEUTICALS LTD. </b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><b style="font-weight:bold;">Notes to Consolidated Financial Statements</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">December 31, 2022 and 2021</b></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_MjGK2CkTR0aSuL2-VrcrTA" name="us-gaap:CommitmentsDisclosureTextBlock" id="Tb_XviCmLHlW0yYD96L_oc7jA" continuedAt="Tb_XviCmLHlW0yYD96L_oc7jA_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;margin:0pt 0pt 12pt 0pt;">NOTE&#160;13&#160;&#8211; RESEARCH, CONSULTING AGREEMENTS AND COMMITMENTS</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;margin:0pt 0pt 12pt 0pt;">Research and consulting agreement</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Quoin Inc. entered into a research and consulting agreement (the &#8220;Research Agreement&#8221;) which commits it to pay the former owner of Polytherapeutics (the &#8220;Consultant&#8221; or &#8220;Seller&#8221;) to transfer the technical know-how of Polytherapeutics with respect to (i)&#160;good manufacturing practices (&#8220;GMP&#8221;), clinical and commercial manufacturing of the Company&#8217;s PolyDur polymer and (ii)&#160;formulation development of products utilizing the Company&#8217;s PharmaDur polymer (See Note&#160;10). The agreement required&#160;monthly consulting payments of $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_2_28_2021_srt_CounterpartyNameAxis_qnrx_PolytherapeuticsMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_Ee8c7Y50o0yVTS6YiSf1Ng" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementMonthlyPayment" scale="0" id="Narr_y5ffL3Dm5EyRbVcm-wLN-Q">20,833</ix:nonFraction> beginning on July&#160;31, 2018 and ending February&#160;28, 2021 (the &#8220;Post-Closing Period&#8221;) for a total of $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_2_28_2021_srt_CounterpartyNameAxis_qnrx_PolytherapeuticsMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_Ee8c7Y50o0yVTS6YiSf1Ng" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_DMSTI_25-kKOMol4GoHZUA">666,667</ix:nonFraction> over the consulting period. Pursuant to an amendment, the Post-Closing Period was revised to terminate on December&#160;31, 2020.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Through December&#160;31, 2022 and the financial statement issuance date, the Company has not made any payments, the Consultant has not performed any services and the Company has not incurred or accrued for any expenses. See Note&#160;16 for Consultant&#8217;s notification of breach of contract.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;margin:0pt 0pt 12pt 0pt;">Other research consulting agreements</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Quoin Inc. entered into <ix:nonFraction unitRef="Unit_Standard_pure_vf2MYNx-4UaRBp-ukIvVng" contextRef="Duration_7_31_2018_To_7_31_2018_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_sVqdzAZlC0CZexZSJq5Ovg" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfAgreement" scale="0" id="Narr_S-BfyGQq30OeBwtp1GnlRA">three</ix:nonFraction> consulting agreements with Axella Research LLC (&#8220;Axella&#8221;) to provide regulatory and pre- clinical/clinical services to the Company with respect to QRX003 and QRX004. The combined fees of the three agreements are approximately $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_7_31_2018_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_WhFMwpJ38UKMH68i2l0YWQ" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_BMslcvrGSUic1KLY-YR8gA">270,000</ix:nonFraction>, payable as milestones were met. The Company incurred accrued expenses of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2021_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_-aGZ2rbco0mtXR4lyLfgXQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="0" id="Narr_SPzCNDEehUyhbdC70izLsw">194,000</ix:nonFraction> in relation to Axella consulting agreements as of December 31, 2021. In August 2022, the Company issued <ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="Duration_8_1_2022_To_8_31_2022_QbTaw07P1k-eLQKFGji0uQ" decimals="INF" format="ixt:numdotdecimal" name="qnrx:StockIssuedDuringPeriodSharesSettlementOfAccruedLiabilities" scale="0" id="Narr_CpFknfogU0yuUdL-iJxWQw">44,187</ix:nonFraction> ADSs to one of Axella<span style="font-size:12pt;">&#8217;</span>s principals to settle the outstanding liability in full. To date the Company has incurred <ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_8_1_2022_To_8_31_2022_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_ubnVMKqGS0aG-_QRr29UbQ" decimals="0" format="ixt-sec:numwordsen" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_Wg_G8fmrZkiYbagQ4X1YGw">no</ix:nonFraction> research and development expenses in connection with these agreements, as no services have been provided.</p><p style="font-family:'Times New Roman','Times','serif';font-size:12pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><span style="font-size:10pt;">In November 2020, Quoin Inc. entered into a Master Service Agreement for an initial term of </span><ix:nonNumeric contextRef="Duration_11_1_2020_To_11_30_2020_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_bye2zHDxUEGDaSEtisP_Iw" format="ixt-sec:durwordsen" name="qnrx:AgreementInitialTerm" id="Narr_D9Dh035JakiRozmwpnbw-w"><span style="font-size:10pt;">three years</span></ix:nonNumeric><span style="font-size:10pt;"> with Therapeutics Inc. for managing preclinical and clinical development for new products in the field of dermatology. The agreement required the execution of individual work orders. Quoin Inc. may terminate any work order for any reason with </span><ix:nonNumeric contextRef="Duration_11_1_2020_To_11_30_2020_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_bye2zHDxUEGDaSEtisP_Iw" format="ixt-sec:durwordsen" name="qnrx:AgreementWrittenTerminationNotice" id="Narr_I40jJg42Ok-hGGcT5Ptx2g"><span style="font-size:10pt;">90 days</span></ix:nonNumeric><span style="font-size:10pt;"> written notice subject to costs incurred through termination and a defined termination fee, unless there is a material breach by Therapeutics Inc. A work order was entered into in June 2022 for the first QRX003 clinical study at an expected estimated cost of approximately </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_6_30_2022_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_jMJZ2oHt1km21eGh90_POw" decimals="-5" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="6" id="Narr_Deh6_vU0s0eXdtKxN1bqUA">4.4</ix:nonFraction></span><span style="font-size:10pt;"> million through 2024. A further work order was entered into in December 2022 for the second QRX003 clinical study at an expected estimated cost of approximately </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2022_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_c79Z2oSEDUOJXw1nCmb6rg" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_s6vjFOG8AUuMdm5jb0fCCw">830,000</ix:nonFraction></span><span style="font-size:10pt;"> through 2024. For the years ended December 31, 2022 and 2021, the Company incurred a research and development expense under these agreements of approximately </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2022_To_12_31_2022_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_RsDXRY6fG0u93YVmiHM72A" decimals="-5" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="6" id="Narr_N5Ct_VU_y027Gn154GIaLA">1.2</ix:nonFraction></span><span style="font-size:10pt;"> million and </span><span style="font-size:10pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2021_To_12_31_2021_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_ELJ79onCqEeeJL2c_W1O6w" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_JH0_u9Ytlke0lxMLf18WMg">340,000</ix:nonFraction></span><span style="font-size:10pt;"> respectively.</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">In November&#160;2021, the Company entered into a commitment with Queensland University of Technology for research related services associated with Netherton Syndrome of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_11_30_2021_srt_CounterpartyNameAxis_qnrx_NethertonSyndromeMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_OzAzAzrVRk6pak8fbLZJTg" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_deoVoQH89Eud_mCtf-ss5g">250,000</ix:nonFraction> for an expected period of eighteen&#160;months. For the years ended December 31, 2022 and 2021, the Company incurred research and development costs related to this agreement of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2022_To_12_31_2022_srt_CounterpartyNameAxis_qnrx_NethertonSyndromeMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_oOIwRdO38E-AD5tx8ecqhw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_S3hNqOE2PUWcv3jTiD0MTA">77,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2021_To_12_31_2021_srt_CounterpartyNameAxis_qnrx_NethertonSyndromeMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_dkZx5FT6bkmAjJy9TlUOEg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_CA46vuirh0uPgVyW3GlCEA">25,000</ix:nonFraction>, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">In May 2022, the Company entered into a commitment with Queensland University of Technology for research related services associated with Scleroderma of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_5_31_2022_srt_CounterpartyNameAxis_qnrx_SclerodermaMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_GL4dDoB4UUu3QMtqrOmt3g" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_UgwHkJNWNUCnxpTFE6Xklw">610,000</ix:nonFraction> for an expected period of eighteen months. The Company incurred research and development expenses of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2022_To_12_31_2022_srt_CounterpartyNameAxis_qnrx_SclerodermaMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_2IHATuTh2k23KcNniEoaLA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_77gzH5htOkOFsDCZcM-oBw">276,000</ix:nonFraction> for the year ended December 31, 2022.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Consulting agreement:</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Quoin Inc. entered into a consulting agreement with an Investor Relations (IR) firm, which provides for a monthly fee of $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2022_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_pbfyjo6TuU2j2h6Rm9aTpg" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementMonthlyPayment" scale="0" id="Narr_OsZZ-MVdvUK3Gx2ODCYO8g">14,000</ix:nonFraction>. The agreement had an automatic annual renewal clause and has been in effect since November 2017. The Company owed the IR firm $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="As_Of_12_31_2021_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_-Cs9FcYN3Uegzlnwq80P3Q" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="0" id="Narr_7hVrYBzB_0WmKyo8UwJ_3Q">584,000</ix:nonFraction> as of December 31, 2021, which was included in accrued expenses in the accompanying balance sheet. In March 2022, the Company entered into a settlement agreement with the IR firm reducing the liability to $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_3_1_2022_To_3_31_2022_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_2SW3ykc6I0mV0vfTLnBzLQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:GainsLossesOnExtinguishmentOfDebt" scale="0" id="Narr_V-23HWworkmNp00ojCCbYA">168,000</ix:nonFraction> and recognized $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_3_1_2022_To_3_31_2022_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_2SW3ykc6I0mV0vfTLnBzLQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:NonoperatingIncomeExpense" scale="0" id="Narr_mYPjM3sXCUmR-utXODViTw">416,000</ix:nonFraction> as other income in the accompanying consolidated statement of operations. For the years ended December 31, 2022 and 2021, the Company incurred expenses of $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2022_To_12_31_2022_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_gBNH2CSdJEeTixEhBrtWBw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ProfessionalFees" scale="0" id="Narr_10-43GoCzkKHmtIPfJ9o5g">112,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_1_1_2021_To_12_31_2021_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_o_pMtJWUdU2GIQc0HEKw-Q" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ProfessionalFees" scale="0" id="Narr_v_CqclWIb0COamYXejotyg">70,000</ix:nonFraction>, respectively.</p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-20</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><b style="font-weight:bold;">QUOIN PHARMACEUTICALS LTD. </b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><b style="font-weight:bold;">Notes to Consolidated Financial Statements</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">December 31, 2022 and 2021</b></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_XviCmLHlW0yYD96L_oc7jA_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;margin:0pt 0pt 12pt 0pt;">Performance milestones and Royalties</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">See Note&#160;10 for asset and in-licensed technology commitments.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 2.15pt 12pt 0pt;"><b style="font-weight:bold;">Merger agreement commitment</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 2.15pt 12pt 0pt;">In consideration for the Share Transfer disclosed in Note 1, the pre-closing Cellect shareholders received a contingent value right (&#8220;CVR&#8221;) entitling the holders to earnouts during the Payment Period (as such term is defined in the Share Transfer Agreement), comprised mainly of payments upon sale, milestone payments, license fees and exit fees realized by the business spun out of Cellect prior to the Merger.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 2.15pt 12pt 0pt;">Cellect entered into a CVR Agreement with Mr. Eyal Leibovitz, in the capacity of Representative for the holders of CVRs, and Computershare Trust Company, N.A., a federally chartered trust company (the &#8220;Rights Agent&#8221;). Under the terms of the CVR Agreement, the holders of the Cellect ADSs immediately prior to the Merger had the right to receive, through their ownership of CVRs, their pro-rata share of the net Share Transfer consideration, making such holders of CVRs the indirect beneficiaries of the net payments under the Share Transfer. CVRs were recorded in a register administered by the Rights Agent but were not certificated.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 2.5pt 0pt 0pt;">Since the Company will not receive any net proceeds from the CVRs, there is no asset or liability recorded in the consolidated financial statements.</p></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:12pt;text-align:justify;margin:0pt;"><span style="font-size:10pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_MjGK2CkTR0aSuL2-VrcrTA" name="us-gaap:StockholdersEquityNoteDisclosureTextBlock" id="Tb_Yn_QZKBDT0GvAP-omiMzRw" continuedAt="Tb_Yn_QZKBDT0GvAP-omiMzRw_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;margin:0pt 0pt 12pt 0pt;">NOTE&#160;14&#160;&#8211; SHAREHOLDERS&#8217; EQUITY AND SHARE OWNERSHIP AND RIGHTS</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Company held a Special General Meeting on February 28, 2022, at which the Company&#8217;s shareholders adopted the Amended and Restated Articles of Association of the Company. The Company held its Annual General Meeting on April 12, 2022, at which the Company&#8217;s shareholders approved an increase to the authorized share capital to <ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="As_Of_4_12_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_6BClfieLoUeEBYE8J9lSzw" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_guwmrvz6NUCJT6Yu8D3aYA">50,000,000,000</ix:nonFraction> ordinary shares from <ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="As_Of_4_11_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_CRCUIiXuj0qHLc9xNXNCHg" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_V_chSShREU-_D0JMxwg6nQ">12,500,000,000</ix:nonFraction>, <ix:nonFraction unitRef="Unit_Divide_USD_shares_f-Iw-_7kF0Wo7clLz9E5qQ" contextRef="As_Of_4_12_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_6BClfieLoUeEBYE8J9lSzw" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:CommonStockParOrStatedValuePerShare" scale="0" id="Narr_JuYJrvw3ckKCiDgUrREq8Q">no</ix:nonFraction> par value. The Company held a further Annual General Meeting on November 3, 2022, at which the Company&#8217;s shareholders approved an increase to the authorized share capital to <ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="As_Of_11_3_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_XuE_sWugM0qgtagvQngTDA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_mhsyG8gj8Em0UgkbEce9pw">500,000,000,000</ix:nonFraction> ordinary shares from <ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="As_Of_11_2_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_VOMkvANXvkWuI3y0Lrz7Dg" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_8wdiLWxV-0qDFA9UYcpmxA">50,000,000,000</ix:nonFraction>, <ix:nonFraction unitRef="Unit_Divide_USD_shares_f-Iw-_7kF0Wo7clLz9E5qQ" contextRef="As_Of_11_3_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_XuE_sWugM0qgtagvQngTDA" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:CommonStockParOrStatedValuePerShare" scale="0" id="Narr_6hfBl09D5UmfKgpP5Wt5iQ">no</ix:nonFraction> par value. These ordinary shares are not redeemable and do not have any preemptive rights.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Holders of the Company&#8217;s ordinary shares have <ix:nonFraction unitRef="Unit_Standard_Vote_DmiUOPJjx02GJEKAve8Nfw" contextRef="As_Of_12_31_2022_SDmIfAnEKEWKh2bTnplXEQ" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:SharesNumberOfVotes" scale="0" id="Narr_oYrNK5lbZkyeNsyg0Aljjg">one</ix:nonFraction> vote for each ordinary share held on all matters submitted to a vote of shareholders at a shareholders meeting. The board of directors shall determine and provide a record date for each shareholders meeting and all shareholders at such record date may vote. Unless stipulated differently in the Companies Law or in the articles of association, all shareholders&#8217; resolutions shall be approved by a simple majority vote.</p><p style="font-family:'Times New Roman','Times','serif';font-size:12pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><span style="font-size:10pt;">Under Israeli law, the Company may declare and pay dividends only if, upon the determination of our board of directors, there is no reasonable concern that the distribution will prevent the Company from being able to meet the terms of our existing and foreseeable obligations as they become due. Under the Companies Law, the distribution amount is further limited to the greater of retained earnings or earnings generated over the </span><span style="font-size:10pt;"><ix:nonFraction unitRef="Unit_Standard_Y_Amr1ORjh6UaHCh4D-_V1Ow" contextRef="As_Of_12_31_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_yoSFmKpNo0-5UYak560N5Q" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfYearsIncomeForDistributionLimit" scale="0" id="Narr_Kx3BrYl3uE6N_Vxqrw3aCQ">two</ix:nonFraction></span><span style="font-size:10pt;"> most recent&#160;years legally available for distribution according to our then last reviewed or audited financial statements, provided that the date of the financial statements is not more than </span><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_fpdlfDdBY06IU4SaPlpn8A" format="ixt-sec:durwordsen" name="qnrx:DateOfFinancialStatementsAndDistributionPeriodMaximum" id="Narr_w70TkzbbA0iPgkfCCYZCqQ"><span style="font-size:10pt;">six&#160;months</span></ix:nonNumeric><span style="font-size:10pt;"> prior to the date of distribution. In the event that the Company does not have retained earnings or earnings generated over the </span><span style="font-size:10pt;"><ix:nonFraction unitRef="Unit_Standard_Y_Amr1ORjh6UaHCh4D-_V1Ow" contextRef="As_Of_12_31_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_yoSFmKpNo0-5UYak560N5Q" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfYearsIncomeForDistributionLimit" scale="0" id="Narr_SJ_p7yya90KK5FR8P8DbPw">two</ix:nonFraction></span><span style="font-size:10pt;"> most recent&#160;years legally available for distribution, the Company may seek the approval of the court in order to distribute a dividend. The court may approve our request if it determines that there is no reasonable concern that the payment of a dividend will prevent the Company from satisfying existing and foreseeable obligations as they become due.</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Bank of New York Mellon, as depositary, has registered and delivered American Depositary Shares, also referred to as ADSs. Following an ADS ratio adjustment effective August 1, 2022, each ADS represents five thousand (<ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="As_Of_8_1_2022_us-gaap_StatementClassOfStockAxis_dei_AdrMember_69nlsTLTwE-zZAZnUTUEvg" decimals="INF" format="ixt:numdotdecimal" name="qnrx:NumberOfOrdinarySharesForAmericanDepositaryShares" scale="0" id="Narr_oL2cudiAXUWgjrtzjRPmCw">5,000</ix:nonFraction>) ordinary shares (or a right to receive five thousand (<ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="As_Of_12_31_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_me-k85tUVkuKWkdA6_lJJw" decimals="INF" format="ixt:numdotdecimal" name="qnrx:NumberOfOrdinarySharesForAmericanDepositaryShares" scale="0" id="Narr_oG7sGbHr3U-lN_fRbjkWIg">5,000</ix:nonFraction>) ordinary shares). Each ADS will also represent any other securities, cash or other property which may be held by the depositary. ADSs may be held either (a)&#160;directly (1)&#160;by having an American Depositary Receipt, also referred to as an ADR, which is a certificate evidencing a specific number of ADSs or (2)&#160;by having uncertificated ADSs, or (b)&#160;indirectly by holding a security entitlement in ADSs through a broker or other financial institution that is a direct or indirect participant in The Depository Trust Company, also called DTC.</p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-21</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><b style="font-weight:bold;">QUOIN PHARMACEUTICALS LTD. </b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><b style="font-weight:bold;">Notes to Consolidated Financial Statements</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">December 31, 2022 and 2021</b></p></div><div style="clear:both;max-width:100%;position:relative;min-height:13.8pt;"><a id="_39159b9a_8655_4242_98ba_2b6b7edfeb3d"></a><a id="Tc_EhP8lLEn0E2GSYYXEzUDWQ_1_4"></a><a id="Tc_Wz5jhJneo0-jFj56BmEz8Q_2_2"></a><a id="Tc_VpjQLK6JvkeZP3U67qOwkQ_2_4"></a><a id="Tc_J9Kix3WDN0yY8X3WiXoVyQ_3_2"></a><a id="Tc_83WF_5HrEU6bNoR1_cofLw_3_4"></a><a id="Tc_mH5v4_hB0kSeYXIvRbPmIQ_4_2"></a><a id="Tc_2PfqiZnIDUay70BPe0tVpA_4_4"></a><a id="Tc_RVo5zMoKeUGvO8XFw1DBeQ_5_0"></a><a id="Tc_TOWo0Ti_0kSHi0fkioai_Q_5_4"></a><a id="Tc_sMmoXwFBGkmuvvzwQunEyA_5_6"></a><a id="Tc_8TzTBxqZjEKCfaHrH5aRMA_6_0"></a><a id="Tc_rZ-wtAbJ2EqNQukeQjcdlA_6_6"></a><a id="Tc_fw4uycWyS02O0sedBKXTLw_7_0"></a><a id="Tc_Bamy9Gt350y_WanuPtEoOw_7_4"></a><a id="Tc_lpH0xgEOlEe_hlMERiBYJA_7_6"></a><a id="Tc_hIzv-H48HECisS-iB9PSSg_8_0"></a><a id="Tc_QTawbI-SMEu3t5bo74TzXg_8_6"></a><a id="Tc_4LF6De5PlEOOVTr3CC7k6Q_9_0"></a><a id="Tc_m8oqF6csUUOnGbV3ZqVorA_9_6"></a><a id="Tc_8F0BZFwL4ECsLvTUrMGNtg_10_0"></a><a id="Tc_96AVZGAOsEemgEW3PznZQA_10_5"></a><a id="Tc_w5NvP9gtp0iFlgybBbeLWg_11_0"></a><a id="Tc_GautpgCwgk-zg7b4Q-Cq3A_11_4"></a><a id="Tc_pCO0pqRVr0-mH0FqEEAkWw_11_6"></a><ix:continuation id="Tb_Yn_QZKBDT0GvAP-omiMzRw_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 2.15pt 12pt 0pt;">On August 9, 2022, the Company completed an offering (the &#8220;August Offering&#8221;) of <ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="Duration_8_9_2022_To_8_9_2022_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_W-D4akN1HEeTjMvZ2p2aKg" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_ITi-Dd2zyE2AxxxsmWamhw">11,050,000,000</ix:nonFraction> ordinary shares represented by <ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="Duration_8_9_2022_To_8_9_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_zOQPqmRhVUWFHAGJqkl2aA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_veFoI1FIHUGgZF9jdNCtgw">2,210,000</ix:nonFraction> ADSs at a purchase price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_f-Iw-_7kF0Wo7clLz9E5qQ" contextRef="As_Of_8_9_2022_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_P3UEZruDHUO1wvcEut0Zmw" decimals="2" format="ixt:numdotdecimal" name="us-gaap:SharePrice" scale="0" id="Narr_WhFpXpcHPUCi9eZdTL19sA">5.00</ix:nonFraction> per ADS and pre-funded warrants (the &#8220;August Pre-Funded Warrants&#8221;) to purchase <ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="As_Of_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_Y6vjYIYp50S2x6lFv-6BEw" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByEachWarrantOrRight" scale="0" id="Narr_WpP_78GfDES5CTwelZ7PNA">5,750,000,000</ix:nonFraction> ordinary shares represented by <ix:nonFraction unitRef="Unit_Standard_shares_uigvcIcA-0qx2gTISLhi_A" contextRef="As_Of_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_BVEq-BF7HUqLtONlBAlDDA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByEachWarrantOrRight" scale="0" id="Narr_imKbTD77-EG4QY4Wo5wInQ">1,150,000</ix:nonFraction> ADSs at a per pre-funded warrant price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_f-Iw-_7kF0Wo7clLz9E5qQ" contextRef="As_Of_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_BVEq-BF7HUqLtONlBAlDDA" decimals="4" format="ixt:numdotdecimal" name="us-gaap:SharePrice" scale="0" id="Narr_v3fMLDe0P0Coq7eAniuzFA">4.9999</ix:nonFraction>, with each ADS and August Pre-Funded Warrant accompanied by an ordinary warrant (the &#8220;August Common Warrant&#8221;), for aggregate gross proceeds of $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_8_9_2022_To_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_j33WuOVlAkufwBpW5_J-1g" decimals="-5" format="ixt:numdotdecimal" name="qnrx:ProceedsFromIssuanceOfPublicOffering" scale="6" id="Narr_UpRjNxKC206zpg8DAZKCYw">16.8</ix:nonFraction> million, resulting in net proceeds of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_df3FZjleZU2zXLAhNV_Aew" contextRef="Duration_8_9_2022_To_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_j33WuOVlAkufwBpW5_J-1g" decimals="-5" format="ixt:numdotdecimal" name="qnrx:NetProceedsFromIssuancePublicOfferingAfterIssuanceCosts" scale="6" id="Narr_Bh3o3JZFKki-sNFO7ryk3Q">14.9</ix:nonFraction> million. Each August Common Warrant had an exercise price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_f-Iw-_7kF0Wo7clLz9E5qQ" contextRef="As_Of_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_BVEq-BF7HUqLtONlBAlDDA" decimals="2" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" id="Narr_0ZEgOeIPKECQyjw-5DsvdA">5.00</ix:nonFraction> per ADS and was to expire on the fifth anniversary of the Closing Date. On the Closing Date, the holder of August Pre-Funded Warrants sold in the August Offering exercised its Pre-Funded Warrants in full. The August Common Warrant exercise price and expiration date were subsequently amended for investors who participated in both the August Offering and February Offering, see Note 18.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 2.15pt 12pt 0pt;">In connection with the August Offering, the Company entered into a Securities Purchase Agreement (the &#8220;Purchase Agreement&#8221;) with certain institutional investors. The Purchase Agreement provided that for a period of <ix:nonNumeric contextRef="Duration_8_9_2022_To_8_9_2022_XyK_MQnBzUeBBJlmTmbWdA" format="ixt-sec:durwordsen" name="qnrx:ThresholdPeriodForNotToEnterInToAgreementForVariableRateTransactionFromDateOfClosingOfOffering" id="Narr_HiSkI6P1Rku5zUVMgtjwSQ">180 days</ix:nonNumeric> following the closing of the August Offering, the Company will not effect or enter into an agreement to effect a &#8220;variable rate transaction&#8221; as defined in the Purchase Agreement. Further, the Company has agreed in the Purchase Agreement not to issue, enter into any agreement to issue or announce the issuance or proposed issuance of any ADSs or ordinary shares or their equivalents, subject to certain exceptions, for a period of <ix:nonNumeric contextRef="Duration_8_9_2022_To_8_9_2022_XyK_MQnBzUeBBJlmTmbWdA" format="ixt-sec:durwordsen" name="qnrx:ThresholdPeriodForNotToIssueOrProposedIssuanceOfAnyAdsSOrOrdinaryShares" id="Narr_xSej0vTbQU23rNq-atOYxg">90 days</ix:nonNumeric> after the closing of the August Offering. The Purchase Agreement also contained representations, warranties, indemnification and other provisions customary for transactions of this nature.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 2.15pt 12pt 0pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">Warrants</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 2.15pt 12pt 0pt;">The following table summarizes warrant activities during the year ended December 31, 2021 and the year ended December 31, 2022:</p><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_MjGK2CkTR0aSuL2-VrcrTA" name="qnrx:SummaryOfWarrantActivitiesTableTextBlock" id="Group_dr5xxmfgAUmvRa-7gDJFBA" continuedAt="Group_dr5xxmfgAUmvRa-7gDJFBA_2" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:-0.07870102%;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:72.57%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;