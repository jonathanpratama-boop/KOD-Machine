    <td style="padding-left:0.08in;vertical-align:top;padding-right:0.08in;text-align:left;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><font style="color:#000000;white-space:pre-wrap;font-family:Arial;min-width:fit-content;">$82.6 &#x2013; $84.9</font></p></td>
