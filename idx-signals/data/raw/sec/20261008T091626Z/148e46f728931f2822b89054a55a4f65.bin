    <td style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center">Abstentions</td>
    <td>&#160;</td>
    <td style="border-bottom: Black 1.5pt solid; font: 10pt Times New Roman, Times, Serif; text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>Broker Non-Votes</b></span></td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 25%; text-align: center">439,680,742</td><td style="width: 1%">&#160;</td>
