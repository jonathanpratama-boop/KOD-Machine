    <td style="width: 24%; text-align: center">5,859,903</td>
    <td style="width: 1%">&#160;</td>
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: center; width: 24%"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">320,242,179</span></td></tr>
  </table>



<p style="margin-top: 0; margin-bottom: 0">&#160;</p>

<p style="margin-top: 0; margin-bottom: 0"></p>

