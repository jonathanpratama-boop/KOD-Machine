    <td style="width: 1%; text-align: left">$</td><td style="width: 16%; text-align: right"><ix:nonFraction name="us-gaap:AssetsHeldInTrustNoncurrent" contextRef="AsOf2023-12-31" id="Fact001171" format="ixt:numdotdecimal" decimals="0" unitRef="USD">19,901,169</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr id="xdx_408_eus-gaap--Cash_iI_z2ZT32wgwn04" style="vertical-align: bottom; background-color: White">
