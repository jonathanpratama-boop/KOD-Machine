    <td colspan="2" style="border-bottom: Black 1pt solid; font-weight: bold; text-align: center">Annual Base Salary</td><td style="padding-bottom: 1pt; font-weight: bold">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: justify">Kraig T. Higginson</td><td>&#160;</td>
