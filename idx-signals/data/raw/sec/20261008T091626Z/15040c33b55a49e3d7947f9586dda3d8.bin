    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction name="us-gaap:AdditionalPaidInCapital" contextRef="AsOf2023-12-31_srt_RevisionOfPriorPeriodReclassificationAdjustmentMember_custom_AspireBiopharmaIncMember" id="Fact000556" format="ixt:numdotdecimal" decimals="0" unitRef="USD">199,500</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
