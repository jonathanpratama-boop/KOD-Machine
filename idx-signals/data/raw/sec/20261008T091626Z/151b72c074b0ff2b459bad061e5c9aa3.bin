_1zyOYZWy1UGniGnBNQQs8g_5_0"></a><a id="Tc_S_jvR6RZ3kaYqwMrr1wJig_5_2"></a><a id="Tc_OQADSkYwOE2HdXS7IJv3mg_5_5"></a><a id="Tc_72sy0g1_3E-zLMm3liGXMw_1_2"></a><a id="Tc_K8ZrxUji-EeMzKkPRij-XQ_1_5"></a><a id="Tc_HsyZ5fAROUiv2V31eKrAUg_2_2"></a><a id="Tc_2zHtXhiuDkCo95RqQ1lEKg_2_5"></a><a id="Tc_c9Ul5g32LUGaFJsTYwadvw_3_0"></a><a id="Tc_HUoIto1W4EybvAtO-U2hTw_3_2"></a><a id="Tc_PowY-mkluUavoV3xTvuEDg_3_5"></a><a id="Tc_yXH68jp690i5cXcuRP4HwQ_4_0"></a><a id="Tc_lGxPhL3mikq8b0348ExTVw_4_3"></a><a id="Tc_G_Pk6_ePnUK52kL2SwJfSg_5_0"></a><a id="Tc_QxZvcW5Y_0q7x8U7kv9eHw_6_0"></a><a id="Tc_yL1x5tTgvkuRVtGJbK6jNg_6_3"></a><a id="Tc_9s2Jn7a-LUKlhEER7YMH6g_7_0"></a><a id="Tc_Zp8Lf7GSG0Kb9jq4LVqRJw_7_2"></a><a id="Tc_vZ4qJZ-CeUCok0j_DZ6GPw_7_5"></a><a id="Tc_GAANkDKKlE-62325u8tLeA_7_6"></a><ix:continuation id="Tb_x49HwW6NsUexvFDgJS80BQ_cont6" continuedAt="Tb_x49HwW6NsUexvFDgJS80BQ_cont7"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Tau Agreement</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">As discussed in Note 9 the Tau Agreement has both a Commitment Amount and a Commitment fee that requires to be fair valued under ASC 815 and ASC 480, respectively. As such as of July 31, 2024 the issuance date and as of September 30, 2024 both the Commitment Amount and the Commitment Fee were valued using Mote Carlo model resulting in the fair value of the Commitment Amount at $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_7_31_2024_srt_CounterpartyNameAxis_atch_TauInvestmentPartnersLlcMember_us-gaap_SubsidiarySaleOfStockAxis_atch_AtMarketAgreementMember_cknkfiFFtEiV179nt8RnwA" decimals="0" format="ixt:num-dot-decimal" name="atch:InitialFairValueCommitmentAmount" scale="0" id="Narr_1N1ol8ICaEOjOdZmWvIZAw">966,153</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_9_30_2024_srt_CounterpartyNameAxis_atch_TauInvestmentPartnersLlcMember_us-gaap_SubsidiarySaleOfStockAxis_atch_AtMarketAgreementMember_PJqPYgf5W0evX9egkfYmLw" decimals="0" format="ixt:num-dot-decimal" name="atch:SubsequentFairValueOfCommitmentAmount" scale="0" id="Narr_sUoxnZE3UEqh4SNGcheJrA">892,558</ix:nonFraction>, respectively and the Commitment Fee at $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_7_31_2024_srt_CounterpartyNameAxis_atch_TauInvestmentPartnersLlcMember_us-gaap_SubsidiarySaleOfStockAxis_atch_AtMarketAgreementMember_cknkfiFFtEiV179nt8RnwA" decimals="0" format="ixt:num-dot-decimal" name="atch:InitialFairValueCommitmentFee" scale="0" id="Narr_tggbptTMKUi-XX2YlnCkpg">124,796</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_9_30_2024_srt_CounterpartyNameAxis_atch_TauInvestmentPartnersLlcMember_us-gaap_SubsidiarySaleOfStockAxis_atch_AtMarketAgreementMember_PJqPYgf5W0evX9egkfYmLw" decimals="0" format="ixt:num-dot-decimal" name="atch:SubsequentFairValueOfCommitmentFee" scale="0" id="Narr_UNeR_2j16kGuRMwrjnrosQ">79,948</ix:nonFraction>, respectively. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The key inputs into the Monte-Carlo model for the Commitment Amount as of issuance date of July 31, 2024, and September 30, 2024 were as follows:</p><ix:continuation id="Group_OdxxfKsm3UyWHejFqHXFvg_12" continuedAt="Group_OdxxfKsm3UyWHejFqHXFvg_13"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:80%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:66.79%;margin:0pt;padding:0pt;"><d