rif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.38%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td></tr><tr><td style="vertical-align:bottom;width:70.96%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Public Warrants</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.38%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares__uYNCiLHIkOvp3lBfmdLWw" contextRef="Duration_7_1_2024_To_9_30_2024_us-gaap_AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareByAntidilutiveSecuritiesAxis_atch_PublicWarrantsMember_Uc_Jqeo-EEWUZjPRH82cSg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" scale="0" id="Tc_yHZ-cBuVSkefOlnLkS_euQ_11_2">10,062,500</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.38%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares__uYNCiLHIkOvp3lBfmdLWw" contextRef="Duration_7_1_2023_To_9_30_2023_us-gaap_AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareByAntidilutiveSecuritiesAxis_atch_PublicWarrantsMember_NwoBgDeInkKbVAGbJyM36w" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" scale="0" id="Tc_31UAX9mRNUyqzQ4O7Oys3Q_11_4">10,062,500</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:70.96%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Private Warrants</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.38%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares__uYNCiLHIkOvp3lBfmdLWw" contextRef="Duration_7_1_2024_To_9_30_2024_us-gaap_AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareByAntidilutiveSecuritiesAxis_atch_PrivateWarrantsMember_CMhowZMTfUCs0Z1OfgdHNg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" scale="0" id="Tc_0mXudOMFLEaQpK52sjg9jA_12_2">5,553,125</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.38%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares__uYNCiLHIkOvp3lBfmdLWw" contextRef="Duration_7_1_2023_To_9_30_2023_us-gaap_AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareByAntidilutiveSecuritiesAxis_atch_PrivateWarrantsMember_-tsNORwNy0iQyf2TVyJdlg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" scale="0" id="Tc_-kA4DaPnZ0ytfRxyZ1yzfw_12_4">6,153,125</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:70.96%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Secured convertible note warrants</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.38%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares__uYNCiLHIkOvp3lBfmdLWw" contextRef="Duration_7_1_2024_To_9_30_2024_us-gaap_AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareByAntidilutiveSecuritiesAxis_atch_SecuredConvertibleNoteWarrantsMember_qQw3fKVGOU6hxroLxREyyA" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" scale="0" id="Tc_oTscqA6QtkmCTO1WHfyDDg_13_2">600,000</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.38%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> &#8212;</p></td></tr><tr><td style="vertical-align:bottom;width:70.96%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Total excluded under treasury method &#8211; out of the money</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.38%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares__uYNCiLHIkOvp3lBfmdLWw" contextRef="Duration_7_1_2024_To_9_30_2024_G_cfyEkcAkCe-k4MlwIprg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" scale="0" id="Tc_DgZAKS_G4UC8YIyl3s1XYA_14_2">16,215,625</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.38%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares__uYNCiLHIkOvp3lBfmdLWw" contextRef="Duration_7_1_2023_To_9_30_2023_ZN7v9QQyHECYwZ1lHhbSKg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" scale="0" id="Tc_DYWwn-DEX0KTpbVmX5RTqw_14_4">16,215,625</ix:nonFraction></p></td></tr></table></ix:nonNumeric></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_7_1_2024_To_9_30_2024_G_cfyEkcAkCe-k4MlwIprg" name="us-gaap:NewAccountingPronouncementsPolicyPolicyTextBlock" id="Tb_VY9L-PyumUCaKq2QKiIg_g" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><span style="font-style:italic;font-weight:bold;">Recent Accounting Standards</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Management does not believe that any other recently issued, but not yet effective, accounting standards, if currently adopted, would have a material effect on the Company&#8217;s condensed consolidated financial statements. </p></ix:nonNumeric></ix:continuation></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-51</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">ATLASCLEAR HOLDINGS, INC.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">NOTES TO CONDENSED CONSOLIDATED FINANCIAL STATEMENTS</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">SEPTEMBER 30, 2024</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">(Unaudited)</b></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><ix:continuation id="Tb_KIyAqu01gESgsv_KRfWTsw_cont3"></ix:continuation><ix:nonNumeric contextRef="Duration_7_1_2024_To_9_30_2024_G_cfyEkcAkCe-k4MlwIprg" name="atch:CashAndSecuritiesSegregatedUnderFederalAndOtherRegulationsDisclosuresTextBlock" id="Tb_fNGES9JSzkaKxIUNydfoUQ" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTE&#160;3. CASH SEGREGATED IN ACCORDANCE WITH FEDERAL REGULATIONS</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Wilson-Davis is required by Rule 15c3-3 of the SEC to maintain a cash reserve with respect to customers&#8217; transactions and credit balances, on a settlement date basis. Such a reserve is computed weekly using a formula provided by the rule, and the reserve account must be separate from all other bank accounts of Wilson-Davis. The required reserve as of September 30, 2024, was calculated to be $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_9_30_2024_atch_CashAndSecuritiesSegregatedUnderFederalAndOtherRegulationsAxis_atch_CustomersTransactionsAndCreditBalancesMember_5s4rWvX_iUGnKToi6HCF5w" decimals="0" format="ixt:num-dot-decimal" name="atch:CashReserveDepositRequired" scale="0" id="Narr_pGmXfNczsEKdw2YDVZZcdg">18,830,537</ix:nonFraction>. Wilson-Davis had $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_9_30_2024_atch_CashAndSecuritiesSegregatedUnderFederalAndOtherRegulationsAxis_atch_CustomersTransactionsAndCreditBalancesMember_5s4rWvX_iUGnKToi6HCF5w" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:CashAndSecuritiesSegregatedUnderFederalAndOtherRegulations" scale="0" id="Narr_WD2oZS6WSEmPEi59Fc4xhA">19,667,586</ix:nonFraction> cash which was $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_9_30_2024_atch_CashAndSecuritiesSegregatedUnderFederalAndOtherRegulationsAxis_atch_CustomersTransactionsAndCreditBalancesMember_5s4rWvX_iUGnKToi6HCF5w" decimals="0" format="ixt:num-dot-decimal" name="atch:CashReserveDepositLessThanAmountRequired" scale="0" id="Narr_GiJgvJZRY0apqAQvCSEQIw">837,049</ix:nonFraction> more than the amount required. On October 1, 2024, Wilson-Davis withdrew $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_10_1_2024_atch_CashAndSecuritiesSegregatedUnderFederalAndOtherRegulationsAxis_atch_CustomersTransactionsAndCreditBalancesMember_I339FMe8DkWopBFyGRXdGw" decimals="0" format="ixt:num-dot-decimal" name="atch:AmountWithdrawnFromReserveAccount" sign="-" scale="0" id="Narr_SSi2ZjzM2U-b40b-9jp34g">337,049</ix:nonFraction> from the reserve account in accordance with the rule, which resulted in an excess of $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_10_1_2024_atch_CashAndSecuritiesSegregatedUnderFederalAndOtherRegulationsAxis_atch_CustomersTransactionsAndCreditBalancesMember_I339FMe8DkWopBFyGRXdGw" decimals="0" format="ixt:num-dot-decimal" name="atch:CashReserveDepositInExcessOfAmountRequired" scale="0" id="Narr_xPRKjVy0W0y_fx9ksMJ59g">500,000</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Wilson-Davis is required by Rule 15c3-3 of the SEC to maintain a cash reserve with respect to broker-dealer transactions and credit balances. Such a reserve is computed weekly using a formula provided by the rule, and the reserve account must be separate from all other bank accounts of Wilson-Davis. The required reserve as of September 30, 2024, was calculated to be $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_9_30_2024_atch_CashAndSecuritiesSegregatedUnderFederalAndOtherRegulationsAxis_atch_BrokerDealerTransactionsAndCreditBalancesMember_UAIy9msLtE6Zm-mpKz52kg" decimals="0" format="ixt:num-dot-decimal" name="atch:CashReserveDepositRequired" scale="0" id="Narr_j8X9L9rQcUecogZUArCbYg">100,000</ix:nonFraction>. Wilson-Davis had $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_9_30_2024_atch_CashAndSecuritiesSegregatedUnderFederalAndOtherRegulationsAxis_atch_BrokerDealerTransactionsAndCreditBalancesMember_UAIy9msLtE6Zm-mpKz52kg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:CashAndSecuritiesSegregatedUnderFederalAndOtherRegulations" scale="0" id="Narr_s86GIRUmVUGoO1vP17pbXw">200,000</ix:nonFraction> cash on deposit in the reserve account, which was $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_9_30_2024_atch_CashAndSecuritiesSegregatedUnderFederalAndOtherRegulationsAxis_atch_BrokerDealerTransactionsAndCreditBalancesMember_UAIy9msLtE6Zm-mpKz52kg" decimals="0" format="ixt:num-dot-decimal" name="atch:CashReserveDepositLessThanAmountRequired" scale="0" id="Narr_i3sTFyWk9EC9_nXgjts3PQ">100,000</ix:nonFraction> more than the amount required.</p></ix:nonNumeric><ix:nonNumeric contextRef="Duration_7_1_2024_To_9_30_2024_G_cfyEkcAkCe-k4MlwIprg" name="atch:BrokerDealerNetCapitalRequirementSecRegulationTextBlock" id="Tb_rJWQJXiRZ0SZi4SLtE544g" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 8pt 0pt;"><b style="font-weight:bold;">NOTE&#160;4. NET CAPITAL REQUIREMENTS</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">As a broker-dealer, Wilson-Davis is subject to the uniform net capital rule adopted and administered by the SEC. The rule requires maintenance of minimum net capital and prohibits a broker-dealer from engaging in securities transactions at a time when its net capital falls below minimum requirements, as those terms are defined by the rule. Under the alternative method permitted by this rule, net capital shall not be less than the greater of $250,000 or 2% of aggregate debit items arising from customer transactions, as defined. Also, Wilson-Davis has a minimum requirement based upon the number of securities markets that it maintains. On September 30, 2024, Wilson-Davis&#8217;s net capital was $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_9_30_2024_ll4s9jxr1U6ujm8UtL-j9w" decimals="0" format="ixt:num-dot-decimal" name="srt:NetCapital" scale="0" id="Narr_FakxUtsnz0-h7_igzCet_Q">10,449,178</ix:nonFraction>, which was $<ix:nonFraction unitRef="Unit_Standard_USD_5swrX355mkOebOs5E5ZArA" contextRef="As_Of_9_30_2024_ll4s9jxr1U6ujm8UtL-j9w" decimals="0" format="ixt:num-dot-decimal" name="srt:AlternativeExcessNetCapital" scale="0" id="Narr_01V94ii_KUO3HKjPkhvrVA">10,199,178</ix:nonFraction> in excess of the minimum required.</p></ix:nonNumeric><a id="Tc_C6cDftrcPEy7A53_UF10nw_1_2"></a><a id="Tc_56WX0wnZ3kCt4I6Ikuv3eA_2_2"></a><a id="Tc_JQuM7784zkS3TYIF9gMSgw_3_2"></a><a id="Tc_PddjOsnkokqFBebxno0tKA_4_0"></a><a id="Tc_eD4i6_6SqUa57gF_QYcaNA_4_2"></a><a id="Tc_9xXGOQRig0aWiUBOEHHwgA_5_0"></a><a id="Tc_ak4drA_uZk-VeTkbez2Q_Q_6_0"></a><a id="Tc_zhhxT6gIMUWCLZ81isM3sg_7_0"></a><a id="Tc_0gzz22h2vkGqLMrbCmLd8w_7_2"></a><ix:nonNumeric contextRef="Duration_7_1_2024_To_9_30_2024_G_cfyEkcAkCe-k4MlwIprg" name="us-gaap:CashAndCashEquivalentsDisclosureTextBlock" id="Tb_UJyIkgSBXEuwyRSw-yApTw" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 8pt 0pt;"><b style="font-weight:bold;">NOTE 5 &#8211; CASH AND RESTRICTED CASH</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">Reconciliation of cash and restricted cash as shown in the condensed statements of cash flows is presented in the table below: </p><ix:nonNumeric contextRef="Duration_7_1_2024_To_9_30_2024_G_cfyEkcAkCe-k4MlwIprg" name="us-gaap:ScheduleOfCashAndCashEquivalentsTableTextBlock" id="Tb_p-T5lna9u0qPo3huRIWLWg" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:81.74%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size