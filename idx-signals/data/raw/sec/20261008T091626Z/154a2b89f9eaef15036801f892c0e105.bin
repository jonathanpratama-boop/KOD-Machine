</ix:nonNumeric><ix:nonNumeric contextRef="From2023-01-01to2023-03-31" escape="true" name="us-gaap:SubsequentEventsTextBlock"><p id="xdx_804_eus-gaap--SubsequentEventsTextBlock_zP3vrxRhMWKh" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>NOTE
10: <span id="xdx_821_zyhzY2v6Me3h">SUBSEQUENT EVENTS </span></b></span></p>

<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0.5in; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p>

<p style="font: 10pt Times New Roman, Times, Serif; text-indent: 0.5in; margin-top: 0pt; margin-right: 0pt; margin-bottom: 0pt; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">On April 27, 2023, Leumi increased the Cortex Credit Line by
$<span id="xdx_90B_eus-gaap--LineOfCredit_iI_pn3n3_c20230427__us-gaap--SubsequentEventTypeAxis__us-gaap--SubsequentEventMember_zRDyxQCzNxk9" title="Line of credit"><ix:nonFraction name="us-gaap:LineOfCredit" contextRef="AsOf2023-04-27_us-gaap_SubsequentEventMember" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">1,000</ix:nonFraction></span>, which was fully withdrawn by Cortex.</span></p>

</ix:nonNumeric><p id="xdx_81C_zYRx2m2syYub" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0.5in; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p>


