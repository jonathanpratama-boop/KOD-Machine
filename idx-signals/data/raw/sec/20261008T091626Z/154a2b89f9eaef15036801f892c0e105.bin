    <td style="text-align: left">&#160;</td><td style="text-align: right"><span id="xdx_900_eus-gaap--ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1_iI_pid_c20230331__us-gaap--StatementEquityComponentsAxis__custom--ClassKWarrantsMember_zxKO9tuguTwd" title="Exercise Price"><ix:nonFraction name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" contextRef="AsOf2023-03-31_custom_ClassKWarrantsMember" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">22.40</ix:nonFraction></span></td><td style="text-align: left">&#160;</td><td>&#160;</td>
