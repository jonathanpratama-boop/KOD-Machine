    <td style="width: 1%; text-align: left">&#160;</td><td id="xdx_987_ecustom--WarrantExercisable_iI_pid_c20230331__us-gaap--StatementEquityComponentsAxis__custom--ClassJWarrantsMember_zktpeFKMyts" title="Exercisable" style="width: 17%; text-align: right"><ix:nonFraction name="VBIX:WarrantExercisable" contextRef="AsOf2023-03-31_custom_ClassJWarrantsMember" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">130,333</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
