    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 14%; text-align: right"><ix:nonFraction name="srt:BankLoans" contextRef="AsOf2022-12-31_custom_TheCompanyMember_custom_ShortTermBankLoanMember" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">69</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
