  <tr style="vertical-align: bottom; ">
    <td style="font-size: 10pt; padding-bottom: 2.5pt">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif; padding-bottom: 2.5pt">&#160;</td>
    <td style="border-bottom: Black 2.5pt double; font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="border-bottom: Black 2.5pt double; font: 10pt Times New Roman, Times, Serif; text-align: right">2,814,360</td><td style="padding-bottom: 2.5pt; font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif; padding-bottom: 2.5pt">&#160;</td>
