    <td style="padding-bottom: 2.5pt">&#160;</td>
    <td style="border-bottom: Black 2.5pt double; text-align: left">&#160;</td>
    <td style="border-bottom: Black 2.5pt double; text-align: right"><ix:nonFraction name="HOLO:BenefitOfIncomeTaxes" contextRef="From2023-01-012023-06-30" id="Fact001235" format="ixt:numdotdecimal" decimals="0" sign="-" unitRef="RMB">993,927</ix:nonFraction></td>
