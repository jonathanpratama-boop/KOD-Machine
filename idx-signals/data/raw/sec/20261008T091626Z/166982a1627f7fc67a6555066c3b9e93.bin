    <td style="text-align: left">&#160;</td></tr>
  <tr id="xdx_407_eus-gaap--LesseeOperatingLeaseLiabilityUndiscountedExcessAmount_iNI_pp0p0_di_zQvC7JSHv6Bj" style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="vertical-align: top; text-indent: -0.125in; padding-left: 0.125in; text-align: left">Less: Interest</td>
    <td style="padding-bottom: 1pt; text-align: left">&#160;</td>
    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td>
    <td style="border-bottom: Black 1pt solid; text-align: right">(<ix:nonFraction name="us-gaap:LesseeOperatingLeaseLiabilityUndiscountedExcessAmount" contextRef="AsOf2024-06-30" id="Fact001395" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="RMB">210,602</ix:nonFraction></td>
    <td style="padding-bottom: 1pt; text-align: left">)</td>
    <td style="padding-bottom: 1pt">&#160;</td>
    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td>
