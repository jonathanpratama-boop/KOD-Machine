    <td colspan="2" style="border-bottom: Black 1pt solid; font-weight: bold; text-align: center">RMB</td>
    <td style="padding-bottom: 1pt; font-weight: bold">&#160;</td>
    <td style="font-weight: bold; padding-bottom: 1pt">&#160;</td>
