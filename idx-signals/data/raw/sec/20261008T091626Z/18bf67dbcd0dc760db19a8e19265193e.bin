        <div style="line-height:1.25;font-family:'Times New Roman', Times, serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><ix:nonFraction id="Fxbrl_20231110050624015" name="us-gaap:BusinessCombinationConsiderationTransferred1" contextRef="C_20230801to20230808_usgaapBusinessAcquisitionAxis_rwlkAltergIncMember" unitRef="USD" scale="3" decimals="-3" format="ixt:num-dot-decimal">22,100</ix:nonFraction></span></span></div>
        </td>
