    <td style="padding-bottom: 4pt; text-align: left">&#160;</td>
    <td style="padding-bottom: 4pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; text-align: left">$</td>
    <td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c3" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DerivativeFairValueOfDerivativeNet" scale="3" unitRef="usd">50</ix:nonFraction></td>
