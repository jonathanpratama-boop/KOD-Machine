  <tr style="vertical-align: top; background-color: rgb(204,238,255)">
    <td><span style="font-size: 10pt">10.2+</span></td>
    <td>&#160;</td>
    <td style="text-align: justify"><span style="font-size: 10pt"><a href="http://www.sec.gov/Archives/edgar/data/1899005/000121390022008695/ea155804ex10-2_beamrimag.htm">2010 Option Plan (filed as Exhibit 10.2 to our Registration Statement on Form F-1 as filed with the Securities and Exchange Commission on February 22, 2022, and incorporated herein by reference)</a></span></td></tr>
  <tr style="vertical-align: top; background-color: White">
    <td><span style="font-size: 10pt">10.3+</span></td>
    <td>&#160;</td>
    <td style="text-align: justify"><span style="font-size: 10pt"><a href="http://www.sec.gov/Archives/edgar/data/1899005/000121390022008695/ea155804ex10-3_beamrimag.htm">2015 Share Incentive Plan (filed as Exhibit 10.3 to our Registration Statement on Form F-1 as filed with the Securities and Exchange Commission on February 22, 2022, and incorporated herein by reference)</a></span></td></tr>
  <tr style="vertical-align: top; background-color: rgb(204,238,255)">
    <td><span style="font-size: 10pt">10.4</span></td>
    <td>&#160;</td>
    <td style="text-align: justify"><span style="font-size: 10pt"><a href="http://www.sec.gov/Archives/edgar/data/1899005/000121390022038918/ea162604ex10-4_beamrimag.htm">Form of Compensation Policy for Directors and Officers (filed as Exhibit 10.4 to our Registration Statement on Form F-1 as filed with the Securities and Exchange Commission on July 12,2022, and incorporated herein by reference)</a></span></td></tr>
  <tr style="vertical-align: top; background-color: White">
    <td><span style="font-size: 10pt">10.5</span></td>
    <td>&#160;</td>
    <td style="text-align: justify"><span style="font-size: 10pt"><a href="http://www.sec.gov/Archives/edgar/data/1899005/000121390022008695/ea155804ex10-5_beamrimag.htm">Loan and Security Agreement dated as of February 19, 2017 between Silicon Valley Bank, Beamr Imaging Ltd. and Beamr, Inc. (filed as Exhibit 10.5 to our Registration Statement on Form F-1 as filed with the Securities and Exchange Commission on February 22, 2022, and incorporated herein by reference)</a></span></td></tr>
  <tr style="vertical-align: top; background-color: rgb(204,238,255)">
    <td><span style="font-size: 10pt">10.6</span></td>
    <td>&#160;</td>
