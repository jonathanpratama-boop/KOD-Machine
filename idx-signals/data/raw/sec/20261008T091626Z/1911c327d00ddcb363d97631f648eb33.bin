    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right">3,210</td><td style="padding-bottom: 4pt; text-align: left">&#160;</td><td style="padding-bottom: 4pt">&#160;</td>
