                    <div style="line-height: 1.25;">&#9679;</div>
                  </td>
                  <td style="width: 92%; vertical-align: top;">
                    <div style="text-align: justify; line-height: 1.25;">the title or designation;</div>
                  </td>
                </tr>

            </table>
