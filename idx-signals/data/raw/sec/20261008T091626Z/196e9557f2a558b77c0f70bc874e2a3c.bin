<TABLE CELLPADDING="0" CELLSPACING="0" ALIGN="CENTER" STYLE="width: 80%; font: 10pt Times New Roman, Times, Serif; margin-top: 0pt; margin-bottom: 0pt"><TR STYLE="vertical-align: top">
