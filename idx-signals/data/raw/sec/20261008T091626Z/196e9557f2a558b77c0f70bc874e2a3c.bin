    <TD>&nbsp;</TD>
    <TD STYLE="text-align: center"><FONT STYLE="font-family: Wingdings; font-size: 10pt"><B>l</B></FONT></TD>
    <TD>&nbsp;</TD>
    <TD STYLE="text-align: center"><FONT STYLE="font-family: Wingdings; font-size: 10pt"><B>l</B></FONT></TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">(II)
    Working capital and general corporate purposes <SUP>(1)</SUP></TD>
    <TD>&nbsp;</TD>
    <TD STYLE="text-align: center"><FONT STYLE="font-family: Wingdings; font-size: 10pt"><B>l</B></FONT></TD>
    <TD>&nbsp;</TD>
