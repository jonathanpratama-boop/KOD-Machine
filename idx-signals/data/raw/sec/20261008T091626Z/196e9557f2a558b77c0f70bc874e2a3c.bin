    <TD STYLE="width: 1%; font-size: 10pt; text-align: left">&nbsp;</TD><TD STYLE="width: 16%; font-size: 10pt; text-align: right">7,908</TD><TD STYLE="width: 1%; font-size: 10pt; text-align: left">&nbsp;</TD><TD STYLE="width: 2%; font-size: 10pt">&nbsp;</TD>
    <TD STYLE="width: 1%; font-size: 10pt; text-align: left">&nbsp;</TD><TD STYLE="width: 16%; font-size: 10pt; text-align: right">7,824</TD><TD STYLE="width: 1%; font-size: 10pt; text-align: left">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: White">
