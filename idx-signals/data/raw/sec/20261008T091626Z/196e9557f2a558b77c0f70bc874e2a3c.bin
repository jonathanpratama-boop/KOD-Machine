    <TD STYLE="width: 1%; font-size: 10pt; font-weight: bold; text-align: left">&nbsp;</TD><TD STYLE="width: 18%; font-size: 10pt; font-weight: bold; text-align: right">13.72</TD><TD STYLE="width: 1%; font-size: 10pt; font-weight: bold; text-align: left">&nbsp;</TD></TR>
