    <TD STYLE="border-bottom: Black 1pt solid; font-size: 10pt; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1pt solid; font-size: 10pt; text-align: center">US$<FONT STYLE="font-family: Wingdings"><B>l</B></FONT></TD><TD STYLE="padding-bottom: 1pt; font-size: 10pt; text-align: left">&nbsp;</TD></TR>
