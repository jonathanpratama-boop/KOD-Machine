  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;NMPA&rdquo; refers to China&rsquo;s National Medical Products Administration and its predecessor, the China Food and Drug Administration.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;NDA&rdquo; refers to a New Drug Application issued by the FDA.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;Ordinary Shares&rdquo; refers to the Class A Ordinary Shares and Class B Ordinary Shares collectively.&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
