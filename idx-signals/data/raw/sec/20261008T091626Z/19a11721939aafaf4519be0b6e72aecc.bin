    <DIV STYLE="break-before: page; margin-top: 6pt; margin-bottom: 12pt"><P STYLE="margin: 0pt">&nbsp;</P></DIV>
    <!-- Field: /Page -->



<P STYLE="margin: 0">&nbsp;</P>

<TABLE CELLSPACING="0" CELLPADDING="0" STYLE="font: 10pt Times New Roman, Times, Serif; width: 100%; border-collapse: collapse">
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify; width: 0.5in">&nbsp;</TD>
    <TD STYLE="text-align: justify; width: 0.25in">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;cGCP&rdquo; refers to Current Good Clinical Practice as adopted by the applicable regulatory authority.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;cGLP&rdquo; refers to Current Good Laboratory Practice as adopted by the applicable regulatory authority.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;cGMP&rdquo; refers to Current Good Manufacturing Practice as adopted by the applicable regulatory authority.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;Class A Ordinary Shares&rdquo; refers to the Company&rsquo;s Class A Ordinary Shares, par value $1.00 per share.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;Class B Ordinary Shares&rdquo; refers to the Company&rsquo;s Class B Ordinary Shares, par value $1.00 per share.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;CMC&rdquo; refers to chemical, manufacturing and control.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&nbsp;&ldquo;Company,&rdquo; &ldquo;we,&rdquo; and &ldquo;us&rdquo; refer to Aptorum Group Limited, a Cayman Islands exempted company with limited liability whose principal place of business is in Hong Kong.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;Covar&rdquo; refers to Covar Pharmaceuticals Incorporated, a contract research organization engaged by the Company.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;CROs&rdquo; refers to contract research organizations.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;CTA&rdquo; refers to Clinical Trial Application.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;EEA&rdquo; refers to the European Economic Area.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;EMA&rdquo; refers to the European Medicines Agency.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;EMEA&rdquo; refers to Europe, the Middle East and Africa.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;EPO&rdquo; refers to the European Patent Organization or the European Patent Office operated by it.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;European Patent&rdquo; refers to patents issuable by the EPO.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;EU&rdquo; refers to the European Union.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;Exchange Act&rdquo; refers to the U.S. Securities Exchange Act of 1934, as amended.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;FDA&rdquo; refers to U.S. Food and Drug Administration.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;FDCA&rdquo; refers to the U.S. Federal Food, Drug and Cosmetic Act.</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&#9679;</TD>
    <TD STYLE="text-align: justify">&ldquo;February 2020 Offering&rdquo; refers to the offer of Class A Ordinary Shares and warrants, including the Selling Shareholder Warrants, to purchase shares of Class A Ordinary Shares at an initial exercise price of $7.40 per share, pursuant to the offering we conducted in February 2020 pursuant to the prospectus supplement dated February 25, 2020 to the registration statement on Form F-3 (File No. 333-235819) that was declared effective on January 15, 2020.&nbsp;&nbsp;</TD></TR>
</TABLE>

