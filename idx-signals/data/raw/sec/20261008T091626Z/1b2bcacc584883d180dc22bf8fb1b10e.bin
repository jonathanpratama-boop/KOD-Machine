ne;">impairment </div>loss was recognized for the <div style="white-space: nowrap; letter-spacing: 0px; top: 0px;display:inline;">six-month</div> period ended June&#160;30, 2024. </div></ix:continuation> <div style="font-size: 18pt; margin-top: 0px; margin-bottom: 0px;text-indent: 0px;">&#160;</div> <ix:nonNumeric name="us-gaap:AccountsPayableAccruedLiabilitiesAndOtherLiabilitiesDisclosureCurrentTextBlock" contextRef="P01_01_2024To06_30_2024" escape="true" id="ixv-7020">
