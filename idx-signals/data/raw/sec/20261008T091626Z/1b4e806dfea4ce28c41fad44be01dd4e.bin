    <td style="layout-grid-mode: line">&#160;</td>
    <td colspan="3" style="layout-grid-mode: line; text-align: right">&#160;</td></tr>
  <tr id="xdx_405_eus-gaap--Revenues_hus-gaap--StatementBusinessSegmentsAxis__custom--IndustrialCommercialMember_zFX1BMCBzLDa" style="vertical-align: bottom">
    <td style="display: none; width: 9%; visibility: hidden">Revenues</td>
    <td style="width: 49%; layout-grid-mode: line"><span style="font-family: Times New Roman, Times, Serif; font-size: 11pt">&#160;Industrial and Commercial</span></td>
