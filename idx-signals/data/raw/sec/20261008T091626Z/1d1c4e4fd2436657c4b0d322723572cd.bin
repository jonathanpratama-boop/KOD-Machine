    <TD STYLE="text-transform: uppercase; text-align: left">&nbsp;</TD><TD STYLE="text-transform: uppercase; text-align: right">&mdash;</TD><TD STYLE="text-transform: uppercase; text-align: left">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: White">
    <TD STYLE="width: 88%; text-indent: -10pt; padding-left: 10pt">Expected share price volatility (%)</TD><TD STYLE="width: 1%; text-transform: uppercase">&nbsp;</TD>
    <TD STYLE="width: 1%; text-transform: uppercase; text-align: left">&nbsp;</TD><TD STYLE="width: 9%; text-transform: uppercase; text-align: right">72</TD><TD STYLE="width: 1%; text-transform: uppercase; text-align: left">%</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
