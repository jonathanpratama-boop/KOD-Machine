			</td>
			<td id=".trail.D3" style="font-family: Times New Roman; font-size: 10pt;">&nbsp;</td>
			<td id=".lead.D4" style="font-family: Times New Roman; font-size: 10pt;">&nbsp;</td>
			<td colspan="2" data-td-column-id="[11]" data-td-column-label="Average Summary Compensation Total for Non- PEO Named Executive Officers(3)" id=".amt.D4" style="text-align: center; font-family: Times New Roman; font-size: 10pt; margin-left: 0pt;">
