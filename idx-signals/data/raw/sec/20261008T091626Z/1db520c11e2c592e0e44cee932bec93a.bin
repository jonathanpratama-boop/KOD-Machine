			<td colspan="2" data-td-column-id="[19]" data-td-column-label="Value of Initial $100 Investment based on Total Stockholder Return(5)" id=".amt.D6" style="text-align: center; font-family: Times New Roman; font-size: 10pt; margin-left: 0pt;">
			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:center;margin:0pt;">Value of</p>

			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:center;margin:0pt;">Initial $100</p>

			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:center;margin:0pt;">Investment</p>

			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:center;margin:0pt;">based on</p>

