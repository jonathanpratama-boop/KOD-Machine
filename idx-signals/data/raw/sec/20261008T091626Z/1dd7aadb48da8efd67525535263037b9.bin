    <td style="text-align: center">78,849</td><td>&#160;</td>
    <td style="text-align: center">2,270,160</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left">Stephan Jackman</td>
    <td style="text-align: center">1,961,534</td><td>&#160;</td>
    <td style="text-align: center">53,478</td><td>&#160;</td>
    <td style="text-align: center">71,316</td><td>&#160;</td>
    <td style="text-align: center">2,270,160</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="text-align: left">Henry C. Nisser</td>
