    <items1To7>
      <item1>
        <securityTitle>Class A ordinary shares, par value $0.0000001 per share</securityTitle>
        <issuerName>XChange TEC.INC</issuerName>
        <issuerPrincipalAddress>
          <com:street1>No.801, Building 1</com:street1>
          <com:street2>1136 Xinzha Road JingAn District</com:street2>
          <com:city>Shanghai</com:city>
          <com:stateOrCountry>F4</com:stateOrCountry>
