    <td colspan="2" id="xdx_494_20240101__20240630__us-gaap--RelatedPartyTransactionsByRelatedPartyAxis__us-gaap--RelatedPartyMember_zdCJJZWDljLl" style="border-bottom: Black 1pt solid; font-weight: bold; text-align: center">Related Parties</td><td style="padding-bottom: 1pt; font-weight: bold">&#160;</td><td style="font-weight: bold; padding-bottom: 1pt">&#160;</td>
