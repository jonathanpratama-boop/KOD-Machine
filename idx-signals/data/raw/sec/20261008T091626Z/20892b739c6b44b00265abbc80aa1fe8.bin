    <td colspan="2" id="xdx_491_20240101__20241231_zSRUJzlrb6R8" style="border-bottom: Black 1pt solid; font-weight: bold; text-align: center">December 31, 2024</td><td style="padding-bottom: 1pt; font-weight: bold">&#160;</td></tr>
