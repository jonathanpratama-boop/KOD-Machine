  <div style="line-height: 1.25">&#160;</div>
  <div style="text-align: justify; text-indent: 36pt; margin-left: 36pt; line-height: 1.25; font-family: 'Times New Roman', Times, serif; font-size: 10pt;">&#8220;<font style="font-size: 10pt; font-family: 'Times New Roman', Times, serif;"><u>Rule 144</u></font>&#8221;
