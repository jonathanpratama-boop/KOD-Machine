<body bgcolor="#ffffff" style="font-family: 'Times New Roman', Times, serif; font-size: 10pt; text-align: left; color: #000000;">
  <div class="BRPFPageHeader">
    <div style="line-height: 1.25; text-align: right;">
      <hr align="center" style="border: none; border-bottom: 1px solid black; border-top: 4px solid black; height: 10px; color: #ffffff; background-color: #ffffff; text-align: center; margin-left: auto; margin-right: auto;"><u><font style="font-weight: bold;">Exhibit 10.2</font></u><br style="line-height: 1.25;">
    </div>
