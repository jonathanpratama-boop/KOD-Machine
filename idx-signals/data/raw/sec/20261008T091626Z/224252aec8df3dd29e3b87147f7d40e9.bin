      <tr>
        <td style="width: 99pt;"><br>
        </td>
        <td style="width: 31.5pt; vertical-align: top; font-family: 'Times New Roman', Times, serif; font-size: 10pt;">(iv)</td>
        <td style="width: auto; vertical-align: top; text-align: justify;">
          <div style="font-family: 'Times New Roman', Times, serif; font-size: 10pt;">the Security Agreement duly executed by the Company, along with all of the Security Documents;</div>
        </td>
      </tr>

  </table>
  <div style="line-height: 1.25">&#160;</div>
  <table cellspacing="0" cellpadding="0" id="zb9b928008ac34772bab561ee6d7fbd6e" class="DSPFListTable" style="font-family: 'Times New Roman', Times, serif; font-size: 10pt; width: 100%; text-align: left; color: #000000;">

      <tr>
        <td style="width: 99pt;"><br>
        </td>
