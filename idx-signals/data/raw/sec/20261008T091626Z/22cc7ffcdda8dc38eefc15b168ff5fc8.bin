    <TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">$</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 9%; text-align: right">264,449</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">&nbsp;</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%">&nbsp;</TD>
    <TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">$</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 9%; text-align: right">&ndash;</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">&nbsp;</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%">&nbsp;</TD>
    <TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">$</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 9%; text-align: right">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&ndash;</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">&nbsp;</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%">&nbsp;</TD>
    <TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">$</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 9%; text-align: right">264,449</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">&nbsp;</TD></TR>
