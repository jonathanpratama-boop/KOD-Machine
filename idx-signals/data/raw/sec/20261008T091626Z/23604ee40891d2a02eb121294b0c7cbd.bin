    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif">3,491,871</span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif">270,515</span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
