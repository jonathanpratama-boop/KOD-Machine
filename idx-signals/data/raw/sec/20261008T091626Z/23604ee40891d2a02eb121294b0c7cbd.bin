  <tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
    <td style="font: 10pt Times New Roman, Times, Serif; width: 0.25in"><span style="font-family: Times New Roman, Times, Serif"><span id="xdx_909_edei--DocumentQuarterlyReport_c20250701__20251231_zXFywcMcMYNd"><ix:nonNumeric contextRef="From2025-07-01to2025-12-31" format="ixt:booleantrue" id="Fact000019" name="dei:DocumentQuarterlyReport">&#9746;</ix:nonNumeric></span></span></td>
