    <TD STYLE="font: 10pt Times New Roman, Times, Serif; color: #191919; text-align: left">$</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; color: #191919; text-align: right">297,770</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; color: #191919; text-align: left">&nbsp;</TD>
    <TD STYLE="font: 10pt Times New Roman, Times, Serif; color: #191919; text-align: right">Nil</TD><TD STYLE="text-align: right; font: 10pt Times New Roman, Times, Serif; color: #191919">&nbsp;</TD>
