pyNWt8KEKAU65DVDdQ3g">26,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_YChbv9X-XUa8jwjcRwwRlQ" contextRef="Duration_10_1_2021_To_12_31_2021_CWc3aZXxYE-fh5t4ONAk8w" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:AmortizationOfDebtDiscountPremium" scale="0" id="Narr_MIM8R0SSvEWuLqZdGJJUdg">93,000</ix:nonFraction> for the three months ended December&#160;31,&#160;2022 and 2021, respectively, and $<ix:nonFraction unitRef="Unit_Standard_USD_YChbv9X-XUa8jwjcRwwRlQ" contextRef="Duration_7_1_2022_To_12_31_2022_EmzOX688D0CoZHmddSn_jA" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:AmortizationOfDebtDiscountPremium" scale="0" id="Narr_UMmiCMpw9E-v2wL63mreyQ">62,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_YChbv9X-XUa8jwjcRwwRlQ" contextRef="Duration_7_1_2021_To_12_31_2021_D4RpYSzqu06V_n9SjGINzQ" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:AmortizationOfDebtDiscountPremium" scale="0" id="Narr_uNNZ8bo9pk6AB7yH5E5w_g">195,000</ix:nonFraction> for the six months ended December 31, 2022 and 2021, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><a id="_af606e7e_a5ff_4638_b67a_c1940e015287"></a><a id="Tc_xeEVNoD3IEiVbqLiW1BHUg_1_2"></a><a id="Tc_K0EfLKAYLE6C3z8xgd6sUg_1_5"></a><a id="Tc_wjzreSALVkq50ddG_UbLtQ_2_2"></a><a id="Tc_PmLe8IYOB0yV9HgaP3XvXA_2_5"></a><a id="Tc_M0ShLccQRUyfj3eGboF9tw_3_0"></a><a id="Tc_urHFagn8jkWdYdTBJULLjw_3_2"></a><a id="Tc_AQrO_szjAEGgb9F6LiDYpQ_3_5"></a><a id="Tc_yaQwHRyVSUCbbxUGGd0-kA_3_6"></a><a id="Tc_MvDIppPwM0KnYuNqz3nljg_4_0"></a><a id="Tc_1xZq3mW7X0KoPmFLktbxkw_4_6"></a><a id="Tc_sGkgjYxOQUacnLJTWnKXRg_5_0"></a><a id="Tc_J3uyaSzBJUqnQ0N74-KEqQ_5_2"></a><a id="Tc_ozxFMiLqfku_O--8HCoaBw_5