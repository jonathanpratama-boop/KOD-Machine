    <TD STYLE="border-bottom: black 1pt solid; text-align: center"><FONT STYLE="font-size: 10pt"><B>Abstain</B></FONT></TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: #CCEEFF">
    <TD STYLE="width: 32%; text-align: center"><FONT STYLE="font-size: 10pt">&nbsp;68,301,727</FONT></TD>
    <TD STYLE="width: 2%; text-align: center">&nbsp;</TD>
    <TD STYLE="width: 32%; text-align: center"><FONT STYLE="font-size: 10pt">&nbsp;224,841</FONT></TD>
