    <td style="padding-top:0.01in;border-right:0.75pt solid #000000;padding-left:0.01in;vertical-align:top;padding-bottom:0.01in;border-bottom:0.75pt solid #000000;padding-right:0.01in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="color:#000000;white-space:pre-wrap;min-width:fit-content;">20,834,525</span></p></td>
    <td style="padding-top:0.01in;border-right:0.75pt solid #000000;padding-left:0.01in;vertical-align:top;padding-bottom:0.01in;border-bottom:0.75pt solid #000000;padding-right:0.01in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="color:#000000;white-space:pre-wrap;min-width:fit-content;">75,195,467</span></p></td>
