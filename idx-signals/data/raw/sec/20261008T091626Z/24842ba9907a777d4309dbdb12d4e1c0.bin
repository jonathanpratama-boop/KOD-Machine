    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:InventoryRawMaterials" scale="0" unitRef="cny" id="ixv-6366">56,728,381</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; ">
