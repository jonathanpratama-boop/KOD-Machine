    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c1" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:InventoryWorkInProcess" scale="0" unitRef="cny" id="ixv-6367">130,609,171</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
