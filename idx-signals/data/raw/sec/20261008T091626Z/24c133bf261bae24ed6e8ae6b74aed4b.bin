700;line-height:115%">Notes Payable</span></div><div style="text-align:justify"><span><br/></span></div><div style="text-align:justify"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:115%">March 2020 <ix:nonFraction unitRef="number" contextRef="i7c3a5e7303ae44ff81bd35b402712f2b_I20200318" decimals="2" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="id3VybDovL2RvY3MudjEvZG9jOmJiNWQwZWIxN2U3NzQ2OGViNzlkYzYwMjdkNTUzNWIxL3NlYzpiYjVkMGViMTdlNzc0NjhlYjc5ZGM2MDI3ZDU1MzViMV8xOTAvZnJhZzozOWYwMjg2OTkyMmI0NWE2YWY5OGQ0MGIzNTgxMjkyNy90ZXh0cmVnaW9uOjM5ZjAyODY5OTIyYjQ1YTZhZjk4ZDQwYjM1ODEyOTI3XzQ0Mg_fa9b3259-ff0a-4178-9de9-4a0360347a8a">10</ix:nonFraction>% Note Purchase Agreement and Promissory Note</span></div><div><span><br/></span></div><div style="text-align:justify"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:115%">On March 18, 2020, the Company entered into a note purchase agreement with Iliad, pursuant to which the Company agreed to issue and sell to the holder an unsecured promissory note (the &#8220;March 2020 <ix:nonFraction unitRef="number" contextRef="i4335eea89ae045b2b933c384990abfb9_I20200318" decimals="2" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="id3VybDovL2RvY3MudjEvZG9jOmJiNWQwZWIxN2U3NzQ2OGViNzlkYzYwMjdkNTUzNWIxL3NlYzpiYjVkMGViMTdlNzc0NjhlYjc5ZGM2MDI3ZDU1MzViMV8xOTAvZnJhZzozOWYwMjg2OTkyMmI0NWE2YWY5OGQ0MGIzNTgxMjkyNy90ZXh0cmVnaW9uOjM5ZjAyODY5OTIyYjQ1YTZhZjk4ZDQwYjM1ODEyOTI3XzY4Nw_d225c5fc-882a-492b-b676-cff7622ba6a2">10</ix:nonFraction>% Note&#8221;) in an aggregate initial principal amount of $<ix:nonFraction unitRef="usd" contextRef="i7c3a5e7303ae44ff81bd35b402712f2b_I20200318" decimals="-5" name="inpx:NotePrincipalAndInterestExchangedForCommonShares" scale="6" id="id3VybDovL2RvY3MudjEvZG9jOmJiNWQwZWIxN2U3NzQ2OGViNzlkYzYwMjdkNTUzNWIxL3NlYzpiYjVkMGViMTdlNzc0Njhl