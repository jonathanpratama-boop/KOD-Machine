top:12pt;text-align:justify"><span><br/></span></div><div style="height:45pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="margin-top:12pt;text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:120%">F-55</span></div></div></div><div id="ibb5d0eb17e77468eb79dc6027d5535b1_208"></div><hr style="page-break-after:always"/><div style="min-height:90pt;width:100%"><div><span style="color:#0000ff;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline">Table of Contents</span></div><div style="margin-top:3pt;text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:700;line-height:120%">INPIXON AND SUBSIDIARIES</span></div><div style="text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:700;line-height:120%">NOTES TO CONSOLIDATED FINANCIAL STATEMENTS</span></div><div style="text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:700;line-height:120%">FOR THE YEARS ENDED DECEMBER 31, 2022 AND 2021</span></div><div style="margin-top:12pt;text-align:justify"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:700;line-height:120%">Note 20 - Preferred Stock (continued)</span></div></div><div style="margin-top:12pt;text-align:justify"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:700;line-height:120%">Note 20 - <ix:nonNumeric contextRef="ia78dd2c195fb43428268c4e05a3dad19_D20220101-20221231" name="inpx:PreferredStockAndTemporaryEquityTextBlock" id="id3VybDovL2RvY3MudjEvZG9jOmJiNWQwZWIxN2U3NzQ2OGViNzlkYzYwMjdkNTUzNWIxL3NlYzpiYjVkMGViMTdlNzc0NjhlYjc5ZGM2MDI3ZDU1MzViMV8yMDgvZnJhZzozOWJmYmM0NGVjOWE0YzczYjkxYTRiZWJiZjMwYzRkMi90ZXh0cmVnaW9uOjM5YmZiYzQ0ZWM5YTRjNzNiOTFhNGJlYmJmMzBjNGQyXzgyMDg_93e9e0eb-d9a7-47e0-a277-b9d211cd2ff4" continuedAt="i01d67be5d43542049c943dd08e4b8539" escape="true">Preferred Stock</ix:nonNumeric></span></div><ix:continuation id="i01d67be5d43542049c943dd08e4b8539" continuedAt="i27bd8d5995a64fb8acb69bf310796883"><div style="margin-top:12pt;text-align:justify"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The Company is authorized to issue up to <ix:nonFraction unitRef="shares" contextRef="ie1b25e2df7ca44beae553be1ddf04901_I20221231" decimals="INF" name="us-gaap:PreferredStockSharesAuthorized" format="ixt:num-dot-decimal" scale="0" id="id3VybDovL2RvY3MudjEvZG9jOmJiNWQwZWIxN2U3NzQ2OGViNzlkYzYwMjdkNTUzNWIxL3NlYzpiYjVkMGViMTdlNzc0NjhlYjc5ZGM2MDI3ZDU1MzViMV8yMDgvZnJhZzozOWJmYmM0NGVjOWE0YzczYjkxYTRiZWJiZjMwYzRkMi90ZXh0cmVnaW9uOjM5YmZiYzQ0ZWM5YTRjNzNiOTFhNGJlYmJmMzBjNGQyXzcy_702596c5-7b96-4e1b-8ae2-2927e204bb9e">5,000,000</ix:nonFraction> shares of preferred stock with a par value of $<ix:nonFraction unitRef="usdPerShare" contextRef="ie1b25e2df7ca44beae553be1ddf04901_I20221231" decimals="INF" name="us-gaap:PreferredStockParOrStatedValuePerShare" scale="0" id="id3VybDovL2RvY3MudjEvZG9jOmJiNWQwZWIxN2U3NzQ2OGViNzlkYzYwMjdkNTUzNWIxL3NlYzpiYjVkMGViMTdlNzc0NjhlYjc5ZGM2MDI3ZDU1MzViMV8yMDgvZnJhZzozOWJmYmM0NGVjOWE0YzczYjkxYTRiZWJiZjMwYzRkMi90ZXh0cmVnaW9uOjM5YmZiYzQ0ZWM5YTRjNzNiOTFhNGJlYmJmMzBjNGQyXzEyMQ_8935bf53-99ec-4e35-92b9-152920af5f88">0.001</ix:nonFraction> per share with rights, preferences, privileges and restrictions as to be determined by the Company&#8217;s Board of Directors.</span></div><div style="margin-top:12pt;text-align:justify"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%">Series 4 Convertible Preferred Stock</span></div><div style="margin-top:12pt;text-align:justify"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:120%">On April 20, 2018, the Company filed with the Secretary of State of the State of Nevada the Certificate of Designation that created the Series 4 Convertible Preferred Stock (&#8220;Series 4 Preferred&#8221;), authorized <ix:nonFraction unitRef="shares" contextRef="i697d0c428c03457fa271983cf22bf25e_I20180420" decimals="INF" name="us-gaap:PreferredStockSharesAuthorized" format="ixt:num-dot-decimal" scale="0" id="id3VybDovL2RvY3MudjEvZG9jOmJiNWQwZWIxN2U3NzQ2OGViNzlkYzYwMjdkNTUzNWIxL3NlYzpiYjVkMGViMTdlNzc0NjhlYjc5ZGM2MDI3ZDU1MzViMV8yMDgvZnJhZzozOWJmYmM0NGVjOWE0YzczYjkxYTRiZWJiZjMwYzRkMi90ZXh0cmVnaW9uOjM5YmZiYzQ0ZWM5YTRjNzNiOTFhNGJlYmJmMzBjNGQyXzQ5MA_f1dfa8a9-b557-4e9a-aa8f-b0a6a07ee413">10,415</ix:nonFraction> shares of Series 4 Preferred and designated the preferences, rights and limitations of the Series 4 Preferred. The Series 4 Preferred is non-voting (except to the extent required by law) and was convertible into the number of shares of common stock, determined by dividing the aggregate stated value of the Series 4 Preferred of $<ix:nonFraction unitRef="usdPerShare" contextRef="i697d0c428c03457fa271983cf22bf25e_I20180420" decimals="INF" name="us-gaap:PreferredStockParOrStatedValuePerShare" format="ixt:num-dot-decimal" scale="0" id="id3VybDovL2RvY3MudjEvZG9jOmJiNWQwZWIxN2U3NzQ2OGViNzlkYzYwMjdkNTUzNWIxL3NlYzpiYjVkMGViMTdlNzc0NjhlYjc5ZGM2MDI3ZDU1MzViMV8yMDgvZnJhZzozOWJmYmM0NGVjOWE0YzczYjkxYTRiZWJiZjMwYzRkMi90ZXh0cmVnaW9uOjM5YmZiYzQ0ZWM5YTRjNzNiOTFhNGJlYmJmMzBjNGQyXzgyMg_da31e386-4976-4573-bf00-83f8c2aeb67f">1,000</ix:nonFraction> per share to be converted by $<ix:nonFraction unitRef="usdPerShare" contextRef="i697d0c428c03457fa271983cf22bf25e_I20180420" decimals="INF" name="inpx:SeriesPreferredStockConversionValue" format="ixt:num-dot-decimal" scale="0" id="id3VybDovL2RvY3MudjEvZG9jOmJiNWQwZWIxN2U3NzQ2OGViNzlkYzYwMjdkNTUzNWIxL3NlYzpiYjVkMGViMTdlNzc0NjhlYjc5ZGM2MDI3ZDU1MzViMV8yMDgvZnJhZzozOWJmYmM0NGVjOWE0YzczYjk