    <td style="width:18.364%;box-sizing:content-box;"></td>
   </tr>
   <tr style="height:43.9pt;white-space:pre-wrap;word-break:break-word;">
    <td style="vertical-align:bottom;"><p style="font-size:12pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="white-space:pre-wrap;min-width:fit-content;">&#160;</font></p></td>
    <td style="padding-left:0.037in;vertical-align:bottom;border-bottom:1pt solid #000000;padding-right:0.037in;text-align:left;"><p style="font-size:10pt;margin-top:2.65pt;font-family:Times New Roman;margin-bottom:1.5pt;text-align:center;"><font style="color:#000000;white-space:pre-wrap;font-weight:bold;min-width:fit-content;">Shares (after 1-35 reverse share split)</font><font style="color:#000000;top:-4.6899999999999995pt;white-space:pre-wrap;font-weight:bold;font-size:6.7pt;position:relative;min-width:fit-content;">(1)(2)(3)(4)</font></p></td>
