     <td style="padding-top:0in;text-indent:5.75pt;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;"><p style="margin-left:1.067%;text-indent:0;font-size:11pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="color:#000000;white-space:pre-wrap;font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;">Per Brodin, CFO</font><font style="color:#000000;white-space:pre-wrap;font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;"> </font></p></td>
     <td style="padding-top:0in;text-indent:0.5pt;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;"><p style="margin-left:0.093%;text-indent:0;font-size:11pt;margin-top:0;font-family:Times New Roman;margin-bottom:0.25pt;text-align:left;"><font style="color:#000000;white-space:pre-wrap;font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;">William Jones; David Collins</font><font style="color:#000000;white-space:pre-wrap;font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;"> </font></p></td>
