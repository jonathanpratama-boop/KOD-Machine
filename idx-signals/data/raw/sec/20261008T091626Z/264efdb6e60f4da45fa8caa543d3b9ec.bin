space:nowrap;width:2.51%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_3_31_2023_I95lwmKa1kSC2DnOWeLqIQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:AccrualsClassifiedAsCurrent" scale="0" id="Tc_jWIQ5VnInEuFtS5HHfgjUQ_4_4">162,557</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:75.03%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Provisions</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.51%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:OtherShorttermProvisions" scale="0" id="Tc_YVealmwI00-cA0OPlsmYIQ_5_2">66,899</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.51%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> &#8212;</p></td></tr><tr><td style="vertical-align:bottom;width:75.03%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">Total</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.51%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:TradeAndOtherCurrentPayables" scale="0" id="Tc_4N_KiJpMckKATG4N4RnqYg_6_2">755,202</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.51%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">&#160;</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_3_31_2023_I95lwmKa1kSC2DnOWeLqIQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:TradeAndOtherCurrentPayables" scale="0" id="Tc_OIqP_4bI_UCCZGk-tk8QuQ_6_4">1,790,700</ix:nonFraction></b></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:0pt;margin:0pt;"><span style="font-size:1pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_4_1_2023_To_3_31_2024_SXKabfbue0KLjKL7OMxylQ" name="pbm:DisclosureOfConvertibleNoteLiabilityTextBlock" id="Tb_K87QKPisWEaK5OYqDuoG2Q" continuedAt="Tb_K87QKPisWEaK5OYqDuoG2Q_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;margin:0pt 0pt 12pt 0pt;">9. Convertible note liability</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On January&#160;15, 2024, in connection with the RTO Transaction (Note&#160;5), the Company and Psyence Biomed II entered into the Securities Purchase Agreement with the Investors and the NCAC Sponsor, relating to up to <ix:nonFraction unitRef="Unit_Standard_item_s-l1VIqG9Uanppx6r9y-Ww" contextRef="As_Of_1_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_h6udegDZ0kKohWWoFyiUyg" decimals="INF" format="ixt-sec:numwordsen" name="pbm:NumberOfSeniorSecuredConvertibleNotesCollectivelyAsNotes" scale="0" id="Narr_diFFheLyt0O6H8va79--Ig">four</ix:nonFraction> senior secured convertible notes obligations under which are guaranteed by certain assets of the Company and Psyence Biomed II, issuable to the Investors at or after the Closing, as the case may be, for the aggregate principal amount of up to $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_1_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_STYyJ_8sP0yElEPlFiZgKg" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtInstrumentFaceAmount" scale="0" id="Narr_qwkf9fO_skCH8ICiD3k8Rw">12,500,000</ix:nonFraction> in exchange for up to $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_1_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_STYyJ_8sP0yElEPlFiZgKg" decimals="0" format="ixt:num-dot-decimal" name="pbm:SubscriptionAmount" scale="0" id="Narr_FwxMEIAOnkWXKVGiRcb5CQ">10,000,000</ix:nonFraction> in cash subscription amounts (the &#8220;<b style="font-weight:bold;">Convertible Note&#160;Financing</b>&#8221;).</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;">The First Tranche Notes, for an aggregate of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember__eybCCZqUkqWJLQvEBcifA" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:NotionalAmount" scale="0" id="Narr_eZ1Zd0q-RESVq0pJoZ2Gng">3,125,000</ix:nonFraction> principal, were delivered by the Company to the Investors on January&#160;25, 2024, in exchange for an aggregate of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_1_25_2024_To_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_fmPXwO1w-UaQ9kanIMCxfg" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsProceedsFromConvertibleDebt" scale="0" id="Narr_wjTdETBU30yGmpa0WTRDFQ">2,500,000</ix:nonFraction> in financing, which occurred substantially concurrently with the consummation of the RTO </p></ix:nonNumeric></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:24pt 0pt 0pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td><td style="vertical-align:top;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;"><img src="pbm-20240930xex99d3002.jpg" alt="Graphic" style="display:inline-block;height:28.5pt;left:0%;padding-bottom:0pt;position:relative;top:0pt;width:87.75pt;"/></p></td><td style="vertical-align:bottom;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;">22</p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">PSYENCE BIOMEDICAL LTD.</b></p></td></tr><tr><td style="vertical-align:top;width:100%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">Consolidated Financial Statements</b></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:none;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><a id="Tc_8VLeE9Y6CEy7Whpl-_hlLg_1_2"></a><a id="Tc_1aGj5pfDLkut2wYpkkKxKw_2_0"></a><a id="Tc_LaiE8WDL0UaaR88GZyP5Yw_3_0"></a><a id="Tc_nHYChN5L5U24o3ofLVEqGg_4_0"></a><a id="Tc_8KabVRASIUGdpoInbDbMDg_4_3"></a><a id="Tc_SrzD6pvWvUmc9WaLDVRCqQ_5_0"></a><a id="Tc_mvNQXDvZqEOv5Nudzq4ZbQ_5_3"></a><a id="Tc_uC3VSl1KjEqNK6TNP-BH5Q_6_0"></a><a id="Tc_wNa7O7twdk2IEW4R5cmDDQ_6_3"></a><a id="Tc_vYFvIEDGykCcB8mh_YkjZA_7_0"></a><a id="Tc_J20VA2fQq0a0KLPhM8F3uw_7_3"></a><a id="Tc_4WhlQaFNIUi3GDB1rDa1xA_8_0"></a><a id="Tc_vvbybA0zu06mDr70veL9gA_8_3"></a><a id="Tc_M8hNYUDx0U2cA18KbGbbpA_9_0"></a><a id="Tc_n_LqnYVPQUOtg-thaSVVaQ_9_3"></a><ix:continuation id="Tb_K87QKPisWEaK5OYqDuoG2Q_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Transaction. On the original issuance date of the First Tranche Notes, interest began accruing at <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_CN31Z1lyBEmawH1JkTiPCg" decimals="3" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_wMm9mSf8CkWe7tb6DTC-yg">8.0</ix:nonFraction>% per annum based on the outstanding principal amount of the First Tranche Notes&#160;and is payable&#160;monthly in arrears in cash or in common shares of the Company at the Conversion Price (as defined below). The maturity date of the First Tranche Note&#160;is January&#160;25, 2027.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The price at which the Investors can convert the outstanding principal and interest to the common shares (the &#8220;Conversion Price&#8221;) is determined as follows: The initial Conversion Price of the First Tranche Notes&#160;was $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_CN31Z1lyBEmawH1JkTiPCg" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtInstrumentConvertibleInitialConversionPrice" scale="0" id="Narr_sIFXyk0NOUSV1LEY8ZnY3g">750.00</ix:nonFraction> ($<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_1_25_2024_944-6LBskESHkuK5eGL0PA" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtInstrumentConvertiblePreConsolidationConversionPrice" scale="0" id="Narr_ji1wmcylBUKzOhbOIC67eQ">10.00</ix:nonFraction> pre-share consolidation); provided, however, that such Conversion Price is subject to certain adjustments according to the terms and reset dates included in the First Tranche Notes&#160;and may be reduced to a Conversion&#160;Floor of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_srt_StatementScenarioAxis_pbm_UntilFirstResetDateMember_VzY_nRlLfky7W4lfqe83NA" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtInstrumentConvertibleFloorPrice" scale="0" id="Narr_UEQZ1w9wRUajN9Qgv_q6cw">75.00</ix:nonFraction>, until the First Reset Date (<ix:nonNumeric contextRef="Duration_1_25_2024_To_1_25_2024_Sac8ahw7kkmcpSEmtDJsdw" format="ixt-sec:durday" name="pbm:NumberOfDaysPriorToEffectiveInitialRegistrationStatementForFirstResetDate" id="Narr_q80P1dUGPUu35U2W3S5PAA">5</ix:nonNumeric>&#160;days prior the initial Registration Statement is effective), then to $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_srt_StatementScenarioAxis_pbm_OnSecondResetDateMember_ncyOUE72ukmocjDc8Z0H-Q" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtInstrumentConvertibleFloorPrice" scale="0" id="Narr_DEhhUz7Xs0uOgWd8jx53TQ">37.50</ix:nonFraction> on the Second Reset Date (<ix:nonNumeric contextRef="Duration_1_25_2024_To_1_25_2024_Sac8ahw7kkmcpSEmtDJsdw" format="ixt-sec:durmonth" name="pbm:PeriodOfClosingDateConsideredForSecondResetDate" id="Narr_IVCp4RdOSEWZwhzu03Xy0w">3</ix:nonNumeric>-month anniversary of Closing Date) and <ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_1_25_2023_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_BvezJDz-uEqqy_HrQoZE6A" decimals="2" format="ixt-sec:numwordsen" name="pbm:DebtInstrumentConvertibleFloorPrice" scale="0" id="Narr_Irbzc7PsfkuScM-y3T6S7A">no</ix:nonFraction> floor thereafter. The Conversion Price is the lowest volume-weighted average price (&#8220;<b style="font-weight:bold;">VWAP</b>&#8221;) of the shares up until conversion date subject to the conversion floor.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The Company is obligated to make a Make Whole Payment to Investors within <span style="-sec-ix-hidden:Hidden_Z4ChO50cMkKUnnoCygwVeQ;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">thirty-five</span></span> (35) Trading Days following a Conversion Date if the <span style="-sec-ix-hidden:Hidden_KpSY2FHAokGFAbpsh1uHUA;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">thirty</span></span> (30) Day VWAP, starting from the first Trading Date after the conversion, is lower than the Conversion Price. The Make Whole Payment can be made in either cash or Common Shares, at the Company&#8217;s discretion, subject to certain conditions.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">If the Company elects to settle the Make Whole Payment in Common Shares, it will transfer to the Holder the number of Common Shares (the &#8220;Make Whole Shares&#8221;) calculated as the difference between (A)&#160;the principal amount converted on the Conversion Date divided by the <ix:nonNumeric contextRef="Duration_1_15_2024_To_1_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_hsieA9mdREani5uNWz8bsg" format="ixt-sec:durday" name="pbm:ThresholdPeriodForVolumeWeightedAveragePrice" id="Narr_qgYROUQQCkeN7DHsnq_rBw">30</ix:nonNumeric> Day VWAP, and (B)&#160;the principal amount converted divided by the Conversion Price on the Conversion Date. Alternatively, if the Company chooses to pay in cash, the payment will equal the number of Make Whole Shares multiplied by the 30 Day VWAP.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Total proceeds received were $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2023_To_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_amyTMmJuA0Cbmfgr9LJdaw" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsProceedsFromConvertibleDebt" scale="0" id="Narr_Z21PZ3sU1kWCApAyvKwJbg">2,500,000</ix:nonFraction>. The Company has designated the entire instrument as FVTPL instrument. The fair value of the convertible notes was estimated using a combined discounted cash flow approach and Monte Carlo simulation with the following assumptions as of March&#160;31, 2024.</p><ix:nonNumeric contextRef="Duration_4_1_2023_To_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_nYe7m5_mxUubStevVRgaHQ" name="ifrs-full:DisclosureOfSignificantUnobservableInputsUsedInFairValueMeasurementOfLiabilitiesExplanatory" id="Tb_-nZQ1TVKik-R1kkN6dVo1Q" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:80.98%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2.55%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:14.84%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:1.62%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td></tr><tr><td style="vertical-align:bottom;width:80.98%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.55%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">&#160;&#160;&#160;&#160;</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.84%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">Inputs</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.62%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">&#160;</b></p></td></tr><tr><td style="vertical-align:bottom;width:80.98%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Share price</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.55%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.84%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_UnobservableInputsAxis_pbm_SharePriceMeasurementInputMember_mkgA9e8KvEGIotNL4zIZYg" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:SignificantUnobservableInputLiabilities" scale="0" id="Tc_l681Ejk47Eq8QxQ4-apFFw_2_2">85.50</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.62%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td></tr><tr><td style="vertical-align:bottom;width:80.98%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Note principal amount</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.55%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.84%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CAD_UKntLULJbkaokFHT4XTVUg" contextRef="As_Of_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_9vHVYWp08E20QCuemQCdog" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtInstrumentFaceAmount" scale="0" id="Tc_JeYlMeoHuUu2uhbbI4cZLw_3_2">3,125,000</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.62%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td></tr><tr><td style="vertical-align:bottom;width:80.98%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Prepayment Amount</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.55%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.84%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_UnobservableInputsAxis_ifrs-full_ConstantPrepaymentRateMeasurementInputMember_dPZ9O0ZKu0uT6l4LFG39RA" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:SignificantUnobservableInputLiabilities" scale="0" id="Tc_aCJNfeXLNU29tFS-h4vJmg_4_2">130</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.62%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">%</p></td></tr><tr><td style="vertical-align:bottom;width:80.98%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Discount rate shares</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.55%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.84%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_UnobservableInputsAxis_pbm_DiscountRateSharesMeasurementInputMember_ejy_-MPRzkSr0r0lxadnBg" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:SignificantUnobservableInputLiabilities" scale="0" id="Tc_zb0cpek-S0Ko_6OkYkuw9g_5_2">4.43</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.62%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">%</p></td></tr><tr><td style="vertical-align:bottom;width:80.98%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Discount rate cash</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.55%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.84%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_UnobservableInputsAxis_pbm_DiscountRateCashMeasurementInputMember_hKqVBVhNZEiQPJDBVi_I_g" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:SignificantUnobservableInputLiabilities" scale="0" id="Tc_7Y3t0fl_fUW_L8Ji3D9bsg_6_2">20.83</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.62%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">%</p></td></tr><tr><td style="vertical-align:bottom;width:80.98%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Volatility annual</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.55%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.84%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_UnobservableInputsAxis_pbm_HistoricalAnnualVolatilityForSharesMeasurementInputMember_zEEZ2BpxvUeyiU_5yNsjAg" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:SignificantUnobservableInputLiabilities" scale="0" id="Tc_D0oYbF49h0uV4-SrreD60Q_7_2">100</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.62%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">%</p></td></tr><tr><td style="vertical-align:bottom;width:80.98%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Volatility daily</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.55%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.84%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_UnobservableInputsAxis_pbm_HistoricalDailyVolatilityForSharesMeasurementInputMember_2b2x9ZTaoE-O7TKbbf8DxQ" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:SignificantUnobservableInputLiabilities" scale="0" id="Tc_PkENm9o02UGuXJBCwfMdeQ_8_2">6.30</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.62%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">%</p></td></tr><tr><td style="vertical-align:bottom;width:80.98%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Risk free annual</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.55%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.84%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_UnobservableInputsAxis_pbm_AnnualInterestRateMeasurementInputMember_DZpjnGhOAUSK_0VBFb9CJQ" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:SignificantUnobservableInputLiabilities" scale="0" id="Tc_bKT4hdY7Tku4NSlz5cPHDA_9_2">4.43</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.62%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">%</p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The fair value was calculated to be $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_9vHVYWp08E20QCuemQCdog" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:FinancialLiabilitiesAtFairValue" scale="0" id="Narr_SFqdX4XjG0CvV2mChunm1Q">7,657,397</ix:nonFraction> as of March&#160;31, 2024. A fair value loss was recognized of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2023_To_3_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_nYe7m5_mxUubStevVRgaHQ" decimals="0" format="ixt:num-dot-decimal" name="pbm:FairValueAdjustmentOnConvertibleNote" sign="-" scale="0" id="Narr_3c3QTzwMq0qCwNpvMkP0nw">5,157,397</ix:nonFraction> during the&#160;year end March&#160;31, 2024 ($<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2022_To_3_31_2023_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_i1uxQljSqEK8JMC-sLNtbQ" decimals="0" format="ixt-sec:numwordsen" name="pbm:FairValueAdjustmentOnConvertibleNote" scale="0" id="Narr_cLhSSD2vl0CGl0nqIpFvUg">nil</ix:nonFraction>, March&#160;31, 2023).</p></ix:continuation><ix:nonNumeric contextRef="Duration_4_1_2023_To_3_31_2024_SXKabfbue0KLjKL7OMxylQ" name="ifrs-full:DisclosureOfDerivativeFinancialInstrumentsExplanatory" id="Tb_ZV6n81pSdUybMvVvBS8elQ" continuedAt="Tb_ZV6n81pSdUybMvVvBS8elQ_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;margin:0pt 0pt 12pt 0pt;">10. Derivative warrant liabilities</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Prior to the RTO Transaction, NCAC had <ix:nonFraction unitRef="Unit_Standard_item_s-l1VIqG9Uanppx6r9y-Ww" contextRef="Duration_4_1_2023_To_3_31_2024_SXKabfbue0KLjKL7OMxylQ" decimals="INF" format="ixt-sec:numwordsen" name="pbm:NumberOfClassesOfWarrantsOutstanding" scale="0" id="Narr_ziOvOO0ELUylUqnWVXBMGQ">two</ix:nonFraction> classes of warrants outstanding, which were assumed by the Company upon completion of the RTO Transaction.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Public Warrants: which had resulted from NCAC&#8217;s initial public offering (the &#8220;<b style="font-weight:bold;">NCAC IPO</b>&#8221;) and entitled to registration on the Form&#160;F-4 filed in connection with the RTO Transaction. These warrants were listed on Nasdaq Capital Market under the symbol &#8220;PBMWW&#8221;.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Private Warrants: which had resulted from NCAC&#8217;s private placement prior to the NCAC IPO.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">As at the Closing Date and March&#160;31, 2024, there were <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="INF" format="ixt:num-dot-decimal" name="pbm:NumberOfWarrantsIssued" scale="0" id="Narr_7wW52cbWY0eaC6x-DGAPxA">174,267</ix:nonFraction> (<ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="INF" format="ixt:num-dot-decimal" name="pbm:NumberOfWarrantsIssuedPreConsolidation" scale="0" id="Narr_mdV0Bw3JaUyFi4pAaha40g">13,070,000</ix:nonFraction> pre-share consolidation) warrants <span style="-sec-ix-hidden:Hidden_dgxJVwsoUEODzonIjftA6A;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">issued</span></span> and <span style="-sec-ix-hidden:Hidden_Sj8Jw34G0EGyYYUdm39Tpw;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">outstanding</span></span>, comprised of <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="As_Of_3_31_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_pbm_PublicWarrantsMember_THb0EWbuC0-O1bTZoaAZxQ" decimals="INF" format="ixt:num-dot-decimal" name="pbm:NumberOfWarrantsOutstanding" scale="0" id="Narr_cpfi7-bkKEK-00Wa7WvgoA">166,667</ix:nonFraction> (<ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="As_Of_3_31_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_pbm_PublicWarrantsMember_THb0EWbuC0-O1bTZoaAZxQ" decimals="INF" format="ixt:num-dot-decimal" name="pbm:NumberOfWarrantsIssuedPreConsolidation" scale="0" id="Narr_dYJyPRdeUkC86O7Ad7pebw">12,500,000</ix:nonFraction> pre-share consolidation) Public Warrants and <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="As_Of_3_31_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_pbm_PrivateWarrantsMember_0GhBxGPPoUygLHP_TZighg" decimals="INF" format="ixt:num-dot-decimal" name="pbm:NumberOfWarrantsIssued" scale="0" id="Narr_q6ogJgcg-Ea6JGjyua_Aow">7,600</ix:nonFraction> (<ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="As_Of_3_31_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_pbm_PrivateWarrantsMember_0GhBxGPPoUygLHP_TZighg" decimals="INF" format="ixt:num-dot-decimal" name="pbm:NumberOfWarrantsIssuedPreConsolidation" scale="0" id="Narr_vaKY0i_-GkKdSspo0l0-5Q">570,000</ix:nonFraction> pre-share consolidation) <span style="-sec-ix-hidden:Hidden_mNN7sAciP0S35FqMPbBbmg;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">Private Warrants</span></span>. Each warrant is exercisable to purchase <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="INF" format="ixt-sec:numwordsen" name="pbm:IfrsClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" id="Narr_mVNcE8Wdp0qz7rY2So54Mg">one</ix:nonFraction> common share at a price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="2" format="ixt:num-dot-decimal" name="pbm:IfrsClassOfWarrantOrRightExercisePriceOfWarrantsOrRights" scale="0" id="Narr_PnqQOd1G_USOGSyAT3LFCQ">862.50</ix:nonFraction> ($<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="2" format="ixt:num-dot-decimal" name="pbm:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRightsPreConsolidation" scale="0" id="Narr_AUV8RmUy6UiQvzQYHX9X2A">11.50</ix:nonFraction> pre-share consolidation) per share. As a result of the potential cashless exercise feature included within the indenture of the warrants, the Company has classified the warrants as a liability measured at fair value through profit or loss as they failed to meet the &#8220;fixed-for-fixed&#8221; requirements prescribed by <i style="font-style:italic;">IAS 32&#160;&#8211; Financial Instruments: presentation.</i></p></ix:nonNumeric></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:24pt 0pt 0pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td><td style="vertical-align:top;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;"><img src="pbm-20240930xex99d3002.jpg" alt="Graphic" style="display:inline-block;height:28.5pt;left:0%;padding-bottom:0pt;position:relative;top:0pt;width:87.75pt;"/></p></td><td style="vertical-align:bottom;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;">23</p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">PSYENCE BIOMEDICAL LTD.</b></p></td></tr><tr><td style="vertical-align:top;width:100%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">Consolidated Financial Statements</b></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:none;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><a id="Tc_OIvqiBUmK0aHQQtNgaBcEQ_1_2"></a><a id="Tc_KPz2e5d2aUeDHhqiKhsD5w_1_4"></a><a id="Tc_MXPNJU7bz0SUAiCsuWeUVg_2_2"></a><a id="Tc_7HsX9-S8s026K-lMStVZog_2_4"></a><a id="Tc_0ybYSMsPfUuDHIbF32lTCA_3_0"></a><a id="Tc_WoGpUm4xH0WeBnxug-7R0A_4_0"></a><a id="Tc_uEgOZY9QpE6M-HvU8izh3g_5_0"></a><a id="Tc_JOdBdCkLI0u7ISi0UOqlTg_6_0"></a><a id="Tc_XsI-E3TtkUKPIduDwxX8QQ_6_3"></a><a id="Tc_eaoGLJ6sO0eDzypiM0BrEw_6_5"></a><a id="Tc_1GLPF98QJE2BZhiBvYpBfA_7_0"></a><a id="Tc_Hk6yXJsyB0yXRshP9_THdw_8_0"></a><a id="Tc_sumBVDdDS0-e-CvfEkf3PA_8_3"></a><a id="Tc_6RXcjilAsk6ou0-aYcGJcA_8_5"></a><a id="Tc_1Iz7T0dEq0mSELH1FHS3bw_9_0"></a><a id="Tc_STjlLUpDj0qQ3ek2JCbv_A_9_2"></a><a id="Tc_P4_lWS6tvUKYa-xzL3sMIA_9_4"></a><a id="Tc_LMS_x6zQKkWGOhyCcBIEtg_1_2"></a><a id="Tc_mP0ByXCFQ0W_N_vlXEML1w_1_7"></a><a id="Tc_QAtKok1ZIEWq5ZOQE0TjSg_2_5"></a><a id="Tc_r81oxHthA0OjLzhe-dv0IA_2_10"></a><a id="Tc_IebKwAmehEWK9f-i_j7NoA_3_5"></a><a id="Tc_aui6nJGhUEWxA0PPYC9Ihw_3_10"></a><a id="Tc_T8bpmtRjekGTUywv0LvV0g_4_2"></a><a id="Tc_6vL1eVBe7UWWDlpYE7_P7g_4_5"></a><a id="Tc_tOEgqyFRJUONkRj3KmJuhQ_4_7"></a><a id="Tc_1Cjs1KLrmki81zWcQzCfAw_4_10"></a><a id="Tc_5bE_1grsoUqeT6T_OPrIQg_5_2"></a><a id="Tc_uTghWyI2kUeQjrB3FJpmmQ_5_5"></a><a id="Tc_LhsOD1rHmEejmzdx24VVEQ_5_7"></a><a id="Tc_xKeLvRKixUC1GctoOifW4A_5_10"></a><a id="Tc_S8Kk73DAv0WU3aYBXR-QeQ_6_0"></a><a id="Tc_Si7GEcW200OEjVrWqcK3Yg_6_2"></a><a id="Tc_qgg1vpMQKkyZsPahWJ01Ew_6_4"></a><a id="Tc_bHpCGs-85ECs6nL0sEHnoQ_6_5"></a><a id="Tc_cFQatfbbxkqd99FB76jyxA_6_7"></a><a id="Tc_1cbKUG8viE2qk54OcGvR2Q_6_9"></a><a id="Tc_o6Haam8ySUmkv5OVg5vS-A_6_10"></a><a id="Tc_DCTDNS5xEkqHywUD-KB6zg_7_0"></a><a id="Tc_iQJxVN-CIU-GS50Wo69tiQ_8_0"></a><a id="Tc_5ZYCGGFh7U6g7THZrpbSFQ_8_4"></a><a id="Tc_ZtRxY4vLB0qmd3qt4V1oag_8_9"></a><a id="Tc_nW0g9_u-qkC56wQdUCNFkA_1_7"></a><a id="Tc_GNLDBhIdqU6YY1BL3a1YLA_1_9"></a><a id="Tc_0OznfNEaDEWcPoQ-JqDK3g_2_5"></a><a id="Tc__LJ4iellKkqX69Ak-aQe9A_2_7"></a><a id="Tc_R_VeRRXghU2sxyrLKnjLhg_2_9"></a><a id="Tc_h8uacGwdt0qxdiI-bchZqw_3_0"></a><a id="Tc_BmuQu6J3e0qDcCRI8IPGvw_3_2"></a><a id="Tc_P8vHLNlQXUCndzlNWijrKA_3_5"></a><a id="Tc_yZXBjY-T9UWFAWoYAIMYMQ_3_7"></a><a id="Tc_7zN198XsGkSuFECKQL-LnA_3_9"></a><a id="Tc_qX5HACRLokac94L58ue7bg_4_0"></a><a id="Tc_EUlaQmdRNk2_tf4HdtTbkA_4_2"></a><a id="Tc_FmVAX_foCk-2dEnUXg8s0A_4_4"></a><a id="Tc_wDQ29fCKNEGso_0SdfpYnQ_5_0"></a><a id="Tc_YrAwsT7GOk2I6klMc_G4qg_5_4"></a><ix:continuation id="Tb_ZV6n81pSdUybMvVvBS8elQ_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Since the Public Warrants are traded on Nasdaq, their price is observable. The Company valued the Public Warrants using the closing price of PBMWW to measure their fair value.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The Company utilizes a Black-Scholes options valuation model to value the private warrants at each reporting period, with changes in fair value recognized in the statement of net loss and comprehensive loss. The estimated fair value of the warrant liability is determined using Level 2 inputs. Inherent in a Black-Scholes pricing model are assumptions related to expected volatility of the Public Warrants, expected life, risk-free interest rate and dividend yield. The Company estimates the volatility of its ordinary shares based on industry historical volatility that matches the expected remaining life of the warrants. The risk-free interest rate is based on the U.S. Treasury zero-coupon yield curve on the grant date for a maturity similar to the expected remaining life of the warrants. The expected life of the warrants is assumed to be equivalent to their remaining contractual term. The dividend rate is based on the historical rate, which the Company anticipates remaining at <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="2" format="ixt-sec:numwordsen" name="pbm:DividendYield" scale="-2" id="Narr_EsQl57HhEEOCfa-ufhF4yQ">zero</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The following table provides quantitative information regarding Level 2 fair value measurements at March&#160;31, 2024:</p><ix:nonNumeric contextRef="Duration_4_1_2023_To_3_31_2024_SXKabfbue0KLjKL7OMxylQ" name="ifrs-full:DisclosureOfSignificantUnobservableInputsUsedInFairValueMeasurementOfLiabilitiesExplanatory" id="Tb_2iDzW7tLXk6_I-W0oaiazg" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:68.5%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:1.71%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:13.25%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:1.71%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="ve