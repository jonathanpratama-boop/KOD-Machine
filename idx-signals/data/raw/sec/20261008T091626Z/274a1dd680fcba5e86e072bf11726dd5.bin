    <TD STYLE="padding: 0pt; text-align: left; text-indent: 0pt; width: 5%">12</TD>
    <TD STYLE="padding: 0pt; text-align: left; text-indent: 0pt; width: 85%">Voting rights of Members</TD>
    <TD STYLE="padding: 0pt; text-align: center; text-indent: 0pt; width: 10%">26</TD></TR>
  <TR STYLE="text-align: left; vertical-align: bottom; font: 10pt Times New Roman, Times, Serif; background-color: White">
    <TD COLSPAN="2" STYLE="padding: 0pt; text-align: left; text-indent: 0pt">Right to vote</TD>
    <TD STYLE="padding: 0pt; text-align: center; text-indent: 0pt">26</TD></TR>
  <TR STYLE="text-align: left; vertical-align: bottom; font: 10pt Times New Roman, Times, Serif; background-color: rgb(204,238,255)">
    <TD COLSPAN="2" STYLE="padding: 0pt; text-align: left; text-indent: 0pt">Rights of joint holders</TD>
    <TD STYLE="padding: 0pt; text-align: center; text-indent: 0pt">26</TD></TR>
  <TR STYLE="text-align: left; vertical-align: bottom; font: 10pt Times New Roman, Times, Serif; background-color: White">
    <TD COLSPAN="2" STYLE="padding: 0pt; text-align: left; text-indent: 0pt">Representation of corporate Members</TD>
    <TD STYLE="padding: 0pt; text-align: center; text-indent: 0pt">26</TD></TR>
  <TR STYLE="text-align: left; vertical-align: bottom; font: 10pt Times New Roman, Times, Serif; background-color: rgb(204,238,255)">
    <TD COLSPAN="2" STYLE="padding: 0pt; text-align: left; text-indent: 0pt">Member with mental disorder</TD>
