            <td style="padding:3pt 0pt 1pt 0pt; min-width:7.5pt; text-align:right; white-space:nowrap;">54</td>
            <td style="padding:0pt;padding-left:5.125pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
