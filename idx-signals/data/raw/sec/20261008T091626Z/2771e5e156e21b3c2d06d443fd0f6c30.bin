            <td style="padding:3pt 0pt 1pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td>
            <td style="padding:3pt 0pt 1pt 0pt; min-width:15pt; text-align:right; white-space:nowrap;">2019</td>
