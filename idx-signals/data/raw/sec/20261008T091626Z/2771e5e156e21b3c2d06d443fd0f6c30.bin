            <td style="padding:3pt 0pt 1pt 0pt; min-width:15pt; text-align:right; white-space:nowrap;">2021</td>
            <td style="padding:0pt;padding-left:3.995pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
          </tr>
          <tr style="line-height:10pt;background-color:#CCEEFF;white-space:nowrap;text-align:center;vertical-align:bottom;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Times New Roman, Times, serif ;font-size:10pt;">
            <td style="padding:3pt 0pt 1pt 0pt; width:176.88pt;text-align:left;">
              <font style="letter-spacing:0.2pt;">Renah Persofsky </font>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt;padding-left:5.125pt;width:0pt;">&#8203;</td>
            <td style="padding:3pt 0pt 1pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td>
            <td style="padding:3pt 0pt 1pt 0pt; min-width:7.5pt; text-align:right; white-space:nowrap;">64</td>
            <td style="padding:0pt;padding-left:5.125pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:3pt 0pt 1pt 0pt; width:154.88pt;text-align:left;">
              <font style="letter-spacing:0.2pt;">Independent Director </font>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt;padding-left:3.995pt;width:0pt;">&#8203;</td>
            <td style="padding:3pt 0pt 1pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td>
            <td style="padding:3pt 0pt 1pt 0pt; min-width:15pt; text-align:right; white-space:nowrap;">2022</td>
            <td style="padding:0pt;padding-left:3.995pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
          </tr>
          <tr style="line-height:10pt;white-space:nowrap;text-align:center;vertical-align:bottom;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Times New Roman, Times, serif ;font-size:10pt;">
