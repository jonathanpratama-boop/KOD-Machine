    <td style="text-align: center">&#160;</td><td style="text-align: center">310,271</td><td style="text-align: center">&#160;</td><td style="text-align: center">&#160;</td>
    <td style="text-align: center">&#160;</td><td style="text-align: center">30,446</td><td style="text-align: center">&#160;</td><td style="text-align: center">&#160;</td>
