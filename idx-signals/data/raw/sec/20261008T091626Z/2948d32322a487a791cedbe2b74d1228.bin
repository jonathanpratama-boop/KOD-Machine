    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c9" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AdjustmentForAmortization" scale="0" unitRef="usd" id="ixv-6284">1,780,000</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
