    <td style="border-bottom: Black 1.5pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; text-align: right"><ix:nonFraction contextRef="c9" decimals="0" format="ixt:num-dot-decimal" name="hht:FinanceExpense" scale="0" unitRef="usd" id="ixv-6303">46,570</ix:nonFraction></td><td style="padding-bottom: 1.5pt; text-align: left">&#160;</td></tr>
