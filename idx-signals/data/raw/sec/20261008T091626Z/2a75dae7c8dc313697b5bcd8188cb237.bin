    <td colspan="6" style="border-bottom: Black 1.5pt solid; font-weight: bold; font-style: italic; text-align: center">AGAINST</td><td style="text-align: center; padding-bottom: 1.5pt; font-weight: bold; font-style: italic">&#160;</td><td style="text-align: center; padding-bottom: 1.5pt; font-weight: bold; font-style: italic">&#160;</td>
    <td colspan="6" style="border-bottom: Black 1.5pt solid; font-weight: bold; font-style: italic; text-align: center">ABSTAIN</td><td style="text-align: center; padding-bottom: 1.5pt; font-weight: bold; font-style: italic">&#160;</td><td style="text-align: center; padding-bottom: 1.5pt; font-weight: bold; font-style: italic">&#160;</td>
