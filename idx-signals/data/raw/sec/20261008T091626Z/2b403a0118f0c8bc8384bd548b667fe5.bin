  <TR STYLE="vertical-align: bottom; background-color: White">
    <TD STYLE="text-align: left; padding-bottom: 1pt; text-indent: -7.1pt; padding-left: 15.5pt">-&#9;cash flow hedge gain</TD><TD STYLE="padding-bottom: 1pt">&nbsp;</TD>
    <TD STYLE="border-bottom: Black 1pt solid; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1pt solid; text-align: right">(2,197</TD><TD STYLE="padding-bottom: 1pt; text-align: left">)</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
