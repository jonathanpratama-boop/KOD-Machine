    <TD COLSPAN="2" STYLE="border-bottom: Black 1.5pt solid; text-align: center"><P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt; text-align: center"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt"><B>June
                                            30,</B></FONT><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt"><B>
                                            2023</B></FONT></P></TD><TD STYLE="padding-bottom: 1.5pt">&#160;</TD><TD STYLE="font-weight: bold; padding-bottom: 1.5pt">&#160;</TD>
    <TD COLSPAN="2" STYLE="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center">December 31, 2022</TD><TD STYLE="padding-bottom: 1.5pt; font-weight: bold">&#160;</TD><TD STYLE="font-weight: bold; padding-bottom: 1.5pt">&#160;</TD>
    <TD COLSPAN="2" STYLE="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center">December 31, 2021</TD><TD STYLE="padding-bottom: 1.5pt; font-weight: bold">&#160;</TD></TR>
