    <TD STYLE="text-align: left">&#160;</TD><TD STYLE="text-align: right">330,968</TD><TD STYLE="text-align: left">&#160;</TD><TD>&#160;</TD>
    <TD STYLE="text-align: left">&#160;</TD><TD STYLE="text-align: right">216,188</TD><TD STYLE="text-align: left">&#160;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
