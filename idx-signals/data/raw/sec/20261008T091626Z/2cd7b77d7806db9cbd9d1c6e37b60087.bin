    <TD STYLE="width: 60%">Revenue</TD><TD STYLE="width: 2%">&#160;</TD>
    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 16%; text-align: right">1,856,564</TD><TD STYLE="width: 1%; text-align: left">&#160;</TD><TD STYLE="width: 2%">&#160;</TD>
    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 16%; text-align: right">1,016,962</TD><TD STYLE="width: 1%; text-align: left">&#160;</TD></TR>
