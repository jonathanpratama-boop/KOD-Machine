    <TD STYLE="border-bottom: Black 2.5pt double; text-align: left">$</TD><TD STYLE="border-bottom: Black 2.5pt double; text-align: right">303,935</TD><TD STYLE="padding-bottom: 2.5pt; text-align: left">&#160;</TD><TD STYLE="padding-bottom: 2.5pt">&#160;</TD>
    <TD STYLE="border-bottom: Black 2.5pt double; text-align: left">$</TD><TD STYLE="border-bottom: Black 2.5pt double; text-align: right">396,707</TD><TD STYLE="padding-bottom: 2.5pt; text-align: left">&#160;</TD><TD STYLE="padding-bottom: 2.5pt">&#160;</TD>
    <TD STYLE="border-bottom: Black 2.5pt double; text-align: left">$</TD><TD STYLE="border-bottom: Black 2.5pt double; text-align: right">684,703</TD><TD STYLE="padding-bottom: 2.5pt; text-align: left">&#160;</TD><TD STYLE="padding-bottom: 2.5pt">&#160;</TD>
    <TD STYLE="border-bottom: Black 2.5pt double; text-align: left">$</TD><TD STYLE="border-bottom: Black 2.5pt double; text-align: right">805,667</TD><TD STYLE="padding-bottom: 2.5pt; text-align: left">&#160;</TD></TR>
