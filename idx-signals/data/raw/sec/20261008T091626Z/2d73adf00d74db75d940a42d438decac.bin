    <td style="width: 1%; text-align: left">$</td><td style="width: 7%; text-align: right"><ix:nonFraction contextRef="c20" decimals="0" format="ixt:num-dot-decimal" name="rclf:AllocationOfNetLossAsAdjusted" scale="0" unitRef="usd">6,810,256</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 7%; text-align: right"><ix:nonFraction contextRef="c24" decimals="0" format="ixt:num-dot-decimal" name="rclf:AllocationOfNetLossAsAdjusted" scale="0" unitRef="usd">1,702,564</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
