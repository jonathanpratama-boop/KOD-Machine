    <td style="padding-left: 0.125in; text-indent: -0.125in; width: 20%; text-align: left">Allocation of net income (loss)</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 7%; text-align: right">(<ix:nonFraction contextRef="c17" decimals="0" format="ixt:num-dot-decimal" name="rclf:AllocationOfNetLossAsAdjusted" scale="0" sign="-" unitRef="usd">69,870</ix:nonFraction></td><td style="width: 1%; text-align: left">)</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 7%; text-align: right">(<ix:nonFraction contextRef="c21" decimals="0" format="ixt:num-dot-decimal" name="rclf:AllocationOfNetLossAsAdjusted" scale="0" sign="-" unitRef="usd">963,406</ix:nonFraction></td><td style="width: 1%; text-align: left">)</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 7%; text-align: right"><ix:nonFraction contextRef="c18" decimals="0" format="ixt:num-dot-decimal" name="rclf:AllocationOfNetLossAsAdjusted" scale="0" unitRef="usd">1,167,178</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td>
