    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c1" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AccountsReceivableNetCurrent" scale="0" unitRef="usd" id="ixv-6010">14,384,228</ix:nonFraction></td><td style="padding-bottom: 4pt; text-align: left">&#160;</td><td style="padding-bottom: 4pt">&#160;</td>
