    <td style="width: 1%; border-bottom: Black 1.5pt solid; text-align: left">$</td><td style="width: 9%; border-bottom: Black 1.5pt solid; text-align: right"><ix:nonFraction contextRef="c162" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:OtherLiabilitiesCurrent" scale="0" unitRef="usd" id="ixv-6167">540,096</ix:nonFraction></td><td style="width: 1%; padding-bottom: 1.5pt; text-align: left">&#160;</td></tr>
