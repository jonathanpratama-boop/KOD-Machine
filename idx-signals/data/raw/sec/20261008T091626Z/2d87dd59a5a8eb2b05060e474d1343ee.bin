    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c11" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AllowanceForDoubtfulAccountsReceivable" scale="0" unitRef="usd" id="ixv-6016">791,827</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
