			<p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: center;">&#8212;</p>
			</td>
			<td style="border-bottom:solid 1px #000000;vertical-align:bottom;width:6%;">
			<p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: center;">&#8212;</p>
			</td>
			<td style="border-bottom:solid 1px #000000;vertical-align:bottom;width:6.5%;">
			<p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: center;">&#8212;</p>
