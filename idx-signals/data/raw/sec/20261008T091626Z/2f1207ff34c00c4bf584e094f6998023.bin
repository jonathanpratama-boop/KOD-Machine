    <span id="xdx_904_edei--SecurityExchangeName_c20231130__20231130_z33P7EvwnG75"><ix:nonNumeric contextRef="AsOf2023-11-30" format="ixt-sec:exchnameen" name="dei:SecurityExchangeName">Nasdaq</ix:nonNumeric></span> Capital Market</span></span></td></tr>
