              <td style="padding:1.5pt 0pt 4pt 0pt;border-bottom:1px solid #000000; min-width:21.75pt; text-align:right; white-space:nowrap;">
                <div style="font-weight:bold;">19.4</div>
              </td>
              <td style="padding:0pt;padding-left:0pt;width:0pt;border-bottom:1px solid #000000;">&#8203;</td>
              <td style="padding:0pt;border-bottom:1px solid #000000; width:0pt;">&#8203;</td>
            </tr>
