          <tr style="line-height:12pt;background-color:#CCEEFF;white-space:nowrap;text-align:center;vertical-align:bottom;font-style:normal;font-weight:bold;font-variant:normal;text-transform:none;color:#000000;font-family:Arial Narrow, Arial, Tahoma, Geneva, sans-serif;font-size:10pt;">
            <td style="padding:0pt 0pt 2.667pt 0pt; width:263.51pt;white-space:normal;text-align:left;">
              <div style="margin-left:10pt; text-indent:-10pt;">
                <font style="letter-spacing:0.25pt;">Fair value of items which are periodically measured at fair value:</font>
              </div>
