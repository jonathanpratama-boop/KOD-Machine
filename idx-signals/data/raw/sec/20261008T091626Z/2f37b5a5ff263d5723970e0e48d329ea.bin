            <td style="padding:0pt;padding-left:29.82pt;width:0pt;">&#8203;</td>
            <td style="padding:1.25pt 0pt 3.5pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td>
            <td style="padding:1.25pt 0pt 3.5pt 0pt; min-width:30.75pt; text-align:right; white-space:nowrap;">160,548</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
          </tr>
          <tr style="line-height:10pt;white-space:nowrap;text-align:center;vertical-align:bottom;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Arial Narrow, Arial, Tahoma, Geneva, sans-serif;font-size:10pt;">
            <td style="padding:1.5pt 0pt 3.5pt 0pt; width:378.08pt;text-align:left;">
              <div style="white-space:nowrap;">
                <font style="letter-spacing:0.25pt;">Performance-based (&#8220;earn out&#8221;) contingent consideration(1) </font>
              </div>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt;padding-left:29.82pt;width:0pt;">&#8203;</td>
            <td style="padding:1.5pt 0pt 3.5pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td>
            <td style="padding:1.5pt 0pt 3.5pt 0pt; min-width:30.75pt; text-align:right; white-space:nowrap;">59,131</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;">&#8203;</td>
