          </tr>
          <tr style="line-height:10pt;white-space:nowrap;text-align:center;vertical-align:bottom;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Arial Narrow, Arial, Tahoma, Geneva, sans-serif;font-size:10pt;">
            <td style="padding:0pt;border-bottom:1px solid #FFFFFF; width:0pt;">&#8203;</td>
            <td style="border-bottom:1px solid #FFFFFF;padding:1.5pt 0pt 2.5pt 0pt; width:376.61pt;text-align:left;">
              <div style="white-space:nowrap;">
                <font style="letter-spacing:0.25pt;">Pro&#160;forma net tangible book value per share as of September&#160;30, 2022 </font>
              </div>
            </td>
            <td style="padding:0pt;border-bottom:1px solid #FFFFFF; width:6pt;">&#8203;</td>
            <td style="padding:0pt;border-bottom:1px solid #000000; width:6pt;">&#8203;</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;border-bottom:1px solid #000000;">&#8203;</td>
