              <div style="white-space:nowrap; text-align:center;">
                <font style="letter-spacing:0.225pt;">Note</font>
              </div>
            </td>
            <td style="padding:0pt;border-bottom:1px solid #000000; width:6pt;">&#8203;</td>
            <td style="padding:0pt;border-bottom:1px solid #000000; width:6pt;">&#8203;</td>
