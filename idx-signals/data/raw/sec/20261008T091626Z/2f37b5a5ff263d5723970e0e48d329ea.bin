          <tr style="line-height:10pt;background-color:#CCEEFF;white-space:nowrap;text-align:center;vertical-align:bottom;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Arial Narrow, Arial, Tahoma, Geneva, sans-serif;font-size:10pt;">
            <td style="padding:1.25pt 0pt 3.5pt 0pt; width:46.6pt;text-align:left;">
              <div style="white-space:nowrap;">
                <font style="letter-spacing:0.25pt;">C </font>
              </div>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt;padding-left:52.58pt;width:0pt;">&#8203;</td>
            <td style="padding:1.25pt 0pt 3.5pt 0pt; min-width:6pt; text-align:right; ">$</td>
            <td style="padding:1.25pt 0pt 3.5pt 0pt; min-width:15pt; text-align:right; white-space:nowrap;">150</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt;padding-left:33.32pt;width:0pt;">&#8203;</td>
            <td style="padding:1.25pt 0pt 3.5pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td>
            <td style="padding:1.25pt 0pt 3.5pt 0pt; min-width:12.75pt; text-align:right; white-space:nowrap;">3.2<font style="position:absolute;">%</font></td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
