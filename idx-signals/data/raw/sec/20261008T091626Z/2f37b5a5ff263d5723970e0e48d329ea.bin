              <td style="padding:1.5pt 0pt 4pt 0pt;border-bottom:1px solid #000000; min-width:17.25pt; text-align:right; white-space:nowrap;">10.1</td>
              <td style="padding:0pt;padding-left:0pt;width:0pt;border-bottom:1px solid #000000;">&#8203;</td>
              <td style="padding:0pt;border-bottom:1px solid #000000; width:6pt;">&#8203;</td>
              <td style="padding:0pt;border-bottom:1px solid #000000; width:6pt;">&#8203;</td>
              <td style="padding:0pt;padding-left:13.81pt;width:0pt;border-bottom:1px solid #000000;">&#8203;</td>
