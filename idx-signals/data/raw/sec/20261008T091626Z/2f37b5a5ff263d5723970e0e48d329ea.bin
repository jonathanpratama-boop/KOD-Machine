            <td style="padding:2.34pt 0pt 1.77pt 0pt; width:108.75pt;">
              <font style="letter-spacing:0.225pt;">See Note 30A(5) </font>
            </td>
            <td style="padding:0pt; width:3.5pt;">&#8203;</td>
            <td style="padding:0pt; width:3.5pt;">&#8203;</td>
