          <tr style="line-height:10pt;background-color:#CCEEFF;white-space:nowrap;text-align:left;vertical-align:top;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Arial Narrow, Arial, Tahoma, Geneva, sans-serif;font-size:10pt;">
