            <td style="padding:1.5pt 0pt 4pt 0pt;border-bottom:0.75pt solid #000000; ; min-width:6pt; text-align:right; ">&#8203;</td>
            <td style="padding:1.5pt 0pt 4pt 0pt;border-bottom:0.75pt solid #000000; ; min-width:33pt; text-align:right; white-space:nowrap;">606,128</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;border-bottom:0.75pt solid #000000; ;">&#8203;</td>
            <td style="padding:0pt;border-bottom:0.75pt solid #000000; ; width:3pt;">&#8203;</td>
            <td style="padding:0pt;border-bottom:0.75pt solid #000000; ; width:3pt;">&#8203;</td>
            <td style="padding:0pt;padding-left:16.72pt;width:0pt;border-bottom:0.75pt solid #000000; ;">&#8203;</td>
            <td style="padding:1.5pt 0pt 4pt 0pt;border-bottom:0.75pt solid #000000; ; min-width:6pt; text-align:right; ">&#8203;</td>
            <td style="padding:1.5pt 0pt 4pt 0pt;border-bottom:0.75pt solid #000000; ; min-width:33pt; text-align:right; white-space:nowrap;">636,334</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;border-bottom:0.75pt solid #000000; ;">&#8203;</td>
            <td style="padding:0pt;border-bottom:0.75pt solid #000000; ; width:3pt;">&#8203;</td>
            <td style="padding:0pt;border-bottom:0.75pt solid #000000; ; width:3pt;">&#8203;</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;border-bottom:0.75pt solid #000000; ;">&#8203;</td>
            <td style="padding:1.5pt 0pt 4pt 0pt;border-bottom:0.75pt solid #000000; ; min-width:6pt; text-align:right; ">&#8203;</td>
            <td style="padding:1.5pt 0pt 4pt 0pt;border-bottom:0.75pt solid #000000; ; min-width:33pt; text-align:right; white-space:nowrap;">752,314</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;border-bottom:0.75pt solid #000000; ;">&#8203;</td>
            <td style="padding:0pt;border-bottom:0.75pt solid #000000; ; width:3pt;">&#8203;</td>
            <td style="padding:0pt;border-bottom:0.75pt solid #000000; ; width:3pt;">&#8203;</td>
