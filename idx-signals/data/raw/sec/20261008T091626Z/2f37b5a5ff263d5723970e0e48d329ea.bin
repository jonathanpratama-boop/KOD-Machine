              <td style="padding:1.25pt 0pt 3.5pt 0pt; min-width:12.75pt; text-align:right; white-space:nowrap;">4.0</td>
              <td style="padding:0pt;padding-left:0pt;width:0pt;">&#8203;</td>
              <td style="padding:0pt; width:6pt;">&#8203;</td>
              <td style="padding:0pt; width:6pt;">&#8203;</td>
