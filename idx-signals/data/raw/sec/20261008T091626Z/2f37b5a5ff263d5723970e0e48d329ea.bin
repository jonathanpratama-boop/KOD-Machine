            <td style="padding:0pt; width:0pt;">&#8203;</td>
            <td style="padding:2.167pt 0pt 0.833pt 0pt; width:161pt;">
              <font style="letter-spacing:0.25pt;">Central-Eastern Europe segment </font>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
