            <td style="padding:1.5pt 0pt 4pt 0pt;border-bottom:0.75pt solid #000000; ; min-width:0pt; text-align:right; ">&#8203;</td>
            <td style="padding:1.5pt 0pt 4pt 0pt;border-bottom:0.75pt solid #000000; ; min-width:26.25pt; text-align:right; white-space:nowrap;">2.2</td>
