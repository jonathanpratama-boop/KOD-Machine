    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 16%; text-align: right">0.84</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 2%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 16%; text-align: right">1,965,094.32</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD></TR>
