    <td style="width: 2%; text-align: center">&#160;</td>
    <td style="border-bottom: black 1.5pt solid; width: 24%; text-align: center"><span style="font-size: 10pt">Broker Non-Votes</span></td></tr>
  <tr style="background-color: #CCEEFF">
    <td style="text-align: center"><span style="font-size: 10pt">29,332,407,453</span></td>
    <td>&#160;</td>
    <td style="text-align: center"><span style="font-size: 10pt">6,785,775,332</span></td>
    <td>&#160;</td>
