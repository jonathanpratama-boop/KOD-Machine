    <td style="padding-top:0.003in;text-indent:36pt;padding-left:0.003in;vertical-align:top;padding-bottom:0.003in;padding-right:0.003in;text-align:left;"><p style="text-indent:-36pt;padding-left:36pt;font-size:8.5pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><font style="color:#000000;white-space:pre-wrap;font-style:italic;min-width:fit-content;">(1)</font></p></td>
    <td style="padding-top:0.003in;padding-left:0.003in;vertical-align:top;padding-bottom:0.003in;padding-right:0.003in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="color:#000000;white-space:pre-wrap;font-style:italic;min-width:fit-content;">Dr. Schambye is also a director of the Company and his biographical information appears on page 8.</font><font style="color:#000000;white-space:pre-wrap;font-style:italic;min-width:fit-content;"> </font></p></td>
