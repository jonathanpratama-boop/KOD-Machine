    <td style="text-align: left">&#160;</td><td style="text-align: right">(<ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="elws:RightofuseAssetOperatingLease" scale="0" unitRef="usd" id="ixv-6049">30,497</ix:nonFraction></td><td style="text-align: left">)</td></tr>
  <tr style="vertical-align: bottom; ">
