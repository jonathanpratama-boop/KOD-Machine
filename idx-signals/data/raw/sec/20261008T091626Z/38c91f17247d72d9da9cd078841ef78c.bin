taxes</td> <td>&#160;</td> <td style="text-align: left;">&#160;</td> <td style="text-align: right;"><ix:nonFraction name="ifrs-full:InterestPaidClassifiedAsFinancingActivities" id="fc_1927700636" contextRef="cref_55821411" unitRef="uref_1717180837" scale="0" decimals="0" format="ixt:num-dot-decimal">67,624</ix:nonFraction></td> <td style="text-align: left;">&#160;</td> <td>&#160;</td> <td style="text-align: left;">&#160;</td> <td style="text-align: right;"><ix:nonFraction name="ifrs-full:InterestPaidClassifiedAsFinancingActivities" id="fc_1655896820" contextRef="cref_69881006" unitRef="uref_1717180837" scale="0" decimals="0" format="ixt:num-dot-decimal">213,727</ix:nonFraction></td> <td style="text-align: left;">&#160;</td> </tr><tr style="vertical-align: bottom; background-color: White;"> <td style="padding-left: 0.125in; text-indent: -0.125in; text-align: left;">Cash paid as interest on lease liability</td> <td>&#160;</td> <td style="text-align: left;">&#160;</td> <td style="text-align: right;"><span style="-sec-ix-hidden:fc_1445641720;">3,252</span></td> <td style="text-align: left;">&#160;</td> <td>&#160;</td> <td style="text-align: left;">&#160;</td> <td style="text-align: right;"><ix:nonFraction name="ifrs-full:InterestExpenseOnLeaseLiabilities" id="fc_1654761723" contextRef="cref_69881006" unitRef="uref_1717180837" scale="0" decimals="0" format="ixt:num-dot-decimal">3,204</ix:nonFraction></td> <td style="text-align: left;">&#160;</td> </tr><tr style="vertical-align: bottom; background-color: rgb(204,238,255);"><td style="padding-left: 0.125in; text-indent: -0.125in; font-weight: bold; text-align: left;">Non-cash financing and investing activities</td> <td>&#160;</td> <td style="text-align: left;">&#160;</td> <td style="text-align: right;">&#160;</td> <td style="text-align: left;">&#160;</td> <td>&#160;</td> <td style="text-align: left;">&#160;</td> <td style="text-align: right;">&#160;</td> <td style="text-align: left;">&#160;</td> </tr><tr style="vertical-al