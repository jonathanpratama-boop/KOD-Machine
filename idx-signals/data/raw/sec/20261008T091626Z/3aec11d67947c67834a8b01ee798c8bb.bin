    <TD STYLE="text-align: right; width: 34%"><IMG SRC="drr0689_ex99-4img05.jpg" ALT=""></TD>
    <TD STYLE="text-align: left; width: 33%"></TD></TR>
</TABLE>
<P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0">&nbsp;</P>


