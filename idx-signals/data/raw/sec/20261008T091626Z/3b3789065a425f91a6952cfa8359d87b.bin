  <tr>

    <td style="width: 32.93%; vertical-align: bottom; background-color: rgb(204, 238, 255); font-family: 'Times New Roman'; font-size: 10pt;">
            <div style="text-align: center; color: rgb(0, 0, 0);">1,838,853</div>
          </td>

    <td style="width: 3.9%; vertical-align: bottom; background-color: rgb(204, 238, 255); font-family: 'Times New Roman'; font-size: 10pt;">&#160;</td>

