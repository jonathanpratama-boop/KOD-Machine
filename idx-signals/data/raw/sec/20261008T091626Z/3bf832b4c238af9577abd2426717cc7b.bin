    <td style="width: 1%; text-align: left">$</td><td style="width: 16%; text-align: right"><ix:nonFraction name="us-gaap:DebtInstrumentCarryingAmount" contextRef="AsOf2023-06-30" id="Fact001227" format="ixt:numdotdecimal" decimals="0" unitRef="USD">338,362</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr id="xdx_406_eus-gaap--DebtInstrumentUnamortizedDiscount_iNI_di_msLTDzcuB_zAUuucQXCcVe" style="vertical-align: bottom; background-color: White">
