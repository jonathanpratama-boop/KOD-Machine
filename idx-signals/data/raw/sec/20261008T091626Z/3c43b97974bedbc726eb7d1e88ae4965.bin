              <td style="padding:2.167pt 0pt 0.833pt 0pt; width:126.91pt;">
                <div style="margin-left:10pt; text-indent:-10pt;">
                  <font style="letter-spacing:0.2pt;">Total issued and outstanding </font>
                  <br >
                  <font style="letter-spacing:0.2pt;">as of November&#160;29, 2024</font>
                </div>
