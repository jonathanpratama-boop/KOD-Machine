    <td style="text-align: left">&#160;</td><td style="text-align: right">62</td><td style="text-align: left">%</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">73</td><td style="text-align: left">%</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">65</td><td style="text-align: left">%</td></tr>
