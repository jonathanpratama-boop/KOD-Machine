    <td style="text-align: left">&#160;</td><td style="text-align: right">91,183</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">13,039</td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; ">
    <td style="text-indent: -0.125in; padding-left: 0.125in; text-align: left">Less: Cash, cash equivalents and restricted cash of discontinued operations</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">38,883</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">70,651</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">55,121</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">7,882</td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-indent: -0.125in; padding-left: 0.125in; text-align: left">Cash, cash equivalents and restricted cash &#8211; end of the period from continuing operations</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">16,390</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">25,121</td><td style="text-align: left">&#160;</td><td>&#160;</td>
