  <tr style="vertical-align: bottom">
    <td style="text-align: center">&#160;</td><td style="font-weight: bold; padding-bottom: 1.5pt">&#160;</td>
    <td colspan="2" style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center">2023</td><td style="padding-bottom: 1.5pt; font-weight: bold">&#160;</td><td style="font-weight: bold; padding-bottom: 1.5pt">&#160;</td>
    <td colspan="2" style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center">2024</td><td style="padding-bottom: 1.5pt; font-weight: bold">&#160;</td><td style="font-weight: bold; padding-bottom: 1.5pt">&#160;</td>
    <td colspan="2" style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center">2025</td><td style="padding-bottom: 1.5pt; font-weight: bold">&#160;</td></tr>
  <tr style="vertical-align: bottom">
    <td style="text-align: center">&#160;</td><td style="font-weight: bold">&#160;</td>
    <td colspan="2" style="font-weight: bold; text-align: center">RMB</td><td style="font-weight: bold">&#160;</td><td style="font-weight: bold">&#160;</td>
    <td colspan="2" style="font-weight: bold; text-align: center">RMB</td><td style="font-weight: bold">&#160;</td><td style="font-weight: bold">&#160;</td>
    <td colspan="2" style="font-weight: bold; text-align: center">RMB</td><td style="font-weight: bold">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 64%; text-align: left; padding-bottom: 1.5pt">Operating lease income from fixed payments</td><td style="width: 1%; padding-bottom: 1.5pt">&#160;</td>
    <td style="border-bottom: Black 1.5pt solid; width: 1%; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; width: 9%; text-align: right"><ix:nonFraction contextRef="c8" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseLeaseIncomeLeasePayments" scale="3" unitRef="cny" id="ixv-39098">124,140</ix:nonFraction></td><td style="width: 1%; padding-bottom: 1.5pt; text-align: left">&#160;</td><td style="width: 1%; padding-bottom: 1.5pt">&#160;</td>
    <td style="border-bottom: Black 1.5pt solid; width: 1%; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; width: 9%; text-align: right"><ix:nonFraction contextRef="c9" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseLeaseIncomeLeasePayments" scale="3" unitRef="cny" id="ixv-39099">68,558</ix:nonFraction></td><td style="width: 1%; padding-bottom: 1.5pt; text-align: left">&#160;</td><td style="width: 1%; padding-bottom: 1.5pt">&#160;</td>
    <td style="border-bottom: Black 1.5pt solid; width: 1%; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; width: 9%; text-align: right"><ix:nonFraction contextRef="c0" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseLeaseIncomeLeasePayments" scale="3" unitRef="cny" id="ixv-39100">22,630</ix:nonFraction></td><td style="width: 1%; padding-bottom: 1.5pt; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; ">
    <td style="font-weight: bold; padding-bottom: 2.5pt">Total</td><td style="font-weight: bold; padding-bottom: 2.5pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c8" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseLeaseIncome" scale="3" unitRef="cny" id="ixv-39101">124,140</ix:nonFraction></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; padding-bottom: 2.5pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c9" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseLeaseIncome" scale="3" unitRef="cny" id="ixv-39102">68,558</ix:nonFraction></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; padding-bottom: 2.5pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c0" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseLeaseIncome" scale="3" unitRef="cny" id="ixv-39103">22,630</ix:nonFraction></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left">&#160;</td></tr>
  </table></ix:continuation></ix:nonNumeric>

<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify; text-indent: 0.5in">&#160;</p>

<ix:nonNumeric contextRef="c0" escape="true" name="us-gaap:LessorOperatingLeasePaymentsToBeReceivedMaturityTableTextBlock" id="ixv-30063"><ix:continuation continuedAt="_LesseeLeasesPolicyTextBlock-c0_cont_15" id="_LesseeLeasesPolicyTextBlock-c0_cont_14"><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify; text-indent: 0.5in">Lease payments receivable
for the following five years were as follows:</p></ix:continuation>

<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify; text-indent: 0.5in">&#160;</p>

<ix:continuation id="_LesseeLeasesPolicyTextBlock-c0_cont_15"><table cellpadding="0" style="font: 10pt Times New Roman, Times, Serif; border-collapse: collapse; width: 100%; border-spacing: 0px;">
  <tr style="vertical-align: bottom">
