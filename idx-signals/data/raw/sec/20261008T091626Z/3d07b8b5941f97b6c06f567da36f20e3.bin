    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c156" decimals="-3" format="ixt:num-dot-decimal" id="ix_44_fact" name="uk:EquitySecuritiesWithoutReadilyDeterminableFairValuesInvestments" scale="3" unitRef="cny">18,681</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c157" decimals="-3" format="ixt:num-dot-decimal" id="ix_45_fact" name="uk:EquitySecuritiesWithoutReadilyDeterminableFairValuesInvestments" scale="3" unitRef="cny">18,681</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
