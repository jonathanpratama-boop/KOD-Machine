    <td style="border-bottom: Black 1.5pt solid; text-align: right">(<ix:nonFraction contextRef="c235" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyTransactionGainLossRealizedAfterTax" scale="3" sign="-" unitRef="usd" id="ixv-39692">4</ix:nonFraction></td>
    <td style="padding-bottom: 1.5pt; text-align: left">)</td></tr>
