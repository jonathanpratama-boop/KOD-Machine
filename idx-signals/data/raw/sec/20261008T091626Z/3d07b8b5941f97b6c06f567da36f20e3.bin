    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c9" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:CostOfRevenue" scale="3" unitRef="cny" id="ixv-39523">79,013</ix:nonFraction></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; padding-bottom: 2.5pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c0" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:CostOfRevenue" scale="3" unitRef="cny" id="ixv-39524">26,866</ix:nonFraction></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left">&#160;</td></tr>
