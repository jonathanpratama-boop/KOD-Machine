<ix:nonNumeric contextRef="d_2026-01-01_2026-06-30" name="us-gaap:ComprehensiveIncomeNoteTextBlock" id="c1272" escape="true">
<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"><b>10 </b>&#8211;<b> Accumulated Other Comprehensive Income (Loss)</b></p>

<p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;">&#160;</p>

