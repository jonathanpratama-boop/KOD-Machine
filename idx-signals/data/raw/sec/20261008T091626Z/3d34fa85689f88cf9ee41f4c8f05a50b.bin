    <div style="break-before: page; margin-top: 6pt; margin-bottom: 6pt"><p id="xdx_230_z0sVYb7N8YU" style="margin: 0pt">&#160;</p></div>
    <!-- Field: /Page --></ix:exclude>

<ix:exclude><p id="xdx_237_zlfOKyWcG424" style="font: 10pt Times New Roman, Times, Serif; margin: 0; text-align: center"><span style="background-color: white"></span></p></ix:exclude>

<ix:exclude><p id="xdx_23B_zUrLqtdaUkV9" style="font: 10pt Times New Roman, Times, Serif; margin: 0; text-align: center">&#160;</p></ix:exclude>

<ix:exclude><p id="xdx_23C_zCDJ8PpiZnUk" style="font: 10pt Times New Roman, Times, Serif; margin-top: 0; margin-bottom: 0; text-align: center"><span style="background-color: white"><b>INFOBIRD CO.,
