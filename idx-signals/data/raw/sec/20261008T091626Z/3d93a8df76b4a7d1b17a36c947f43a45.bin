  <ix:nonNumeric contextRef="d_2023-04-01_2023-06-30" name="us-gaap:PropertyPlantAndEquipmentDisclosureTextBlock" id="c2447373" escape="true">
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;"><b>Note <em style="font: inherit;">5.</em>&#xa0; Property and Equipment, Net</b></p>
