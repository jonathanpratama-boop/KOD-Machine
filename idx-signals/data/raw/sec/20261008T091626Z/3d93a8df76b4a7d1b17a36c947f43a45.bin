    </div>
   </ix:exclude>
   <ix:exclude>&#xa0;</ix:exclude>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"><b><i>Warrants Outstanding</i></b></p>
   <p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;">&#xa0;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">The following table summarizes warrants outstanding and exercisable as of <em style="font: inherit;"> June 30, 2023. </em>All outstanding warrants are currently exercisable and the weighted average exercise price of such warrants at <em style="font: inherit;"> June 30, 2023 </em>is $<ix:nonFraction id="c101608542" contextRef="d_2023-04-01_2023-06-30_ClassOfWarrantOrRightAxis-The2019EmployeeStockPurchasePlanMember" unitRef="USDPerShare" name="vtgn:ClassOfWarrantOrRightWeightedAverageExercisePrice" scale="0" format="ixt:numdotdecimal" decimals="INF">16.87</ix:nonFraction> per share.</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#xa0;</p>
   <ix:nonNumeric contextRef="d_2023-04-01_2023-06-30" name="us-gaap:ScheduleOfStockholdersEquityNoteWarrantsOrRightsTextBlock" id="c2447413" escape="true">
