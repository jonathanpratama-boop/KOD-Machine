</ix:continuation>
        <ix:continuation id="Text_0fe898d9b91646558838ee59d0ee74af2" continuedAt="Text_0fe898d9b91646558838ee59d0ee74af3">
<div style="display:none;"><br /></div>
<div style="text-align: justify; text-indent: 18pt; color: #000000; font-family: 'Times New Roman'; font-size: 10pt;">The principal financial liabilities of the Company consist of cash overdraft.</div>
</ix:continuation>
        <ix:continuation id="Text_0fe898d9b91646558838ee59d0ee74af3" continuedAt="Text_0fe898d9b91646558838ee59d0ee74af4">
