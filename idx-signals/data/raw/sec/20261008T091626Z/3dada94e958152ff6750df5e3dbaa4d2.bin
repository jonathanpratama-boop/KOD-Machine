    <td valign="bottom" style="vertical-align: bottom; width: 76%; background-color: rgb(204, 238, 255);">
                  <div style="color: rgb(0, 0, 0); text-indent: -9pt; margin-left: 9pt;">Management fees &#8211; Pavimar (b)</div>
