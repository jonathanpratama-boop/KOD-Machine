                  <div style="color: #000000;"><ix:nonFraction name="us-gaap:LongTermDebtMaturitiesRepaymentsOfPrincipalInYearTwo" id="Fact_eff0383514ab4a67a5c53341b2bd421e" contextRef="c20221231" unitRef="U002" decimals="0" scale="0" format="ixt:num-dot-decimal">2,700,000</ix:nonFraction></div>
