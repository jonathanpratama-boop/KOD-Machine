        </div>

      </div>

    </div>


  </div>
<div style="font-family: 'Times New Roman'; font-size: 10pt; text-align: left; color: #000000;">

    <div>
      <div>
        <div>
          <ix:nonNumeric name="us-gaap:RelatedPartyTransactionsDisclosureTextBlock" id="Text_be188dd684b1413e8961ba400c2d890a" contextRef="c20220101to20221231" escape="true" continuedAt="Text_7fdc4f1ee8034bcebbe2baeaf3fc124c1">
<div>
            <table cellspacing="0" cellpadding="0" style="font-family: 'Times New Roman'; font-size: 10pt; width: 100%; text-align: left; color: #000000;" class="DSPFListTable">


  <tr>

    <td style="width: 18pt; vertical-align: top; color: #000000; font-weight: bold;">3.</td>

    <td style="width: auto; vertical-align: top;">
                    <div style="color: #000000; font-weight: bold;">Transactions with Related Parties:</div>
                  </td>

  </tr>


</table>
            <div style="font-family: 'Times New Roman'; font-size: 10pt;"> <br />
            </div>

          </div>
</ix:nonNumeric>

          <ix:nonNumeric name="us-gaap:ScheduleOfRelatedPartyTransactionsTableTextBlock" id="Text_bd45a0a1e61f45ba86bd26c8d709a918" contextRef="c20220101to20221231" escape="true" continuedAt="Text_a5313996fd734356a8862c8d253a81a71"><ix:continuation id="Text_7fdc4f1ee8034bcebbe2baeaf3fc124c1" continuedAt="Text_7fdc4f1ee8034bcebbe2baeaf3fc124c2">
<div style="display:none;"><br /></div>
<div style="text-align: justify; text-indent: 20pt; color: #000000; font-family: 'Times New Roman'; font-size: 10pt;">During the period ended December 31, 2021, and the year ended December 31, 2022, the Company incurred the following charges in
            connection with related party transactions, which are included in the accompanying combined carve-out financial statements:</div>
</ix:continuation></ix:nonNumeric>
          <ix:continuation id="Text_a5313996fd734356a8862c8d253a81a71" continuedAt="Text_a5313996fd734356a8862c8d253a81a72"><ix:continuation id="Text_7fdc4f1ee8034bcebbe2baeaf3fc124c2" continuedAt="Text_7fdc4f1ee8034bcebbe2baeaf3fc124c3">
<div style="font-family: 'Times New Roman'; font-size: 10pt;"><br />
          </div>
</ix:continuation></ix:continuation>
          <ix:continuation id="Text_a5313996fd734356a8862c8d253a81a72" continuedAt="Text_a5313996fd734356a8862c8d253a81a73"><ix:continuation id="Text_7fdc4f1ee8034bcebbe2baeaf3fc124c3" continuedAt="Text_7fdc4f1ee8034bcebbe2baeaf3fc124c4">
