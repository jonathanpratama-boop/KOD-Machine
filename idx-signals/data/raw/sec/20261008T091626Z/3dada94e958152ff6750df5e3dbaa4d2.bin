                  <div style="color: #000000; font-weight: bold;"><ix:nonFraction name="us-gaap:DebtInstrumentCarryingAmount" id="Fact_dbc4c911b831479a85385387ab44278b" contextRef="c20221231" unitRef="U002" decimals="0" scale="0" format="ixt:num-dot-decimal">13,250,000</ix:nonFraction></div>
                </td>

    <td valign="bottom" style="vertical-align: bottom; width: 1%; white-space: nowrap;" colspan="1">&#160;</td>

