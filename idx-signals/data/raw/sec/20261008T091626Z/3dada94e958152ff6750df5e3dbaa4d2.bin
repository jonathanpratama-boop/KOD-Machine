    <td style="width: 3.7%; vertical-align: top;">
                  <div style="color: #000000; font-size: 8pt;">(1)</div>
                </td>

    <td style="width: 96.3%; vertical-align: top;">
                  <div style="text-align: justify; color: rgb(0, 0, 0); font-size: 10pt;">On May 9, 2022, the Company entered into an agreement with an unaffiliated third party for the sale of the <span style="font-style: italic;">M/T Wonder Arcturus</span>
                    for a gross sale price of $<ix:nonFraction name="toro:PropertyPlantAndEquipmentSalesPrice" id="Fact_d6f5725935034669adbd7ccdc92556a8" contextRef="c20220509_PropertyPlantAndEquipmentByTypeAxis_WonderArcturusMember" unitRef="U002" decimals="-4" scale="6" format="ixt:num-dot-decimal">13.15</ix:nonFraction> million. The vessel was delivered to its new owners on July 15, 2022. For further
                    information, see Note 5 to these&#160;&#160; combined financial statements.</div>
                  <div style="text-align: justify; color: rgb(0, 0, 0); font-size: 10pt;"> <br />
                  </div>
                </td>

  </tr>


</table>
</ix:continuation></ix:continuation>

