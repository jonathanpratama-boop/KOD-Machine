    <td style="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif; width: 14%; text-align: right"><span id="xdx_905_eifrs-full--ProportionOfOwnershipInterestInAssociate_pid_dp_uPure_c20230101__20231231__ifrs-full--SignificantInvestmentsInAssociatesAxis__custom--YahalomaTechnologiesIncMember_ztdeDfRHah8"><ix:nonFraction name="ifrs-full:ProportionOfOwnershipInterestInAssociate" contextRef="From2023-01-012023-12-31_custom_YahalomaTechnologiesIncMember12510437" id="Fact001145" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">50</ix:nonFraction></span></td><td style="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">%</td></tr>
