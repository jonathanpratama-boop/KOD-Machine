    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td id="xdx_984_ecustom--NumberOfSharesIssuedAndOutstanding_iI_pid_c20241231__ifrs-full--ClassesOfShareCapitalAxis__custom--DeferredSharesMember_zhSt2kqQf1F7" title="Number of shares issued and outstanding" style="font: 10pt Times New Roman, Times, Serif; text-align: right"><ix:nonFraction name="SMX:NumberOfSharesIssuedAndOutstanding" contextRef="AsOf2024-12-31_custom_DeferredSharesMember" id="Fact001931" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">25,000</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif">&#160;</td>
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td id="xdx_980_eifrs-full--NumberOfSharesAuthorised_iI_pid_c20231231__ifrs-full--ClassesOfShareCapitalAxis__custom--DeferredSharesMember_zX0ANKbB47qa" title="Number of shares authorized" style="font: 10pt Times New Roman, Times, Serif; text-align: right"><ix:nonFraction name="ifrs-full:NumberOfSharesAuthorised" contextRef="AsOf2023-12-31_custom_DeferredSharesMember" id="Fact001933" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">25,000</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif">&#160;</td>
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td id="xdx_98A_ecustom--NumberOfSharesIssuedAndOutstanding_iI_pid_c20231231__ifrs-full--ClassesOfShareCapitalAxis__custom--DeferredSharesMember_zu9R3dmH0eY4" title="Number of shares issued and outstanding" style="font: 10pt Times New Roman, Times, Serif; text-align: right"><ix:nonFraction name="SMX:NumberOfSharesIssuedAndOutstanding" contextRef="AsOf2023-12-31_custom_DeferredSharesMember" id="Fact001935" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">25,000</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td></tr>
