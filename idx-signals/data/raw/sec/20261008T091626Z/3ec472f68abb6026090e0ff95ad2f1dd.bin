    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 22%; text-align: center">552,370</td><td style="width: 1%; text-align: center">&#160;</td><td style="text-align: center; width: 1%">&#160;</td>
    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 22%; text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">5,091</span></td><td style="width: 1%; text-align: center">&#160;</td><td style="text-align: center; width: 1%">&#160;</td>
    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 22%; text-align: center">&#8212;</td><td style="width: 1%; text-align: center">&#160;</td></tr>
