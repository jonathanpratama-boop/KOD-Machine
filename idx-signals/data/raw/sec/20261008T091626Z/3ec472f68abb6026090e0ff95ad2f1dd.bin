  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 23%; text-align: center">611,576</td><td style="width: 1%; text-align: center">&#160;</td><td style="text-align: center; width: 1%">&#160;</td>
    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 22%; text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">175,457</span></td><td style="width: 1%; text-align: center">&#160;</td><td style="text-align: center; width: 1%">&#160;</td>
    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 22%; text-align: center">4,979</td><td style="width: 1%; text-align: center">&#160;</td><td style="text-align: center; width: 1%">&#160;</td>
    <td style="width: 1%; text-align: center">&#160;</td><td style="width: 22%; text-align: center">792,012</td><td style="width: 1%; text-align: center">&#160;</td></tr>
