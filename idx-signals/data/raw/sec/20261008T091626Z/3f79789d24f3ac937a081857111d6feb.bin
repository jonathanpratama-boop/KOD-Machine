ount" scale="3" id="Tc_rFPEThsggU68l4mDHKDHZw_8_2">132,348</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.68%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:8.1%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="As_Of_12_31_2025_YbCFQ_bWu02uoN-a8GX8kw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:EquitySecuritiesWithoutReadilyDeterminableFairValueAmount" scale="3" id="Tc_Sd9aVqu2O0aR9FNIdfCjRA_8_4">103,401</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.68%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.5%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_LY5SbL077UuXzIvTBWGN_g" contextRef="As_Of_12_31_2025_YbCFQ_bWu02uoN-a8GX8kw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:EquitySecuritiesWithoutReadilyDeterminableFairValueAmount" scale="3" id="Tc_LDUnD1hQaUe6V547Q2BUug_8_6">14,786</ix:nonFraction></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt;">Before 2020, the Group made several equity investments in private companies, over which the Group has neither significant influence over operating and financial policies nor control through its investments. The Group is also not entitled to redemption rights to request investees to early redeem its equity interests at the Group&#8217;s sole discretion. The Group elected a measurement alternative to account for these equity investments.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:2pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-33</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">TUNIU CORPORATION</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">NOTES&#160;TO THE CONSOLIDATED FINANCIAL STATEMENTS</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;text-indent:0pt;margin:0pt;"><b style="font-weight:bold;">(All amounts in thousands, except for share and per share data, or otherwise noted)</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_sa1E8SbPAE6Cp18y_-zFjg_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">6. Long-term investments - continued</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Equity investments included investments in HNA Trust with the carrying value of RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="As_Of_12_31_2024_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_tour_HnaTrustMember_T-hNB2-C80uB0gz_SGxvUQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:EquityMethodInvestments" scale="3" id="Narr__XPtbC4OdUioelttgbZ1xA">12,895</ix:nonFraction> and RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="As_Of_12_31_2025_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_tour_HnaTrustMember_9E5uxAOv0EOnxN1isPQeJQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:EquityMethodInvestments" scale="3" id="Narr_fJfnKHrarE-JdUIahm_CeQ">12,543</ix:nonFraction> as of December 31, 2024 and 2025, respectively. As disclosed in Note 22(a), in May 2022, the Group received and registered <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="Duration_5_1_2022_To_5_31_2022_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_tour_HnaTrustMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_rcZzAe_lMEqFKCyIAWs_rA" decimals="INF" format="ixt:num-dot-decimal" name="tour:NumberOfUnitsReceivedAndRegisteredForSettlementOfDebts" scale="0" id="Narr_H9l21kgi-kO2URMoSHxrWQ">632,992,650</ix:nonFraction> trust units, representing <ix:nonFraction unitRef="Unit_Standard_pure_HWvhQR0-ukSb-U3gHiU3bg" contextRef="Duration_5_1_2022_To_5_31_2022_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_tour_HnaTrustMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_rcZzAe_lMEqFKCyIAWs_rA" decimals="4" format="ixt:num-dot-decimal" name="tour:PercentageOfUnitsReceivedForSettlementOfDebts" scale="-2" id="Narr_zZYeuX5s2E6pklzSJt6ZZA">0.09</ix:nonFraction>% of total unit interests, as the settlement of the remaining HNA debts. Upon the receipts of trust units with the legal title by the Group, the Group recognized an initial investment with the amount of RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_5_1_2022_To_5_31_2022_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_tour_HnaTrustMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_rcZzAe_lMEqFKCyIAWs_rA" decimals="-3" format="ixt:num-dot-decimal" name="tour:InitialInvestmentOnReceiptOfUnits" scale="3" id="Narr_4N8vbcRZQkeu_kv0OsVRiw">13,318</ix:nonFraction>. As an ordinary unit holder, the Group is entitled to receive distribution of trust income based on the income distribution plan of HNA trust. The Group has no redemption rights to request HNA Trust to early redeem its trusts units at the Group&#8217;s sole discretion and HNA trust is a privately owned and the trust units are not traded publicly. As a result, the Group accounted for such investment in trust units as equity investment without readily determinable fair values and elected to apply the measurement alternatives for this investment. During the years ended December 31, 2023, 2024 and 2025, the Group received cash of RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2023_To_12_31_2023_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_tour_HnaTrustMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_hZ5d0LxbokWn-82rLHI_yA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromDividendsReceived" scale="3" id="Narr_3-lIYTD5HUaU4-_Yl9tb3Q">212</ix:nonFraction>, RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2024_To_12_31_2024_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_tour_HnaTrustMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_8HJbgSe960iPVEiHVHvWQg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromDividendsReceived" scale="3" id="Narr_vVu84q-ke0yWUhlvK7S0yA">211</ix:nonFraction> and RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2025_To_12_31_2025_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_tour_HnaTrustMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_jjNwAAFAHUOy9LPuLk_qqA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromDividendsReceived" scale="3" id="Narr_Ewdij3Ff60GUtxNilbFGww">352</ix:nonFraction> from HNA Trust, respectively, with the equivalent trust units deregistered according to the trust agreement and the corresponding investment was derecoginsed accordingly.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">No remeasurement was made for the years ended December 31, 2023, 2024 and 2025 as no observable transactions for these equity investees were noticed, other than impairment disclosed below.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">During the year ended December 31, 2023, 2024 and 2025, the Group recognized impairment losses of RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2023_To_12_31_2023_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_tour_HnaTrustMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_hZ5d0LxbokWn-82rLHI_yA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:EquitySecuritiesWithoutReadilyDeterminableFairValueUpwardPriceAdjustmentAnnualAmount" scale="3" id="Narr_AtwXv0vMDECH6-8TGyy-7w">22,240</ix:nonFraction>, RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2024_To_12_31_2024_Ireyc2Gaz0e4DWbZMpQykA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:EquitySecuritiesWithoutReadilyDeterminableFairValueImpairmentLossAnnualAmount" scale="3" id="Narr_akY8cj-SKk-AAoblwFMG3Q">17,553</ix:nonFraction> and RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:EquitySecuritiesWithoutReadilyDeterminableFairValueImpairmentLossAnnualAmount" scale="3" id="Narr_i_IK5OCXGkqiWy4zIjex6A">13,595</ix:nonFraction> on certain equity investments based on the Group&#8217;s assessment of current economic and market conditions with the considerations of the operating performance of the investees, respectively. The key parameters used in the assessment of certain investment are trailing P/S and discount for lack of marketability. The impairment was recorded in interest and investment income, net.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;margin:0pt 0pt 10pt 18pt;">Held-to-maturity investments</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt;">The Group made investments in time deposits that the Group has intention and ability to hold until maturity. The Group classified these investments as held-to-maturity investments. As of December 31, 2024 and 2025, the carrying value of these investments amounted to RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="As_Of_12_31_2024_CWohO9wAdUu5cU9w_28Hzg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:HeldToMaturitySecurities" scale="3" id="Narr_CpAh1ji_RUeRt56DAvqKbw">343,300</ix:nonFraction> and RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="As_Of_12_31_2025_YbCFQ_bWu02uoN-a8GX8kw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:HeldToMaturitySecurities" scale="3" id="Narr_6sO_D_cJpESavaTtadjkdA">67,904</ix:nonFraction>, respectively.</p></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><a id="Tc_OvrqQEcmQk-0FVMECkoYcA_1_2"></a><a id="Tc_RYcAVfeI8kOR8iaKhIAuqw_2_2"></a><a id="Tc__8XFkeF-wUmFNid8vIK8TQ_2_4"></a><a id="Tc_p6veXqmxCEad5uXCf6KRwQ_3_2"></a><a id="Tc_uYrbLfxWF0qhqdwKirQHrQ_3_4"></a><a id="Tc_sjg-ZDc0EkufZL6Zyj_GbQ_3_6"></a><a id="Tc_z2k38O7o9U6jGWqYjvr6Jg_4_0"></a><a id="Tc_3fZ7uZTLMU6N8aiSPvfRGQ_5_0"></a><a id="Tc_ZPk_YUUQYk-wDjDmI8q8bQ_6_0"></a><a id="Tc_5oSwsOreO0WC0C81ukkAUg_7_0"></a><a id="Tc_j4zSlr0ooUKIzzw1jhHdGg_8_0"></a><a id="Tc_D1bLBe7s20qb3LhIKucG_A_9_0"></a><a id="Tc_zKRm-_lKQkCqpLiTDDMKqg_10_0"></a><a id="Tc_5dKAXCQKKEq8IKOiTklZQA_11_0"></a><a id="Tc_JjAMUkfMTkSdeLI403zw1A_12_0"></a><a id="Tc_CiMbLxEH2UmjVGAsE_boiw_13_0"></a><a id="Tc_S0TkntZ5DEa7M81nlNrnLg_14_0"></a><a id="Tc_30e7I02XvUyD0LWfVB_yWw_14_6"></a><a id="Tc_tQ9WCvTD7keCTCCNSPx9qw_15_0"></a><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" name="us-gaap:PropertyPlantAndEquipmentDisclosureTextBlock" id="Tb_H60EzoLhaE2werX2e-w-oA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">7. Property and equipment, net</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The following is a summary of property and equipment, net:</p><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" name="us-gaap:PropertyPlantAndEquipmentTextBlock" id="Tb_7QedI2rA20CreKJLNQ4nqA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:64.89%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:9.59%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:9.59%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2.01%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div