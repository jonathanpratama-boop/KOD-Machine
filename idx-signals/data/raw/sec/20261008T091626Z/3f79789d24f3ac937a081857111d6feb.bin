ion unitRef="Unit_Standard_USD_LY5SbL077UuXzIvTBWGN_g" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxReconciliationChangeInDeferredTaxAssetsValuationAllowance" scale="3" id="Tc_azgX4T2BxECWDxyZIb3HyQ_16_4">693</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.05%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.6%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 0pt 0.05pt 0pt;"> (<ix:nonFraction unitRef="Unit_Standard_pure_HWvhQR0-ukSb-U3gHiU3bg" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="3" format="ixt:num-dot-decimal" name="us-gaap:EffectiveIncomeTaxRateReconciliationChangeInDeferredTaxAssetsValuationAllowance" sign="-" scale="-2" id="Tc_3YGsdwkkBkuh8c9EqHfgzg_16_6">15.9</ix:nonFraction>)</p></td></tr><tr style=""><td style="vertical-align:bottom;width:64.95%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="-sec-ix-hidden:Hidden_v8kmJokTjke2RGZqaDIQ5g;"><b style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:bold;">Income tax expense</b></span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.05%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.63%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxExpenseBenefit" scale="3" id="Tc_05D8HzPHJUq2pPJYfLafSw_17_2">1,425</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.05%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.63%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_LY5SbL077UuXzIvTBWGN_g" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxExpenseBenefit" scale="3" id="Tc_VqCYqViYBU2MIbEOCeMjWg_17_4">204</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.05%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.6%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 0pt 0.05pt 0pt;"> (<ix:nonFraction unitRef="Unit_Standard_pure_HWvhQR0-ukSb-U3gHiU3bg" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="3" format="ixt:num-dot-decimal" name="us-gaap:EffectiveIncomeTaxRateContinuingOperations" sign="-" scale="-2" id="Tc_tVgtMeWkIkqKWKkwHGVb9w_17_6">4.7</ix:nonFraction>)</p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The PRC statutory tax rate of <ix:nonFraction unitRef="Unit_Standard_pure_HWvhQR0-ukSb-U3gHiU3bg" contextRef="Duration_1_1_2023_To_12_31_2023_MKzBP10bE0a4L6zTSkr1mQ" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:EffectiveIncomeTaxRateReconciliationAtFederalStatutoryIncomeTaxRate" scale="-2" id="Narr_dSvm-GdN8kOIWF-SDjoMHQ"><ix:nonFraction unitRef="Unit_Standard_pure_HWvhQR0-ukSb-U3gHiU3bg" contextRef="Duration_1_1_2024_To_12_31_2024_Ireyc2Gaz0e4DWbZMpQykA" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:EffectiveIncomeTaxRateReconciliationAtFederalStatutoryIncomeTaxRate" scale="-2" id="Narr_hRcBlY_0vkSELZ-MLEx5iA"><ix:nonFraction unitRef="Unit_Standard_pure_HWvhQR0-ukSb-U3gHiU3bg" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:EffectiveIncomeTaxRateReconciliationAtFederalStatutoryIncomeTaxRate" scale="-2" id="Narr_d1f3E9bFIkufTLxoy8431A">25</ix:nonFraction></ix:nonFraction></ix:nonFraction>% is used for the effective tax rate reconciliation as substantially all of the Group&#8217;s operations are based in the PRC for the years ended December 31, 2023, 2024 and 2025.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The entities with preferential income tax were still in cumulative losses position with full allowance provided for deferred tax assets, and therefore, the income tax and per-share effects of the preferential income tax were <ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2023_To_12_31_2023_MKzBP10bE0a4L6zTSkr1mQ" decimals="-3" format="ixt-sec:numwordsen" name="tour:PreferentialTaxRateIncomeTaxExpenseBenefit" scale="3" id="Narr_-qppYY-pkk6MKtHV_H5RLA"><ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2024_To_12_31_2024_Ireyc2Gaz0e4DWbZMpQykA" decimals="-3" format="ixt-sec:numwordsen" name="tour:PreferentialTaxRateIncomeTaxExpenseBenefit" scale="3" id="Narr_kURORED5Q0aKteXSr9wH-w"><ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="-3" format="ixt-sec:numwordsen" name="tour:PreferentialTaxRateIncomeTaxExpenseBenefit" scale="3" id="Narr_mlheAoXlEUCGeW22b2mv7g">nil</ix:nonFraction></ix:nonFraction></ix:nonFraction> for the years ended December 31, 2023, 2024 and 2025. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">For the year ended December 31, 2025, income taxes paid amounted to RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxesPaidNet" scale="3" id="Narr_Br68Fs7ei0SPXjJO6J6x6A">1,394</ix:nonFraction> (US$<ix:nonFraction unitRef="Unit_Standard_USD_LY5SbL077UuXzIvTBWGN_g" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxesPaidNet" scale="3" id="Narr_8cGTO8rYbUSrghPPWJJLhA">199</ix:nonFraction>) in mainland China.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><i style="font-style:italic;">Uncertain Tax Position</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Group did not identify any significant unrecognized tax benefits for each of the periods presented. The Group did <ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2023_To_12_31_2023_MKzBP10bE0a4L6zTSkr1mQ" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:UnrecognizedTaxBenefitsInterestOnIncomeTaxesExpense" scale="3" id="Narr_039dOg6Ng0iEksMDWbvbWw"><ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2024_To_12_31_2024_Ireyc2Gaz0e4DWbZMpQykA" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:UnrecognizedTaxBenefitsInterestOnIncomeTaxesExpense" scale="3" id="Narr_1AT1p53qOUGXTvpw4ACh8g"><ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:UnrecognizedTaxBenefitsInterestOnIncomeTaxesExpense" scale="3" id="Narr_RkFrJDJzd0qnJgIHIO86ZQ">no</ix:nonFraction></ix:nonFraction></ix:nonFraction>t incur any interest related to unrecognized tax benefits and did <ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2023_To_12_31_2023_MKzBP10bE0a4L6zTSkr1mQ" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:UnrecognizedTaxBenefitsIncomeTaxPenaltiesExpense" scale="3" id="Narr_L4iODcP-gkesOeINmyhrtA"><ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2024_To_12_31_2024_Ireyc2Gaz0e4DWbZMpQykA" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:UnrecognizedTaxBenefitsIncomeTaxPenaltiesExpense" scale="3" id="Narr_REAIVg_QcEOAk4mgKN719A"><ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:UnrecognizedTaxBenefitsIncomeTaxPenaltiesExpense" scale="3" id="Narr_6IElvYU-WU6sXhEMeEJq-g">no</ix:nonFraction></ix:nonFraction></ix:nonFraction>t recognize any penalties as income tax expense.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-40</p></div></div>
