rWkkVMZykmdxJfyIa4Z_Q" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_hEeVDvwiEESpOsWadcCxQw">120,000,000</ix:nonFraction></ix:nonFraction> Class B Ordinary Shares, each at a par value of US$<ix:nonFraction unitRef="Unit_Divide_USD_shares_5ND9gXxKaEyB5sPrV5YXrA" contextRef="As_Of_12_31_2024_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassBMember_DjUPypRxxUiDRNy1nGnWbQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockParOrStatedValuePerShare" scale="0" id="Narr_X-PwTxPoq02DdZSHDL5auA"><ix:nonFraction unitRef="Unit_Divide_USD_shares_5ND9gXxKaEyB5sPrV5YXrA" contextRef="As_Of_12_31_2025_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassBMember_frWkkVMZykmdxJfyIa4Z_Q" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockParOrStatedValuePerShare" scale="0" id="Narr_L3Omc792skGao052zcqu4A">0.0001</ix:nonFraction></ix:nonFraction> per share, and <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2024_CWohO9wAdUu5cU9w_28Hzg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ExcessStockSharesAuthorized" scale="0" id="Narr_1pGDiiey8kertj32Kj-PSg"><ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2025_YbCFQ_bWu02uoN-a8GX8kw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ExcessStockSharesAuthorized" scale="0" id="Narr_jzMzKt0NkUGfW7tNWc0cyQ">100,000,000</ix:nonFraction></ix:nonFraction> shares of a par value of US$<ix:nonFraction unitRef="Unit_Divide_USD_shares_5ND9gXxKaEyB5sPrV5YXrA" contextRef="As_Of_12_31_2024_CWohO9wAdUu5cU9w_28Hzg" decimals="INF" format="ixt:num-dot-decimal" name="tour:ExcessCommonStockParOrStatedValuePerShare" scale="0" id="Narr_E10bgYdwK0uNe-4tEQkDcA"><ix:nonFraction unitRef="Unit_Divide_USD_shares_5ND9gXxKaEyB5sPrV5YXrA" contextRef="As_Of_12_31_2025_YbCFQ_bWu02uoN-a8GX8kw" decimals="INF" format="ixt:num-dot-decimal" name="tour:ExcessCommonStockParOrStatedValuePerShare" scale="0" id="Narr_61cojr-Gt0iESnr8UlOu6g">0.0001</ix:nonFraction></ix:nonFraction> each of such class or classes as the board of directors may determine.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt;">As of December 31, 2025, <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2025_YbCFQ_bWu02uoN-a8GX8kw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_CEBqIK4nyUiiN2nHg1g3nQ">1,000,000,000</ix:nonFraction> ordinary shares were authorized. <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2025_YbCFQ_bWu02uoN-a8GX8kw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesIssued" scale="0" id="Narr_pkC_pHO27UW5YNhIq17pdQ">345,326,342</ix:nonFraction> ordinary shares were issued, comprising of <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2025_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassAMember_GrC6Em2vPEO7oV-iy3Wr2Q" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesIssued" scale="0" id="Narr_G-9nyAe56USB68kqR9JADA">327,952,842</ix:nonFraction> Class A shares and <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2025_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassBMember_frWkkVMZykmdxJfyIa4Z_Q" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesIssued" scale="0" id="Narr_55Ff-WOEf0GpEtLRSw7bMQ">17,373,500</ix:nonFraction> Class B shares as of December 31, 2025. <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2025_YbCFQ_bWu02uoN-a8GX8kw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesOutstanding" scale="0" id="Narr_j2IXslmJIEq4fVo8sC09cg">327,628,481</ix:nonFraction> ordinary shares were outstanding, comprising of <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2025_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassAMember_GrC6Em2vPEO7oV-iy3Wr2Q" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesOutstanding" scale="0" id="Narr_b-yiBtjFKUyfMh2y4A9Eeg">310,254,981</ix:nonFraction> Class A shares and <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2025_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassBMember_frWkkVMZykmdxJfyIa4Z_Q" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesOutstanding" scale="0" id="Narr_puVys81ef0Go3kwsLJzSVg">17,373,500</ix:nonFraction> Class B shares as of December 31, 2025.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-42</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">TUNIU CORPORATION</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">NOTES&#160;TO THE CONSOLIDATED FINANCIAL STATEMENTS</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;text-indent:0pt;margin:0pt;"><b style="font-weight:bold;">(All amounts in thousands, except for share and per share data, or otherwise noted)</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc_J_L1UdEUKkiJMmU14_slrQ_1_2"></a><a id="Tc_JIGDCoCGHUOHNqtl_1ksvQ_2_2"></a><a id="Tc_nLfg1R_rQECiw69E3MGlMQ_2_4"></a><a id="Tc_NYg9hVGvT0SUNhGoduKsmQ_2_6"></a><a id="Tc_aIoF8m5enUKaJn2G1sNKlQ_3_2"></a><a id="Tc_9PoGz5zMqUq5A0Y5GqKimA_3_4"></a><a id="Tc_NEel2VYdcUe0L9TrtE9Irg_3_6"></a><a id="Tc_zQNoIHZbYkKJJxHTTf_Lkw_3_8"></a><a id="Tc_PKlz7U-fo0S5uLtfajL8_w_4_0"></a><a id="Tc_OkDIifNKRkS0kLUgz5HS_g_5_0"></a><a id="Tc_1EBV4orip0-S0tKDpQVK-A_6_0"></a><a id="Tc_DL9h_cCobUGRtKu0iZr2og_7_0"></a><a id="Tc_xWUkmQns5E6GyPhE7_zgnw_8_0"></a><a id="Tc_E2bvEM25VUuT-sMKcQqcQA_1_4"></a><a id="Tc_p8GXpC9iSUio95gYxw_UjA_1_6"></a><a id="Tc_XYdKnqu-P0SOmipfNALv8g_2_4"></a><a id="Tc_NcYCmZLg0EC_lRfuxXA_Yw_2_6"></a><a id="Tc_ZSW5le0KgUW-uxV-tywSZw_2_8"></a><a id="Tc_uZrlPXRcjESbo9D9GwybOg_3_2"></a><a id="Tc_dZDPbVNV5k6WLbaUYuzYUA_3_4"></a><a id="Tc_2_EJy8Hy6EKqu3Gdy7DqPQ_3_6"></a><a id="Tc_9tnF6PU800a9pm8vdIzP1g_3_8"></a><a id="Tc__mcanNw9lEGB-Vo9NIDGBg_4_2"></a><a id="Tc_KEL6-9mn9UiipvrmZBDBuQ_4_4"></a><a id="Tc_h4NqpLQVFUWh3QtIB53TiQ_4_6"></a><a id="Tc_7sydvdo_kUS31pj2H4G58g_4_8"></a><a id="Tc_RLKTEScL70ygTlnnqMnybg_5_4"></a><a id="Tc_17Q-u2ST5EWmNFIUlvaZgA_5_6"></a><a id="Tc_KJwzerUZo0OPy9is2r1sCQ_5_8"></a><a id="Tc_Rv_fyx0pBkSFvn6Z0kBqxQ_6_0"></a><a id="Tc_Uq7MYKytDEWNpWQoJDSHXQ_7_0"></a><a id="Tc_QoDqQOdyiEO7tiTDnyUliA_7_4"></a><a id="Tc_q51CsT_0ek-n63KeLglwuA_7_6"></a><a id="Tc_tVx4yKH9_0GqFC9nCiUSgw_7_8"></a><a id="Tc_RbhILcAUVEOK8zPquonm6w_8_0"></a><a id="Tc_NbeD-_pko0e5RjMhwKpdtw_8_4"></a><a id="Tc_sKUJ4yjHqkuY_fF9W1LhvA_8_6"></a><a id="Tc_dbkprQI9d0Cev0rUD6sitw_8_8"></a><a id="Tc_L94JCmKOEEephPIBvJLjpA_9_0"></a><a id="Tc_mkQE864fLkWZxTgtVFZqug_10_0"></a><a id="Tc_0UZOzyJ-EUqiuCIHCXiq9A_11_0"></a><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" name="us-gaap:DisclosureOfCompensationRelatedCostsShareBasedPaymentsTextBlock" id="Tb_Ih-0XVVyLkesO2yGbL5guw" continuedAt="Tb_Ih-0XVVyLkesO2yGbL5guw_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">17. Share-based Compensation Expenses</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Company&#8217;s 2008 Incentive Compensation Plan (the &#8220;2008 Plan&#8221;) allows the plan administrator to grant share options and restricted shares to the Company&#8217;s employees, directors, and consultants, up to a maximum of <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="Duration_12_1_2012_To_12_31_2012_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2008Member_Ft7Iwuqq6Um_ePz49KP9UQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfAdditionalSharesAuthorized" scale="0" id="Narr_fiN2xB0_oEO-880EdpQiLQ">18,375,140</ix:nonFraction> ordinary shares. In April&#160;2014 the Company adopted the 2014 Share Incentive Plan (the &#8220;2014 Plan&#8221;). The maximum aggregate number of shares will be increased automatically if and whenever the ordinary shares reserved under the 2014 Plan account for less than <ix:nonFraction unitRef="Unit_Standard_pure_HWvhQR0-ukSb-U3gHiU3bg" contextRef="Duration_4_1_2014_To_4_30_2014_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2014Member_akshP0WcVkO4q_ul0enJlQ" decimals="2" format="ixt:num-dot-decimal" name="tour:ThresholdPercentOfOrdinarySharesReservedToTotalOutstandingSharesThenAutomaticallyIncreasedNumberOfSharesReservedForFutureIssuances" scale="-2" id="Narr_nvU5tC6h5Uubt2a1etbnCw">1</ix:nonFraction>% of the total then-issued and outstanding ordinary shares on an as-converted basis, as a result of which increase the ordinary shares reserved under the 2014 Plan immediately after each such increase shall equal <ix:nonFraction unitRef="Unit_Standard_pure_HWvhQR0-ukSb-U3gHiU3bg" contextRef="Duration_4_1_2014_To_4_30_2014_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2014Member_akshP0WcVkO4q_ul0enJlQ" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardPercentageOfOutstandingStockMaximum" scale="-2" id="Narr_humrpRjNqkKx8Mxfoe-ohQ">5</ix:nonFraction>% of the then-issued and outstanding ordinary shares on an as-converted basis, reaching a total of <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_4_30_2014_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2014Member_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassAMember_OZmbLfA_K02pyZQpzSaMhA" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAuthorized" scale="0" id="Narr_Evg_Y1YHFEmXfPTIU-H_6g">41,964,263</ix:nonFraction> Class A ordinary shares. The maximum aggregate number of shares which may be issued under the 2014 Plan increased automatically by an aggregate of <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="Duration_4_1_2023_To_4_30_2023_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2014Member_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassAMember_qddynijgLUezNFXsp0By9Q" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfAdditionalSharesAuthorized" scale="0" id="Narr_JYanNMJNukqMnq8hJt8sAQ">17,542,440</ix:nonFraction> Class A ordinary shares in April 2023, reaching to a total of <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_4_30_2023_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2014Member_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassAMember_IEeTngIN9UO_IT2HR1W8SA" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAuthorized" scale="0" id="Narr_jOQa9aY_7UyefPCVCwkorQ">59,506,703</ix:nonFraction> Class A ordinary shares.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The share options and restricted shares granted under the 2008 plan initially have a contractual term of <span style="-sec-ix-hidden:Hidden_0Uhv4qGLIk-hjDXJl3FmKw;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">six</span></span> or <ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_srt_RangeAxis_srt_MaximumMember_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2008Member_vgeN660qIUW_MI0U5xt4Ww" format="ixt-sec:durwordsen" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardExpirationPeriod" id="Narr_QmHsejVP60aFovrhHitkLA">ten years</ix:nonNumeric>, and grants under the 2014 plan have a contractual term of <ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2014Member_1-1YkVP2506k0HsFsVuTTQ" format="ixt-sec:durwordsen" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardExpirationPeriod" id="Narr_JWd-tpxle0K8C3jMzBWPvA">ten years</ix:nonNumeric>. The incentive awards under both 2008 plan and 2014 plan generally vest over a period of <ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2008And2014Member_4R1kSv10m029y90vsz-_-w" format="ixt-sec:durwordsen" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1" id="Narr_BAqMhNbXLkCWnXHd1WVFpg">four years</ix:nonNumeric> of continuous service, <span style="-sec-ix-hidden:Hidden_CryybXSQ00qQhaeV-LrGcw;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">one</span></span> fourth (1/4) of which vest upon the first anniversary of the stated vesting commencement date and the remaining vest ratably over the following <ix:nonFraction unitRef="Unit_Standard_M_Rlfj96li7kKtB7CNDRCCLw" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2008And2014Member_4R1kSv10m029y90vsz-_-w" decimals="INF" format="ixt:num-dot-decimal" name="tour:SharebasedCompensationArrangementBySharebasedPaymentAwardNumberOfEqualMonthlyInstallments" scale="0" id="Narr_LbIz7V2bmkqTGBNTnAVOYg">36</ix:nonFraction>&#160;months. As of December 31, 2025, <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2025_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2008And2014Member_Z-fVPo1TKEGryli-OuCsVw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsOutstandingNumber" scale="0" id="Narr_1bH2orFeKUqG3BedN_TR_w">34,728,763</ix:nonFraction> options and <ix:nonFraction unitRef="Unit_Standard_shares_aEx_wvfvxEWJi6J1VcvYRQ" contextRef="As_Of_12_31_2025_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockMember_us-gaap_PlanNameAxis_tour_IncentiveCompensationPlan2008And2014Member_KLEuhTzB1USYIZtcJXc5Gg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsNonvestedNumber" scale="0" id="Narr_uPb7FBCtaECnSsjY64U5yg">18,879</ix:nonFraction> restricted shares were outstanding under the 2008 and 2014 plan.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Group recognized share-based compensation expense of RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2023_To_12_31_2023_MKzBP10bE0a4L6zTSkr1mQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Narr_llqsdeeheUe6U-ZGIigQOw">15,926</ix:nonFraction>, RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2024_To_12_31_2024_Ireyc2Gaz0e4DWbZMpQykA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Narr_co--zsPw2EGz92TdIigjHw">9,406</ix:nonFraction> and RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Narr_R-LquKIIP0OjJ52ZjP8OSw">5,605</ix:nonFraction> for the years ended December 31, 2023, 2024 and 2025, respectively, which was classified as follows:</p><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_WIfOC0S8e0maSoeEnRWSQw" name="us-gaap:ScheduleOfEmployeeServiceShareBasedCompensationAllocationOfRecognizedPeriodCostsTextBlock" id="Tb_PYPDMrHMJk6JAvw7gxy7Nw" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:57.98%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:1.68%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:8.46%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:1.68%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></d