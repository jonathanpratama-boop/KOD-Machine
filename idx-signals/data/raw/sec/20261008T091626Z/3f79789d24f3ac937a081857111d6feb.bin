t-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_DisposalGroupClassificationAxis_us-gaap_DisposalGroupDisposedOfBySaleNotDiscontinuedOperationsMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_tour_DisposalOfCertainSubsidiariesEngagedInJapanTourBusinessMember_I4ctsC1gtUim4kYKkiVbMA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DiscontinuedOperationGainLossFromDisposalOfDiscontinuedOperationBeforeIncomeTax" scale="3" id="Tc_UbHtGFwTYU6W_NjjwqXYwg_7_2">24,118</ix:nonFraction></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt;">As a result of above disposals, the Group recognized a disposal gain of <ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2023_To_12_31_2023_us-gaap_DisposalGroupClassificationAxis_us-gaap_DisposalGroupDisposedOfBySaleNotDiscontinuedOperationsMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_tour_DisposalOfCertainSubsidiariesEngagedInJapanTourBusinessMember_TUo2kKBRs0qj-6QA1FTZng" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:DiscontinuedOperationGainLossFromDisposalOfDiscontinuedOperationBeforeIncomeTax" scale="3" id="Narr_cr9ysfqKQEuqKoDB3f2BUw">nil</ix:nonFraction>, RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_DisposalGroupClassificationAxis_us-gaap_DisposalGroupDisposedOfBySaleNotDiscontinuedOperationsMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_tour_DisposalOfCertainSubsidiariesEngagedInJapanTourBusinessMember_I4ctsC1gtUim4kYKkiVbMA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DiscontinuedOperationGainLossFromDisposalOfDiscontinuedOperationBeforeIncomeTax" scale="3" id="Narr_udFmhLFn3UagByjWgCsc_Q">24,118</ix:nonFraction> and <ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DisposalGroupClassificationAxis_us-gaap_DisposalGroupDisposedOfBySaleNotDiscontinuedOperationsMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_tour_DisposalOfCertainSubsidiariesEngagedInJapanTourBusinessMember_AXP-2pAmXky9J12gtbu9Lw" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:DiscontinuedOperationGainLossFromDisposalOfDiscontinuedOperationBeforeIncomeTax" scale="3" id="Narr_zHuPUHXoDE68GEuiv5CU7A">nil</ix:nonFraction> for the years ended December 31, 2023, 2024 and 2025, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-31</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">TUNIU CORPORATION</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">NOTES&#160;TO THE CONSOLIDATED FINANCIAL STATEMENTS</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;text-indent:0pt;margin:0pt;"><b style="font-weight:bold;">(All amounts in thousands, except for share and per share data, or otherwise noted)</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_Iu_LXgSVLE-fb82RP2agtg_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">4. Business acquisition &#8211; continued</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;"><span style="font-style:italic;font-weight:bold;">Disposal of travel agencies &#8211; continued</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">During the years of December 31, 2023, 2024 and 2025, out of the disposal considerations, the Group received proceeds of RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2023_To_12_31_2023_us-gaap_DisposalGroupClassificationAxis_us-gaap_DisposalGroupDisposedOfBySaleNotDiscontinuedOperationsMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_tour_DisposalOfTravelAgenciesMember_wJSTkUU-QEelQ8OzNtMvTg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromDivestitureOfInterestInConsolidatedSubsidiaries" scale="3" id="Narr_FCkTblSGZ0qghkFK5bB4Ww">3,243</ix:nonFraction>, RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_DisposalGroupClassificationAxis_us-gaap_DisposalGroupDisposedOfBySaleNotDiscontinuedOperationsMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_tour_DisposalOfTravelAgenciesMember_WLJnIRBkg0eFBL3QZo9mlA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromDivestitureOfInterestInConsolidatedSubsidiaries" scale="3" id="Narr_mRcVCg9q9kibNbQcjFjvYw">5,475</ix:nonFraction> and RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DisposalGroupClassificationAxis_us-gaap_DisposalGroupDisposedOfBySaleNotDiscontinuedOperationsMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_tour_DisposalOfTravelAgenciesMember_oWQYcXk6hUmyko3oXe3meQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromDivestitureOfInterestInConsolidatedSubsidiaries" scale="3" id="Narr_MIOKzD29ZE6OpkpwOwATIg">1,016</ix:nonFraction>, respectively. As of December 31, 2025, the unpaid disposal considerations were RMB<ix:nonFraction unitRef="Unit_Standard_CNY_KLlvWlT6dE2YYlR3I7zG2A" contextRef="As_Of_12_31_2025_us-gaap_DisposalGroupClassificationAxis_us-gaap_DisposalGroupDisposedOfBySaleNotDiscontinuedOperationsMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_tour_DisposalOfTravelAgenciesMember_XulCRjjACE--6WTVjGyMsg" decimals="-3" format="ixt:num-dot-decimal" name="tour:ConsiderationReceivableForDiscontinuedOperation" scale="3" id="Narr_mixXPitiUUydn8xYvn4EbQ">12,107</ix:nonFraction> which are expected to receive in<ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DisposalGroupClassificationAxis_us-gaap_DisposalGroupDisposedOfBySaleNotDiscontinuedOperationsMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_tour_DisposalOfTravelAgenciesMember_oWQYcXk6hUmyko3oXe3meQ" format="ixt-sec:durwordsen" name="tour:ThresholdPeriodForConsiderationReceivableDiscontinuedOperations" id="Narr_UoZV-oPid02smyMLJd3D4w"> 4 years</ix:nonNumeric>. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The business size of disposed former subsidiaries were not material to the Group and the Group continues to operate its travel agency business, hence the disposals were not considered as a strategic shift for the Group&#8217;s business operations nor discontinued operations. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Refer to Note 6 for accounting for the retained noncontrolling investments in these former subsidiaries disposed in 2022.</p></ix:continuation><a id="_ecc9e0b3_d492_4925_899d_3d9aee7fff46"></a><a id="Tc_7A8RpNzZBUGX7Rc0bylgpA_1_2"></a><a id="Tc_HIGgExiHtUOUhj0MsQKzHQ_2_2"></a><a id="Tc_1vFoIJ44CkCNSWb6h0IcMg_2_4"></a><a id="Tc_SNiMhXIr_EujXI5WsYYA0w_3_2"></a><a id="Tc_JApd2w3O_kqy5qQaoa6_8g_3_4"></a><a id="Tc_P7bpzlkbUEmhsvatti6S8Q_3_6"></a><a id="Tc_vO5Xl0qI4UqXvwjbCegyCQ_4_0"></a><a id="Tc_40lM7DIjVUebS-2_3aQQlA_5_0"><