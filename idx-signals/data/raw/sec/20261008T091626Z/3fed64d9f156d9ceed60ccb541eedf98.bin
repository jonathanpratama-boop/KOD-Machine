    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction name="CDIO:DebtDiscountRelatedToDerivativeLiability" contextRef="From2022-01-012022-09-30" format="ixt:zerodash" decimals="0" scale="0" unitRef="USD">&#8212;</ix:nonFraction>&#160;&#160;</td><td style="text-align: left">&#160;</td></tr>
