    <TD STYLE="padding: 0pt; text-align: justify; text-indent: 0pt"><FONT STYLE="font-size: 10pt">the registered office of the Company for the time being;</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
    <TD>&nbsp;</TD>
    <TD STYLE="padding: 0pt; text-align: justify; font-weight: bold; text-indent: 0pt">&nbsp;</TD>
    <TD STYLE="padding: 0pt; text-align: justify; text-indent: 0pt">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD>&nbsp;</TD>
    <TD STYLE="padding: 0pt; text-align: justify; font-weight: bold; text-indent: 0pt"><FONT STYLE="font-size: 10pt">Officer</FONT></TD>
    <TD STYLE="padding: 0pt; text-align: justify; text-indent: 0pt"><FONT STYLE="font-size: 10pt">any person appointed by the Board to hold an office in the Company;</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
    <TD>&nbsp;</TD>
    <TD STYLE="padding: 0pt; text-align: justify; font-weight: bold; text-indent: 0pt">&nbsp;</TD>
    <TD STYLE="padding: 0pt; text-align: justify; text-indent: 0pt">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD>&nbsp;</TD>
