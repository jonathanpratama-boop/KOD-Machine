    <td style="width: 23%; text-align: center">1,747,523</td><td style="width: 2%">&#160;</td>
    <td style="width: 24%; text-align: center">111,200</td><td style="width: 2%">&#160;</td>
    <td style="width: 24%; text-align: center">9,282,448</td></tr>
