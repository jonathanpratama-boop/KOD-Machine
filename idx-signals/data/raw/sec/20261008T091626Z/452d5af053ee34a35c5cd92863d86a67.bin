    <td style="width: 23%; text-align: center">1,253,674</td><td style="width: 2%">&#160;</td>
    <td style="width: 24%; text-align: center">67,835</td><td style="width: 2%">&#160;</td>
    <td style="width: 24%; text-align: center">-</td></tr>
