<TABLE STYLE="BORDER-COLLAPSE:COLLAPSE; font-family:Times New Roman; font-size:10pt" BORDER="0" CELLPADDING="0" CELLSPACING="0" WIDTH="100%">
<TR VALIGN="TOP">
<TD WIDTH="38%"> <P STYLE=" margin-top:0pt; margin-bottom:1pt; margin-left:2%; text-indent:-2%; font-size:10pt; font-family:Times New Roman"><B>&#147;Secretary&#148; </B></P></TD>
<TD>means any Person appointed by the Directors to perform any of the duties of the secretary of the Company; </TD></TR></TABLE> <P STYLE="font-size:12pt;margin-top:0pt;margin-bottom:0pt">&nbsp;</P>
