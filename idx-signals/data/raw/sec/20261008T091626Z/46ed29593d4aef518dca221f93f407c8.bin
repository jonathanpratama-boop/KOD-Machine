              <td style="padding:3pt 0pt 20.06pt 0pt; width:162pt;">
                <div style="white-space:nowrap;">
                  <font style="letter-spacing:0.2pt;">The Maiden bye-laws provide that the </font>
                </div>
              </td>
              <td style="padding:0pt; width:6pt;">&#8203;</td>
              <td style="padding:0pt; width:6pt;">&#8203;</td>
              <td style="padding:3pt 0pt 20.06pt 0pt; width:162pt;">
                <font style="letter-spacing:0.2pt;">The Bermuda NewCo bye-laws </font>
              </td>
              <td style="padding:0pt; width:0pt;">&#8203;</td>
