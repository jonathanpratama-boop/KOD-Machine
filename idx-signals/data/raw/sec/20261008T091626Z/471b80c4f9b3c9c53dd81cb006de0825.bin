</ix:nonNumeric><ix:nonNumeric contextRef="From2022-01-01to2022-12-31" escape="true" name="us-gaap:CashAndCashEquivalentsPolicyTextBlock"><p id="xdx_849_eus-gaap--CashAndCashEquivalentsPolicyTextBlock_zcjKIjUMtgk8" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p>

<table cellspacing="0" cellpadding="0" style="font: 10pt Times New Roman, Times, Serif; width: 100%; border-collapse: collapse">
