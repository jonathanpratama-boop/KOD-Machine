    <td style="font-family: Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font-family: Times New Roman, Times, Serif; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><span id="xdx_908_eus-gaap--ForeignCurrencyExchangeRateTranslation1_iI_pid_dp_uPure_c20211231_zVRxfgYef9og" title="Increase (decrease) of the Official exchange rate of NIS 1 to US dollar during the year"><ix:nonFraction name="us-gaap:ForeignCurrencyExchangeRateTranslation1" contextRef="AsOf2021-12-31" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">3.22</ix:nonFraction></span></span></td><td style="font-family: Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">%</span></td></tr>
