    <td style="font-family: Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font-family: Times New Roman, Times, Serif; text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_904_ecustom--PropertyPlantAndEquipmentDepreciationRate_pid_dp_c20220101__20221231__us-gaap--PropertyPlantAndEquipmentByTypeAxis__custom--FurnitureAndOfficeEquipmentMember__srt--RangeAxis__srt--MinimumMember_zRU5mrMCN6O9" title="Property plant and equipment depreciation rate"><ix:nonFraction name="IGAP:PropertyPlantAndEquipmentDepreciationRate" contextRef="From2022-01-012022-12-31_custom_FurnitureAndOfficeEquipmentMember_srt_MinimumMember" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">7</ix:nonFraction></span>-<span id="xdx_905_ecustom--PropertyPlantAndEquipmentDepreciationRate_pid_dp_c20220101__20221231__us-gaap--PropertyPlantAndEquipmentByTypeAxis__custom--FurnitureAndOfficeEquipmentMember__srt--RangeAxis__srt--MaximumMember_zEqvPgLnwR9c" title="Property plant and equipment depreciation rate"><ix:nonFraction name="IGAP:PropertyPlantAndEquipmentDepreciationRate" contextRef="From2022-01-012022-12-31_custom_FurnitureAndOfficeEquipmentMember_srt_MaximumMember" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">15</ix:nonFraction></span></span></td><td style="font-family: Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
