			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:center;margin:0pt;"><b>Memberships</b></p>
			</td>
		</tr>
		<tr>
			<td style="vertical-align:middle;width:6.8%;">&nbsp;</td>
