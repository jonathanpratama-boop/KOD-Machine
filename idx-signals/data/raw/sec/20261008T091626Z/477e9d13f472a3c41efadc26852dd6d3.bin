  <tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_909_edei--Security12bTitle_c20260916__20260916_zq6SmcToDD3a"><ix:nonNumeric contextRef="AsOf2026-09-16" id="Fact000026" name="dei:Security12bTitle">Common
    Stock</ix:nonNumeric></span> </span></td>
