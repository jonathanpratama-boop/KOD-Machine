om: 3pt;">&#8203;</td><td colspan="4" style="width: 95.65%; text-align: left; vertical-align: bottom; padding-bottom: 3pt;"><div class="fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 10pt; margin-top: 0pt; margin-left: 0pt; text-align: left;">No fee required. </div></td></tr><tr><td style="width: 2.17%; text-align: left; vertical-align: top; padding-top: 3pt; padding-bottom: 3pt;"><div class="fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 1pt; margin-top: 0pt; margin-left: 0pt; text-align: left;">&#8201;<font style="font-size: 10pt;">&#x2610;</font></div></td><td class="gutter" style="width: 1.09%; border-bottom: none; font-size: 2pt; padding-top: 3pt; padding-bottom: 3pt;">&#8203;</td><td class="gutter" style="width: 1.09%; border-bottom: none; font-size: 2pt; padding-top: 3pt; padding-bottom: 3pt;">&#8203;</td><td style="width: 93.48%; text-align: left; vertical-align: bottom; padding-top: 3pt; padding-bottom: 3pt;"><div class="fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 10pt; margin-top: 0pt; margin-left: 0pt; text-align: left;">Fee paid previously with preliminary materials. </div></td><td class="gutter" style="width: 1.09%; border-bottom: none; font-size: 2pt; padding-top: 3pt; padding-bottom: 3pt;">&#8203;</td></tr><tr><td style="width: 2.17%; text-align: left; vertical-align: top; padding-top: 3pt;"><div class="fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 1pt; margin-top: 0pt; margin-left: 0pt; text-align: left;">&#8201;<font style="font-size: 10pt;">&#x2610;</font><font style="font-size: 10pt;"> </font></div></td><td class="gutter" style="width: 1.09%; border-bottom: none; font-size: 2pt; padding-top: 3pt;">&#8203;</td><td class="gutter" style="width: 1.09%; border-bottom: none; font-size: 2pt; padding-top: 3pt;">&#8203;</td><td style="width: 93.48%; text-align: left; vertical-align: bottom; padding-top: 3pt;"><div class="fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 10pt; margin-top: 0pt; margin-left: 0pt; text-align: left;">Fee computed on table in exhibit required by Item&#160;25(b) per Exchange Act Rules 14a-6(i)(1) and 0-11.</div></td><td class="gutter" style="width: 1.09%; border-bottom: none; font-size: 2pt; padding-top: 3pt;">&#8203;</td></tr></table></div></div><div class="block-frill" style="width: 540pt; margin-top: 12pt; margin-left: 0pt;"><div><div class="rule-full" style="height: 0pt; width: 100%; border-bottom: 1pt solid #000000; margin-top: 1pt; margin-bottom: 1pt; margin-left: auto; margin-right: auto;"> </div><div class="rule-full" style="height: 0pt; width: 100%; border-bottom: 2pt solid #000000; margin-bottom: 1pt; margin-left: auto; margin-right: auto; margin-top: 4pt;"> </div></div></div></div>
