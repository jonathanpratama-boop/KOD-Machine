  <tr id="xdx_403_eus-gaap--DebtInstrumentCarryingAmount_iI_hus-gaap--VestingAxis__us-gaap--ShareBasedCompensationAwardTrancheOneMember_maSDCzvUr_z3rbswpHfned" style="vertical-align: bottom; background-color: rgb(204,238,255)">
