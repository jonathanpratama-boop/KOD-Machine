    <td style="border-bottom: Black 1.5pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; text-align: right"><ix:nonFraction name="us-gaap:ShortTermLeaseCost" contextRef="From2023-01-012023-06-30" id="Fact001788" format="ixt:numdotdecimal" decimals="0" unitRef="USD">3,479</ix:nonFraction></td><td style="padding-bottom: 1.5pt; text-align: left">&#160;</td></tr>
  <tr id="xdx_401_eus-gaap--LeaseCost_iT_mtLCzMxP_zcXk458Ftjk1" style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left; padding-bottom: 2.5pt">Total lease expenses</td><td style="padding-bottom: 2.5pt">&#160;</td>
