  <tr style="vertical-align: bottom">
    <td style="text-align: center">&#160;</td><td style="text-align: center; padding-bottom: 1.5pt">&#160;</td>
    <td colspan="2" id="xdx_495_20240101__20240630_zgJ2tYCmvRn3" style="border-bottom: Black 1.5pt solid; text-align: center"><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt; text-align: center; text-indent: 0pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>Six months ended</b></span></p> <p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt; text-align: center; text-indent: 0pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>June 30, 2024</b></span></p></td><td style="text-align: center; padding-bottom: 1.5pt">&#160;</td><td style="text-align: center; padding-bottom: 1.5pt">&#160;</td>
    <td colspan="2" id="xdx_49A_20230101__20230630_zw6kZJdA8Jo3" style="border-bottom: Black 1.5pt solid; text-align: center"><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt; text-align: center; text-indent: 0pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>Six months ended</b></span></p> <p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt; text-align: center; text-indent: 0pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>June 30, 2023</b></span></p></td><td style="text-align: center; padding-bottom: 1.5pt">&#160;</td></tr>
