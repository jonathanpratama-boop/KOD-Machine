    <td style="border-bottom: Black 2.5pt double; text-align: left">$</td><td style="border-bottom: Black 2.5pt double; text-align: right"><ix:nonFraction name="us-gaap:LeaseCost" contextRef="From2023-01-012023-06-30" id="Fact001791" format="ixt:numdotdecimal" decimals="0" unitRef="USD">149,274</ix:nonFraction></td><td style="padding-bottom: 2.5pt; text-align: left">&#160;</td></tr>
  </table>

</ix:nonNumeric><p id="xdx_8A6_zFcWggYHPXzb" style="font: 10pt Times New Roman, Times, Serif; text-indent: 0pt; margin: 0pt; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p>

<p style="font: 10pt Times New Roman, Times, Serif; text-indent: 0pt; margin: 0pt; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">On March 31, 2024, the Company terminated its short-term office lease.</span></p>

<p style="font: 10pt Times New Roman, Times, Serif; text-indent: 0pt; margin: 0pt; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p>

</ix:nonNumeric><ix:nonNumeric contextRef="From2024-01-01to2024-06-30" escape="true" id="Fact001793" name="us-gaap:CommitmentsAndContingenciesDisclosureTextBlock"><p id="xdx_80B_eus-gaap--CommitmentsAndContingenciesDisclosureTextBlock_z64o4dzl0Av6" style="font: 10pt Times New Roman, Times, Serif; text-indent: 0pt; margin: 0pt; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>15.
<span id="xdx_823_zyXSA7JFPlG5">COMMITMENTS AND CONTINGENCIES</span></b></span></p>

<p style="font: 10pt Times New Roman, Times, Serif; text-indent: 0pt; margin: 0pt; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p>

<p style="font: 10pt Times New Roman, Times, Serif; text-indent: 0pt; margin: 0pt; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b><i>Debenture
principal repayments</i></b></span></p>

<p style="font: 10pt Times New Roman, Times, Serif; text-indent: 0pt; margin: 0pt; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p>

