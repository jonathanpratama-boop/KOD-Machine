    <td style="border-bottom: Black 2.5pt double; text-align: left">$</td><td style="border-bottom: Black 2.5pt double; text-align: right"><ix:nonFraction name="SHPH:CommonStockIssuedForSettlementOfDebt" contextRef="From2023-01-012023-09-30" id="Fact000680" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">2,697,849</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
