    <td colspan="2" style="border-bottom: Black 1pt solid; text-align: center">September 30, 2024</td><td style="padding-bottom: 1pt">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left">Annualized volatility</td><td>&#160;</td>
