<tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
<td style="font: 10pt Times New Roman, Times, Serif; width: 0.25in"/><td style="font: 10pt Times New Roman, Times, Serif; width: 0.25in"><b>&#9679;</b></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: justify">Note 6 &#8211; Convertible Notes (now labeled Notes Payable)</td></tr>
<tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
<td style="font: 10pt Times New Roman, Times, Serif; width: 0.25in"/><td style="font: 10pt Times New Roman, Times, Serif; width: 0.25in"><b>&#9679;</b></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: justify">Note 7 &#8211; Stockholders&#8217; Equity</td></tr>
<tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
<td style="font: 10pt Times New Roman, Times, Serif; width: 0.25in"/><td style="font: 10pt Times New Roman, Times, Serif; width: 0.25in"><b>&#9679;</b></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: justify">Note 8 &#8211; Derivative Liabilities</td></tr>
<tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
<td style="font: 10pt Times New Roman, Times, Serif; width: 0.25in"/><td style="font: 10pt Times New Roman, Times, Serif; width: 0.25in"><b>&#9679;</b></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: justify">Note 10 &#8211; Income Taxes</td></tr></table>

<p style="font: 10pt Times New Roman, Times, Serif; margin-top: 0pt; margin-bottom: 0pt; text-align: justify">&#160;</p>

