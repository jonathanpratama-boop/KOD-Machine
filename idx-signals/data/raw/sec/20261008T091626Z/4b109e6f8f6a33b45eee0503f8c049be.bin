    <td colspan="2" id="xdx_491_20221231_zxvrrxMWcL77" style="font: bold 10pt Times New Roman, Times, Serif; text-align: center">December 31,</td><td style="font: bold 10pt Times New Roman, Times, Serif; text-align: center">&#160;</td></tr>
