    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td id="xdx_988_ecustom--DerivativeGainLossOnDerivativeWarrants_iN_di_c20240701__20240930__us-gaap--FairValueByFairValueHierarchyLevelAxis__us-gaap--FairValueInputsLevel3Member_zebAtBNeLTfa" title="Gain on change in fair value of the derivative" style="border-bottom: Black 1pt solid; text-align: right">(<ix:nonFraction name="SHPH:DerivativeGainLossOnDerivativeWarrants" contextRef="From2024-07-012024-09-30_us-gaap_FairValueInputsLevel3Member" id="Fact001399" format="ixt:numdotdecimal" decimals="0" unitRef="USD">285,812</ix:nonFraction></td><td style="text-align: left">)</td><td>&#160;</td>
    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td id="xdx_98B_ecustom--DerivativeGainLossOnDerivativeWarrants_iN_di_c20240701__20240930__srt--StatementScenarioAxis__custom--AcceleratedFeatureMember_zPBwdwrYuNpi" title="Gain on change in fair value of the derivative" style="border-bottom: Black 1pt solid; text-align: right">(<ix:nonFraction name="SHPH:DerivativeGainLossOnDerivativeWarrants" contextRef="From2024-07-012024-09-30_custom_AcceleratedFeatureMember" id="Fact001401" format="ixt:numdotdecimal" decimals="0" unitRef="USD">504</ix:nonFraction></td><td style="text-align: left">)</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td>Balance - September 30, 2024</td><td>&#160;</td>
    <td style="border-bottom: Black 1pt solid; text-align: left">$</td><td id="xdx_983_eus-gaap--FairValueMeasurementWithUnobservableInputsReconciliationsRecurringBasisLiabilityValue_iE_c20240701__20240930__us-gaap--FairValueByFairValueHierarchyLevelAxis__us-gaap--FairValueInputsLevel3Member_zVRSIXdU7ud2" title="Ending balance" style="border-bottom: Black 1pt solid; text-align: right"><ix:nonFraction name="us-gaap:FairValueMeasurementWithUnobservableInputsReconciliationsRecurringBasisLiabilityValue" contextRef="AsOf2024-09-30_us-gaap_FairValueInputsLevel3Member" id="Fact001403" format="ixt:numdotdecimal" decimals="0" unitRef="USD">74,107</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="border-bottom: Black 1pt solid; text-align: left">$</td><td id="xdx_987_eus-gaap--FairValueMeasurementWithUnobservableInputsReconciliationsRecurringBasisLiabilityValue_iE_c20240701__20240930__srt--StatementScenarioAxis__custom--AcceleratedFeatureMember_zjY9VHvFzmnf" title="Ending balance" style="border-bottom: Black 1pt solid; text-align: right"><span style="-sec-ix-hidden: xdx2ixbrl1405">-</span></td><td style="text-align: left">&#160;</td></tr>
