    <td style="border-bottom: Black 2.5pt double; text-align: left">$</td><td style="border-bottom: Black 2.5pt double; text-align: right"><ix:nonFraction name="SHPH:InitialRecognitionOfRightOfUseAssetAndLiability" contextRef="From2023-01-012023-09-30" id="Fact000690" format="ixt:numdotdecimal" decimals="0" unitRef="USD">365,556</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
