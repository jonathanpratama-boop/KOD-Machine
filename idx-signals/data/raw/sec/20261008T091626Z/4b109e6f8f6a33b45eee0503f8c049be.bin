    <td style="font: 10pt Times New Roman, Times, Serif; text-align: justify"><p style="font: 10pt Times New Roman, Times, Serif; margin-top: 0pt; margin-bottom: 0pt">A total of <span id="xdx_907_eus-gaap--ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights_iI_c20221231__us-gaap--DebtInstrumentAxis__custom--DecemberTwentyThousandTwentyOneNotesMember_zcDW6A0xy2Ql"><ix:nonFraction name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" contextRef="AsOf2022-12-31_custom_DecemberTwentyThousandTwentyOneNotesMember" id="Fact003149" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">66,250</ix:nonFraction></span>
