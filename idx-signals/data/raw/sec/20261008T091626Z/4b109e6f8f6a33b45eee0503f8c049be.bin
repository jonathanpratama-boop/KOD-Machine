  <tr style="vertical-align: bottom; background-color: White">
    <td style="text-align: left">Risk-free interest rate</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_900_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20240930__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputRiskFreeInterestRateMember__srt--RangeAxis__srt--MinimumMember__us-gaap--StatementEquityComponentsAxis__us-gaap--WarrantMember_fKg_____zA5amL5eBn93"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-09-30_us-gaap_MeasurementInputRiskFreeInterestRateMember_srt_MinimumMember_us-gaap_WarrantMember" id="Fact001363" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">3.64</ix:nonFraction></span>% - <span id="xdx_90A_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20240930__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputRiskFreeInterestRateMember__srt--RangeAxis__srt--MaximumMember__us-gaap--StatementEquityComponentsAxis__us-gaap--WarrantMember_fKg_____zUaAsl1Y4pv9"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-09-30_us-gaap_MeasurementInputRiskFreeInterestRateMember_srt_MaximumMember_us-gaap_WarrantMember" id="Fact001364" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">4.93</ix:nonFraction></span>%</span></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 78%; text-align: left">Quoted VWAP</td><td style="width: 2%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 18%; text-align: right"><span id="xdx_90A_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uUSDPShares_c20240930__us-gaap--MeasurementInputTypeAxis__custom--MeasurementInputVolumeWeightedAveragePriceMember__us-gaap--StatementEquityComponentsAxis__us-gaap--WarrantMember_fKg_____zukBnuwX2Mm1"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-09-30_custom_MeasurementInputVolumeWeightedAveragePriceMember_us-gaap_WarrantMember" id="Fact001365" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">1.31</ix:nonFraction></span></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td>Exercise price</td><td>&#160;</td>
    <td style="text-align: left">$</td><td style="text-align: right"><span id="xdx_90A_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uUSDPShares_c20240930__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputExercisePriceMember__us-gaap--StatementEquityComponentsAxis__us-gaap--WarrantMember_fKg_____zevczGKdDdS1"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-09-30_us-gaap_MeasurementInputExercisePriceMember_us-gaap_WarrantMember" id="Fact001366" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">1.93</ix:nonFraction></span></td><td style="text-align: left">&#160;</td></tr>
