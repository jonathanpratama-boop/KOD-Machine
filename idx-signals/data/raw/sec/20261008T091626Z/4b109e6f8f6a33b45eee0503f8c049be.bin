    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td id="xdx_988_ecustom--DerivativeGainLossOnDerivativeWarrants_iN_di_c20240401__20240630__srt--StatementScenarioAxis__custom--AcceleratedFeatureMember_zYfKSGduoC64" title="Gain on change in fair value of the derivative" style="border-bottom: Black 1pt solid; text-align: right">(<ix:nonFraction name="SHPH:DerivativeGainLossOnDerivativeWarrants" contextRef="From2024-04-012024-06-30_custom_AcceleratedFeatureMember" id="Fact001393" format="ixt:numdotdecimal" decimals="0" unitRef="USD">1,531</ix:nonFraction></td><td style="text-align: left">)</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td>Balance - June 30, 2024</td><td>&#160;</td>
    <td style="text-align: left">$</td><td id="xdx_988_eus-gaap--FairValueMeasurementWithUnobservableInputsReconciliationsRecurringBasisLiabilityValue_iS_c20240701__20240930__us-gaap--FairValueByFairValueHierarchyLevelAxis__us-gaap--FairValueInputsLevel3Member_z8U9Gm56oRZb" title="Beginning balance" style="text-align: right"><ix:nonFraction name="us-gaap:FairValueMeasurementWithUnobservableInputsReconciliationsRecurringBasisLiabilityValue" contextRef="AsOf2024-06-30_us-gaap_FairValueInputsLevel3Member" id="Fact001395" format="ixt:numdotdecimal" decimals="0" unitRef="USD">359,919</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">$</td><td id="xdx_987_eus-gaap--FairValueMeasurementWithUnobservableInputsReconciliationsRecurringBasisLiabilityValue_iS_c20240701__20240930__srt--StatementScenarioAxis__custom--AcceleratedFeatureMember_zLwKVcGlKMTi" title="Beginning balance" style="text-align: right"><ix:nonFraction name="us-gaap:FairValueMeasurementWithUnobservableInputsReconciliationsRecurringBasisLiabilityValue" contextRef="AsOf2024-06-30_custom_AcceleratedFeatureMember" id="Fact001397" format="ixt:numdotdecimal" decimals="0" unitRef="USD">504</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
