    <td style="text-align: left">&#160;</td><td style="text-align: right">&#160;</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">&#160;</td><td style="text-align: left">&#160;</td></tr>
  <tr id="xdx_407_eus-gaap--DerivativeAssetsCurrent_iI_hus-gaap--FairValueByAssetClassAxis__us-gaap--USTreasurySecuritiesMember_zj0gaAYf6Jhf" style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left; padding-bottom: 1pt">United States Treasury Bonds</td><td style="padding-bottom: 1pt">&#160;</td>
