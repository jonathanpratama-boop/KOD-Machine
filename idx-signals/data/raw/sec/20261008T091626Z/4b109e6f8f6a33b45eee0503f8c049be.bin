    <td style="border-bottom: Black 2.5pt double; text-align: left">$</td><td style="border-bottom: Black 2.5pt double; text-align: right"><span style="-sec-ix-hidden: xdx2ixbrl0682">-</span></td><td style="text-align: left">&#160;</td><td>&#160;</td>
