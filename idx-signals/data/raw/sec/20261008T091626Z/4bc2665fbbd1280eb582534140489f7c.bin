  <div class="page" style="flex-direction:column;overflow:hidden;display:flex;min-height:11in;"><div class="fixed-width-container" style="margin-left:auto;padding-left:0.3in;width:7.8999999999999995in;box-sizing:content-box;margin-right:auto;padding-right:0.3in;"><div class="absolute-block-container" style="margin-left:-0.3in;z-index:6;position:relative;"></div><div class="absolute-block-container" style="margin-left:-0.3in;z-index:4;position:relative;"></div><div class="absolute-block-container" style="margin-left:-0.3in;z-index:3;position:relative;"><div style="align-content:start;display:inline;padding-top:0in;transform:translate(0px, 0px) rotate(0.0deg);z-index:283118592;overflow:hidden;top:0.25in;left:0.9688in;padding-left:0in;width:5.0958in;padding-bottom:0in;position:absolute;padding-right:0in;height:0.7646in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:8pt;text-align:left;"><font style="color:#fff1e0;white-space:pre-wrap;font-weight:bold;font-size:20pt;font-family:Arial;font-kerning:none;min-width:fit-content;">Financial Results</font></p><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:8pt;text-align:left;"><font style="color:#fff1e0;white-space:pre-wrap;font-weight:bold;font-size:20pt;font-family:Arial;font-kerning:none;min-width:fit-content;">4</font><font style="color:#fff1e0;white-space:pre-wrap;font-weight:bold;vertical-align:super;font-size:13.4pt;font-family:Arial;font-kerning:none;min-width:fit-content;">th</font><font style="color:#fff1e0;white-space:pre-wrap;font-weight:bold;font-size:20pt;font-family:Arial;font-kerning:none;min-width:fit-content;"> Quarter and Full Year 2025</font></p></div><div style="align-content:start;display:inline;padding-top:0in;transform:translate(0px, 0px) rotate(0.0deg);z-index:278924288;overflow:hidden;top:0;left:0.5in;padding-left:0in;width:8.0438in;padding-bottom:0in;position:absolute;padding-right:0in;height:1.7854in;"><p style="font-size:10pt;margi