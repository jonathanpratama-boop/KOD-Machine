            <td style="padding:0pt; min-width:3pt; text-align:right; ">$</td>
            <td style="padding:0pt; min-width:18.75pt; text-align:right; white-space:nowrap;">&#8212;</td>
            <td style="padding:0pt;padding-left:5.63pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
