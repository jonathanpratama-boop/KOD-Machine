              <td style="padding:2.75pt 0pt 2pt 0pt;border-bottom:3pt double #000000; min-width:3.75pt; text-align:right; ">$</td>
              <td style="padding:2.75pt 0pt 2pt 0pt;border-bottom:3pt double #000000; min-width:24pt; text-align:right; white-space:nowrap;">69,000 </td>
              <td style="padding:0pt;padding-left:6.8pt;width:0pt;">&#8203;</td>
