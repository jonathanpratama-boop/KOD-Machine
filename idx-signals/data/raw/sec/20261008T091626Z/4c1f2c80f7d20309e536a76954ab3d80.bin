            <td style="padding:0pt; width:351.82pt;text-align:left;">
              <div style="white-space:nowrap;">
                <font style="letter-spacing:0.16pt;">Common shares issued for Visualix asset acquisition </font>
              </div>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
