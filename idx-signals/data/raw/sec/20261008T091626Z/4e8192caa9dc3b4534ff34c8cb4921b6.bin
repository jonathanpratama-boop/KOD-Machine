    <TD STYLE="border-bottom: Black 2.5pt double; font-weight: bold; text-align: left">&#160;</TD><TD STYLE="border-bottom: Black 2.5pt double; font-weight: bold; text-align: right">(351</TD><TD STYLE="padding-bottom: 2.5pt; font-weight: bold; text-align: left">)%</TD><TD STYLE="padding-bottom: 2.5pt; font-weight: bold">&#160;</TD>
    <TD STYLE="border-bottom: Black 2.5pt double; font-weight: bold; text-align: left">$</TD><TD STYLE="border-bottom: Black 2.5pt double; font-weight: bold; text-align: right">(650,979</TD><TD STYLE="padding-bottom: 2.5pt; font-weight: bold; text-align: left">)</TD><TD STYLE="padding-bottom: 2.5pt; font-weight: bold">&#160;</TD>
    <TD STYLE="border-bottom: Black 2.5pt double; font-weight: bold; text-align: left">&#160;</TD><TD STYLE="border-bottom: Black 2.5pt double; font-weight: bold; text-align: right">215</TD><TD STYLE="padding-bottom: 2.5pt; font-weight: bold; text-align: left">%</TD></TR>
