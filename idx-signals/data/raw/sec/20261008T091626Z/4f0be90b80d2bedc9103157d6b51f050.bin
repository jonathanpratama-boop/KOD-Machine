ily:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:83%"><ix:nonFraction unitRef="usd" contextRef="i191d43cefb9b479d93755a06dff56474_D20190527-20220529" decimals="-3" name="us-gaap:RestructuringCosts" format="ixt:num-dot-decimal" scale="3" id="f-2014">1,343</ix:nonFraction>&#160;</span></td><td style="background-color:#ffffff;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"></td></tr><tr><td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:top"><div><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:83%">Lease costs</span></div></td><td colspan="3" style="display:none"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:83%"><ix:nonFraction unitRef="usd" contextRef="ic52839acd04d4568bcba688c5adf2345_D20190527-20220529" decimals="-3" name="us-gaap:RestructuringCosts" format="ixt:num-dot-decimal" scale="3" id="f-2015">2,218</ix:nonFraction>&#160;</span></td><td style="background-color:#cceeff;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:83%"><ix:nonFraction unitRef="usd" contextRef="ic2f27d12ff9c470bb02e0ada428e56a5_D20190527-20220529" decimals="-3" name="us-gaap:RestructuringCosts" scale="3" id="f-2016">26</ix:nonFraction>&#160;</span></td><td style="background-color:#cceeff;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:83%"><ix:nonFraction unitRef="usd" contextRef="ia5cf03df99034f3490b857e92b366a36_D20190527-20220529" decimals="-3" name="us-gaap:RestructuringCosts" format="ixt:num-dot-decimal" scale="3" id="f-2017">2,244</ix:nonFraction>&#160;</span></td><td style="background-color:#cceeff;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"></td></tr><tr><td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:left;vertical-align:top"><div><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:83%">Other restructuring costs</span></div></td><td colspan="3" style="display:none"></td><td colspan="3" style="background-color:#ffffff;padding:0 1pt"></td><td colspan="2" style="background-color:#ffffff;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:83%"><ix:nonFraction unitRef="usd" contextRef="ibde98d439168440d9f9ac16c48f7dfd2_D20190527-20220529" decimals="-3" name="us-gaap:RestructuringCosts" scale="3" id="f-2018">323</ix:nonFraction>&#160;</span></td><td style="background-color:#ffffff;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"></td><td colspan="3" style="background-color:#ffffff;padding:0 1pt"></td><td colspan="2" style="background-color:#ffffff;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:83%"><ix:nonFraction unitRef="usd" contextRef="i5b3f42c82bd245548384d60f4224f2c5_D20190527-20220529" decimals="-3" name="us-gaap:RestructuringCosts" format="ixt:num-dot-decimal" scale="3" id="f-2019">4,898</ix:nonFraction>&#160;</span></td><