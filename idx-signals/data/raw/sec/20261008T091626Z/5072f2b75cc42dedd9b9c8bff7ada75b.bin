    <TD STYLE="font-size: 10pt; text-align: left">&nbsp;</TD><TD STYLE="font-size: 10pt; text-align: right">5.52</TD><TD STYLE="font-size: 10pt; text-align: left">%</TD><TD STYLE="font-size: 10pt">&nbsp;</TD>
