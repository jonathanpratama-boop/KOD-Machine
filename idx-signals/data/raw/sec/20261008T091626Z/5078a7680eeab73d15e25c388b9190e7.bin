<TD VALIGN="top"> <P STYLE=" margin-top:0pt ; margin-bottom:0pt; margin-left:1.00em; text-indent:-1.00em; font-size:10pt; font-family:Times New Roman">Gross proceeds</P></TD>
<TD VALIGN="bottom">&nbsp;&nbsp;</TD>
<TD NOWRAP VALIGN="bottom">$</TD>
<TD NOWRAP VALIGN="bottom" ALIGN="right">125,000,000</TD>
