    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 12%; text-align: right">&mdash;</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
