    <td colspan="2" style="border-bottom: Black 1pt solid; font-weight: bold; text-align: center">Average</td><td style="padding-bottom: 1pt; font-weight: bold">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 60%; text-align: justify">06/30/2024</td><td style="width: 2%">&#160;</td>
