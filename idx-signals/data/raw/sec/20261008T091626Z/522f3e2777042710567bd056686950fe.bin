    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 16%; text-align: right"><ix:nonFraction name="WNW:OperatingLeaseRightOfUseAssetGross" contextRef="AsOf2023-12-31" id="Fact001309" format="ixt:numdotdecimal" decimals="0" unitRef="USD">293,991</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
