    <td style="text-align: left">Net cash provided by financing activities</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction name="us-gaap:NetCashProvidedByUsedInFinancingActivities" contextRef="From2024-01-012024-06-30_us-gaap_VariableInterestEntityPrimaryBeneficiaryMember" id="Fact000758" format="ixt:numdotdecimal" decimals="0" unitRef="USD">27,665</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction name="us-gaap:NetCashProvidedByUsedInFinancingActivities" contextRef="From2023-01-012023-06-30_us-gaap_VariableInterestEntityPrimaryBeneficiaryMember" id="Fact000759" format="ixt:numdotdecimal" decimals="0" unitRef="USD">277,229</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
