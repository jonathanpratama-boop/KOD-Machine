    <td style="width: 1%; text-align: left">$</td><td style="width: 16%; text-align: right">(<ix:nonFraction name="us-gaap:NetCashProvidedByUsedInOperatingActivities" contextRef="From2023-01-012023-06-30_us-gaap_VariableInterestEntityPrimaryBeneficiaryMember" id="Fact000753" format="ixt:numdotdecimal" decimals="0" sign="-" unitRef="USD">374,667</ix:nonFraction></td><td style="width: 1%; text-align: left">)</td></tr>
