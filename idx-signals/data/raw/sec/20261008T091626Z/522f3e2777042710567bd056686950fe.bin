    <td style="width: 1%; text-align: left">$</td><td style="width: 16%; text-align: right"><ix:nonFraction name="us-gaap:BusinessAcquisitionsProFormaRevenue" contextRef="From2022-01-012022-12-31_custom_CodeBeatingMember" id="Fact001039" format="ixt:numdotdecimal" decimals="0" unitRef="USD">11,977,268</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
