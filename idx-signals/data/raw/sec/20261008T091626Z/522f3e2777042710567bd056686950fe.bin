    <td style="text-align: left">&#160;</td><td style="text-align: right">(<ix:nonFraction name="us-gaap:NetCashProvidedByUsedInInvestingActivities" contextRef="From2023-01-012023-06-30_us-gaap_VariableInterestEntityPrimaryBeneficiaryMember" id="Fact000756" format="ixt:numdotdecimal" decimals="0" sign="-" unitRef="USD">5,496</ix:nonFraction></td><td style="text-align: left">)</td></tr>
