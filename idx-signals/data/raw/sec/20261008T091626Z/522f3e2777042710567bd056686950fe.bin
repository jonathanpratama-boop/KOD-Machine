    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td id="xdx_980_ecustom--RevenuePercentage_pid_dp_uPure_c20240101__20240630__srt--ProductOrServiceAxis__custom--SmsServiceMember_zTYDGvmNa1d6" title="% of total revenue" style="border-bottom: Black 1pt solid; text-align: right"><ix:nonFraction name="WNW:RevenuePercentage" contextRef="From2024-01-012024-06-30_custom_SmsServiceMember" id="Fact000879" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">0.0</ix:nonFraction></td><td style="padding-bottom: 1pt; text-align: left">%</td><td style="padding-bottom: 1pt">&#160;</td>
