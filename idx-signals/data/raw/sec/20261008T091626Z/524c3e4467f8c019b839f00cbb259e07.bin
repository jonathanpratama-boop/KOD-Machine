    <TD STYLE="border-bottom: Black 1.5pt solid; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1.5pt solid; text-align: right">(8,188,582</TD><TD STYLE="padding-bottom: 1.5pt; text-align: left">)</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
    <TD STYLE="text-align: left; padding-bottom: 4pt">Loss before income tax</TD><TD STYLE="padding-bottom: 4pt">&nbsp;</TD>
