    <TD COLSPAN="2">&nbsp;</TD><TD>&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
    <TD STYLE="padding-left: 0.125in; width: 76%; text-align: left"><I STYLE="font-style: normal; font-weight: normal">- Local &ndash; United States</I></TD><TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 9%; text-align: right">(3,728,225</TD><TD STYLE="width: 1%; text-align: left">)</TD><TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 9%; text-align: right">(3,541,832</TD><TD STYLE="width: 1%; text-align: left">)</TD></TR>
