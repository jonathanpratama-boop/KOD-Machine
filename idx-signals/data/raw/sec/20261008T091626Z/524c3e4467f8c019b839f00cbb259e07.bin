    <TD STYLE="border-bottom: Black 4pt double; text-align: left">$</TD><TD STYLE="border-bottom: Black 4pt double; text-align: right">68,885,035</TD><TD STYLE="padding-bottom: 4pt; text-align: left">&nbsp;</TD><TD STYLE="padding-bottom: 4pt">&nbsp;</TD>
    <TD STYLE="border-bottom: Black 4pt double; text-align: left">$</TD><TD STYLE="border-bottom: Black 4pt double; text-align: right">79,198,691</TD><TD STYLE="padding-bottom: 4pt; text-align: left">&nbsp;</TD><TD STYLE="padding-bottom: 4pt">&nbsp;</TD>
    <TD STYLE="padding-bottom: 4pt; text-align: left">&nbsp;</TD><TD STYLE="padding-bottom: 4pt; text-align: right">(13.0</TD><TD STYLE="padding-bottom: 4pt; text-align: left">)%</TD></TR>
