    <TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 8%; text-align: center"><FONT STYLE="font-size: 10pt">5&nbsp;years</FONT></TD>
    <TD STYLE="width: 1%">&nbsp;</TD></TR>
