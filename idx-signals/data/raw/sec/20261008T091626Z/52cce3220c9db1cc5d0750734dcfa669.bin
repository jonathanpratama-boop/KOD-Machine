    <TD STYLE="text-align: left">&nbsp;</TD><TD STYLE="text-align: right">368</TD><TD STYLE="text-align: left">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
    <TD STYLE="padding: 0pt; text-align: left; text-indent: 0pt">Conversion of loan</TD><TD>&nbsp;</TD>
    <TD STYLE="text-align: left">&nbsp;</TD><TD STYLE="text-align: right">(4,156</TD><TD STYLE="text-align: left">)</TD><TD>&nbsp;</TD>
    <TD STYLE="text-align: left">&nbsp;</TD><TD STYLE="text-align: right">-</TD><TD STYLE="text-align: left">&nbsp;</TD><TD>&nbsp;</TD>
