    <TD STYLE="text-align: left">&nbsp;</TD><TD STYLE="text-align: right">9,957</TD><TD STYLE="text-align: left">&nbsp;</TD><TD>&nbsp;</TD>
    <TD STYLE="text-align: left">&nbsp;</TD><TD STYLE="text-align: right">(188</TD><TD STYLE="text-align: left">)</TD><TD>&nbsp;</TD>
