            <td style="padding:0pt; width:0pt;">&#8203;</td>
            <td style="padding:3.5pt 0pt 1.5pt 0pt; width:393.59pt;text-align:left;">
              <div style="margin-left:10pt;">
                <font style="letter-spacing:0.2pt;">Issuance of Public and Private Warrants&#8201;&#8211;&#8201;Level&#160;3&#8201;&#8211;&#8201;July&#160;2021 </font>
              </div>
            </td>
