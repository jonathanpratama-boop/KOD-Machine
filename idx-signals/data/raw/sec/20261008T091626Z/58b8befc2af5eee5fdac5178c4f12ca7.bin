    <td style="text-align: left">Robert L. Angell</td><td>&#160;</td>
    <td>CTO (resigned on December 5, 2025)</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">38.2</td><td style="text-align: left">&#160;</td><td>&#160;</td>
