    <td style="border-bottom: Black 4pt double; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; text-align: right"><div style="-sec-ix-hidden: hidden-fact-163">&#8212;</div></td><td style="padding-bottom: 2.5pt; text-align: left">&#160;</td><td style="font-weight: bold; padding-bottom: 2.5pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c0" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:Revenues" scale="3" unitRef="cny" id="ixv-24709">1,039</ix:nonFraction></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left">&#160;</td></tr>
