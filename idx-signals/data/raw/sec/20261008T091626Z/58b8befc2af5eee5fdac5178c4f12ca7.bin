    <td style="border-bottom: Black 1.5pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; text-align: right">(<ix:nonFraction contextRef="c89" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:Revenues" scale="3" sign="-" unitRef="cny" id="ixv-24708">1</ix:nonFraction></td><td style="padding-bottom: 1.5pt; text-align: left">)</td></tr>
