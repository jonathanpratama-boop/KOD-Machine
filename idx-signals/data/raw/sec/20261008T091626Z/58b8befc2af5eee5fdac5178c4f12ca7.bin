    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c13" decimals="3" format="ixt:num-dot-decimal" name="us-gaap:EffectiveIncomeTaxRateReconciliationAtFederalStatutoryIncomeTaxRate" scale="-2" unitRef="pure" id="ixv-24906">25.0</ix:nonFraction></td><td style="width: 1%; text-align: left">%</td><td style="width: 1%">&#160;</td>
