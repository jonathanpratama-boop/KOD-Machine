<td style="width: 0.5in"/><td style="width: 0.25in"><span style="font-family: Times New Roman, Times, Serif">(a)</span></td><td style="text-align: justify"><ix:footnote id="ix_0_footnote" xml:lang="en-US">It relates to prepaid rental deposits.</ix:footnote></td></tr></table></ix:nonNumeric></ix:nonNumeric><div>

</div><p style="font: 10pt Times New Roman, Times, Serif; margin-top: 0pt; margin-bottom: 0pt">&#160;</p><div>

</div><ix:nonNumeric contextRef="c0" continuedAt="_IntangibleAssetsDisclosureTextBlock-c0_cont_1" escape="true" name="us-gaap:IntangibleAssetsDisclosureTextBlock" id="ixv-21250"><table cellpadding="0" style="font: bold 10pt Times New Roman, Times, Serif; margin-top: 0pt; margin-bottom: 0pt; width: 100%; border-spacing: 0px;"><tr style="vertical-align: top; text-align: justify">
<td style="width: 0.25in; text-align: left">5</td><td style="text-align: justify">INTANGIBLE ASSETS, NET</td>
</tr></table>

<p style="font: bold 10pt Times New Roman, Times, Serif; margin: 0pt 0">&#160;</p>

