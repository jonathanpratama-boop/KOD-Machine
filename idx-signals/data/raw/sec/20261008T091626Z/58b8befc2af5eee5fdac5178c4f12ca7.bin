    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right">(<ix:nonFraction contextRef="c12" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest" scale="3" sign="-" unitRef="cny" id="ixv-24902">11,489</ix:nonFraction></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left">)</td><td style="font-weight: bold; padding-bottom: 2.5pt">&#160;</td>
