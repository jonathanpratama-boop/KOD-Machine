    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c81" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents" scale="3" unitRef="cny" id="ixv-24697">17</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
