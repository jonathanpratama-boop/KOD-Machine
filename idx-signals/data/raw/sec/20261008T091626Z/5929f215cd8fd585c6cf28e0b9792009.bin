				<TR CLASS="No-Table-Style _idGenTableRowColumn-6" STYLE="background: #CCEEFF;height:12pt;">
					<TD CLASS="TB" STYLE="border-bottom-width:0pt;border-left-width:0pt;border-right-width:0pt;border-top-width:0pt;padding-bottom:3pt;padding-left:3pt;padding-right:3pt;padding-top:3pt;vertical-align:bottom;padding-left:0pt;width: 23.72%; padding: 0in 0in 3px 0in;border-width: 0pt;" VALIGN="bottom">
