            <td style="padding:3.25pt 0pt 1.5pt 0pt; width:144pt;">
              <font style="letter-spacing:0.2pt;">Gerd Auffarth, M.D. </font>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
