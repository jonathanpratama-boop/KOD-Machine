&ldquo;aim,&rdquo; &ldquo;estimate,&rdquo; &ldquo;intend,&rdquo; &ldquo;plan,&rdquo; &ldquo;believe,&rdquo; &ldquo;potential,&rdquo; &ldquo;continue,&rdquo;
