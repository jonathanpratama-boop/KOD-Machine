    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c241" decimals="0" format="ixt:num-dot-decimal" name="nivf:WaiverOfRelatedPartyBalance" scale="0" unitRef="usd" id="ixv-20965">190,000</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c242" decimals="0" format="ixt:num-dot-decimal" name="nivf:WaiverOfRelatedPartyBalance" scale="0" unitRef="usd" id="ixv-20966">125,000</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c243" decimals="0" format="ixt:num-dot-decimal" name="nivf:WaiverOfRelatedPartyBalance" scale="0" unitRef="usd" id="ixv-20967">120,000</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
