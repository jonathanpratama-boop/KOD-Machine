    <td style="border-bottom: Black 1.5pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; text-align: right">(<ix:nonFraction contextRef="c0" decimals="0" format="ixt:num-dot-decimal" id="ix_126_fact" name="nivf:ReverseCapitalization" scale="0" unitRef="usd">6,028,690</ix:nonFraction></td><td style="padding-bottom: 1.5pt; text-align: left">)</td></tr>
