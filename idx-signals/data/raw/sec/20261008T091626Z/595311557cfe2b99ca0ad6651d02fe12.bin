    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Issuance of shares&#160;as compensation for services (<i>Note 1</i>)</span></td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c6" decimals="0" format="ixt:num-dot-decimal" id="ix_123_fact" name="us-gaap:StockIssuedDuringPeriodValueOther" scale="0" unitRef="usd">2,866,856</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
