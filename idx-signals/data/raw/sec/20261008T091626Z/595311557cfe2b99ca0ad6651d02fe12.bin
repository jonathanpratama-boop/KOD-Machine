    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c0" decimals="0" format="ixt:num-dot-decimal" id="ix_125_fact" name="nivf:StockIssuedDuringPeriodValueIssuanceOfSharesThroughEquityLineOfCredit" scale="0" unitRef="usd">1,936,236</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
