    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c116" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-20620">6.9091</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td>Period average</td><td>&#160;</td>
    <td style="text-align: center">$: RMB</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c117" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-20621">7.1946</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
