  <tr style="vertical-align: top">
    <td><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">202206000037 (LLP0033395-LCA) &amp; AF002380</span></td>
    <td style="text-align: right">&#160;</td></tr>
  <tr style="vertical-align: top">
    <td><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">(Registered with PCAOB and MIA)</span></td>
    <td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Tel: +603-4813 9469</span></td></tr>
