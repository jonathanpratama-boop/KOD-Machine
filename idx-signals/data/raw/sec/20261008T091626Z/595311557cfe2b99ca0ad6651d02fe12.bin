    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c0" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodValueConversionOfUnits" scale="0" unitRef="usd" id="ixv-20825">2,650,000</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
