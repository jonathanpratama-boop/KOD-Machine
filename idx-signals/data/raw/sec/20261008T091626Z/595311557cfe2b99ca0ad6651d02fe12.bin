    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c110" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-20614">34.6153</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
