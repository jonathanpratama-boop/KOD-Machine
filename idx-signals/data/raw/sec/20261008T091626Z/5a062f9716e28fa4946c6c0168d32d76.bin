    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 9%; text-align: right">6,353</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 9%; text-align: right">9,328</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 1%">&nbsp;</TD>
