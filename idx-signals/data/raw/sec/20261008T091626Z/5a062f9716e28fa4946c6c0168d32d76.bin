    <TD STYLE="padding-left: 0.25in; text-indent: -0.125in; width: 76%; text-align: left">Cash and cash equivalents</TD><TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 9%; text-align: right">68,279,539</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 1%">&nbsp;</TD>
