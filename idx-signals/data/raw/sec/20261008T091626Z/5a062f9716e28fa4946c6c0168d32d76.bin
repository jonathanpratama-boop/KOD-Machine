    <TD STYLE="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: left">$</TD><TD STYLE="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: right">13,662,501</TD><TD STYLE="padding-bottom: 1.5pt; font-weight: bold; text-align: left">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
