    <TD STYLE="border-bottom: Black 1.5pt solid; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1.5pt solid; text-align: right">(162,893,356</TD><TD STYLE="padding-bottom: 1.5pt; text-align: left">)</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: White">
