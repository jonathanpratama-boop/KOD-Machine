    <TD STYLE="border-bottom: Black 1.5pt solid; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1.5pt solid; text-align: right">(2,665,659</TD><TD STYLE="padding-bottom: 1.5pt; text-align: left">)</TD><TD>&nbsp;</TD>
    <TD STYLE="border-bottom: Black 1.5pt solid; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1.5pt solid; text-align: right">30,848</TD><TD STYLE="padding-bottom: 1.5pt; text-align: left">&nbsp;</TD></TR>
