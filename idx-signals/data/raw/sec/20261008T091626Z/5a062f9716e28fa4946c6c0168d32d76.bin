    <TD STYLE="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: right">25.5</TD><TD STYLE="padding-bottom: 1.5pt; font-weight: bold; text-align: left">%</TD></TR>
