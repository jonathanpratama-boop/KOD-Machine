						<P CLASS="Signature_rule" STYLE="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:0;margin-top:0;orphans:1;page-break-after:auto;page-break-before:auto;text-align:left;text-indent:0;widows:1;margin-top:8pt;"><FONT CLASS="Italic" STYLE="font-style:italic;font-weight:normal;font-style:normal;font-weight:normal;">/s/</FONT><FONT CLASS="Italic" STYLE="font-style:italic;font-weight:normal;"> Chester S. Zygmont, III</FONT></P>
					</TD>
