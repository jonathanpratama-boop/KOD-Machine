                      <div style="margin-top:0pt;margin-bottom:0pt"><p style="text-align:center;margin-top:8pt;margin-bottom:3pt"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">F - 10</span></span></p><div style="page-break-after:always"><hr style="border-width:0px;clear:both;margin:4px 0px;width:100%;height:2px;color:#000000;background-color:#000000"/></div><p style="margin-top:10pt;margin-bottom:0pt;text-align:right"><span style="font-family:Times New Roman, Times, Serif;font-size:10pt"><strong>PAINREFORM LTD. </strong></span></p></div><div style="font:10pt Times New Roman, Times, Serif;margin:0pt 0;text-align:right">&#160;</div><div style="font:10pt Times New Roman, Times, serif;margin:0pt 0px"><p style="margin-top:0pt;margin-bottom:0pt;font-size:10pt;font-family:Times New Roman, Times, serif"><span style="font-size:12pt;font-family:Times New Roman, serif"><strong><span style="font-size:10pt">NOTES TO CONDENSED </span></strong></span><span style="font-size:12pt;font-family:Times New Roman, serif"><strong><span style="font-size:10pt">UNAUDITED&#160;</span></strong></span><span style="font-size:12pt;font-family:Times New Roman, serif"><strong><span style="font-size:10pt">FINANCIAL STATEMENTS</span></strong></span></p><div style="text-align:center;text-align:center"><hr style="height:1px;width:100%;color:rgb(0, 0, 0);background-color:rgb(0, 0, 0);text-align:center;margin-left:auto;margin-right:auto;border:medium none;margin-top:5pt;margin-bottom:5pt;text-align:center"/></div><div style="margin-bottom:10pt"><p style="margin-top:0pt;margin-bottom:0pt;font-size:10pt;font-family:Times New Roman, Times, serif;margin-bottom:0pt"><span style="font-size:12pt;font-family:Times New Roman, serif"><strong><span style="font-size:10pt">U.S. dollars in thousands, except share and per share data</span></strong></span></p></div></div>
                    </div>
                  </div>
                  <div style="margin-top:0pt;margin-bottom:0pt">
                    <div style="text-align:justify;line-height:1.25;font-weight:bold;margin-top:0pt;margin-bottom:0pt"><span style="font-size:10pt;margin-top:0pt;margin-bottom:0pt"><span style="font-family:Times New Roman, Times, serif;margin-top:0pt;margin-bottom:0pt">NOTE 5: SHAREHOLDERS&#8217; EQUITY (Cont.)</span></span></div>
                    <div style="text-align:justify;line-height:1.25;font-weight:bold;margin-top:0pt;margin-bottom:0pt">&#160;</div>
                  </div>
                </ix:exclude></div>
