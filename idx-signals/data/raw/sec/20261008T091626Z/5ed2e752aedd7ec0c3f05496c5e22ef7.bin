                            <div style="line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><ix:nonNumeric id="Fxbrl_20220808121910143" name="prfx:ClassOfWarrantOrRightIssuanceDate" contextRef="C_20240101to20240630_usgaapClassOfWarrantOrRightAxis_prfxDecemberTwoThousandNinteenWarrantsMember" format="ixt:date-monthname-day-year-en">December 9, 2019</ix:nonNumeric></span></span></div>
