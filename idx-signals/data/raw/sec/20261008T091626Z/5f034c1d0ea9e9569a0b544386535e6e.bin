		<tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">
			<td style="vertical-align: middle; width: 2%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 2px; padding-bottom: 2px;">
			<p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: center;"><sup style="vertical-align:top;line-height:120%;">1</sup></p>
			</td>
			<td style="vertical-align: middle; width: 98%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 2px; padding-bottom: 2px;">
			<p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt;">Had an aggregate amount of 60,000 options outstanding at December 31, 2022.</p>
			</td>
