		<tr style="background-color: rgb(32, 49, 100);">
			<td style="width: 100%; font-size: 14pt;"><b><font style="color:#ffffff;">Letter from the&nbsp;Chairman and Chief Executive Officer</font></b></td>
		</tr>
		<tr style="background-color: rgb(180, 221, 242);">
			<td style="font-size: 11pt;"><b>G. James Benoit, Jr.</b></td>
		</tr>

