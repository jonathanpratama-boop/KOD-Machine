			<p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; font-variant: normal; text-align: center; margin: 0pt;"><b>(b)</b></p>
			</td>
			<td style="vertical-align: bottom; width: 0.5%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&nbsp;</td>
			<td colspan="2" style="border-bottom: 1px solid rgb(0, 0, 0); vertical-align: bottom; width: 5.3%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">
