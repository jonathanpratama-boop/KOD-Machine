text-bottom;width:29.239%"><tr><td style="width:1.0%"/><td style="width:98.900%"/><td style="width:0.1%"/></tr><tr style="height:3pt"><td colspan="3" style="border-bottom:1pt solid #000000;padding:0 1pt"/></tr></table></div><div style="margin-top:3pt;padding-left:36pt;text-indent:-36pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">(1)</span><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:24.34pt">In regards to the $<ix:nonFraction unitRef="usd" contextRef="c-187" decimals="-5" name="us-gaap:DebtInstrumentCarryingAmount" scale="6" id="f-933">66.3</ix:nonFraction>&#160;million 1150 Clay Mortgage, which matures on June&#160;7, 2026, see the discussion under Fixed Rate Mortgages Payable. In regards to the $<ix:nonFraction unitRef="usd" contextRef="c-188" decimals="-5" name="us-gaap:DebtInstrumentCarryingAmount" scale="6" id="f-934">97.1</ix:nonFraction>&#160;million 1 Kaiser Mortgage, which matures on July&#160;1, 2026, see the discussion under Fixed Rate Mortgages Payable. In regards to the $<ix:nonFraction unitRef="usd" contextRef="c-195" decimals="-5" name="us-gaap:DebtInstrumentCarryingAmount" scale="6" id="f-935">81.0</ix:nonFraction>&#160;million Channel House Mortgage, which matures on January&#160;31, 2027, see the discussion under Variable Rate Mortgages Payable. </span></div></ix:nonNumeric></ix:continuation><div style="height:45pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="text-align:center"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">F-27</span></div></div></div><hr style="page-break-after:always"/><div style="min-height:81pt;width:100%"><div><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#i6158aa6c50ce4621a4d9a2405abbc9c1_7">Table of Contents</a></span></div><div style="text-align:center"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">CREATIVE MEDIA &amp; COMMUNITY TRUST CORPORATION AND SUBSIDIARIES</span></div><div style="text-align:center"><span><br/></span></div><div style="text-align:center"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Notes to Consolidated Financial Statements as</span><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%"> </span><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">of December 31, 2025 and 2024</span></div><div style="text-align:center"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">and for the Years Ended December 31, 2025 and 2024  </span><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%"> </span><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">(Continued)</span></div></div><div style="margin-top:3pt;padding-left:36pt;text-indent:-36pt"><ix:continuation id="f-904-1" continuedAt="f-904-2"><ix:continuation id="f-778-4" continuedAt="f-778-5"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">(2)</span></ix:continuation></ix:continuation><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:24.34pt"><ix:continuation id="f-904-2"><ix:continuation id="f-778-5">The Lending Division Revolving Credit Facility was repaid in full and terminated in January 2026.</ix:continuation></ix:continuation> </span></div><div style="margin-top:3pt;text-indent:-18pt"><span><br/></span></div><div id="i6158aa6c50ce4621a4d9a2405abbc9c1_205"></div><ix:nonNumeric contextRef="c-1" name="us-gaap:DerivativeInstrumentsAndHedgingActivitiesDisclosureTextBlock" id="f-936" continuedAt="f-936-1" escape="true"><div style="margin-top:9pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">8.  DERIVATIVE INSTRUMENTS AND HEDGING ACTIVITIES</span></div><div style="margin-top:9pt;text-indent:36pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:112%">In the ordinary course of business, the Company may use certain types of derivative instruments for the purpose of managing or hedging its interest rate risk. </span></div><ix:nonNumeric contextRef="c-1" name="us-gaap:ScheduleOfInterestRateDerivativesTableTextBlock" id="f-937" escape="true"><div style="margin-top:9pt;text-indent:36pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">The following table summarizes the terms of the Company&#8217;s interest rate cap agreements as of December&#160;31, 2025 (dollar amounts in thousands): </span></div><div style="margin-top:9pt"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:1.0%"/><td style="width:17.759%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:16.297%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.384%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:13.519%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.530%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:6.940%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.384%"/><td style="width:0.1%"/><td style