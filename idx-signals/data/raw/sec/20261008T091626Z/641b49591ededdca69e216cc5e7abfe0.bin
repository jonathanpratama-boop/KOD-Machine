    <TD STYLE="border-bottom: Black 1pt solid; vertical-align: bottom; text-align: justify"><FONT STYLE="font-size: 10pt"><B>Description of Exhibits</B></FONT></TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
    <TD><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">1.1</FONT></TD>
    <TD>&nbsp;</TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt"><A HREF="ex1-1.htm">Form of Placement Agency Agreement</A></FONT></TD></TR>
