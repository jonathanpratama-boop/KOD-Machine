    <td style="text-align: left">Andrea Goren</td><td>&#160;</td>
    <td style="text-align: left">$</td><td style="text-align: right">53,750</td><td style="text-align: left">(3)</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">1,457</td><td style="text-align: left">(4)</td></tr>
