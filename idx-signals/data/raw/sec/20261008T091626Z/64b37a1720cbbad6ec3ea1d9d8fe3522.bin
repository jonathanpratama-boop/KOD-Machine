    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">Manufacturing machinery and equipment</td><td style="font: 10pt Times New Roman, Times, Serif">&#160;</td>
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td id="xdx_98E_ecustom--AssetAcquisitionPriceOfAcquisitionFixedAssets_c20230416__20230417__us-gaap--TypeOfArrangementAxis__custom--AssetPurchaseAgreementMember__srt--CounterpartyNameAxis__custom--FlisomAgMember__us-gaap--PropertyPlantAndEquipmentByTypeAxis__us-gaap--MachineryAndEquipmentMember_zntebemsh5Pj" title="Fixed Assets" style="font: 10pt Times New Roman, Times, Serif; text-align: right"><ix:nonFraction name="asti:AssetAcquisitionPriceOfAcquisitionFixedAssets" contextRef="From2023-04-162023-04-17_custom_AssetPurchaseAgreementMember_custom_FlisomAgMember_us-gaap_MachineryAndEquipmentMember" format="ixt:numdotdecimal" decimals="0" unitRef="USD">3,682,621</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td></tr>
