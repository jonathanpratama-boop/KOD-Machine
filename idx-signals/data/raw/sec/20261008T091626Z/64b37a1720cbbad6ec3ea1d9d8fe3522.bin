    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td id="xdx_983_eus-gaap--ContractWithCustomerLiabilityRevenueRecognized_iN_pp0p0_di_c20220101__20221231_znNmtIHGSQHl" title="Recognized as revenue" style="border-bottom: Black 1pt solid; text-align: right">(<ix:nonFraction name="us-gaap:ContractWithCustomerLiabilityRevenueRecognized" contextRef="From2022-01-012022-12-31" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">239,313</ix:nonFraction></td><td style="padding-bottom: 1pt; text-align: left">)</td></tr>
