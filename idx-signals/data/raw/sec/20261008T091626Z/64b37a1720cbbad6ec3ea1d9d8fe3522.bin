    <td style="text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_905_eus-gaap--PropertyPlantAndEquipmentUsefulLife_iI_dtY_c20221231__srt--RangeAxis__srt--MinimumMember__us-gaap--PropertyPlantAndEquipmentByTypeAxis__us-gaap--FurnitureAndFixturesMember_zV8g8x42SYYc" title="Useful life"><ix:nonNumeric contextRef="AsOf2022-12-31_srt_MinimumMember_us-gaap_FurnitureAndFixturesMember" format="ixt-sec:duryear" name="us-gaap:PropertyPlantAndEquipmentUsefulLife">3</ix:nonNumeric></span>&#160;-&#160;<span id="xdx_904_eus-gaap--PropertyPlantAndEquipmentUsefulLife_iI_dtY_c20221231__srt--RangeAxis__srt--MaximumMember__us-gaap--PropertyPlantAndEquipmentByTypeAxis__us-gaap--FurnitureAndFixturesMember_zMIkFJH1vSP7" title="Useful life"><ix:nonNumeric contextRef="AsOf2022-12-31_srt_MaximumMember_us-gaap_FurnitureAndFixturesMember" format="ixt-sec:duryear" name="us-gaap:PropertyPlantAndEquipmentUsefulLife">7</ix:nonNumeric></span></span></td></tr>
