    <td style="border-bottom: Black 2.5pt double; font-weight: bold; text-align: left">$</td><td id="xdx_98A_eus-gaap--DebtConversionConvertedInstrumentAmount1_iN_pp0p0_di_c20220101__20221231_zh6IryhUP9Ne" title="Notes converted" style="border-bottom: Black 2.5pt double; font-weight: bold; text-align: right">(<ix:nonFraction name="us-gaap:DebtConversionConvertedInstrumentAmount1" contextRef="From2022-01-012022-12-31" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">10,507,101</ix:nonFraction></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left">)</td><td style="font-weight: bold; padding-bottom: 2.5pt">&#160;</td>
