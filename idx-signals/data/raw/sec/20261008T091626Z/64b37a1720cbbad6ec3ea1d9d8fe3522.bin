    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td id="xdx_988_eus-gaap--ContractWithCustomerLiabilityRevenueRecognized_iN_pp0p0_di_c20210101__20211231_zFIxqDdY5ca4" title="Recognized as revenue" style="border-bottom: Black 1pt solid; text-align: right">(<ix:nonFraction name="us-gaap:ContractWithCustomerLiabilityRevenueRecognized" contextRef="From2021-01-012021-12-31" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">307,500</ix:nonFraction></td><td style="padding-bottom: 1pt; text-align: left">)</td></tr>
