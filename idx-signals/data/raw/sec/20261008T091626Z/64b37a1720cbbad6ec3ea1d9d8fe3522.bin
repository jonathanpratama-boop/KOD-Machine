    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td id="xdx_981_eus-gaap--DebtInstrumentUnamortizedDiscount_iNI_pp0p0_di_c20221231__us-gaap--DebtInstrumentAxis__custom--L1ConvertibleNoteMember_zWBlgHJJ4SPh" title="Less: remaining discount" style="border-bottom: Black 1pt solid; text-align: right">(<ix:nonFraction name="us-gaap:DebtInstrumentUnamortizedDiscount" contextRef="AsOf2022-12-31_custom_L1ConvertibleNoteMember" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">4,846,857</ix:nonFraction></td><td style="padding-bottom: 1pt; text-align: left">)</td><td style="font-weight: bold; padding-bottom: 1pt">&#160;</td>
    <td style="border-bottom: Black 1pt solid; font-weight: bold; text-align: left">&#160;</td><td id="xdx_984_eus-gaap--ConvertibleLongTermNotesPayable_c20221231__us-gaap--DebtInstrumentAxis__custom--L1ConvertibleNoteMember_pp0p0" title="Promissory Notes, net of discount" style="border-bottom: Black 1pt solid; font-weight: bold; text-align: right"><ix:nonFraction name="us-gaap:ConvertibleLongTermNotesPayable" contextRef="AsOf2022-12-31_custom_L1ConvertibleNoteMember" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">2,653,143</ix:nonFraction></td><td style="padding-bottom: 1pt; font-weight: bold; text-align: left">&#160;</td></tr>
