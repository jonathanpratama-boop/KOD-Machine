    <td style="text-align: left">&#160;</td><td id="xdx_986_eus-gaap--DeferredRevenue_iS_pp0p0_c20220101__20221231_zr6vxDhBvFtj" title="Beginning Balance" style="text-align: right"><ix:nonFraction name="us-gaap:DeferredRevenue" contextRef="AsOf2021-12-31" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">22,500</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
