    <td style="text-align: left">Discount rate</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span style="font-size: 10pt"><span id="xdx_907_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20250331__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputDiscountRateMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember__srt--RangeAxis__srt--MinimumMember_zcvPtEgKHTif" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2025-03-31_us-gaap_MeasurementInputDiscountRateMember_custom_ConvertibleBridgeNotesMember_srt_MinimumMember" id="Fact000786" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">40</ix:nonFraction></span>% - <span id="xdx_907_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20250331__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputDiscountRateMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember__srt--RangeAxis__srt--MaximumMember_zmtP7BOqXE5g" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2025-03-31_us-gaap_MeasurementInputDiscountRateMember_custom_ConvertibleBridgeNotesMember_srt_MaximumMember" id="Fact000788" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">60</ix:nonFraction></span></span></td><td style="text-align: left">%</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span style="font-size: 10pt"><span id="xdx_909_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20241231__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputDiscountRateMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember__srt--RangeAxis__srt--MinimumMember_zXnntvKbSRLi" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-12-31_us-gaap_MeasurementInputDiscountRateMember_custom_ConvertibleBridgeNotesMember_srt_MinimumMember" id="Fact000790" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">40</ix:nonFraction></span>% - <span id="xdx_903_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20241231__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputDiscountRateMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember__srt--RangeAxis__srt--MaximumMember_z40GAcFsRT3e" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-12-31_us-gaap_MeasurementInputDiscountRateMember_custom_ConvertibleBridgeNotesMember_srt_MaximumMember" id="Fact000792" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">60</ix:nonFraction></span></span></td><td style="text-align: left">%</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="text-align: left">Probability assessment<sup>1</sup></td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span style="font-size: 10pt"><span id="xdx_90A_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20250331__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputDefaultRateMember__srt--RangeAxis__srt--MinimumMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember_fKDEp_zCdA9t8J03F7" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2025-03-31_us-gaap_MeasurementInputDefaultRateMember_srt_MinimumMember_custom_ConvertibleBridgeNotesMember" id="Fact000794" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">5</ix:nonFraction></span>% - <span id="xdx_906_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20250331__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputDefaultRateMember__srt--RangeAxis__srt--MaximumMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember_fKDEp_zfl7dDNhTwbg" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2025-03-31_us-gaap_MeasurementInputDefaultRateMember_srt_MaximumMember_custom_ConvertibleBridgeNotesMember" id="Fact000796" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">20</ix:nonFraction></span></span></td><td style="text-align: left">%</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span style="font-size: 10pt"><span id="xdx_90C_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20241231__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputDefaultRateMember__srt--RangeAxis__srt--MinimumMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember_fKDEp_z2040BbfzsS4" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-12-31_us-gaap_MeasurementInputDefaultRateMember_srt_MinimumMember_custom_ConvertibleBridgeNotesMember" id="Fact000798" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">10</ix:nonFraction></span>% - <span id="xdx_902_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20241231__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputDefaultRateMember__srt--RangeAxis__srt--MaximumMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember_fKDEp_z65C4hs33GPc" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-12-31_us-gaap_MeasurementInputDefaultRateMember_srt_MaximumMember_custom_ConvertibleBridgeNotesMember" id="Fact000800" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">40</ix:nonFraction></span></span></td><td style="text-align: left">%</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left">Illiquidity discount</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span id="xdx_90D_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20250331__us-gaap--MeasurementInputTypeAxis__custom--MeasurementInputIlliquidityDiscountMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember_zzBviUM7Mww8" title="Warrants measurement input">(<ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2025-03-31_custom_MeasurementInputIlliquidityDiscountMember_custom_ConvertibleBridgeNotesMember" id="Fact000802" format="ixt:numdotdecimal" decimals="INF" sign="-" unitRef="Pure">29</ix:nonFraction></span></td><td style="text-align: left">)%</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span id="xdx_90B_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20241231__us-gaap--MeasurementInputTypeAxis__custom--MeasurementInputIlliquidityDiscountMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember_zJnrooLsZnne" title="Warrants measurement input">(<ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-12-31_custom_MeasurementInputIlliquidityDiscountMember_custom_ConvertibleBridgeNotesMember" id="Fact000804" format="ixt:numdotdecimal" decimals="INF" sign="-" unitRef="Pure">26</ix:nonFraction></span></td><td style="text-align: left">)%</td></tr>
  </table>

<p style="font: 10pt Times New Roman, Times, Serif; margin-top: 0pt; margin-bottom: 0pt; margin-left: 0">&#160;</p>

