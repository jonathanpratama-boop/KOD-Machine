  <tr style="vertical-align: bottom; background-color: White">
    <td>Volatility</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span style="font-size: 10pt"><span id="xdx_905_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20250331__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputPriceVolatilityMember__srt--RangeAxis__srt--MinimumMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember_z8fv75ZIMs8e" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2025-03-31_us-gaap_MeasurementInputPriceVolatilityMember_srt_MinimumMember_custom_ConvertibleBridgeNotesMember" id="Fact000778" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">73.90</ix:nonFraction></span>% - <span id="xdx_901_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20250331__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputPriceVolatilityMember__srt--RangeAxis__srt--MaximumMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember_zYniyzeKTKi5" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2025-03-31_us-gaap_MeasurementInputPriceVolatilityMember_srt_MaximumMember_custom_ConvertibleBridgeNotesMember" id="Fact000780" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">120.16</ix:nonFraction></span></span></td><td style="text-align: left">%</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span style="font-size: 10pt"><span id="xdx_903_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20241231__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputPriceVolatilityMember__srt--RangeAxis__srt--MinimumMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember_zzoX0iGENwQh" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-12-31_us-gaap_MeasurementInputPriceVolatilityMember_srt_MinimumMember_custom_ConvertibleBridgeNotesMember" id="Fact000782" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">57.50</ix:nonFraction></span>% - <span id="xdx_901_eus-gaap--WarrantsAndRightsOutstandingMeasurementInput_iI_pid_uPure_c20241231__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputPriceVolatilityMember__srt--RangeAxis__srt--MaximumMember__us-gaap--DebtInstrumentAxis__custom--ConvertibleBridgeNotesMember_z1AdAwKNGxo5" title="Warrants measurement input"><ix:nonFraction name="us-gaap:WarrantsAndRightsOutstandingMeasurementInput" contextRef="AsOf2024-12-31_us-gaap_MeasurementInputPriceVolatilityMember_srt_MaximumMember_custom_ConvertibleBridgeNotesMember" id="Fact000784" format="ixt:numdotdecimal" decimals="INF" unitRef="Pure">97.14</ix:nonFraction></span></span></td><td style="text-align: left">%</td></tr>
