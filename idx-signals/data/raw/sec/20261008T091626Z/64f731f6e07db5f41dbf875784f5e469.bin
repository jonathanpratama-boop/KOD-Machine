  <tr id="xdx_402_eus-gaap--Cash_iI_maCACEAzwWH_zM2MZzd4E2Dj" style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom; background-color: #CCEEFF">
    <td style="font: 10pt Times New Roman, Times, Serif"><span style="font-size: 10pt">Cash</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: right"><span style="font-size: 10pt">$ <ix:nonFraction name="us-gaap:Cash" contextRef="AsOf2025-03-31" id="Fact000507" format="ixt:numdotdecimal" decimals="0" unitRef="USD">4,511,790</ix:nonFraction> </span></td>
    <td style="font: 10pt Times New Roman, Times, Serif">&#160;</td>
