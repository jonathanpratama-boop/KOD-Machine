  <tr id="xdx_40F_eus-gaap--MoneyMarketFundsAtCarryingValue_iI_maCACEAzwWH_zkLuAoxE8f03" style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom; background-color: white">
    <td style="font: 10pt Times New Roman, Times, Serif"><span style="font-size: 10pt">Money market funds</span></td>
