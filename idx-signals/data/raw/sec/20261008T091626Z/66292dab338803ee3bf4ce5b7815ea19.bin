    <td style="text-align: left">&#160;</td><td style="text-align: right">(<ix:nonFraction contextRef="c0" decimals="0" format="ixt:num-dot-decimal" name="wbuy:SingaporeTaxExemptionOrNontaxableIncome" scale="0" unitRef="usd">7,981</ix:nonFraction></td><td style="text-align: left">)</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c5" decimals="0" format="ixt:num-dot-decimal" name="wbuy:SingaporeTaxExemptionOrNontaxableIncome" scale="0" sign="-" unitRef="usd">14,886</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
