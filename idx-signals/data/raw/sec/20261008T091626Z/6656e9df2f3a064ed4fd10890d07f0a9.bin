    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c5" decimals="0" format="ixt:num-dot-decimal" name="apm:TotalCarryingValueAtTheEndOfThePeriod" scale="0" unitRef="usd">4,079,707</ix:nonFraction></td><td style="padding-bottom: 4pt; text-align: left">&#160;</td></tr>
