    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c5" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IntangibleAssetsNetExcludingGoodwill" scale="0" unitRef="usd">880,256</ix:nonFraction></td><td style="padding-bottom: 4pt; text-align: left">&#160;</td></tr>
