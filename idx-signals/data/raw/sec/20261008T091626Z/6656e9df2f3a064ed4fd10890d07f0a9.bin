    <td style="text-align: left">&#160;</td><td style="text-align: right">5.35</td><td style="text-align: left">%</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">8.45</td><td style="text-align: left">%</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left; text-indent: -9pt; padding-left: 9pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">CGY Investments Limited<sup>(7)</sup></span></td><td>&#160;</td>
