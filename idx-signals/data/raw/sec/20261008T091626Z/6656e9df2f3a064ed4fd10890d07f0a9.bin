    <td style="text-align: left">$</td><td style="text-align: right"><ix:nonFraction contextRef="c254" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AssetsNet" scale="0" unitRef="usd">4,195</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
