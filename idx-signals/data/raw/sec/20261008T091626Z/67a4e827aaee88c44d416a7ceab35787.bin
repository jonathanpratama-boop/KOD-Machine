 0.5pt 0pt 0.5pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:86.58%;margin:0pt;padding:0pt 0.5pt 0pt 0.5pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><a style="-sec-extract:exhibit;font-family:&quot;'Times New Roman','Times','serif'&quot;;" href="https://www.sec.gov/Archives/edgar/data/1835724/000119312521070815/d72883dex44.htm"><span style="font-family:'Times New Roman','Times','serif';font-style:normal;font-weight:normal;">Sixth Amended and Restated Shareholders&#8217; Agreement between the Registrant and other parties thereto dated August&#160;7, 2019 (incorporated herein by reference to Exhibit&#160;4.4 to the registration statement on Form&#160;F-1 (File No.&#160;333-253910), as amended, initially filed with the Securities and Exchange Commission on March&#160;5, 2021)</span></a></p></td></tr><tr><td style="vertical-align:top;width:10.53%;margin:0pt;padding:0pt 0.5pt 0pt 0.5pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">2.5<sup style="font-size:7.5pt;line-height:100%;top:0pt;vertical-align:top;">*</sup></p></td><td style="vertical-align:top;width:2.87%;margin:0pt;padding:0pt 0.5pt 0pt 0.5pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:86.58%;margin:0pt;padding:0pt 0.5pt 0pt 0.5pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><a style="-sec-extract:exhibit;font-family:&quot;'Times New Roman','Times','serif'&quot;;" href="zh-20231231xex2d5.htm"><span style="font-family:'Times New Roman','Times','serif';font-style:normal;font-weight:normal;">Description of Securities </span></a></p></td