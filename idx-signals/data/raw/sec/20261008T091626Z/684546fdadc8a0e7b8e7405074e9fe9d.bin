on unitRef="Unit_Divide_USD_shares_jfdFUlNSV0qcnxaW6J7NSw" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_Lm4isNNRGka3GMUC_OpU_Q" decimals="2" format="ixt:numdotdecimal" name="cycc:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsUnvestedWeightedAverageGrantDateFairValue" scale="0" id="Tc_xoae5HjKPUmFL9W6EWNTcw_12_5">1.18</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:71.19%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Vested and exercisable at December&#160;31,&#160;2022</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.25%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.26%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_-YBxS00-XkuQkothZsMe1w" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_Lm4isNNRGka3GMUC_OpU_Q" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsVestedInPeriod" scale="0" id="Tc_SMIsLk9ZVE2iUqGm-ySb8Q_13_2">17,409</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.25%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.25%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.77%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_USD_shares_jfdFUlNSV0qcnxaW6J7NSw" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_Lm4isNNRGka3GMUC_OpU_Q" decimals="2" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsVestedInPeriodWeightedAverageGrantDateFairValue" scale="0" id="Tc_Uq0FgXt69ESUCkbEqqRaFw_13_5">6.69</ix:nonFraction></p></td></tr></table></div><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:2pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="font-size:1pt;margin-bottom:10pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_LPa-h9eBZU2rhZHhfF1odw" name="us-gaap:PensionAndOtherPostretirementBenefitsDisclosureTextBlock" id="Tb_dq7WMRTqM0Cq6-Co-wFV3w" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">13.&#160;&#160;Employee Benefit Plans</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Pension Plan</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Company operates a defined contribution group personal pension plan for all of its UK based employees. Company contributions to the plan totaled approximately $<ix:nonFraction unitRef="Unit_Standard_USD_OUe9CJ22uEqidq9cx6kI5g" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_RetirementPlanTypeAxis_cycc_PensionPlanMember_kEyqOBD4yECgRs97STNyIA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DefinedContributionPlanEmployerDiscretionaryContributionAmount" scale="0" id="Narr_MDuphJg7i0qEru66foeqTQ">42,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_OUe9CJ22uEqidq9cx6kI5g" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RetirementPlanTypeAxis_cycc_PensionPlanMember_JH__FxAWP064WyiBGnUZRw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DefinedContributionPlanEmployerDiscretionaryContributionAmount" scale="0" id="Narr_cx_R_810W0eRVZtvr_4vng">44,000</ix:nonFraction> for the&#160;years ended December 31, 2021 and 2022, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;font-weight:bold;margin:0pt 0pt 12pt 0pt;">401(k)&#160;Plan</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The 401(k)&#160;Plan provides for matching contributions by the Company in an amount equal to the lesser of <ix:nonFraction unitRef="Unit_Standard_pure_5nROB11vkke-i8QaPo2nUg" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RetirementPlanTypeAxis_cycc_Plan401KMember_2CjrSYyoYUSZBo9DDKBX_Q" decimals="2" format="ixt:numdotdecimal" name="cycc:DefinedContributionPlanEmployerMatchingContributionAsPercentageOfEmployeeDeferral" scale="-2" id="Narr_yWZRn4nxX0e-lgsn0CktRA">100</ix:nonFraction>% of the employee&#8217;s deferral or <ix:nonFraction unitRef="Unit_Standard_pure_5nROB11vkke-i8QaPo2nUg" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RetirementPlanTypeAxis_cycc_Plan401KMember_2CjrSYyoYUSZBo9DDKBX_Q" decimals="2" format="ixt:numdotdecimal" name="us-gaap:DefinedContributionPlanMaximumAnnualContributionsPerEmployeePercent" scale="-2" id="Narr_EnqdOvmBg0ypgpedqcZ4JA">6</ix:nonFraction>% of the U.S. employee&#8217;s qualifying compensation. The 401(k)&#160;Plan is intended to qualify under Section&#160;401(k)&#160;of the Internal Revenue Code, so that contributions to the 401(k)&#160;Plan by employees or by the Company, and the investment earnings thereon, are not taxable to the employees until withdrawn. Company matching contributions are tax deductible by the Company when made. In 2022, Company employees could elect to reduce their current compensation by up to the statutorily prescribed annual limit of $<ix:nonFraction unitRef="Unit_Standard_USD_OUe9CJ22uEqidq9cx6kI5g" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RetirementPlanTypeAxis_cycc_Plan401KMember_2CjrSYyoYUSZBo9DDKBX_Q" decimals="0" format="ixt:numdotdecimal" name="cycc:DefinedContributionPlanEmployeeStatutorilyPrescribedAnnualContributionLimitBeforeAttainingSpecifiedAge" scale="0" id="Narr_dHa-pv7v3EClbMcznKMuaw">20,500</ix:nonFraction> if under <ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RetirementPlanTypeAxis_cycc_Plan401KMember_2CjrSYyoYUSZBo9DDKBX_Q" format="ixt-sec:durwordsen" name="cycc:DefinedContributionPlanSpecifiedAgeLimitOfEmployeesForCalculationOfStatutorilyPrescribedAnnualLimitOfContribution" id="Narr_fsrihjDdI0eIamjQM0X3Kw">50 years</ix:nonNumeric> old and $<ix:nonFraction unitRef="Unit_Standard_USD_OUe9CJ22uEqidq9cx6kI5g" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RetirementPlanTypeAxis_cycc_Plan401KMember_2CjrSYyoYUSZBo9DDKBX_Q" decimals="0" format="ixt:numdotdecimal" name="cycc:DefinedContributionPlanEmployeeStatutorilyPrescribedAnnualContributionLimitAfterAttainingSpecifiedAge" scale="0" id="Narr_CKQoIM8ACUqunwh8YgsBZg">27,000</ix:nonFraction> if over 50&#160;years old and to have those funds contributed to the 401(k)&#160;Plan. The Company made contributions of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_OUe9CJ22uEqidq9cx6kI5g" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_RetirementPlanTypeAxis_cycc_Plan401KMember_28LT0I_Rx0KEmjyhGAKL7w" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DefinedContributionPlanCostRecognized" scale="0" id="Narr_pguSPMLEdUqMA4cDWiDV4w">71,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_OUe9CJ22uEqidq9cx6kI5g" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RetirementPlanTypeAxis_cycc_Plan401KMember_2CjrSYyoYUSZBo9DDKBX_Q" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DefinedContributionPlanCostRecognized" scale="0" id="Narr_fwplq0DzJUaUPf3hbihAPw">95,000</ix:nonFraction> to the 401(k)&#160;Plan for the&#160;years ended December 31, 2021 and 2022, respectively.</p></ix:nonNumeric><a id="_8c0353c3_8cfb_4734_8f02_3110ace4d59c"></a><a id="Tc_ZOBqcCAe1kKn-SwPkmH9vw_1_2"></a><a id="Tc_RJIq4ep9-UOX0RxjTlduJA_2_2"></a><a id="Tc_2l4_DWn2h0GeAWdR-p8B-w_2_5"></a><a id="Tc_i1jaQ8n_NkCrxjnMn_HNHA_3_6"></a><a id="Tc_9iOUHs6G40SNJ0VI9a1tFA_4_0"></a><a id="Tc_A2HRqqxsrUqvZZUlnjNprg_4_2"></a><a id="Tc_THn8VTrZmUKt2hHIJXAsrQ_4_5"></a><a id="Tc_SXHSyTkzzEWh25ANbCHoYQ_5_0"></a><a id="Tc_nNh4AWpOn0S2jhcu2G9a6Q_6_0"></a><a id="Tc_O1IE1mtk50ifxTYKPU9SGA_6_2"></a><a id="Tc_PhutrFWjQ0GLRMxDa7Z5vg_6_5"></a><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_LPa-h9eBZU2rhZHhfF1odw" name="us-gaap:IncomeTaxDisclosureTextBlock" id="Tb_8KwXA9nqc0e9jhFeqSajPA" continuedAt="Tb_8KwXA9nqc0e9jhFeqSajPA_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">14.&#160;&#160;Taxes</p><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_LPa-h9eBZU2rhZHhfF1odw" name="us-gaap:ScheduleOfIncomeBeforeIncomeTaxDomesticAndForeignTableTextBlock" id="Tb_jN6DSyxx50Sx7KDLCpSpUA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">(Loss) income from continu