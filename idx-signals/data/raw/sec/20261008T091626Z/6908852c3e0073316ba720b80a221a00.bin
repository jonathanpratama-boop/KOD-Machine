    <TD COLSPAN="6" STYLE="font-family: Times New Roman, Times, Serif; font-weight: bold; text-align: center; border-bottom: Black 1.5pt solid"><FONT STYLE="font-family: Times New Roman, Times, Serif">For
    the Six Months Ended<BR> June 30,</FONT></TD><TD STYLE="font-family: Times New Roman, Times, Serif; padding-bottom: 1.5pt; font-weight: bold"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD></TR>
