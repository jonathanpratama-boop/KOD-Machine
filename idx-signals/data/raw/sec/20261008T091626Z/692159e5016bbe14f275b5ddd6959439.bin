  <tr id="xdx_40F_eus-gaap--DisposalGroupIncludingDiscontinuedOperationIntangibleAssets_iNI_di_zkLVx0OIHIp6" style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom; background-color: rgb(204,238,255)">
