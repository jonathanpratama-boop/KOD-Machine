    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td></tr>
  <tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom; background-color: White">
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">Expected dividends</td><td style="font: 10pt Times New Roman, Times, Serif">&#160;</td>
