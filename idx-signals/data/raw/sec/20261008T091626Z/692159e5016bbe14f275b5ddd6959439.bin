    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif; text-align: right">(<ix:nonFraction name="us-gaap:DisposalGroupIncludingDiscontinuedOperationIntangibleAssets" contextRef="AsOf2023-04-30_custom_PlaySightAndFoundationSportsMember" format="ixt:numdotdecimal" decimals="0" unitRef="USD">18,576,475</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">)</td></tr>
