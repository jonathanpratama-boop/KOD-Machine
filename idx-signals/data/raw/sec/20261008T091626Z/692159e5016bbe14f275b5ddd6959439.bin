    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif; text-align: right"><ix:nonFraction name="CNXA:DisposalGroupIncludingDiscontinuedOperationContractLiabilities" contextRef="AsOf2023-04-30_custom_PlaySightAndFoundationSportsMember" format="ixt:numdotdecimal" decimals="0" unitRef="USD">3,785,408</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td></tr>
