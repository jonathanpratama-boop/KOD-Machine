    <td colspan="2" id="xdx_486_eus-gaap--FiniteLivedIntangibleAssetsAccumulatedAmortization_iE_z2DiURFhwMZg" style="border-bottom: Black 1.5pt solid; font: bold 10pt Times New Roman, Times, Serif; text-align: center">Accumulated Amortization</td><td style="font: bold 10pt Times New Roman, Times, Serif; padding-bottom: 1.5pt">&#160;</td><td style="font: bold 10pt Times New Roman, Times, Serif; padding-bottom: 1.5pt">&#160;</td>
