			<p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt;">Weighted-average number of ordinary shares outstanding</p>
			</td>
			<td id=".lead.2" style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt;">&nbsp;</td>
