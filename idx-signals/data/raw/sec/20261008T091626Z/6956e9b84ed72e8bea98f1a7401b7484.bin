			<td id=".amt.2" style="width: 16%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt; text-align: center;">50%</td>
			<td id=".trail.2" nowrap="true" style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt;">&nbsp;</td>
