			<td id=".symb.4" style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt;">&nbsp;</td>
			<td id=".amt.4" style="width: 12%; text-align: center; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt;">4.55%</td>
