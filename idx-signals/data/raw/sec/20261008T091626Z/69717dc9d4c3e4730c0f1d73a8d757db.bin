    <td style="width: 1%; text-align: left"><span style="-keep: true">$</span></td><td style="width: 9%; text-align: right"><span style="-keep: true">1,258,286</span></td><td style="width: 1%; text-align: left"><span style="-keep: true">&#160;</span></td><td style="width: 1%"><span style="-keep: true">&#160;</span></td>
    <td style="width: 1%; text-align: left"><span style="-keep: true">$</span></td><td style="width: 9%; text-align: right"><span style="-keep: true">127,934</span></td><td style="width: 1%; text-align: left"><span style="-keep: true">&#160;</span></td><td style="width: 1%"><span style="-keep: true">&#160;</span></td>
