                      <div style="text-align:center;line-height:1.25;color:#000000;font-family:'Times New Roman', serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><ix:nonNumeric id="Fxbrl_20230501112936746" name="dei:SecurityExchangeName" contextRef="C_20230101to20231231" format="ixt-sec:exchnameen">Nasdaq</ix:nonNumeric> Capital Market</span></span></div>
                    </td>
