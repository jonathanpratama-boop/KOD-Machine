    <p style="margin-top:0pt;margin-bottom:0pt;font-size:10pt;font-family:Times New Roman, Times, serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">(1) &#160; &#160; &#160; &#160; &#160;See Note 9a.</span></span></p>
    <p style="margin-top:0pt;margin-bottom:0pt;font-size:10pt;font-family:Times New Roman, Times, serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">(2) &#160; &#160; &#160; &#160; &#160;See Note 9f.</span></span></p>
    <p style="margin-top:0pt;margin-bottom:0pt;font-size:10pt;font-family:Times New Roman, Times, serif">&#160;</p>
