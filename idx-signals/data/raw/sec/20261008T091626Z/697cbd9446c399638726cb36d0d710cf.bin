                    <div style="line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><ix:nonFraction id="Fxbrl_20230214162141286" name="us-gaap:StockIssuedDuringPeriodSharesStockOptionsExercised" contextRef="C_20230101to20231231" unitRef="shares" decimals="INF" format="ixt:fixed-zero">-</ix:nonFraction></span></span></div>
