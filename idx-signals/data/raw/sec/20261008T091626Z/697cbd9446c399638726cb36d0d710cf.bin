        <div style="line-height: 1.25">Revenue</div> </td>
    <td colspan="1" class="cftguttercell" style="vertical-align: bottom; vertical-align: bottom; width: 1%; padding-bottom: 4px; background-color: rgb(204, 238, 255)">&#160;</td>
