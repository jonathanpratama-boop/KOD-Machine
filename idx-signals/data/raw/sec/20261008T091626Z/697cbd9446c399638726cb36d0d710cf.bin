                            <div style="line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><ix:nonFraction id="FFact_0000000000412" name="us-gaap:Revenues" contextRef="C_20210101to20211231" unitRef="USD" scale="3" decimals="-3" format="ixt:num-dot-decimal">5,966</ix:nonFraction></span></span></div>
