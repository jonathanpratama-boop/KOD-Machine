                  </tr>
                  <tr>
                    <td style="vertical-align:top;background-color:#CCEEFF;width:88%;vertical-align:bottom">
                      <div style="line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><span><span><span><span>Total consideration</span></span></span></span></span></span></div>
