                      <div style="line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><span><span><span><span><ix:nonFraction id="Fxbrl_20240224182954721" name="us-gaap:BusinessCombinationConsiderationTransferred1" contextRef="C_20230801to20230808_usgaapBusinessAcquisitionAxis_lfwdAltergIncMember" unitRef="USD" scale="3" decimals="-3" format="ixt:num-dot-decimal">22,100</ix:nonFraction></span></span></span></span></span></span></div>
