                    <div style="line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><ix:nonFraction id="FFact_0000000000566" name="us-gaap:LesseeOperatingLeaseLiabilityPaymentsDueNextTwelveMonths" contextRef="C_20231231" unitRef="USD" scale="3" decimals="-3" format="ixt:num-dot-decimal">1,363</ix:nonFraction></span></span></div>
