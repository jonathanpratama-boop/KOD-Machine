ividualAxis_idai_VariousEmployeesMember_us-gaap_AwardTypeAxis_idai_GrantsMember_IYvN7Gnik0S_Ft2eoOHh8Q" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodValueIssuedForServices" scale="3" id="Narr_ZNCw17HLbU6KUHL5zgE-HA">369</ix:nonFraction> thousand, respectively, options totaling $<ix:nonFraction unitRef="Unit_Standard_USD_lQZOO5SlnUSXzPqjRQyH6g" contextRef="Duration_1_1_2022_To_12_31_2022_srt_TitleOfIndividualAxis_idai_VariousEmployeesMember_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_I5Yg-BapfUO42JyDvqmOtg" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodValueIssuedForServices" scale="3" id="Narr_jHXYtLBiX0Ojw3ZlkndFcw">57</ix:nonFraction> thousand and $<ix:nonFraction unitRef="Unit_Standard_USD_lQZOO5SlnUSXzPqjRQyH6g" contextRef="Duration_1_1_2021_To_12_31_2021_srt_TitleOfIndividualAxis_idai_VariousEmployeesMember_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_mi1zIAjRoU2dA4bRCJoLZA" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodValueIssuedForServices" scale="3" id="Narr_FBqSs7tiJ0iP_Ow87WtWNw">500</ix:nonFraction> thousand, respectively, and RSUs totaling $<ix:nonFraction unitRef="Unit_Standard_USD_lQZOO5SlnUSXzPqjRQyH6g" contextRef="Duration_1_1_2022_To_12_31_2022_srt_TitleOfIndividualAxis_idai_VariousEmployeesMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_AQcNWLmrBEWOy7OboosLNg" decimals="-4" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodValueIssuedForServices" scale="6" id="Narr_7S7c5bguSkKpAbL-sIFScw">1.80</ix:nonFraction> million and $<ix:nonFraction unitRef="Unit_Standard_USD_lQZOO5SlnUSXzPqjRQyH6g" contextRef="Duration_1_1_2021_To_12_31_2021_srt_TitleOfIndividualAxis_idai_VariousEmployeesMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_t0sB1REeLUK1EMU_Yv5N_g" decimals="-4" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodValueIssuedForServices" scale="6" id="Narr_T4rDSEc_fEq