pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> &#x2014;</p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#x200B;</span></p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;">Basic loss per share is computed using the weighted average number of the ordinary shares outstanding during the six months ended June 30, 2022 and 2023. Diluted loss per share is computed using the weighted average number of ordinary shares and ordinary equivalent shares outstanding during six months ended June 30, 2022 and 2023.</p></ix:nonNumeric><a id="Tc_-EzSC4IXQ0iWNSpnstA39A_1_2"></a><a id="Tc_oysjtB6QtE6nTNatdTGnfA_2_2"></a><a id="Tc_Na9v5NhUH0WPXY5e2eFgRA_2_4"></a><a id="Tc_Jh3oLgxwVUGl7a7NwV8ksg_3_2"></a><a id="Tc_nS22CxW4DUWfcoDQGi7n0A_3_4"></a><a id="Tc_yPbulBTrNESPkpF7hbuc5A_4_2"></a><a id="Tc_eNwTRG1OlEy1UNeAlfp2NQ_4_4"></a><a id="Tc_sqb_H4mBfUGoZQp9yGBoCA_5_0"></a><a id="Tc_CtYV8s4C-U6BU6VWVArUAg_1_2"></a><a id="Tc_ep6ShKFWOUa4DFaybpVDBg_2_2"></a><a id="Tc_kU5YRk1uXk-OdHNx9g1jpg_2_4"></a><a id="Tc_ewAWUUa-rEWTHqc57EFs_g_3_2"></a><a id="Tc_qWA_IEqn6kSqDEJeZniu2g_3_4"></a><a id="Tc_0dOkn2HqukuR0fU2-DdjvA_4_2"></a><a id="Tc_nzwxRYGTG0SDcTBHwAHivg_4_4"></a><a id="Tc_iKl2bU_2XEa2cbK21xETng_5_0"></a><a id="Tc_j0SpSNJHs0ORPGoPMIZhVA_6_0"></a><a id="Tc_GN_9DrxfZ06SNAIQKemMvA_1_2"></a><a id="Tc_gmdrnBRVqE2iVKDuHfbGpQ_2_2"></a><a id="Tc__Gf2DlTmy026SfTEqCwE5w_2_4"></a><a id="Tc_-vUe8qCJvUOb5xAaUhiosQ_3_2"></a><a id="Tc_RIQu-cbkZ0y94bCMy08cNQ_3_4"></a><a id="Tc_zwtLFI0GbkaSNw6KOwMkfA_4_0"></a><a id="Tc_EHjn2N6V4Uu_SWlFLFvkkQ_5_0"></a><a id="Tc_HSITjK_HrUaKX_g6_0zLUg_5_2"></a><a id="Tc_SPXs5-RBTE2wutwRkCZn2A_5_4"></a><a id="Tc_AuifA3oywEuUaCHHBSyvCQ_6_0"></a><a id="Tc_JBtBYjbuS0ykIV12LaQ2xg_7_0"></a><a id="Tc_bpC9j9mrpkOcOFwPEASxdA_7_3"></a><a id="Tc_MoOoB3U5FkO9MAsYUviKtA_7_5"></a><ix:nonNumeric contextRef="Duration_1_1_2