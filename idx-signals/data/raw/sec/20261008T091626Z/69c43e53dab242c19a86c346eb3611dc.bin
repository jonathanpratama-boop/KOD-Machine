uaHGg_9_2">700</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.22%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#xA0;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.79%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_fUwO6DKG90KmYldMzD9dsA" contextRef="As_Of_6_30_2023_R-JUnu0Qn0a7t8w1ozGufA" decimals="-3" format="ixt:numdotdecimal" name="ambo:AccruedLoansFromThirdPartiesCurrent" scale="3" id="Tc_UkwcQftXyUyG8Vw6CWEEbQ_9_4">3,450</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:69.93%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Others</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.22%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#x200B;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.82%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_fUwO6DKG90KmYldMzD9dsA" contextRef="As_Of_12_31_2022_oUFxkVN3Xkypg2k4gLCufw" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:OtherAccruedLiabilitiesCurrent" scale="3" id="Tc_PwMYLieIfkqVjXKRr5LJuA_10_2">171</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.22%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#xA0;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.79%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_fUwO6DKG90KmYldMzD9dsA" contextRef="As_Of_6_30_2023_R-JUnu0Qn0a7t8w1ozGufA" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:OtherAccruedLiabilitiesCurrent" scale="3" id="Tc_JnJ8L0INcUCjgEpZz-T4eg_10_4">220</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:69.93%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Total</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.22%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#x200B;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.82%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_fUwO6DKG90KmYldMzD9dsA" contextRef="As_Of_12_31_2022_oUFxkVN3Xkypg2k4gLCufw" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="3" id="Tc_a6jPHBUCUEyci2Y-p52vNg_11_2">3,702</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.22%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#xA0;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:12.79%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_fUwO6DKG90KmYldMzD9dsA" contextRef="As_Of_6_30_2023_R-JUnu0Qn0a7t8w1ozGufA" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="3" id="Tc_TZiuUYGlJUOAjC99VfHdSg_11_4">6,080</ix:nonFraction></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#x200B;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">(Note i) The loans from third-party providers have been fully repaid before the issuance of the condensed consolidated financial statements. </p></ix:nonNumeric></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#x200B;</span></p><ix:nonNumeric contextRef="Duration_1_1_2023_To_6_30_2023_FmyifzWZrUqI1SRppzo6AQ" name="us-gaap:StockholdersEquityNoteDisclosureTextBlock" id="Tb_z7_GGZfJmku1QUBhTaSmzg" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">10. ORDINARY SHARES</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;">The addition of ordinary shares during the six months ended June 30, 2023 came from a registered public offering in February 28, 2023.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">On February 28, 2023, the Company completed the issuance of <ix:nonFraction unitRef="Unit_Standard_shares_CwU6Z0g_GkOFK6pza3PC1A" contextRef="Duration_2_28_2023_To_2_28_2023_us-gaap_StatementClassOfStockAxis_dei_AdrMember_yrZiQaJsWEqTLe5i8FMPYg" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_SVlpLs1d_U6kXCtmjud-Lw">2,500,000</ix:nonFraction> ADSs (representing <ix:nonFraction unitRef="Unit_Standard_shares_CwU6Z0g_GkOFK6pza3PC1A" contextRef="Duration_2_28_2023_To_2_28_2023_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassAMember_Jgbkt2UgtUuqE5GdIRIl3A" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_YknSr0yQ0UeMvyvdy8K_Qw">5,000,000</ix:nonFraction> Class A Ordinary Shares of the Company) at a purchase price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_-1vc0epvCUeZzVmzHfuzqA" contextRef="As_Of_2_28_2023_bf3RByK7zE-1gcn-8LknKQ" decimals="2" format="ixt:numdotdecimal" name="us-gaap:SharesIssuedPricePerShare" scale="0" id="Narr_W9PRedQAvkeAfO7aMEHL6A">0.80</ix:nonFraction> per ADS and an accompanying warrant to purchase of <ix:nonFraction unitRef="Unit_Standard_shares_CwU6Z0g_GkOFK6pza3PC1A" contextRef="Duration_2_28_2023_To_2_28_2023_us-gaap_AwardTypeAxis_ambo_DirectOfferingMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_--v8SOHIXke7Qre-VGKrMw" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_o_Bq5UJ8_E-WdVBgJYuplQ">1,000,000</ix:nonFraction> ADSs (representing <ix:nonFraction unitRef="Unit_Standard_shares_CwU6Z0g_GkOFK6pza3PC1A" contextRef="Duration_2_28_2023_To_2_28_2023_us-gaap_AwardTypeAxis_ambo_DirectOfferingMember_us-gaap_StatementClassOfStockAxis_us-gaap_CommonClassAMember_bCwV_GX7kUuPXrqEUffkrA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_EvFpHobk9kauxzw-dNnQ1w">2,000,000</ix:nonFraction> Class A Ordinary Shares of the Company) at a purchase price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_-1vc0epvCUeZzVmzHfuzqA" contextRef="As_Of_2_28_2023_us-gaap_AwardTypeAxis_ambo_DirectOfferingMember_h99Ns44KR02t7IzteiNrXQ" decimals="2" format="ixt:numdotdecimal" name="us-gaap:SharesIssuedPricePerShare" scale="0" id="Narr_5m46wQrrc0uprb3TODSDxg">0.80</ix:nonFraction> per ADS, in a private placement. The net proceeds from the private placement, after deducting the offering expenses, totaled $<ix:nonFraction unitRef="Unit_Standard_USD_fUwO6DKG90KmYldMzD9dsA" contextRef="Duration_2_28_2023_To_2_28_2023_YpnxylB-iEydphuasXDL3Q" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:ProceedsFromIssuanceOrSaleOfEquity" scale="3" id="Narr_XguqILmwm02_RNiZCuYyTg">1,849</ix:nonFraction>, of which $<ix:nonFraction unitRef="Unit_Standard_USD_fUwO6DKG90KmYldMzD9dsA" contextRef="Duration_2_28_2023_To_2_28_2023_YpnxylB-iEydphuasXDL3Q" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:ProceedsFromIssuanceOfCommonStock" scale="3" id="Narr_Z4J-hrfcsEqeVDVA0HO0Jg">1,449</ix:nonFraction> was allocated to the ordinary shares and $<ix:nonFraction unitRef="Unit_Standard_USD_fUwO6DKG90KmYldMzD9dsA" contextRef="Duration_2_28_2023_To_2_28_2023_YpnxylB-iEydphuasXDL3Q" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:ProceedsFromIssuanceOfWarrants" scale="3" id="Narr_-y65KRP2v0O-7IFytb7OXg">400</ix:nonFraction> to the warrants, respectively. The Company classified the warrant in each of the aforementioned issuances on its consolidated balance sheets as equity, and valued the respective warrant issued in conjunction with private placements using the Black-Scholes model.</p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#x200B;</span></p><ix:nonNumeric contextRef="Duration_1_1_2023_To_6_30_2023_FmyifzWZrUqI1SRppzo6AQ" name="us-gaap:DisclosureOfCompensationRelatedCostsShareBasedPaymentsTextBlock" id="Tb_yIMaPfudIU-c0YULMCWQjQ" continuedAt="Tb_yIMaPfudIU-c0YULMCWQjQ_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">11. SHARE-BASED COMPENSATION</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#x200B;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">Amended and Restated 2010 Equity Incentive Plan</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#x200B;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">On June 1, 2010, the Group adopted the 2010 Equity Incentive Plan, or the &#x201C;2010 Plan&#x201D;, which became effective upon the completion of the IPO on August 5, 2010 and terminated automatically <ix:nonNumeric contextRef="Duration_6_1_2010_To_6_1_2010_us-gaap_PlanNameAxis_ambo_EquityIncentivePlan2010Member__MJvzMSdkkaUnjrCWqoRVg" format="ixt-sec:durwordsen" name="ambo:ShareBasedCompensationArrangementByShareBasedPaymentAwardAutomaticTerminationPeriodOfPlan" id="Narr_6G8T6vd9WkGvS3Z2n0PPzQ">ten years</ix:nonNumeric> after its adoption. On December 21, 2018, the Group amended and restated the 2010 Plan, or the &#x201C;Amended and Restated 2010 Plan&#x201D;, which became effective upon the approval from the Board of Directors and shareholders. The plan will continue in effect for <ix:nonNumeric contextRef="Duration_12_21_2018_To_12_21_2018_us-gaap_PlanNameAxis_ambo_AmendedAndRestatedEquityIncentivePlan2010Member_l1iKirO03kW-RmNxqojQjA" format="ixt-sec:durwordsen" name="ambo:ShareBasedCompensationArrangementsByShareBasedPaymentAwardOptionsExpirationTerm" id="Narr_DHFkuWYcD0m4tXJYIRVZyA">ten years</ix:nonNumeric> from the date adopted by the Board, unless terminated earlier under section 18 of the plan.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:underline;text-decoration-style:solid;visibility:hidden;">&#x200B;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">Restricted stock awards</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#x200B;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">On November 22, 2018, the Board of Directors approved to grant <ix:nonFraction unitRef="Unit_Standard_shares_CwU6Z0g_GkOFK6pza3PC1A" contextRef="Duration_11_22_2018_To_11_22_2018_srt_TitleOfIndividualAxis_srt_ExecutiveOfficerMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockMember_t2xkztDhLEq42jOFm3oegQ" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" scale="0" id="Narr_oL7k07f_H0aQ0eWaZ56Vuw">200,000</ix:nonFraction> Class A ordinary shares of the restricted stock to senior employees of the Group. <ix:nonFraction unitRef="Unit_Standard_pure_1BmhzUpiBkehOYq6oVxzbw" contextRef="Duration_11_22_2018_To_11_22_2018_srt_TitleOfIndividualAxis_srt_ExecutiveOfficerMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockMember_t2xkztDhLEq42jOFm3oegQ" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardAwardVestingRightsPercentage" scale="-2" id="Narr_2_U0gJJnRk6WsyLeuVTiZA">Twenty-five</ix:nonFraction> percent of the awards vested on the one-year anniversary of the vesting commence date, and the remainder shall vest in equal and continuous monthly installments over the following thirty-six months thereafter, subject to the participant&#x2019;s continuing service of the Group through each vesting date. In the six months ended June 30, 2023 and 2022, <ix:nonFraction unitRef="Unit_Standard_shares_CwU6Z0g_GkOFK6pza3PC1A" contextRef="Duration_1_1_2023_To_6_30_2023_srt_TitleOfIndividualAxis_srt_ExecutiveOfficerMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockMember_lwFm-2RyJUW3GBVgrXiyXA" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsVestedInPeriod" scale="0" id="Narr_ccIsrewZOkycZ-FTHHRUwg">nil</ix:nonFraction> and <ix:nonFraction unitRef="Unit_Standard_shares_CwU6Z0g_GkOFK6pza3PC1A" contextRef="Duration_1_1_2022_To_6_30_2022_srt_TitleOfIndividualAxis_srt_ExecutiveOfficerMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockMember_shftLC-fLUyr2qG9c33KlA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsVestedInPeriod" scale="0" id="Narr_FB5-LcRvrU2OG-eZnY3BRg">25,000</ix:nonFraction> shares of restricted stock were vested, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#x200B;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">On May 27, 2022, the Board of Directors approved the grant of <ix:nonFraction unitRef="Unit_Standard_shares_CwU6Z0g_GkOFK6pza3PC1A" contextRef="Duration_5_27_2022_To_5_27_2022_srt_TitleOfIndividualAxis_ambo_ConsultantMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockMember_8L24sa6IMkSmvLMmRwlnnA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" scale="0" id="Narr_JRubiOcuOUGkrIGYiqVq6A">200,000</ix:nonFraction> fully vested Class A ordinary shares of the restricted stock to a consultant as consideration for its service rendered. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#x200B;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">On June 30, 2022, the Board of Directors approved the grant of <ix:nonFraction unitRef="Unit_Standard_shares_CwU6Z0g_GkOFK6pza3PC1A" contextRef="Duration_1_1_2022_To_6_30_2022_srt_TitleOfIndividualAxis_srt_ExecutiveOfficerMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockMember_shftLC-fLUyr2qG9c33KlA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" scale="0" id="Narr_0jAy5knoC06fttVw0m3M5w">5,200,000</ix:nonFraction> fully vested Class A ordinary shares of the restricted stock to senior employees of the Group for their services rendered in the past years.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#x200B;</span></p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-12</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_yIMaPfudIU-c0YULMCWQjQ_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">The Group recorded share-based compensation expenses of $ <ix:nonFraction unitRef="Unit_Standard_CNY_C160STtrOEeWJdHPVaVtUA" contextRef="Duration_1_1_2022_To_6_30_2022_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockMember_us-gaap_IncomeStatementLocationAxis_us-gaap_GeneralAndAdministrativeExpenseMember_GoQlShKtzEaLA_oaREdLuA" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensation" scale="3" id="Narr_86NFuG3T_UuXFdxH_wsFhQ">1,037</ix:nonFraction> and <ix:nonFraction unitRef="Unit_Standard_CNY_C160STtrOEeWJdHPVaVtUA" contextRef="Duration_1_1_2023_To_6_30_2023_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockMember_us-gaap_IncomeStatementLocationAxis_us-gaap_GeneralAndAdministrativeExpenseMember_SZYQ3zhzWk-7aruhsBVcZg" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:ShareBasedCompensation" scale="3" id="Narr_FQtf3YHfY0a4LIcLCrja3Q">nil</ix:nonFraction> in general and administrative expenses for the restricted stock awards for the six months ended June 30, 2022 and 2023, respectively. The unrecognized share-based compensation expenses were amounting to <ix:nonFraction unitRef="Unit_Standard_CNY_C160STtrOEeWJdHPVaVtUA" contextRef="As_Of_6_30_2023_R-JUnu0Qn0a7t8w1ozGufA" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensatio