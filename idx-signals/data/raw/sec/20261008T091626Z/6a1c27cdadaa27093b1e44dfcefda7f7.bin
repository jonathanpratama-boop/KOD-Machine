    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c165" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebt" scale="0" unitRef="usd">4,791,716</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
