    <td style="text-align: left">$</td><td id="xdx_983_eus-gaap--CryptoAssetCost_iI_pn3n3_c20251231__srt--CryptoAssetAxis__custom--EDGEAITokensMember_zrZqTqW1iAih" title="Cost Basis" style="text-align: right"><ix:nonFraction name="us-gaap:CryptoAssetCost" contextRef="AsOf2025-12-31_custom_EDGEAITokensMember" id="Fact000929" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">318,633</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
