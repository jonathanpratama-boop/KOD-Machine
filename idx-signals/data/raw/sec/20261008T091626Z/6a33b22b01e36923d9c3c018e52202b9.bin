  <tr id="xdx_406_eus-gaap--DeferredTaxAssetsNetAbstract_iB_zseGu4gRBbjf" style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left">Deferred tax assets</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">&#160;&#160;&#160;</td><td style="text-align: left">&#160;</td></tr>
  <tr id="xdx_401_eus-gaap--DeferredTaxAssetsOperatingLossCarryforwards_i01I_pn3n3_maDTANzSzr_z9VogWs8tJr2" style="vertical-align: bottom; background-color: White">
