    <td colspan="2" id="xdx_49C_20221231_zq5Z9X7Of3G2" style="font-weight: bold; text-align: center">December 31,</td><td style="font-weight: bold">&#160;</td></tr>
  <tr style="vertical-align: bottom">
    <td>&#160;</td><td style="font-weight: bold">&#160;</td>
