    <td style="width: 1%; text-align: left">$</td><td style="width: 16%; text-align: right"><ix:nonFraction name="CING:PrepaidResearchAndDevelopment" contextRef="AsOf2022-12-31" format="ixt:numdotdecimal" decimals="0" unitRef="USD">1,377,391</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
