    <td colspan="2" style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center">Exercise Price</td><td style="font-weight: bold">&#160;</td><td style="font-weight: bold">&#160;</td>
    <td colspan="2" style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center">Term (years)</td><td style="font-weight: bold">&#160;</td><td style="font-weight: bold">&#160;</td>
