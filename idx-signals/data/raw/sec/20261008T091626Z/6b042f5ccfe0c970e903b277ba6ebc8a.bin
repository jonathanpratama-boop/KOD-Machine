					<TD CLASS="TB" STYLE="border-bottom-width:0pt;border-left-width:0pt;border-right-width:0pt;border-top-width:0pt;padding-bottom:3pt;padding-left:3pt;padding-right:3pt;padding-top:3pt;vertical-align:bottom;padding-left:0pt;padding-right:0pt;width: 13.68%; padding: 0in 0in 3px 0in;border-width: 0pt;" VALIGN="bottom">
						<P CLASS="Tbody_rightalign" STYLE="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:3pt;margin-top:0;orphans:1;page-break-after:auto;page-break-before:auto;text-align:right;text-indent:0;widows:1;margin-right:0pt;">2,790,003</P>
