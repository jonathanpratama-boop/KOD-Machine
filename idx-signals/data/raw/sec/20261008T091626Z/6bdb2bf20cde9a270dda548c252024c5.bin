            <td style="padding:3.25pt 0pt 2.5pt 0pt;border-bottom:3pt double #000000; min-width:30.75pt; text-align:right; white-space:nowrap;">5,513,138</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;">&#8203;</td>
