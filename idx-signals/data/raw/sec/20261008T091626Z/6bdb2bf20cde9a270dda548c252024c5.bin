            <td style="padding:3.5pt 0pt 2.5pt 0pt;border-bottom:1px solid #000000; min-width:33pt; text-align:right; white-space:nowrap;">6,506,384</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;border-bottom:1px solid #CCEEFF;">&#8203;</td>
