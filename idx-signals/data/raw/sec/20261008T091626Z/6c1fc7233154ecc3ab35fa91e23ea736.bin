t-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_9_30_2024_3Rz0r8n1b0i6p2SS894NKA" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:AccrualsClassifiedAsCurrent" scale="0" id="Tc_XnaRQG__3EqZ2hFrWVEc2g_4_2">12,019</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.51%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:AccrualsClassifiedAsCurrent" scale="0" id="Tc_psgXl5ziR0Ck7-i7ckjdNQ_4_4">125,951</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:75.03%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Provisions</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.51%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_9_30_2024_3Rz0r8n1b0i6p2SS894NKA" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:OtherShorttermProvisions" scale="0" id="Tc_doM8ZNA3eEmVwIqq4xDC1Q_5_2">40,926</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.51%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:OtherShorttermProvisions" scale="0" id="Tc_n1ZuZ9jbAkCWfFsAf3sI7w_5_4">66,899</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:75.03%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">Total</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.51%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_9_30_2024_3Rz0r8n1b0i6p2SS894NKA" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:TradeAndOtherCurrentPayables" scale="0" id="Tc_dF9_VzEzdUOh8zUZFp9IJw_6_2">858,558</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.51%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">&#160;</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.96%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_3_31_2024_EiwkkH6IfUecKbw6GMI-OQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:TradeAndOtherCurrentPayables" scale="0" id="Tc__njo0T0MWE2YT5zREag7bg_6_4">755,202</ix:nonFraction></b></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;">Included in trade payables is an amount of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2024_To_9_30_2024_7K5_E20a7kOIviXv5d41-A" decimals="0" format="ixt:num-dot-decimal" name="pbm:ShareSettledIssuanceCostsCostsSettled" scale="0" id="Narr_l9wk9vGPvk6eRgw0_k0OzA">93,750</ix:nonFraction> of share settled share issuance costs not yet settled. Refer Note 12.</p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><a id="_2fc83c67_ceea_4444_bcd6_665760adc218"></a><a id="_8573057c_116a_4a88_937a_0cd3ae2362ee"></a><ix:nonNumeric contextRef="Duration_4_1_2024_To_9_30_2024_7K5_E20a7kOIviXv5d41-A" name="pbm:DisclosureOfConvertibleNoteLiabilityTextBlock" id="Tb_iKwuWS25J0-VLM1xE5kHlg" continuedAt="Tb_iKwuWS25J0-VLM1xE5kHlg_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">8. Convertible note liability</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">During the prior fiscal year, the Company entered into a securities purchase agreement with Harraden Circle Investments, LLC <b style="font-weight:bold;">(&#8220;Investor&#8221;)</b>, relating to up to <ix:nonFraction unitRef="Unit_Standard_item_s-l1VIqG9Uanppx6r9y-Ww" contextRef="As_Of_1_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_h6udegDZ0kKohWWoFyiUyg" decimals="INF" format="ixt-sec:numwordsen" name="pbm:NumberOfSeniorSecuredConvertibleNotesCollectivelyAsNotes" scale="0" id="Narr_Sf5qkpBD0ES1tk3fLIOHQQ">four</ix:nonFraction> senior secured convertible notes, obligations under which are guaranteed by certain assets of the Company. Issuable to the Investors for the aggregate principal amount of up to $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_1_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_STYyJ_8sP0yElEPlFiZgKg" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtInstrumentFaceAmount" scale="0" id="Narr_ut_LuU9pKUeAU5Hb-k3WIA">12,500,000</ix:nonFraction> in exchange for up to $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_1_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_STYyJ_8sP0yElEPlFiZgKg" decimals="0" format="ixt:num-dot-decimal" name="pbm:SubscriptionAmount" scale="0" id="Narr_Nv17RAo8tU2gm4s2YMQvGw">10,000,000</ix:nonFraction> in cash subscription amounts (the &#8220;Convertible Note Financing&#8221;).</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The First Tranche Notes, for an aggregate of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember__eybCCZqUkqWJLQvEBcifA" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:NotionalAmount" scale="0" id="Narr_YA79ay4PnU-QwVdrmydGvQ">3,125,000</ix:nonFraction> principal, were delivered by the Company to the Investors on listing, in exchange for an aggregate of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_1_25_2024_To_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_fmPXwO1w-UaQ9kanIMCxfg" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsProceedsFromConvertibleDebt" scale="0" id="Narr_jNn4mfFAnU-HrokLcyoH9Q">2,500,000</ix:nonFraction> in financing. On the original issuance date of the First Tranche Notes, interest began accruing at <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_CN31Z1lyBEmawH1JkTiPCg" decimals="3" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_LpR2A-NGZEmLbotWi9bIZA">8.0</ix:nonFraction>% per annum based on the outstanding principal amount of the First Tranche Notes and is payable monthly in arrears in cash or in common shares of the Company at the Conversion Price. The maturity date of the First Tranche Notes is January 25, 2027.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The Second Tranche Notes, for an aggregate of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_SecondTrancheNoteMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_by4vGXLPV0ipbop8OhX0OQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:NotionalAmount" scale="0" id="Narr_v1QGMR0aDkWd3aZFZ7q-Og">1,000,000</ix:nonFraction> principal, were delivered by the Company to the Investors, in exchange for an aggregate of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_1_25_2024_To_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_SecondTrancheNoteMember_srt_StatementScenarioAxis_pbm_UntilFirstResetDateMember_iJjDJSsQyUqoJH7u5C5lKQ" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsProceedsFromConvertibleDebt" scale="0" id="Narr_SXAUoenbnk6CKZQT6xOMFg">1,250,000</ix:nonFraction> in financing. On the original issuance date of the Second Tranche Notes, interest began accruing at <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_1_25_2024_ifrs-full_BorrowingsByNameAxis_pbm_SecondTrancheNoteMember_srt_StatementScenarioAxis_pbm_OnSecondResetDateMember_l0FG0W1rQEeeU3VOWy-SiQ" decimals="3" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_dAZDpVz0m06jbNEQd01KOQ">8.0</ix:nonFraction>% per annum based on the outstanding principal amount of the Second Tranche Notes and is payable monthly in arrears in cash or in common shares of the Company at the Conversion Price. The maturity date of the First Tranche Notes is May 31, 2027.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On August 20, 2024, the Company and the Investor signed an addendum to the securities purchase agreement, which requires the Investor to convert the outstanding notes into common shares as soon as possible, within the limits of the agreement. As part of the Addendum, the Investor received 13,333 common shares and 6,667 warrants with a <ix:nonNumeric contextRef="Duration_8_20_2024_To_8_20_2024_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_pZEeDuRdXEWv70OsgB-WQA" format="ixt-sec:durwordsen" name="pbm:IfrsWarrantsAndRightsOutstandingTerm" id="Narr_kP2Ij3Ui8U-AnJIifxyhgg">two-year</ix:nonNumeric> expiry, exercisable at $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_8_20_2024_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_zQYVwnO020qSAt5y0pAo3g" decimals="2" format="ixt:num-dot-decimal" name="pbm:IfrsClassOfWarrantOrRightExercisePriceOfWarrantsOrRights" scale="0" id="Narr_H0DjxdzS6UmZcXd3ol077w">37.50</ix:nonFraction> per share.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The First Tranche Note was fully converted into common shares as of September 30, 2024.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Second Tranche Note: $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2024_To_9_30_2024_ifrs-full_BorrowingsByNameAxis_pbm_SecondTrancheNoteMember_GmsMzDQR50yt2joou9zv6g" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtConversionOriginalDebtAmount" scale="0" id="Narr_ApsuLbo_1E2-sZcye-RJSA">1,087,790</ix:nonFraction> of the $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_9_30_2024_ifrs-full_BorrowingsByNameAxis_pbm_SecondTrancheNoteMember_PogFNbW7v0CUYY5zCSKsRQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:NotionalAmount" scale="0" id="Narr_hkMpP9VJyUWVtRrl_U8iDg">1,250,000</ix:nonFraction> principal was converted by September 30, 2024, leaving an outstanding principal balance of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_9_30_2024_ifrs-full_BorrowingsByNameAxis_pbm_SecondTrancheNoteMember_PogFNbW7v0CUYY5zCSKsRQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:Borrowings" scale="0" id="Narr_H2I2e24LW0KiYxapUu2zjQ">162,210</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The Company has designated the entire instrument as an FVTPL instrument.</p></ix:nonNumeric></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:24pt 0pt 0pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td><td style="vertical-align:top;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman'