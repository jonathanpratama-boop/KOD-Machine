<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:none;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">PSYENCE BIOMEDICAL LTD.</b></p></td></tr><tr><td style="vertical-align:top;width:100%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">Condensed Consolidated Interim Financial Statements (unaudited)</b></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:none;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><a id="Tc_MaXup7VY2EKDp9KCBT9SEQ_1_2"></a><a id="Tc_IQp-TZofsUqhrZTQPXWbiw_2_0"></a><a id="Tc_Rm2dRPeAhka-hKuCw0iYAw_3_0"></a><a id="Tc_MvJihaCzYUmU0wtl7uM-kw_4_0"></a><a id="Tc_44qsayxWrkuuI850095_9g_5_0"></a><a id="Tc_zfAzSrjbSkGmgaqZGDXReQ_5_3"></a><a id="Tc_SUTVCSLX0Ey2GUKgwzTc_Q_6_0"></a><a id="Tc_-IJ5ia0qUE6xbA0t8iLRKA_6_3"></a><a id="Tc_JVsHNy6-yU6Py0iVpwsgDg_7_0"></a><a id="Tc_d_CXtSbtYUWgoJwmadNihQ_7_3"></a><a id="Tc_XR4KogHDlEihuAOzq7g38A_8_0"></a><a id="Tc_jX2qQ6MrQky24hWGjtl4UQ_8_3"></a><a id="Tc_fBDubSlLnU2u4g7z0_5t6g_9_0"></a><a id="Tc_44PODqQJOEyVwVBHe9btYQ_9_3"></a><a id="Tc_mr1gHYZOfUGJU4TscJKVfA_10_0"></a><a id="Tc_Kj9VpKbtPUy1k6VHWWCPmA_10_3"></a><a id="Tc_thIFuqwEr02t2sMPZV-goQ_1_2"></a><a id="Tc_8R4H2IKkaESnrr6ATkdV8A_2_2"></a><a id="Tc_6_zq-U-90UeE7WqyhDRD3w_3_0"></a><a id="Tc_W2QcpWzAx0iyzV8Ago3bZg_4_0"></a><a id="Tc_6AZLd2qMsEuVGtx9V0esaQ_5_0"></a><a id="Tc_gH8CGt2fBkWMrkDYpFFCFg_6_0"></a><a id="Tc_nWzAoPIRCUuhFgokiJBejA_6_3"></a><a id="Tc_9N2sCEr1_0ikv3HFE1GfVA_7_0"></a><a id="Tc_TtCmHsdbg0OGCeFw55fQ6A_8_0"></a><a id="Tc_noTlotzDaEylYtxXVvPwtg_8_3"></a><a id="Tc_oba-5YNrBEaHw2HXUIRruQ_9_0"></a><a id="Tc_X4gAMPwZEUuJBr2RVjhpZw_9_2"></a><ix:continuation id="Tb_iKwuWS25J0-VLM1xE5kHlg_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Total proceeds received were $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2024_To_9_30_2024_ifrs-full_BorrowingsByNameAxis_pbm_FirstTrancheNoteMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_InvestorsMember_3PENp_xc0kiZfwHpMirsTA" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsProceedsFromConvertibleDebt" scale="0" id="Narr_ZYZia6ZKuUOTI0fmrkNUhQ">1,000,000</ix:nonFraction>. The fair value of the convertible notes was estimated using a combined discounted cash flow approach and Monte Carlo simulation with the following assumptions as of September 30, 2024.</p><ix:nonNumeric contextRef="Duration_4_1_2024_To_9_30_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_r2OvuFrWcE2QuUIKboGEWw" name="ifrs-full:DisclosureOfSignificantUnobservableInputsUsedInFairValueMeasurementOfLiabilitiesExplanatory" id="Tb_bmgQVyl1b0KmtdsqneM83Q" escape="true"><p style="font-family:'Times N