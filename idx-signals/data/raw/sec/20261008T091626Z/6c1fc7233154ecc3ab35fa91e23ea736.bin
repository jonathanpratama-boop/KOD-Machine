t 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_4_1_2024_To_9_30_2024_ifrs-full_ComponentsOfEquityAxis_ifrs-full_IssuedCapitalMember_mmPr9JMtEEWXj54OjlTeng" decimals="INF" format="ixt:num-dot-decimal" name="pbm:StockIssuedDuringPeriodSharesConversionOfPromissoryNotes" scale="0" id="Tc_nnOv5te_R0-cX9WA6HPB-A_8_2">70,759</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.41%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.5%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2024_To_9_30_2024_ifrs-full_ComponentsOfEquityAxis_ifrs-full_IssuedCapitalMember_mmPr9JMtEEWXj54OjlTeng" decimals="0" format="ixt:num-dot-decimal" name="pbm:IncreaseDecreaseThroughConversionOfPromissoryNotesEquity" scale="0" id="Tc_xuIhprJIL0-9DEPqpoZ5Eg_8_4">530,692</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:76.14%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Share issuance costs</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.41%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.51%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> &#8212;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.41%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.5%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 0pt 0.05pt 0pt;"> (<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2024_To_9_30_2024_ifrs-full_ComponentsOfEquityAxis_ifrs-full_IssuedCapitalMember_mmPr9JMtEEWXj54OjlTeng" decimals="0" format="ixt:num-dot-decimal" name="pbm:DecreaseThroughStockIssuanceCostsEquity" sign="-" scale="0" id="Tc_sfczWqH0tUeBXwL5A4yaCg_9_4">278,141</ix:nonFraction>)</p></td></tr><tr><td style="vertical-align:bottom;width:76.14%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Balance as at September 30,</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.41%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.51%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="As_Of_9_30_2024_ifrs-full_ComponentsOfEquityAxis_ifrs-full_IssuedCapitalMember_nPtmHZLoUkiqhImaVk764Q" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfSharesOutstanding" scale="0" id="Tc_e2EckD4gCU6-fYIXuiaAPQ_10_2">605,789</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.41%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.5%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_9_30_2024_ifrs-full_ComponentsOfEquityAxis_ifrs-full_IssuedCapitalMember_nPtmHZLoUkiqhImaVk764Q" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:Equity" scale="0" id="Tc_SjfWbjjAdke375GzmoSmMA_10_4">52,940,688</ix:nonFraction></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Common shares</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><i style="font-style:italic;">Conversion of convertible note liability</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On May 15, 2024, a conversion notice was received for a principal amount of USD $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_5_15_2024_To_5_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_lMFaQ8H9rE-p9Qg5i8IMWQ" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtConversionOriginalDebtAmount1" scale="0" id="Narr_9DeVRaNlL0-ypVDqy2RRcw">70,000</ix:nonFraction>. This amount converted at a VWAP of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="Duration_5_15_2024_To_5_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_lMFaQ8H9rE-p9Qg5i8IMWQ" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtConversionVolumeWeightedAveragePricePerShare" scale="0" id="Narr_urnXwsjr6EGAQ-69zAY7tA">40.21</ix:nonFraction> per share, resulting in the issuance of <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_5_15_2024_To_5_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_lMFaQ8H9rE-p9Qg5i8IMWQ" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleNotes" scale="0" id="Narr_XOHgG7xeFk6xb44Y_UHCHw">1,741</ix:nonFraction> shares.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On June 20, 2024, a conversion notice was received for a principal amount of USD $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_6_20_2024_To_6_20_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_CsIOMxfNg0-uHo3Ze2akGQ" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtConversionOriginalDebtAmount1" scale="0" id="Narr_i5btUwaoFkmrWI5T7my86g">1,072,200</ix:nonFraction>. This converted at a VWAP of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="Duration_6_20_2024_To_6_20_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_CsIOMxfNg0-uHo3Ze2akGQ" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtConversionVolumeWeightedAveragePricePerShare" scale="0" id="Narr_0-mBjJQI9USkDCy3sYR3LA">40.21</ix:nonFraction> per share, leading to the issuance of <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_6_20_2024_To_6_20_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_CsIOMxfNg0-uHo3Ze2akGQ" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleNotes" scale="0" id="Narr_1kEwbh5jM0yhRIPWieVarg">26,667</ix:nonFraction> shares.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Concurrently, the Company&#8217;s issued <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_5_15_2024_To_5_15_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_lMFaQ8H9rE-p9Qg5i8IMWQ" decimals="INF" format="ixt:num-dot-decimal" name="pbm:StockIssuedDuringPeriodSharesIssuedForDebtSettlement" scale="0" id="Narr_FUtfuoAel06P6qqqy7DG6w">1,157</ix:nonFraction> shares on May 15, 2024, and <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_6_20_2024_To_6_20_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_CsIOMxfNg0-uHo3Ze2akGQ" decimals="INF" format="ixt:num-dot-decimal" name="pbm:StockIssuedDuringPeriodSharesIssuedForDebtSettlement" scale="0" id="Narr_YBufthbTSUS8t_T9Q0AVeg">1,047</ix:nonFraction> shares on June 20, 2024, to cover outstanding interest on the outstanding principal at a VWAP of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="Duration_6_20_2024_To_6_20_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_CsIOMxfNg0-uHo3Ze2akGQ" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtConversionVolumeWeightedAveragePricePerShare" scale="0" id="Narr_yoG68qALW0aiJvU37PuHnQ">40.21</ix:nonFraction> per share.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On August 20, 2024, a conversion notice was received for a principal amount of USD $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_8_20_2024_To_8_20_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_hPBYv_KRkEuTXwmEqp-ETw" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtConversionOriginalDebtAmount1" scale="0" id="Narr_bes0RjdW_E2Xpk4crNAmLw">161,786</ix:nonFraction>. This converted at a VWAP of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="Duration_8_20_2024_To_8_20_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_hPBYv_KRkEuTXwmEqp-ETw" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtConversionVolumeWeightedAveragePricePerShare" scale="0" id="Narr_b5psqFFZh0u4vUJr31c7qg">28.13</ix:nonFraction> per share, leading to the issuance of <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_8_20_2024_To_8_20_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_hPBYv_KRkEuTXwmEqp-ETw" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleNotes" scale="0" id="Narr_yxXI-tQLZECDoTmYPAFodg">5,751</ix:nonFraction> shares. Additionally, the Company signed an addendum with the holder of the convertible note liability, for <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_8_20_2024_To_8_20_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_hPBYv_KRkEuTXwmEqp-ETw" decimals="INF" format="ixt:num-dot-decimal" name="pbm:StockIssuedDuringPeriodCommonSharesConversionOfNotesRemainingPrincipalAmount" scale="0" id="Narr_YGlX6hred0KoSgwgznYKWA">13,333</ix:nonFraction> common shares, which requires the holder to convert the remaining outstanding principal amounts under the convertible note liability.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On September 4, 2024, a conversion notice was received for a principal amount of USD $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_9_4_2024_To_9_4_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_rdRMZ2rgYEi5SkiWwaIsgw" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtConversionOriginalDebtAmount1" scale="0" id="Narr_0X_d0yKukUWqqj1LlOpHaA">675,180</ix:nonFraction>. This converted at a VWAP of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="Duration_9_4_2024_To_9_4_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_rdRMZ2rgYEi5SkiWwaIsgw" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtConversionVolumeWeightedAveragePricePerShare" scale="0" id="Narr_T_V-oFIYQEqUpyUJUgUCBw">28.13</ix:nonFraction> per share, leading to the issuance of <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_9_4_2024_To_9_4_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_rdRMZ2rgYEi5SkiWwaIsgw" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleNotes" scale="0" id="Narr_m4LX8Vp3X0KZji7rJQfLEw">24,000</ix:nonFraction> shares.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On September 6, 2024, a conversion notice was received for a principal amount of USD $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_9_6_2024_To_9_6_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_8lzRq419xU-263qulAD2NQ" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtConversionOriginalDebtAmount1" scale="0" id="Narr_KP2Ize5C3UqtcjoeuhChqA">375,100</ix:nonFraction>. This converted at a VWAP of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="Duration_9_6_2024_To_9_6_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_8lzRq419xU-263qulAD2NQ" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtConversionVolumeWeightedAveragePricePerShare" scale="0" id="Narr_75lVFQBcrEK_dsAcbimZ5g">28.13</ix:nonFraction> per share, leading to the issuance of <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_9_6_2024_To_9_6_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_8lzRq419xU-263qulAD2NQ" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleNotes" scale="0" id="Narr_jKvVx-iTHkyTK6hiKi-7Ag">13,333</ix:nonFraction> shares.</p></ix:nonNumeric></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:24pt 0pt 0pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td><td style="vertical-align:top;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:12pt 0pt 0pt 0pt;"><img src="pbm-20240930xex99d1002.jpg" alt="Graphic" style="display:inline-block;height:60.38pt;left:0%;padding-bottom:0pt;position:relative;top:0pt;width:87.84pt;"/></p></td><td style="vertical-align:bottom;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;">16</p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:none;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">PSYENCE BIOMEDICAL LTD.</b></p></td></tr><tr><td style="vertical-align:top;width:100%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">Condensed Consolidated Interim Financial Statements (unaudited)</b></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:none;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><ix:continuation id="Tb_n7mmcDokZUaCdEjR3EbRnA_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On September 10, 2024, a conversion notice was received for a principal amount of USD $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_9_10_2024_To_9_10_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_6XkjmgOQsEWmb0BxcS_lfA" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtConversionOriginalDebtAmount1" scale="0" id="Narr_sKQwp2O2P0-iRupzroGHoQ">600,160</ix:nonFraction>. This converted at a VWAP of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="Duration_9_10_2024_To_9_10_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_6XkjmgOQsEWmb0BxcS_lfA" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtConversionVolumeWeightedAveragePricePerShare" scale="0" id="Narr_Hoxw3Pk0B0KhR_IE22sQow">28.13</ix:nonFraction> per share, leading to the issuance of <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_9_10_2024_To_9_10_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_6XkjmgOQsEWmb0BxcS_lfA" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleNotes" scale="0" id="Narr_Pi9pVWQ2a0enssZXaZwKHA">21,333</ix:nonFraction> shares.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On September 19, 2024, a conversion notice was received for a principal amount of USD $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_9_19_2024_To_9_19_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_HnnH2qccDkS79mhVuk1fwg" decimals="0" format="ixt:num-dot-decimal" name="pbm:IfrsDebtConversionOriginalDebtAmount1" scale="0" id="Narr_t7inAC9lqkmIFvmRmufuYg">1,258,364</ix:nonFraction>. This converted at a VWAP of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="Duration_9_19_2024_To_9_19_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_HnnH2qccDkS79mhVuk1fwg" decimals="2" format="ixt:num-dot-decimal" name="pbm:DebtConversionVolumeWeightedAveragePricePerShare" scale="0" id="Narr_OZuUd0g43U2Xr5vVxjm_9w">28.13</ix:nonFraction> per share, leading to the issuance of <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_9_19_2024_To_9_19_2024_ifrs-full_BorrowingsByNameAxis_pbm_IfrsConvertibleDebtMember_HnnH2qccDkS79mhVuk1fwg" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleNotes" scale="0" id="Narr_ilANkdRHWEGY5KV-3--HzA">44,730</ix:nonFraction> shares. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><i style="font-style:italic;">ELOC</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On August 28, 2024, the Company entered into a $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_8_28_2024_DHSsInjKDUWlz68J8S7I0A" decimals="-6" format="ixt:num-dot-decimal" name="pbm:EquityLineOfCreditNotionalAmount" scale="6" id="Narr_cttBfdEFpkyqPqqxMyNoxA">25</ix:nonFraction> million equity line of credit (ELOC) agreement with White Lion Capital, LLC, which was declared effective by the U.S. Securities and Exchange Commission (SEC). This agreement allows the Company to sell up to $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="As_Of_8_28_2024_DHSsInjKDUWlz68J8S7I0A" decimals="-6" format="ixt:num-dot-decimal" name="pbm:EquityLineOfCreditMaximumValueOfSharesAuthorized" scale="6" id="Narr_TwXpJ_fw80KH-YQefDKmDg">25</ix:nonFraction> million in shares over a <ix:nonNumeric contextRef="Duration_8_28_2024_To_8_28_2024_9IfqbKepYEaw5Zh6Pk1yDw" format="ixt-sec:durwordsen" name="pbm:EquityLineOfCreditTermOfAgreement" id="Narr_Qj4K0tFY50iNAGpjmLN1cw">24-month</ix:nonNumeric> period, subject to specific conditions outlined in the Purchase Agreement.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">As part of the consideration for entering into the ELOC, the Company issued <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_8_28_2024_To_8_28_2024_9IfqbKepYEaw5Zh6Pk1yDw" decimals="INF" format="ixt:num-dot-decimal" name="pbm:StockIssuedDuringPeriodSharesEquityLineOfCredit" scale="0" id="Narr_TNMTsyjRVUWDrm_gRg4b4Q">2,328</ix:nonFraction> common shares to White Lion as a commitment fee. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Between August 30, 2024 and September 30, 2024, the Company issued <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_9_1_2024_To_9_30_2024_p9tS38dtYkKBP5TjXSsjOA" decimals="INF" format="ixt:num-dot-decimal" name="pbm:StockIssuedDuringPeriodSharesEquityLineOfCredit" scale="0" id="Narr_Cn9OY3q2QUytHPJmKdBfHw">187,600</ix:nonFraction> common shares for gross proceeds of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_9_1_2024_To_9_30_2024_p9tS38dtYkKBP5TjXSsjOA" decimals="0" format="ixt:num-dot-decimal" name="pbm:StockIssuedDuringPeriodValueEquityLineOfCredit" scale="0" id="Narr_0eZtHwtn3kK6VSQG0HEGtw">1,891,030</ix:nonFraction>, with an issuance share price range of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_9_30_2024_ifrs-full_RangeAxis_ifrs-full_BottomOfRangeMember_rAiZRw3DjEWIDm-bThLhuA" decimals="2" format="ixt:num-dot-decimal" name="pbm:IfrsSharesIssuedPricePerShare" scale="0" id="Narr_xK6CCqOONUqzd2bdRmsigQ">7.95</ix:nonFraction> - $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_9_30_2024_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_fpjpAWNAtEWJl1VvRGzEcQ" decimals="2" format="ixt:num-dot-decimal" name="pbm:IfrsSharesIssuedPricePerShare" scale="0" id="Narr_FD8ePonUC0u2L7aGr46rHQ">30.38</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The Company incurred cash settled share issuance costs of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2024_To_9_30_2024_7K5_E20a7kOIviXv5d41-A" decimals="0" format="ixt:num-dot-decimal" name="pbm:CashSettledShareIssuanceCosts" scale="0" id="Narr_RUDN2N-mpkqHxSA8fuk89Q">92,179</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2024_To_9_30_2024_7K5_E20a7kOIviXv5d41-A" decimals="0" format="ixt:num-dot-decimal" name="pbm:ShareSettledIssuanceCostsCostsSettled" scale="0" id="Narr_DOu5fazDAkeWCm-MurCVUg">93,750</ix:nonFraction> share settled issuance costs relating to the ELOC.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><i style="font-style:italic;">Warrant exchange</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">In July, 2024, the Company completed a warrant exchange agreement with a third-party investor of warrants to purchase the Company&#8217;s common shares, <ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_7_31_2024_nzI1jkOqA0G2bVKz3wjY5A" decimals="INF" format="ixt-sec:numwordsen" name="ifrs-full:ParValuePerShare" scale="0" id="Narr_nO6d6lZCO0uEtS-RnFApNA">no</ix:nonFraction> par value per share, which warrants are currently trading on Nasdaq. Pursuant to the Warrant Exchange Agreement, the Company issued to the Holder <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_7_1_2024_To_7_31_2024_bdP4wkfYt0CYEo33CC14wQ" decimals="INF" format="ixt:num-dot-decimal" name="pbm:StockIssuedDuringPeriodSharesExchangeOfWarrants" scale="0" id="Narr_qEMhRcuuG0eP1XjRl5PE4A">8,800</ix:nonFraction> Common Shares in exchange for the surrender and cancellation of <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_7_1_2024_To_7_31_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_pbm_PublicWarrantsMember_AAtPfvEpx0mJVwqy730uuA" decimals="INF" format="ixt:num-dot-decimal" name="pbm:NumberOfWarrantsExchanged" scale="0" id="Narr_8h9CITYcq0-0jcsTTA-QDw">8,800</ix:nonFraction> Public Warrants held by the Holder.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The company recognised a fair value loss of $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2024_To_9_30_2024_7K5_E20a7kOIviXv5d41-A" decimals="0" format="ixt:num-dot-decimal" name="pbm:FairValueAdjustmentOfWarrantExchange" scale="0" id="Narr_JNs0ruyiBk-a3qo4gBImRw">185,064</ix:nonFraction> in the statement of net profit/(loss) and comprehensive profit/(loss).</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><i style="font-style:italic;">Issuance of shares to third party advisors</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">In May and August 2024, the Company issued <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_5_1_2024_To_5_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_UnsecuredConvertiblePromissoryNotesMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_NcacSponsorMember_XVJy0OqILkaZXyLCYk3YhA" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesIssuedForServices" scale="0" id="Narr_HWxikgXVgUS4PO2Z_NOqPg"><ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_8_1_2024_To_8_31_2024_ifrs-full_BorrowingsByNameAxis_pbm_UnsecuredConvertiblePromissoryNotesMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_NcacSponsorMember_2RN0A6RL-0abQzzS7XEbkA" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesIssuedForServices" scale="0" id="Narr_ooPCMnQagE6oDeGakDqWLQ">4,667</ix:nonFraction></ix:nonFraction> common shares to various third party advisors in exchange for professional services.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><i style="font-style:italic;">Conversion of promissory notes</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On September 30, 2024, the NCAC Note holder <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_4_1_2024_To_9_30_2024_ifrs-full_BorrowingsByNameAxis_pbm_UnsecuredConvertiblePromissoryNotesMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_NcacSponsorMember_NTMn_n1mQ06BSpeXRaz3_Q" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleNotes" scale="0" id="Narr_RUit3mpaVEm-FGCnDCluHw">43,080</ix:nonFraction> common shares at a conversion price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_9_30_2024_ifrs-full_BorrowingsByNameAxis_pbm_UnsecuredConvertiblePromissoryNotesMember_ifrs-full_CategoriesOfRelatedPartiesAxis_pbm_NcacSponsorMember_Azu0viSjCESgdkX2WtaVPw" decimals="2" format="ixt:num-dot-decimal" name="pbm:IfrsDebtInstrumentConvertibleConversionPrice" scale="0" id="Narr_xCBwuml1Z0-DGI8vlqZK1w">37.50</ix:nonFraction> per share and the PGI Note holder converted <ix:nonFraction unitRef="Unit_Standard_shares_pvyiikKkpUa41tyBo3imug" contextRef="Duration_4_1_2024_To_9_30_2024_ifrs-full_BorrowingsByNameAxis_pbm_UnsecuredConvertiblePromissoryNotesMember_ifrs-full_CategoriesOfRelatedPartiesAxis_ifrs-full_ParentMember_TTCoqzrwkUiuX-KYUpVnpg" decimals="INF" format="ixt:num-dot-decimal" name="pbm:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleNotes" scale="0" id="Narr_a1y2kSM1dkuGyzQcTHo4Ug">27,679</ix:nonFraction> common shares at a conversion price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_I9kD_MQ8ME-OHUtxweJqhw" contextRef="As_Of_9_30_2024_ifrs-full_BorrowingsByNameAxis_pbm_UnsecuredConvertiblePromissoryNotesMember_ifrs-full_CategoriesOfRelatedPartiesAxis_ifrs-full_ParentMember_-IK-PZThH0uxK38yEW-_eg" decimals="2" format="ixt:num-dot-decimal" name="pbm:IfrsDebtInstrumentConvertibleConversionPrice" scale="0" id="Narr_CBUMWfhnH0mBe_gf1R55ew">37.50</ix:nonFraction> per share.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">c) Profit/loss per share</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The calculation of basic and diluted profit/loss per share is based on the profit/loss for the period divided by the weighted average number of shares in circulation during the period. In calculating the diluted loss per share, potentially dilutive shares such as warrants have been included.</p></ix:continuation><ix:nonNumeric contextRef="Duration_4_1_2024_To_9_30_2024_7K5_E20a7kOIviXv5d41-A" name="pbm:LoanTextBlock" id="Tb_gHPRyTnDO0-pYFdTQGkKkQ" continuedAt="Tb_gHPRyTnDO0-pYFdTQGkKkQ_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">13. Loan</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">On August&#160;21, 2023 the Company entered into a loan agreement via its Australian subsidiary Psyence Australia (Pty) Ltd (the &#8220;<b style="font-weight:bold;">Borrower</b>&#8221;), to borrow up to AUD $<ix:nonFraction unitRef="Unit_Standard_AUD_Me9Ytye66U-q19_KJ8lC-g" contextRef="As_Of_8_21_2023_ifrs-full_BorrowingsByNameAxis_pbm_LoanFromRhCapitalFinanceCoLlcMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_t8uNXPBKF0e38Vaxq6nIaw" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:NotionalAmount" scale="0" id="Narr_SF0T5ve_00eUbAEoFMR1eQ">1,100,000</ix:nonFraction> by way of a secured loan from RH Capital Finance Co.,&#160;LLC. The Loan is secured by way of a General Security Agreement and company guarantee against the assets of the Borrower and the Company.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;">The loan was granted to the Borrower after it successfully registered its research and development activities with the Australian Federal Government. The Borrower benefits from the Australian Federal Government&#8217;s Research&#160;&amp; Development tax incentive program, which </p></ix:nonNumeric></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:24pt 0pt 0pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td><td style="vertical-align:top;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:12pt 0pt 0pt 0pt;"><img src="pbm-20240930xex99d1002.jpg" alt="Graphic" style="display:inline-block;height:60.38pt;left:0%;padding-bottom:0pt;position:relative;top:0pt;width:87.84pt;"/></p></td><td style="vertical-align:bottom;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;">17</p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:none;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">PSYENCE BIOMEDICAL LTD.</b></p></td></tr><tr><td style="vertical-align:top;width:100%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">Condensed Consolidated Interim Financial Statements (unaudited)</b></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:none;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><ix:continuation id="Tb_gHPRyTnDO0-pYFdTQGkKkQ_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">provides up to a <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="Duration_8_21_2023_To_8_21_2023_ifrs-full_BorrowingsByNameAxis_pbm_LoanFromRhCapitalFinanceCoLlcMember_T4BXnsFmzEiEaQc67cVjJg" decimals="3" format="ixt:num-dot-decimal" name="pbm:MaximumPercentageOfRebateOnResearchDevelopmentTaxIncentiveProgram" scale="-2" id="Narr_xAtV-4i_mka6h_7P92hURw">43.5</ix:nonFraction>% rebate on research and development expenses in Australia. The Loan bears interest at <ix:nonFraction unitRef="Unit_Standard_pure_csGVPTI6LEiHjYWu44qMSw" contextRef="As_Of_8_21_2023_ifrs-full_BorrowingsByNameAxis_pbm_LoanFromRhCapitalFinanceCoLlcMember_G-GOT4SAF0qyvXcb3RcubQ" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_sy3hfF3D7kmQ9skbQc3JIQ">16</ix:nonFraction>% per annum subject to a minimum interest chargeable period of <ix:nonNumeric contextRef="Duration_8_21_2023_To_8_21_2023_ifrs-full_BorrowingsByNameAxis_pbm_LoanFromRhCapitalFinanceCoLlcMember_T4BXnsFmzEiEaQc67cVjJg" format="ixt-sec:durwordsen" name="pbm:BorrowingsMinimumInterestChargeablePeriod" id="Narr_D4M0yWRDz0q-1i23LH441A">91&#160;days</ix:nonNumeric> and is repayable at the earlier of: (a)&#160;<ix:nonNumeric contextRef="Duration_8_21_2023_To_8_21_2023_ifrs-full_BorrowingsByNameAxis_pbm_LoanFromRhCapitalFinanceCoLlcMember_T4BXnsFmzEiEaQc67cVjJg" format="ixt-sec:durday" name="pbm:BorrowingsPeriodToRepayAfterNoticeOfAssessment" id="Narr_7Gjav9P1rUq2AApJjBT41g">21</ix:nonNumeric> business&#160;days after the notice of assessment (in respect of R&amp;D refunds) is issued by the Australian Taxation Office to the Borrower for the financial&#160;year ended June&#160;30, 2023 (b)&#160;an event of default and (c)&#160;30 November&#160;2023.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The loan with RH Capital Finance Co., LLC was repaid in full on October&#160;5, 2023 when the Company received the research and development rebate from the Australian Taxation office, which was utilized to settle the loan payable.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">$<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2024_To_9_30_2024_ifrs-full_BorrowingsByNameAxis_pbm_LoanFromRhCapitalFinanceCoLlcMember_96E0bWBeGEC82x3i9OlR_A" decimals="0" format="ixt-sec:numwordsen" name="ifrs-full:InterestExpenseOnBorrowings" scale="0" id="Narr_fZMm7VwkfkGk5yvRCNpr-A">nil</ix:nonFraction> (September 30, 2023&#160;- $<ix:nonFraction unitRef="Unit_Standard_USD_HeGFnztaUESwmwhdTLq9LA" contextRef="Duration_4_1_2023_To_9_30_2023_ifrs-full_BorrowingsByNameAxis_pbm_LoanFromRhCapitalFinanceCoLlcMember_fg0SpR30iUusX265E2btUg" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:InterestExpenseOnBorrowings" scale="0" id="Narr_w0Ep2VzMEEmeMsADfFQj0Q">27,423</ix:nonFraction>) in interest expense was incurred during the&#160;period ended September 30, 2024, on this loan. The loan and all outstanding interest was repaid.</p></ix:continuation><ix:nonNumeric contextRef="Duration_4_1_2024_To_9_30_2024_7K5_E20a7kOIviXv5d41-A" name="pbm:CapitalManagementDisclosureTextBlock" id="Tb_2x0mWMPjxU-pIh9OGGXbOA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">14. Capital management</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The Company&#8217;s objectives when managing capital are to safeguard the Company&#8217;s ability to continue as a going concern to pursue the development of natural health business, to maintain a flexible capital structure which optimizes the cost of capital at an acceptable risk level.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">The Company manages its capital structure and adjusts it considering changes in economic conditions and the risk characteristics of the underlying assets. To maintain or adjust its capital structure, the Company may obtain additional funding from equity financing, issue new debt, acquire or dispose of assets or adjust the amount of cash and cash equivalents on hand.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">To facilitate the management of its capital requirements, the Company prepares annual budgets that are updated as necessary depending on various factors, including successful capital deployment and general industry conditions. The annual and updated budgets are approved by the Board of Directors.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Management considers its approach to capital management to be appropriate given the relative size of the Company. There were no changes in the Company&#8217;s approach to capital management during the period.</p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:24pt 0pt 0pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td><td style="vertical-align:top;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:33.33%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:33.34%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:12pt 0pt 0pt 0pt;"><img src="pbm-20240930xex99d1002.jpg" alt="Graphic" style="display:inline-block;height:60.38pt;left:0%;padding-bottom:0pt;position:relative;top:0pt;width:87.84pt;"/></p></td><td style="vertical-align:bottom;width:33.32%;margin:0pt;padding:0pt 5.4pt 0pt 5.4pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;">18</p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:none;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;table-layout:fixed;width:100%;"><tr style="height:1pt;"><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:0pt;width:100%;"></div></div></td></tr><tr><td style="vertical-align:top;width:100%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">PSYENCE BIOMEDICAL LTD.</b></p></td></tr><tr><td style="vertical-align:top;width:100%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">Condensed Consolidated Interim Financial Statements (unaudited)</b></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="text-decoration-line:none;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><a id="Tc_sb1j8t5I30GT0k0HaH5mtg_1_0"></a><a id="Tc_X_L5UkUO0UWSSJ01UdCc4w_1_2"></a><a id="Tc_mW93r8jeoEO1nDFGSASVTQ_1_4"></a><a id="Tc_OS83yi06_EGZnCyxO_nt3g_2_0"></a><a id="Tc_H4ZavWkKTkalMUpqkkq5Aw_3_0"></a><ix:nonNumeric contextRef="Duration_4_1_2024_To_9_30_2024_7K5_E20a7kOIviXv5d41-A" name="ifrs-full:DisclosureOfRelatedPartyExplanatory" id="Tb_Wcs9SwVzUkKq4VyIGyR5aQ" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">15. Transactions with related parties</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">All related party transactions are measured at the exchange amount, which is the amount of consideration established and agreed to by the related parties. All amounts either due from or due to related parties other than specifically disclosed are non-interest bearing, unsecured and have no fixed terms of repayments. The Company incurred the following transactions with related parties during the&#160;periods ended September 30, 2024 and September 30, 2023:</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;text-align:justify;margin:0pt 0pt 12pt 0pt;">Compensation to key management personnel</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Key management personnel are those people who have authority and responsibility for planning, directing and controlling the activities of the Company, directly or indirectly. Key management personnel include the Company&#8217;s executive officers and Board of Directors.</p><ix:nonNumeric contextRef="Duration_4_1_2024_To_9_30_2024_7K5_E20a7kOIviXv5d41-A" name="ifrs-full:DisclosureOfInformationAboutKeyManagementPersonnelExplanatory" id="Tb_yUnA0mAJx0eg6mPimtJdXA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:69.