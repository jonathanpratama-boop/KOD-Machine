n','Times','serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.28%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_k5w_y4F0s06neC20a7j_qw" contextRef="Duration_1_1_2022_To_9_30_2022_us-gaap_IncomeStatementLocationAxis_us-gaap_ResearchAndDevelopmentExpenseMember_UoNDGaLbjkyt2pizmCj9aw" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Tc_lrVW4nycQUumN88PSNZloQ_5_12">396</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.64%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td></tr><tr><td style="vertical-align:bottom;width:57.61%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Stock-based compensation costs before income taxes</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.78%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.12%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.27%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_k5w_y4F0s06neC20a7j_qw" contextRef="Duration_7_1_2023_To_9_30_2023_3kH9OHMDwEGvNWsQ-IIhxw" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Tc_APKEaYpRz0GAUjCIsRpM-Q_6_3">390</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.78%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.12%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.27%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_k5w_y4F0s06neC20a7j_qw" contextRef="Duration_7_1_2022_To_9_30_2022_w38j0Jqg5ES9qAf4sf5hpQ" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Tc_2Vi3p-d5QEObKMb80KyB-g_6_6">389</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.78%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.12%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.27%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_k5w_y4F0s06neC20a7j_qw" contextRef="Duration_1_1_2023_To_9_30_2023_DWHTOsOmLUCRL3WMxh6TEg" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Tc_R8dztNxxOkGcXGjbTTu7aQ_6_9">1,151</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.78%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.13%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.28%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_k5w_y4F0s06neC20a7j_qw" contextRef="Duration_1_1_2022_To_9_30_2022_VlYorXHw306Eu-UHcbnsVg" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Tc_FpoPC7HTskiInXEwIPbDvQ_6_12">1,119</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.64%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td></tr></table></div></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;font-weight:bold;margin:0pt 0pt 10pt 18pt;">2018 Plan</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">In May 2018, the Company&#8217;s stockholders approved the 2018 Equity Incentive Plan (the &#8220;2018 Plan&#8221;), under which Cyclacel may make equity incentive grants to its officers, employees, directors and consultants. The 2018 Plan replaced the 2015 Equity Incentive Plan (the &#8220;2015 Plan&#8221;).</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">The 2018 Plan allows for various types of award grants, including stock options and restricted stock units. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">On June 14, 2022, the Company&#8217;s stockholders approved an amendment to the 2018 Plan to increase the number of shares of common stock available for grant under the 2018 Plan by <ix:nonFraction unitRef="Unit_Standard_shares_Eoru-3lM_U6OkDCJh2psng" contextRef="As_Of_6_14_2022_us-gaap_PlanNameAxis_cycc_EquityIncentivePlan2018Member_1oXicvJBpkGWS10PJqu_vA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAuthorized" scale="0" id="Narr_zeARHhJN0kam_tOqYteEGQ">500,000</ix:nonFraction> shares. On June 13, 2023, the Company&#8217;s stockholders approved an amendment to the 2018 Plan to increase the number of shares of common stock available for grant under the 2018 Plan by an additional <ix:nonFraction unitRef="Unit_Standard_shares_Eoru-3lM_U6OkDCJh2psng" contextRef="As_Of_6_13_2023_us-gaap_PlanNameAxis_cycc_EquityIncentivePlan2018Member_g5LMDB1GDU-njPl-yqRBww" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAuthorized" scale="0" id="Narr_vvtZ-zOhNUq6A4CynckPaw">900,000</ix:nonFraction> shares. As of September 30, 2023, the Company has reserved <ix:nonFraction unitRef="Unit_Standard_shares_Eoru-3lM_U6OkDCJh2psng" contextRef="As_Of_6_13_2023_us-gaap_PlanNameAxis_cycc_EquityIncentivePlan2018Member_g5LMDB1GDU-njPl-yqRBww" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAvailableForGrant" scale="0" id="Narr_8oO_EAvHZEqJh3rU1kctsg">336,984</ix:nonFraction> shares of the Company&#8217;s common stock under the 2018 Plan for future issuances. Stock option awards granted under the Company&#8217;s equity incentive plans have a maximum life of <ix:nonNumeric contextRef="Duration_6_13_2023_To_6_13_2023_us-gaap_PlanNameAxis_cycc_EquityIncentivePlan2018Member_BH04SEPgSEWZcL1a3HYKCg" format="ixt-sec:durwordsen" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardExpirationPeriod" id="Narr_N0enQoUnBEqtXYxvtwzE4g">10 years</ix:nonNumeric> and generally vest over a <span style="-sec-ix-hidden:Hidden_0q1H-JVPX02Y8mdar7shwg;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">one</span></span> to <ix:nonNumeric contextRef="Duration_6_13_2023_To_6_13_2023_srt_RangeAxis_srt_MaximumMember_us-gaap_PlanNameAxis_cycc_EquityIncentivePlan2018Member_IUQMh0yeRU-KyjtOOpGK3Q" format="ixt-sec:durwordsen" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1" id="Narr_151E1TPKMEya0Of66ByflA">four-year</ix:nonNumeric> period from the date of grant.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;font-weight:bold;margin:0pt 0pt 10pt 18pt;">2020 Inducement Equity Incentive Plan&#160;</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:36pt;margin:0pt;">In October 2020, the Inducement Equity Incentive Plan (the &#8220;Inducement Plan&#8221;), became effective. Under the Inducement Plan, Cyclacel may make equity incentive grants to new senior level employees (persons to whom the Company may issue securities without stockholder approval). The Inducement Plan allows for the issuance of up to <ix:nonFraction unitRef="Unit_Standard_shares_Eoru-3lM_U6OkDCJh2psng" contextRef="As_Of_10_31_2020_srt_RangeAxis_srt_MinimumMember_us-gaap_PlanNameAxis_cycc_InducementEquityIncentivePlan2020Member_WQnLJHZOLU2yjmUo78P8SA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAuthorized" scale="0" id="Narr_SoAN8zOnRUKY6_jT42CKnw">200,000</ix:nonFraction> shares of the Company&#8217;s common stock (or the equivalent of such number). As of September 30, 2023, <ix:nonFraction unitRef="Unit_Standard_shares_Eoru-3lM_U6OkDCJh2psng" contextRef="As_Of_9_30_2023_us-gaap_PlanNameAxis_cycc_InducementEquityIncentivePlan2020Member_VJtRF7MOJEqST7H-4bORew" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesIssued" scale="0" id="Narr_VkmT1VI7Y0K9wolK7IMdag">120,000</ix:nonFraction> shares under the Inducement Plan have been issued, leaving <ix:nonFraction unitRef="Unit_Standard_shares_Eoru-3lM_U6OkDCJh2psng" contextRef="As_Of_9_30_2023_us-gaap_PlanNameAxis_cycc_InducementEquityIncentivePlan2020Member_VJtRF7MOJEqST7H-4bORew" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAvailableForGrant" scale="0" id="Narr_OH9DnKuJFEmM0U9jj4vmlg">80,000</ix:nonFraction> shares in reserve.</p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">19</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc_Jfz4FOGr3EC2pkil3B3wHQ_2_2"></a><a id="Tc_qNkpGF5wmkyddxUtbFqdMg_2_4"></a><a id="Tc_RLp9xZ2_AUatvYR7NX3tVA_3_2"></a><a id="Tc_7u4k2FKtRUilBvz1OeLcHw_3_4"></a><a id="Tc_fdhtviGpdka_Fw0uvxNxww_4_0"></a><a id="Tc_ckuqbWLa4UiXapZpuqRT5A_4_2"></a><a id="Tc_CQit9XJWnUe9_VDafbKvLg_4_4"></a><a id="Tc_GwoCiHQ0okO83vbeCUbeMA_5_0"></a><a id="Tc_xNLdswXGT0G8zGqVNq_WOw_5_2"></a><a id="Tc_-VmHBO6ySEq-DwVziDErdg_5_4"></a><a id="Tc_q7i1JG64oUieQjwHlzUhCg_6_0"></a><a id="Tc_Rdk0I7icZk-RGcj74B_Aqg_6_2"></a><a id="Tc_gDZc_sIDrUWHJlazKc4dow_6_4"></a><a id="Tc_sxBbE-bn7E-7KyHXR4WDXA_7_0"></a><a id="_7d4475c6_d25c_4b95_8dad_7af1e3983b3c"></a><a id="Tc_9GIYcdXH3UarnjBK_baGEw_1_7"></a><a id="Tc_HsYm0hiX_EGH7kLS_AYf5w_2_4"></a><a id="Tc_I0Y45K5c2UadrY7JaAIDMQ_2_7"></a><a id="Tc_Sz5u1z9YC0eCMCAH4_Jv7w_3_2"></a><a id="Tc_IvDzxeCPjUa61PtoymKOfg_3_4"></a><a id="Tc_Iai3b7M-H0i4wXSSN41Xlg_3_7"></a><a id="Tc_2DN78NNiOkmEaNb5xifQBw_3_9"></a><a id="Tc_SJa4Ch7jHUOGXZ8R25rkLQ_4_2"></a><a id="Tc_yKAhSZ0XI0O93ZcGU9-AbQ_4_4"></a><a id="Tc_FctgF4h6RUydrorx6glYXg_4_7"></a><a id="Tc_vE-rp9NvxkuyKfrMPts2TQ_4_9"></a><a id="Tc_Jh2-A0Z0vEK9jjKAK-0MfA_5_2"></a><a id="Tc_nVGf3q17OE-NxTJlvVZzkw_5_4"></a><a id="Tc_fdB4_daNiEqT283gj9_PiQ_5_7"></a><a id="Tc_yfwM7eS7Skq47Cn2dIXhmA_5_9"></a><a id="Tc_49OkK525MkmsQ8KKT-oaEw_6_0"></a><a id="Tc_vl2H9LpQ40Gn9fwB6Y_Rsg_6_4"></a><a id="Tc_danjDSjZ_UmgARVBINIiaQ_6_9"></a><a id="Tc_YBL_A-T5uEOeIOYKY4n0Ag_6_10"></a><a id="Tc_j31ZIrmgHkOe74SuILG9FQ_7_0"></a><a id="Tc_axRooyR9r0S06RYrCjCJRQ_7_4"></a><a id="Tc_HRNa3ZPa3Ea4cGL7Z8Tl6w_7_7"></a><a id="Tc_XdtohFO9h0uN1Mc-udte4w_7_10"></a><a id="Tc_Q_ofqyJ-3UqUwbELHc2HUQ_8_0"></a><a id="Tc_tZfLQaaGDEeDD2phWCe6kw_8_4"></a><a id="Tc_Nj0O4FOaGE6r3ewxQuVQlg_8_7"></a><a id="Tc_oTmAsECpo0S3bd7WVp-PSw_8_10"></a><a id="Tc_OUm4ROeIZkK77cRgoJrqxA_9_0"></a><a id="Tc_JQtiJIoBLEO_Yf0T7zwaKQ_9_4"></a><a id="Tc_PA1YEshUXEq4fgg8vhPKmQ_9_9"></a><a id="Tc_U0waP-4sJUOUFSnxEtqA2A_9_10"></a><a id="Tc_f2lsqwD7V0elOHTMuGF-mg_10_0"></a><a id="Tc_eJD-E8EKzUG-BAe3K93Dpw_10_4"></a><a id="Tc_F8_dNG8AaUS-ICNGaKCLXg_10_9"></a><a id="Tc_erg3DDzK7UK0xEtBeyL2tw_10_10"></a><a id="Tc_NBP-YYVnYUWW_8txN-sEBg_11_0"></a><a id="Tc_2dXQqRYvHEuN_Xrv6rFO1A_11_4"></a><a id="Tc_JiQ5Rs3Rx0OYqKysODcu4g_11_9"></a><a id="Tc_T4FFlZeMXUuIGn0HIBvqfQ_11_10"></a><ix:continuation id="Tb_2Zs2eVqbdkGzi0gV7ofXgQ_cont2" continuedAt="Tb_2Zs2eVqbdkGzi0gV7ofXgQ_cont3"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;font-weight:bold;margin:0pt 0pt 10pt 18pt;">Option Grants and Exercises</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">There were <ix:nonFraction unitRef="Unit_Standard_shares_Eoru-3lM_U6OkDCJh2psng" contextRef="Duration_1_1_2023_To_9_30_2023_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_ZlFdPanFiEa4F-0tDfP5CA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGross" scale="0" id="Narr_MWxgn4h2m0uHLHQyylHlDw">650,128</ix:nonFraction> options granted during the nine months ended September 30, 2023. These options had a grant date fair value ranging between $<ix:nonFraction unitRef="Unit_Divide_USD_shares__6r3lOvkmEqjoS9qV8z6WA" contextRef="Duration_1_1_2023_To_9_30_2023_srt_RangeAxis_srt_MinimumMember_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_d6wv3htCgE6hmFVz1HhqQg" decimals="2" format="ixt:numdotdecimal" name="cycc:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGrantDateFairValue" scale="0" id="Narr_-jabY_bNj0Su-DzmSFHsSw">0.42</ix:nonFraction>-$<ix:nonFraction unitRef="Unit_Divide_USD_shares__6r3lOvkmEqjoS9qV8z6WA" contextRef="Duration_1_1_2023_To_9_30_2023_srt_RangeAxis_srt_MaximumMember_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_D7Veacx_pE-Vn91kstF7Gw" decimals="2" format="ixt:numdotdecimal" name="cycc:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGrantDateFairValue" scale="0" id="Narr_2wdsjDIPSECX58IsIF462A">0.73</ix:nonFraction> per option. There were <ix:nonFraction unitRef="Unit_Standard_shares_Eoru-3lM_U6OkDCJh2psng" contextRef="Duration_1_1_2022_To_9_30_2022_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_G8QRr7LBskKB7az2XCDmUw" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGross" scale="0" id="Narr_AGmGJrNaOkiw6ZmOqur6JA">522,337</ix:nonFraction> options granted during the nine months ended September 30, 2022. These options had a grant date fair value ranging between $<ix:nonFraction unitRef="Unit_Divide_USD_shares__6r3lOvkmEqjoS9qV8z6WA" contextRef="Duration_1_1_2022_To_9_30_2022_srt_RangeAxis_srt_MinimumMember_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_0A7wD89tfk-wJdcuPblVVQ" decimals="2" format="ixt:numdotdecimal" name="cycc:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGrantDateFairValue" scale="0" id="Narr_njYkqFBcYUiR-R48RKTNFQ">0.83</ix:nonFraction>-$<ix:nonFraction unitRef="Unit_Divide_USD_shares__6r3lOvkmEqjoS9qV8z6WA" contextRef="Duration_1_1_2022_To_9_30_2022_srt_RangeAxis_srt_MaximumMember_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_IX9toJxHXkqEZ4iFDb0weQ" decimals="2" format="ixt:numdotdecimal" name="cycc:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGrantDateFairValue" scale="0" id="Narr_9ehUA7oc1EKFFb-0yZQzdg">2.90</ix:nonFraction> per option. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">Of the options granted during the nine months ended September 30, 2023, <ix:nonFraction unitRef="Unit_Standard_shares_Eoru-3lM_U6OkDCJh2psng" contextRef="Duration_1_1_2023_To_9_30_2023_srt_StatementScenarioAxis_cycc_OptionsVestingOnThirdAnniversaryOfGrantMember_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_3i6vk6y8-UaZKiz9PePWNg" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGross" scale="0" id="Narr_lnRJQJHoD0ysrsEAqS-vtA">384,500</ix:nonFraction> shall vest on the third anniversary of their date of grant, or earlier if either of the certain performance conditions are met relating to enrollment goals for various clinical studies. For purposes of the below calculations, the Company has assumed that these awards will vest after <ix:nonNumeric contextRef="Duration_1_1_2023_To_9_30_2023_srt_StatementScenarioAxis_cycc_OptionsVestingOnThirdAnniversaryOfGrantMember_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_3i6vk6y8-UaZKiz9PePWNg" format="ixt-sec:durwordsen" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1" id="Narr_wrWsX_lsaUiQun7dbxDj9Q">three years</ix:nonNumeric> as satisfaction of the performance conditions is not probable at this time.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:36pt;margin:0pt;">The fair value of the stock options granted is calculated using the Black-Scholes option-pricing model as prescribed by ASC 718 using the following assumptions:</p><ix:nonNumeric contextRef="Duration_1_1_2023_To_9_30_2023_DWHTOsOmLUCRL3WMxh6TEg" name="us-gaap:ScheduleOfShareBasedPaymentAwardStockOptionsValuationAssumptionsTableTextBlock" id="Tb_hJ01W8FX1Uyo23R8f8MkQw" escape="true"><