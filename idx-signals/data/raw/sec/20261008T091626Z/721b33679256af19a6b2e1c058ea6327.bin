   </tr>
   <tr style="height:10.0pt;">
    <td style="background-color:rgba(0,0,0,0);word-break:break-word;white-space:pre-wrap;vertical-align:top;"><p style="text-indent:0.0pt;font-size:10.0pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:left;"><span style="background-color:rgba(0,0,0,0);color:rgba(0,0,0,1);white-space:pre-wrap;font-weight:normal;text-decoration:underline;font-size:10.0pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;">Exhibit No.</span></p></td>
    <td style="background-color:rgba(0,0,0,0);word-break:break-word;white-space:pre-wrap;vertical-align:top;"><p style="text-indent:0.0pt;font-size:10.0pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:left;"><span style="background-color:rgba(0,0,0,0);color:rgba(0,0,0,1);white-space:pre-wrap;font-weight:normal;text-decoration:underline;font-size:10.0pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;">Description</span></p></td>
   </tr>
   <tr style="height:10.0pt;">
    <td style="background-color:rgba(204,238,255,1);word-break:break-word;white-space:pre-wrap;vertical-align:top;"><p style="text-indent:0.0pt;font-size:10.0pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:left;"><span style="background-color:rgba(0,0,0,0);color:rgba(0,0,0,1);white-space:pre-wrap;font-weight:normal;text-decoration:underline;font-size:10.0pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;">3.1</span></p></td>
    <td style="background-color:rgba(204,238,255,1);word-break:break-word;white-space:pre-wrap;vertical-align:top;"><p style="text-indent:0.0pt;font-size:10.0pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:left;"><a href="crbp-ex3_1.htm"><span style="background-color:rgba(0,0,0,0);color:rgba(0,0,255,1);white-space:pre-wrap;font-weight:normal;text-decoration:underline;font-size:10.0pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;">Certificate of Amendment to the Amended and Restated Certificate of Incorporation of Corbus Pharmaceuticals Holdings, Inc., dated February 9, 2023</span></a></p></td>
   </tr>
   <tr style="height:10.0pt;">
    <td style="background-color:rgba(204,238,255,1);word-break:break-word;white-space:pre-wrap;vertical-align:top;"><p style="text-indent:0.0pt;font-size:10.0pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:left;"><span style="background-color:rgba(0,0,0,0);color:rgba(0,0,0,1);white-space:pre-wrap;font-weight:normal;text-decoration:underline;font-size:10.0pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;">99.1</span></p></td>
    <td style="background-color:rgba(204,238,255,1);word-break:break-word;white-space:pre-wrap;vertical-align:top;"><p style="text-indent:0.0pt;font-size:10.0pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:left;"><a href="crbp-ex99_1.htm"><span style="background-color:rgba(0,0,0,0);color:rgba(0,0,255,1);white-space:pre-wrap;font-weight:normal;text-decoration:underline;font-size:10.0pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;">Press Release issued by Corbus Pharmaceuticals Holdings, Inc. dated February 13, 2023</span></a></p></td>
   </tr>
   <tr style="height:10.0pt;">
    <td style="background-color:rgba(204,238,255,1);word-break:break-word;white-space:pre-wrap;vertical-align:top;"><p style="text-indent:0.0pt;font-size:10.0pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:left;"><span style="background-color:rgba(0,0,0,0);color:rgba(0,0,0,1);white-space:pre-wrap;font-weight:normal;text-decoration:underline;font-size:10.0pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;">99.2</span></p></td>
    <td style="background-color:rgba(204,238,255,1);word-break:break-word;white-space:pre-wrap;vertical-align:top;"><p style="text-indent:0.0pt;font-size:10.0pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:left;"><a href="crbp-ex99_2.htm"><span style="background-color:rgba(0,0,0,0);color:rgba(0,0,255,1);white-space:pre-wrap;font-weight:normal;text-decoration:underline;font-size:10.0pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;">Investor Presentation</span></a></p></td>
   </tr>
   <tr style="height:10.0pt;">
