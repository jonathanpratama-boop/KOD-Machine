    <td style="text-align: left">$</td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">[&#9679;]</span></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; ">
