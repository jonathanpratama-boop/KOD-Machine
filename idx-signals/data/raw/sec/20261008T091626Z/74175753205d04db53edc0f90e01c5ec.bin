;padding-left:6.37pt;padding-right:3.12pt;text-indent:-3.25pt"><font style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">Adjusted EPS </font></div></td><td colspan="3" style="background-color:#ffffff;padding:2px 1pt 2px 4.12pt;text-align:left;vertical-align:top"><font style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%">As-reported earnings minus adjustments, divided by the diluted average number of common shares outstanding</font></td></tr><tr><td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:top"><div style="margin-bottom:3pt;padding-left:6.37pt;padding-right:3.12pt;text-indent:-3.25pt"><font style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">Adjusted net capitalization</font></div></td><td colspan="3" style="background-color:#cceeff;padding:2px 1pt 2px 4.12pt;text-align:left;vertical-align:top"><font style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%">Adjusted capitalization minus cash and cash equivalents</font></td></tr><tr><td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:left;vertical-align:top"><div style="margin-bottom:3pt;padding-left:6.37pt;padding-right:3.12pt;text-indent:-3.25pt"><font style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">Adjusted net debt</font></div></td><td colspan="3" style="background-color:#ffffff;padding:2px 1pt 2px 4.12pt;text-align:left;vertical-align:top"><font style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%">Adjusted debt minus cash and cash equivalents</font></td></tr><tr><td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:top"><div style="margin-bottom:3pt;padding-left:6.37pt;padding-right:3.12pt;text-indent:-3.25pt"><font style=