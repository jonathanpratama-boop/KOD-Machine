<TABLE CELLSPACING="0" CELLPADDING="0" STYLE="font: 10pt Times New Roman, Times, Serif; width: 100%; border-collapse: collapse">
  <TR STYLE="vertical-align: bottom">
    <TD STYLE="width: 40%; padding-left: 9pt; text-indent: -9pt; font-size: 10pt"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">Nature
    of operations and going concern (Note 1)</FONT></TD>
    <TD STYLE="width: 20%; font-size: 10pt">&nbsp;</TD>
    <TD STYLE="width: 40%; font-size: 10pt">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom">
    <TD STYLE="padding-left: 9pt; text-indent: -9pt; font-size: 10pt"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">Subsequent
    events (Note 18)</FONT></TD>
    <TD STYLE="font-size: 10pt">&nbsp;</TD>
    <TD STYLE="font-size: 10pt">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom">
