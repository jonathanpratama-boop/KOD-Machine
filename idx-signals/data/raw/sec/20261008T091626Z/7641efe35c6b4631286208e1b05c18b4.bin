    <td style="width: 1%; color: Black; text-align: center">&#160;</td><td style="width: 22%; color: Black; text-align: center">88,179</td><td style="width: 1%; color: Black; text-align: left">&#160;</td><td style="width: 2%; color: Black">&#160;</td>
    <td style="width: 1%; color: Black; text-align: center">&#160;</td><td style="width: 22%; color: Black; text-align: center">1,594</td><td style="width: 1%; color: Black; text-align: left">&#160;</td></tr>
