    <td style="border-bottom: Black 1pt solid; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td id="xdx_987_eus-gaap--TemporaryEquityAccretionToRedemptionValue_c20230101__20230331_zfozVunOFr67" title="Accretion of embedded derivative to redemption value" style="border-bottom: Black 1pt solid; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction name="us-gaap:TemporaryEquityAccretionToRedemptionValue" contextRef="From2023-01-01to2023-03-31" format="ixt:numdotdecimal" decimals="0" unitRef="USD">110,991</ix:nonFraction></span></td><td style="padding-bottom: 1pt; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
  <tr style="vertical-align: bottom; background-color: White">
