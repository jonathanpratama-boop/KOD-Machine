    <td style="text-align: left">Device firmware and software</td><td>&#160;</td>
    <td style="text-align: center"><span id="xdx_90A_eus-gaap--FiniteLivedIntangibleAssetUsefulLife_iI_dtY_c20240930__us-gaap--BusinessAcquisitionAxis__custom--RadicalCleanSolutionsLtdMember__us-gaap--FiniteLivedIntangibleAssetsByMajorClassAxis__custom--DeviceFirmwareAndSoftwareMember_zGMcOPC6Yodd" title="Intangible assets weighted average useful life (years)"><ix:nonNumeric contextRef="AsOf2024-09-30_custom_RadicalCleanSolutionsLtdMember_custom_DeviceFirmwareAndSoftwareMember" format="ixt-sec:duryear" id="Fact001098" name="us-gaap:FiniteLivedIntangibleAssetUsefulLife">5</ix:nonNumeric></span></td><td>&#160;</td>
