    <td style="border-bottom: Black 1.5pt solid; text-align: center">Abstain</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 33%; text-align: center">18,368,466</td><td style="width: 1%">&#160;</td>
    <td style="width: 33%; text-align: center">68,750</td><td style="width: 1%">&#160;</td>
    <td style="width: 32%; text-align: center">807</td></tr>
  </table>

<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify">&#160;</p>

<table cellpadding="0" cellspacing="0" style="font: 10pt Times New Roman, Times, Serif; margin-top: 0pt; margin-bottom: 0pt; width: 100%">
