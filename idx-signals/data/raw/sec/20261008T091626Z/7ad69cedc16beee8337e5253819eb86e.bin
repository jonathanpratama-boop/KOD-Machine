  <ix:nonNumeric contextRef="d_2022-01-01_2022-12-31" name="us-gaap:AccountsPayableAccruedLiabilitiesAndOtherLiabilitiesDisclosureCurrentTextBlock" id="c2351584" escape="true">
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;"><b>(<em style="font: inherit;">10</em>) Accrued Expenses and Other Current Liabilities</b></p>
   <p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;">&#xa0;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">As of <em style="font: inherit;"> December 31, 2022</em> and <em style="font: inherit;">2021</em>, accrued expenses and other current liabilities consisted of the following:</p>
   <p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;">&#xa0;</p>
   <ix:nonNumeric contextRef="d_2022-01-01_2022-12-31" name="us-gaap:ScheduleOfAccruedLiabilitiesTableTextBlock" id="c2351585" escape="true">
