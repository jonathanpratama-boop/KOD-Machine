    <td colspan="6" style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center">USD in thousands</td><td style="padding-bottom: 1.5pt; font-weight: bold">&#160;</td></tr>
  <tr id="xdx_40F_eus-gaap--OperatingLossCarryforwards_iI_pn3n3_z9v36auV4kF9" style="vertical-align: bottom; background-color: rgb(204,238,255)">
