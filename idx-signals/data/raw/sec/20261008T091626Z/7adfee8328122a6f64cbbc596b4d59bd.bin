    <td style="border-bottom: Black 2.5pt double; width: 1%; text-align: left">&#160;</td><td style="border-bottom: Black 2.5pt double; width: 16%; text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction name="us-gaap:OperatingLossCarryforwards" contextRef="AsOf2022-12-31" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">26,295</ix:nonFraction></span></td><td style="width: 1%; padding-bottom: 2.5pt; text-align: left">&#160;</td><td style="width: 2%; padding-bottom: 2.5pt">&#160;</td>
    <td style="border-bottom: Black 2.5pt double; width: 1%; text-align: left">&#160;</td><td style="border-bottom: Black 2.5pt double; width: 16%; text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction name="us-gaap:OperatingLossCarryforwards" contextRef="AsOf2021-12-31" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">15,582</ix:nonFraction></span></td><td style="width: 1%; padding-bottom: 2.5pt; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td>&#160;</td><td>&#160;</td>
