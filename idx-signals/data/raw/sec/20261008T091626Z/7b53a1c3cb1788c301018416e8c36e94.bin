<td>&#160;</td><td>&#160;</td><td colspan="2" style="padding-right: 200.65pt"><p style="margin-top: 0; margin-bottom: 0">Heather Smiles, Vice-President</p>
                                                                              <p style="margin-top: 0; margin-bottom: 0">Investor Relations and Corporate Development</p></td></tr>
