    <TD COLSPAN="2" STYLE="font-weight: bold; text-align: center; border-bottom: Black 1.5pt solid">2025</TD><TD STYLE="padding-bottom: 1.5pt; font-weight: bold">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom">
    <TD STYLE="text-align: center">&nbsp;</TD><TD STYLE="font-weight: bold">&nbsp;</TD>
    <TD COLSPAN="6" STYLE="font-weight: bold; text-align: center">(in thousands of U.S. dollars)</TD><TD STYLE="font-weight: bold">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
    <TD STYLE="width: 76%; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">Audit Fees <SUP>(1)</SUP></FONT></TD><TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 9%; text-align: right">1,100</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 9%; text-align: right">775</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD></TR>
