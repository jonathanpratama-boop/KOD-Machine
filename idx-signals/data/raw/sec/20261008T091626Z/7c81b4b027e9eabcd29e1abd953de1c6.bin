                                                                             <P STYLE="margin-top: 0; margin-bottom: 0">Owned</P></TD><TD STYLE="text-align: center; font-weight: bold; padding-bottom: 1.5pt">&nbsp;</TD>
    <TD STYLE="padding-bottom: 1.5pt; font-weight: bold; text-align: center">&nbsp;</TD><TD STYLE="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center"><P STYLE="margin-top: 0; margin-bottom: 0"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt"><B>Percentage of</B></FONT></P>
                                                                                <P STYLE="margin-top: 0; margin-bottom: 0"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt"><B>Shares of</B></FONT></P>
                                                                                <P STYLE="margin-top: 0; margin-bottom: 0"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt"><B>Common Stock</B></FONT></P>
