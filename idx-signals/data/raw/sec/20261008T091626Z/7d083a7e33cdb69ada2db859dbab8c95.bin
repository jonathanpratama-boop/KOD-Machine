-16327">33,794</ix:nonFraction> </span></div></td><td style="width: 4.75pt; background-color: #C5C4CF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 4.75pt; background-color: #C5C4CF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 44.97pt; padding-top: 1.37pt; text-align: right; vertical-align: bottom; background-color: #C5C4CF; white-space: nowrap;"><div class="BRDSX_fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 7pt; margin-top: 0pt; text-align: right;"><span style="padding-left: 18.08pt;"><ix:nonFraction contextRef="c83" decimals="0" format="ixt:fixed-zero" name="ecd:AdjToCompAmt" scale="0" unitRef="usd" id="ixv-16328">&#8212;</ix:nonFraction></span></div></td><td style="width: 4.75pt; background-color: #C5C4CF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 4.75pt; background-color: #C5C4CF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 45.36pt; padding-top: 1.37pt; text-align: right; vertical-align: bottom; background-color: #C5C4CF; white-space: nowrap;"><div class="BRDSX_fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 7pt; margin-top: 0pt; text-align: right;"><ix:nonFraction contextRef="c84" decimals="0" format="ixt:num-dot-decimal" name="ecd:AdjToCompAmt" scale="0" unitRef="usd" id="ixv-16329">29,072</ix:nonFraction> </div></td><td style="width: 4.75pt; background-color: #C5C4CF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 4.75pt; background-color: #C5C4CF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 43.28pt; padding-top: 1.37pt; text-align: right; vertical-align: bottom; background-color: #C5C4CF; white-space: nowrap;"><div class="BRDSX_fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 7pt; margin-top: 0pt; text-align: right;"><span style="padding-left: 2.33pt;"><ix:nonFraction contextRef="c54" decimals="0" format="ixt:num-