    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">$</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">417,983</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: White">
