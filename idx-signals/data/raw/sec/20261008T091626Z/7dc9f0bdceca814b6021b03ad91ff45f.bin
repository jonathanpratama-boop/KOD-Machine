    <TD STYLE="border-bottom: Black 1.5pt solid; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">$</FONT></TD><TD STYLE="border-bottom: Black 1.5pt solid; text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">1,019,146</FONT></TD><TD STYLE="padding-bottom: 1.5pt; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
