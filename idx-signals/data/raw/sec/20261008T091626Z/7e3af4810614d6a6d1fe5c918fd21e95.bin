    <TD STYLE="text-align: left">FINRA fee</TD>
    <TD STYLE="text-align: left">$</TD><TD STYLE="text-align: right"><FONT STYLE="font-size: 10pt">*</FONT></TD><TD STYLE="text-align: left">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
    <TD STYLE="text-align: left">Legal fees and expenses</TD>
    <TD STYLE="text-align: left">$</TD><TD STYLE="text-align: right"><FONT STYLE="font-size: 10pt">*</FONT></TD><TD STYLE="text-align: left">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: White">
    <TD STYLE="text-align: left">Accounting fees and expenses</TD>
    <TD STYLE="text-align: left">$</TD><TD STYLE="text-align: right"><FONT STYLE="font-size: 10pt">*</FONT></TD><TD STYLE="text-align: left">&nbsp;</TD></TR>
