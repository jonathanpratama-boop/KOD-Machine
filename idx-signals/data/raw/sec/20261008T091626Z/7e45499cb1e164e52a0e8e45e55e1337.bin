			<td style="vertical-align:middle;width:auto;">
			<div style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;"><b>WaveDancer, Inc. </b></div>
			</td>
		</tr>
		<tr>
			<td style="vertical-align:bottom;width:auto;">
