    <!-- Field: /Page -->

<P STYLE="margin: 0pt 0; font-size: 10pt; text-align: justify"></P>

<P STYLE="font-size: 10pt; font-weight: bold; text-align: left; margin: 0pt 0">Approval of Directors</P>

<P STYLE="margin: 0pt 0; font-size: 10pt; font-weight: bold; text-align: left">&nbsp;</P>

<P STYLE="font-size: 10pt; text-align: justify; margin: 0pt 0">The contents and the sending of this Circular to Shareholders entitled
to receive notice of the Meeting, to each director and to the Auditors of the Company have been approved by the Board.</P>

<P STYLE="margin: 0pt 0; font-size: 10pt; text-align: justify">&nbsp;</P>

<P STYLE="font-size: 10pt; text-align: justify; margin: 0pt 0">DATED at Toronto, Ontario, the 31<SUP>st</SUP> day of October, 2024.</P>

<P STYLE="margin: 0pt 0; font-size: 10pt; text-align: justify">&nbsp;</P>

<TABLE CELLPADDING="0" CELLSPACING="0" STYLE="border-collapse: collapse; width: 100%">
  <TR STYLE="vertical-align: bottom; background-color: White">
    <TD STYLE="width: 60%">&nbsp;</TD>
    <TD STYLE="width: 40%; font-size: 10pt">By Order of the Board of Directors,</TD></TR>
