  <div style="line-height: 1.25;"><font style="font-weight: bold;">Notes</font>:</div>
  <table cellspacing="0" cellpadding="0" style="font-family: 'Times New Roman', Times, serif; font-size: 10pt; width: 100%; text-align: left; color: #000000;" class="DSPFListTable" id="z741ff2a107104fc393f4683ce0731a65">

