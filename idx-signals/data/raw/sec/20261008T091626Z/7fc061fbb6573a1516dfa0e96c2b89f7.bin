:bottom;white-space:nowrap;width:1.59%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:16.19%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.5pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_LE_qpcXfD0iccHX-NK0ttg" contextRef="As_Of_12_31_2023_vIRt3TDHYEeozkuW-UQ25w" decimals="0" format="ixt:numdotdecimal" name="us-gaap:FinanceLeaseLiability" scale="0" id="Tc_uZmzW8vvYEOFVjazqArS2g_4_6">1,084</ix:nonFraction></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="font-size:1pt;margin-bottom:10pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_10_1_2023_To_12_31_2023_UVeCyxm__EW8VXmz_-su9w" name="us-gaap:StockholdersEquityNoteDisclosureTextBlock" id="Tb_Ne05XjvE-E6_veOpXL1VDA" continuedAt="Tb_Ne05XjvE-E6_veOpXL1VDA_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 10pt 0pt;">9.&#160;&#160;&#160;&#160;Common Stock and Stockholders&#8217; Equity</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 10pt 0pt;">Common stock</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">On March 29, 2023, following receipt of stockholder approval at the Company&#8217;s 2023 annual meeting of stockholders, the number of authorized shares of common stock under the Company&#8217;s Certificate of Incorporation was increased from <ix:nonFraction unitRef="Unit_Standard_shares_JYuSa2fCNEaCofNH8YW0SA" contextRef="As_Of_3_28_2023_exWG-KrBk02oh-g27-2BAA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_vk70GtbHs024PIRvtaTUCw">325,000,000</ix:nonFraction> shares to <ix:nonFraction unitRef="Unit_Standard_shares_JYuSa2fCNEaCofNH8YW0SA" contextRef="As_Of_3_29_2023_W_149MpgCESssW0vtg_7Nw" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_UbQr7JnquEiU37yddKnN2g">425,000,000</ix:nonFraction> shares.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">In December 2022, in a registered direct equity offering to certain institutional and accredited investors, including GMS Ventures and Investments (&#8220;GMS Ventures&#8221;), the Company&#8217;s largest stockholder, the Company issued <ix:nonFraction unitRef="Unit_Standard_shares_JYuSa2fCNEaCofNH8YW0SA" contextRef="Duration_12_1_2022_To_12_31_2022_us-gaap_SubsidiarySaleOfStockAxis_otlk_DirectRegisteredOfferingMember_tHBbdYykAki43T1V9VMWXw" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_JgzeGpGuDUyvEKpnulfjpQ">28,460,831</ix:nonFraction> shares of common stock at a purchase price per share of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_-ay1juR7WEO99gPQTykNNw" contextRef="As_Of_12_31_2022_us-gaap_SubsidiarySaleOfStockAxis_otlk_DirectRegisteredOfferingMember_RuJtuSK6kEy-YycIhciY1A" decimals="4" format="ixt:numdotdecimal" name="us-gaap:SharesIssuedPricePerShare" scale="0" id="Narr_t3Acv0jow0O7YDPqPPTT4A">0.8784</ix:nonFraction> for $<ix:nonFraction unitRef="Unit_Standard_USD_LE_qpcXfD0iccHX-NK0ttg" contextRef="Duration_12_1_2022_To_12_31_2022_us-gaap_SubsidiarySaleOfStockAxis_otlk_DirectRegisteredOfferingMember_tHBbdYykAki43T1V9VMWXw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ProceedsFromIssuanceOfCommonStock" scale="0" id="Narr_jWuH4mu_zkWBXEzA-1C1mA">23,208,679</ix:nonFraction> in net proceeds after payment of placement agent fees and other offering costs. GMS Ventures purchased an aggregate of <ix:nonFraction unitRef="Unit_Standard_shares_JYuSa2fCNEaCofNH8YW0SA" contextRef="Duration_12_1_2022_To_12_31_2022_srt_CounterpartyNameAxis_otlk_GmsVenturesInvestmentsMember_us-gaap_SubsidiarySaleOfStockAxis_otlk_DirectRegisteredOfferingMember_TQL0_aOlske17bp_UO44_A" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_eEXWIw6IfU6JN7gS-mjarg">14,230,418</ix:nonFraction> shares of common stock in the registered direct equity offering. In connection with the registered direct equity offering, the Company issued to M.S. Howells &amp; Co., the placement agent, warrants to purchase up to an aggregate of <ix:nonFraction unitRef="Unit_Standard_shares_JYuSa2fCNEaCofNH8YW0SA" contextRef="As_Of_12_31_2022_srt_CounterpartyNameAxis_otlk_M.s.HowellsCoMember_us-gaap_SubsidiarySaleOfStockAxis_otlk_DirectRegisteredOfferingMember_JP7bAVYfb0eUjMopl6htyQ" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" id="Narr_ZLKGsJgZB0OOT3Zf6KxUdg">515,755</ix:nonFraction> shares of common stock at an exercise price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_-ay1juR7WEO99gPQTykNNw" contextRef="As_Of_12_31_2022_srt_CounterpartyNameAxis_otlk_M.s.HowellsCoMember_us-gaap_SubsidiarySaleOfStockAxis_otlk_DirectRegisteredOfferingMember_JP7bAVYfb0eUjMopl6htyQ" decimals="2" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" id="Narr_YItZ4WgXXkyefbBX0IEPWA">1.05</ix:nonFraction> per share, which warrants have a <ix:nonNumeric contextRef="As_Of_12_31_2022_srt_CounterpartyNameAxis_otlk_M.s.HowellsCoMember_us-gaap_SubsidiarySaleOfStockAxis_otlk_DirectRegisteredOfferingMember_JP7bAVYfb0eUjMopl6htyQ" format="ixt-sec:durwordsen" name="us-gaap:WarrantsAndRightsOutstandingTerm" id="Narr_OC1SNdmiH0GIad7816wyiA">three-year</ix:nonNumeric> term.</p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">13</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:24pt 0pt 0pt 0pt;">Outlook Therapeutics,&#160;Inc.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">Notes&#160;to Unaudited Interim Consolidated Financial Statements</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="margin-bottom:10pt;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_Ne05XjvE-E6_veOpXL1VDA_cont1" continuedAt="Tb_Ne05XjvE-E6_veOpXL1VDA_cont2"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 10pt 0pt;">H.C. Wainwright &amp; Co. At-the-Market Offering Agreement</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">On March 26, 2021, the Company entered into an At-the-Market Offering Agreement with H.C. Wainwright &amp; Co., as sales agent (&#8220;Wainwright&#8221;) (the &#8220;Wainwright ATM Agreement&#8221; or the &#8220;Wainwright ATM Offering&#8221;), under which the Company may issue and sell shares of its common stock having an aggregate offering price of up to $<ix:nonFraction unitRef="Unit_Standard_USD_LE_qpcXfD0iccHX-NK0ttg" contextRef="As_Of_3_26_2021_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingMember_5lBXJ5h5AEWUO8ADb-PqBA" decimals="0" format="ixt:numdotdecimal" name="otlk:AggregateOfferingPriceAuthorized" scale="0" id="Narr_Ho01wEwmuU6zO5VMOmWL4Q">40,000,000</ix:nonFraction> from time to time through Wainwright. The Company incurred financing costs of $<ix:nonFraction unitRef="Unit_Standard_USD_LE_qpcXfD0iccHX-NK0ttg" contextRef="Duration_3_26_2021_To_3_26_2021_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingMember_B6NobrR8JEiEUCdwbh7MwA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AdjustmentsToAdditionalPaidInCapitalStockIssuedIssuanceCosts" scale="0" id="Narr_5XfrIq5Wp0qStmUvPjWSig">197,654</ix:nonFraction>, which were capitalized and are being reclassified to additional paid in capital on a pro rata basis when the Company sells common stock under the Wainwright ATM Offering. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">Under the Wainwright ATM Agreement, the Company paid Wainwright a commission equal to <ix:nonFraction unitRef="Unit_Standard_pure_wSL5gijhUEyhGEzx3F3-AQ" contextRef="Duration_3_26_2021_To_3_26_2021_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingMember_B6NobrR8JEiEUCdwbh7MwA" decimals="3" format="ixt:numdotdecimal" name="otlk:PercentageOfGrossProceedsFromSaleOfCommonStockToBePaidAsCommission" scale="-2" id="Narr_M4X2GmpxJECexky5Xl8uNQ">3.0</ix:nonFraction>% of the aggregate gross proceeds of any sales of common stock under the Wainwright ATM Agreement. The Company terminated the Wainwright ATM Agreement effective May 15, 2023. As a result, the Company wrote off unamortized deferred costs under the Wainwright ATM Agreement effective as of the termination date.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">During the three months ended December 31, 2022, the Company sold <ix:nonFraction unitRef="Unit_Standard_shares_JYuSa2fCNEaCofNH8YW0SA" contextRef="Duration_10_1_2022_To_12_31_2022_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingMember_1CVX8CKo1kmmnMpg-BR2JQ" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_BLqpq2_OeEuifUWr217Z_Q">895,391</ix:nonFraction> shares of common stock under the Wainwright ATM Offering and generated $<ix:nonFraction unitRef="Unit_Standard_USD_LE_qpcXfD0iccHX-NK0ttg" contextRef="Duration_10_1_2022_To_12_31_2022_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingMember_1CVX8CKo1kmmnMpg-BR2JQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ProceedsFromIssuanceOfCommonStock" scale="0" id="Narr_YBHTl58c1kyn3QjXvyL0bA">1,089,105</ix:nonFraction> in net proceeds. The Company paid fees to Wainwright and other issuance costs of $<ix:nonFraction unitRef="Unit_Standard_USD_LE_qpcXfD0iccHX-NK0ttg" contextRef="Duration_10_1_2022_To_12_31_2022_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingMember_1CVX8CKo1kmmnMpg-BR2JQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:PaymentsOfStockIssuanceCosts" scale="0" id="Narr_W_sOrSDts06-UsSHuVadLg">38,799</ix:nonFraction>. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 10pt 0pt;">BTIG, LLC At-the-Market Offering Agreement</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">On May 16, 2023, the Company entered into an At-the-Market Sales Agreement with BTIG, LLC (&#8220;BTIG&#8221;) as sales agent (the &#8220;BTIG ATM Agreement&#8221; or the &#8220;BTIG ATM Offering&#8221;), under which the Company may issue and sell shares of its common stock having an aggregate offering price of up to $<ix:nonFraction unitRef="Unit_Standard_USD_LE_qpcXfD0iccHX-NK0ttg" contextRef="As_Of_5_16_2023_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingBtigMember_D5S411cg30mSDc9hQ8mFOg" decimals="0" format="ixt:numdotdecimal" name="otlk:AggregateOfferingPriceAuthorized" scale="0" id="Narr_6IqMvxU500uJUdw8uRp_QQ">100,000,000</ix:nonFraction> from time to time through BTIG. The Company incurred financing costs of $<ix:nonFraction unitRef="Unit_Standard_USD_LE_qpcXfD0iccHX-NK0ttg" contextRef="Duration_5_16_2023_To_5_16_2023_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingBtigMember_pRxikTOnVk65r5bIKjCQfg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AdjustmentsToAdditionalPaidInCapitalStockIssuedIssuanceCosts" scale="0" id="Narr_dqlMW4zZKkGmUYP5FpO09g">353,688</ix:nonFraction>, which were capitalized and are being reclassified to additional paid in capital on a pro rata basis when the Company sells common stock under the BTIG ATM Offering. As of December 31, 2023, $<ix:nonFraction unitRef="Unit_Standard_USD_LE_qpcXfD0iccHX-NK0ttg" contextRef="As_Of_12_31_2023_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingBtigMember_XYixN1IzZEeh8lmFIMhdCg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DeferredCosts" scale="0" id="Narr_IZQ7ZLk3iEmnjtaQqFRLfA">331,512</ix:nonFraction> of such deferred costs are included in other assets on the unaudited interim consolidated balance sheets.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">Under the BTIG ATM Agreement, the Company pays BTIG a commission equal to <ix:nonFraction unitRef="Unit_Standard_pure_wSL5gijhUEyhGEzx3F3-AQ" contextRef="Duration_10_1_2023_To_12_31_2023_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingBtigMember_5MWjvXwkmUq3Cwq_xOPgdw" decimals="3" format="ixt:numdotdecimal" name="otlk:PercentageOfGrossProceedsFromSaleOfCommonStockToBePaidAsCommission" scale="-2" id="Narr_X3KOpIOK3EWB35YRr5cjrQ">3.0</ix:nonFraction>% of the aggregate gross proceeds of any sales of common stock under the BTIG ATM Agreement. The offering of common stock pursuant to the BTIG ATM Agreement will terminate upon the earlier of (i) the sale of all common stock subject to the BTIG ATM Agreement or (ii) termination of the BTIG ATM Agreement in accordance with its terms. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;"><ix:nonFraction unitRef="Unit_Standard_shares_JYuSa2fCNEaCofNH8YW0SA" contextRef="Duration_10_1_2023_To_12_31_2023_us-gaap_SubsidiarySaleOfStockAxis_otlk_AtMarketOfferingBtigMember_5MWjvXwkmUq3Cwq_xOPgdw" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_IOcX9AMua0SrfGEpYrM4zQ">No</ix:nonFraction> shares of common stock were sold under the BTIG ATM Offering during the three months ended December 31, 2023.</p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">14</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:24pt 0pt 0pt 0pt;">Outlook Therapeutics,&#160;Inc.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">Notes&#160;to Unaudited Interim Consolidated Financial Statements</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="margin-bottom:10pt;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="_a18c35a4_d65b_4110_9969_402ccc2c57ff"></a><a id="Tc_fphPpOmMfUSXACs3UOcgYA_1_2"></a><a id="Tc_JVrPYyoDMk-DfYto9ZX3ng_2_2"></a><a id="Tc_peqs-F2yxUSGa9U_1Tcr0Q_3_2"></a><a id="Tc_pFRX720gUkyJIabwTs1U3A_4_2"></a><a id="Tc_UtRwvZbcfkOcUyIonjvTEw_4_4"></a><a id="Tc_w4SPnhxkzE-Ois09jGLGAg_5_0"></a><a id="Tc_1egC1a0gT0iDnN9hK4VGyg_5_2"></a><a id="Tc_16lwu0ulf0uZ0C4CUVvcRw_5_4"></a><a id="Tc_G1qwTky0LE2uuWOMG6iXcg_6_0"></a><a id="Tc_FYxQ6sx64UmXt0U3u_V3jA_6_1"></a><a id="Tc__hVOeUHcVEuSJ2ql734CEw_6_4"></a><a id="Tc_79riJjYhrkO_SVFsvR9Ixw_7_0"></a><a id="Tc_Mp5hhS9LhUeXe4hXzTM8iQ_7_4"></a><a id="Tc_PUO7T_BqTEeviaZuSESenw_8_0"></a><a id="Tc_kcYiCcM2REyV9R-1FomT4w_8_4"></a><a id="Tc_EfN54VJtEE-MjwRlTnMXbg_9_0"></a><a id="Tc_NM_OvCO4F0Sf7r2MhY3Usg_9_1"></a><a id="Tc_NvTEVAAgR0iDWtIcP0eCBA_9_4"></a><a id="Tc_onkpi-jNOUCrZtIW5lzitg_10_0"></a><a id="Tc_ldDzrRJryUaiYQHwk-R3cQ_10_1"></a><a id="Tc_