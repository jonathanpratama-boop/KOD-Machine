<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:24pt 0pt 0pt 0pt;">Outlook Therapeutics,&#160;Inc.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">Notes&#160;to Unaudited Interim Consolidated Financial Statements</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="margin-bottom:10pt;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc_FctyA8O_dEquHoUVtpaaUQ_1_2"></a><a id="Tc_0D-BtB2BNUCuS0hOZz4LDg_1_5"></a><a id="Tc_uxyirApKCESEk0NzOrZXyw_2_0"></a><a id="Tc_dzz5b2KzgkKQ_XQqE8o1Nw_3_0"></a><a id="Tc_O7OXVLO6Fk6CNKrtqNMVDw_3_2"></a><a id="Tc_DeBiUZgMLkexI7cusrtihw_3_5"></a><a id="Tc_IcWfuyUMNEO3-LP9_d4UwQ_4_0"></a><a id="Tc_UOU4Nfj5HkynAXe0uIZGdg_4_4"></a><a id="Tc_f8jUo-wuVk2GwRE5vBgE4g_4_7"></a><a id="Tc_WMM_1aGgVkGiSI315wSIzg_5_0"></a><a id="Tc_QS2KTEs2rke1CMZCxxNagA_5_4"></a><a id="Tc_RTxdifPd1E2VLm4sUMOcXw_5_7"></a><a id="Tc_8aOPL5KEgUawgVbI8lnndA_6_0"></a><a id="Tc_fUgV7DxMRkCkKlxyHCUjjg_6_4"></a><a id="Tc_rvhgCsEuckuVayqB_RpsWQ_6_7"></a><a id="Tc_O1F3hJLTQUig0-FUzKguvg_7_0"></a><a id="Tc_FkN6zshw9UGuZKqo0V9kdQ_7_4"></a><a id="Tc_6CzOXvz6N0WBg0fY7YZi_A_7_7"></a><a id="Tc_5NNEhKs75UWpIQDhslNwjg_1_2"></a><a id="Tc_UO8ge9GXfEmpnygXCDvmQQ_1_5"></a><a id="Tc_B5HuscvjvEuLoqtQmys1zA_2_0"></a><a id="Tc_nvSo5htJV0