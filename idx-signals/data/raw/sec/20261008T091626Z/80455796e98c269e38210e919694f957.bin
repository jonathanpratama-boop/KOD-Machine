    <td style="border-bottom: Black 4pt double; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; text-align: right">(<ix:nonFraction contextRef="c14" decimals="3" format="ixt:num-dot-decimal" name="us-gaap:EffectiveIncomeTaxRateContinuingOperations" scale="-2" sign="-" unitRef="pure" id="ixv-27170">9.7</ix:nonFraction></td><td style="padding-bottom: 4pt; text-align: left">)%</td><td style="padding-bottom: 4pt">&#160;</td>
