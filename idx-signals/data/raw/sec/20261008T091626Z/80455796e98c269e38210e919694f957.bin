    <td style="text-align: left">&#160;</td><td style="text-align: right">(3,828,437</td><td style="text-align: left">)</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">(63.0</td><td style="text-align: left">)%</td></tr>
  <tr style="vertical-align: bottom; ">
