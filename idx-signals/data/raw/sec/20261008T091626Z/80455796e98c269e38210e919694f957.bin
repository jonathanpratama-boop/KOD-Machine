    <td style="text-align: left">&#160;</td><td style="text-align: right">(<ix:nonFraction contextRef="c314" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest" scale="0" sign="-" unitRef="usd" id="ixv-27114">59,307</ix:nonFraction></td><td style="text-align: left">)</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c304" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest" scale="0" unitRef="usd" id="ixv-27115">359,534</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
