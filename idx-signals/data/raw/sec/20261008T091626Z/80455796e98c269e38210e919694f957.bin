    <td style="font-weight: bold; text-align: justify; text-indent: -10pt; padding-left: 10pt">OPERATING EXPENSES</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">&#160;</td><td style="text-align: left">&#160;</td><td>&#160;</td>
