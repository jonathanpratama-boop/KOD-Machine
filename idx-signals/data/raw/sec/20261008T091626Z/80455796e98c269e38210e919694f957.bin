    <td style="width: 1%; font-weight: bold; text-align: left">$</td><td style="width: 9%; font-weight: bold; text-align: right">234,752,580</td><td style="width: 1%; font-weight: bold; text-align: left">&#160;</td><td style="width: 1%; font-weight: bold">&#160;</td>
    <td style="width: 1%; font-weight: bold; text-align: left">$</td><td style="width: 9%; font-weight: bold; text-align: right">(65,028,234</td><td style="width: 1%; font-weight: bold; text-align: left">)</td><td style="width: 1%; font-weight: bold">&#160;</td>
