  <tr style="vertical-align: bottom; ">
    <td style="text-align: justify; text-indent: -10pt; padding-left: 10pt">Merchandise costs</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">140,293,419</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">191,040,547</td><td style="text-align: left">&#160;</td><td>&#160;</td>
