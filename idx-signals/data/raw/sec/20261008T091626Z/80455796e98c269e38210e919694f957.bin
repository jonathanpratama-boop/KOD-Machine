    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c198" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:PropertyPlantAndEquipmentGross" scale="0" unitRef="usd" id="ixv-26825">364,916</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
