    <TD STYLE="width: 9%; text-align: center"><FONT STYLE="font-family: Times New Roman, Times, Serif"><B>1</B></FONT></TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: White">
    <TD><FONT STYLE="font-family: Times New Roman, Times, Serif"><B><A HREF="#a_002">ABOUT SCISPARC LTD.</A></B></FONT></TD>
    <TD><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="text-align: center"><FONT STYLE="font-family: Times New Roman, Times, Serif"><B>2</B></FONT></TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
    <TD><FONT STYLE="font-family: Times New Roman, Times, Serif"><B><A HREF="#a_003">RISK FACTORS</A></B></FONT></TD>
    <TD><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
