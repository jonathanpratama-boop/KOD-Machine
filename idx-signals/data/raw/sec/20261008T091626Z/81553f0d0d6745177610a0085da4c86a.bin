    <td style="border-bottom: Black 2.5pt double; text-align: left">&#160;</td><td id="xdx_98E_eifrs-full--IssuedCapital_iE_pn3n3_c20240101__20240630_zXcoSMQCcgye" title="Issued capital, Ending" style="border-bottom: Black 2.5pt double; text-align: right"><ix:nonFraction name="ifrs-full:IssuedCapital" contextRef="AsOf2024-06-30" id="Fact006390" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="CNY">450,782</ix:nonFraction></td><td style="padding-bottom: 2.5pt; text-align: left">&#160;</td><td style="padding-bottom: 2.5pt">&#160;</td>
