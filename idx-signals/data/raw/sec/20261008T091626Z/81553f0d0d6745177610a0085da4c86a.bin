    <td style="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">&#160;</td><td id="xdx_989_ecustom--FairValueAtMeasurementDate_pn3n3_uUSD_c20210101__20211231_zk5zKBhrkqDg" title="Fair value at the measurement date" style="font: 10pt Times New Roman, Times, Serif; width: 14%; text-align: right"><ix:nonFraction name="chnr:FairValueAtMeasurementDate" contextRef="From2021-01-012021-12-31" id="Fact004505" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">70</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif; width: 1%">&#160;</td>
