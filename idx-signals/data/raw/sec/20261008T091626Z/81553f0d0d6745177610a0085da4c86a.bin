    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td id="xdx_982_ecustom--FairValueAtMeasurementDate_c20210101__20211231_pn3n3" title="Fair value at the measurement date" style="font: 10pt Times New Roman, Times, Serif; text-align: right"><ix:nonFraction name="chnr:FairValueAtMeasurementDate" contextRef="From2021-01-012021-12-31" id="Fact004509" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="CNY">449</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif">&#160;</td>
