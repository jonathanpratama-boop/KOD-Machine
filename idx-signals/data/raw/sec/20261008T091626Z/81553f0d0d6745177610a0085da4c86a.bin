    <div style="break-before: page; margin-top: 6pt"><table cellpadding="0" cellspacing="0" id="xdx_235_zeECwO5Ly6Yh" style="width: 100%"><tr><td style="text-align: center; width: 100%"><p style="font: 10pt/11.4pt Times New Roman, Times, Serif; margin: 0; text-align: center"><b>CHINA NATURAL RESOURCES, INC. AND SUBSIDIARIES</b></p><p style="font: 10pt/11.4pt Times New Roman, Times, Serif; margin: 0; text-align: center"><b>NOTES TO CONDENSED CONSOLIDATED FINANCIAL STATEMENTS (UNAUDITED)</b></p><p style="font: 10pt Times New Roman, Times, Serif; margin: 0; text-align: center"><b>(Amounts in thousands, except share and per share data)</b></p>&#160;</td></tr></table></div>
