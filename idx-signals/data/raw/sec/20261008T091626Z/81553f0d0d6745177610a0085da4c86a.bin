  <tr id="xdx_408_eifrs-full--CashFlowsFromUsedInOperatingActivities_i_pn3n3" style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 83%; text-align: left">Operating activities</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 14%; text-align: right"><ix:nonFraction name="ifrs-full:CashFlowsFromUsedInOperatingActivities" contextRef="From2023-01-012023-06-30_custom_PSTTMember" id="Fact005473" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="CNY">5,702</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
