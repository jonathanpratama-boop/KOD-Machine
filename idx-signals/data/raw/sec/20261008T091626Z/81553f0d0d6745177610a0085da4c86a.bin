    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td id="xdx_496_20221231" style="font: 10pt Times New Roman, Times, Serif; text-align: right">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td id="xdx_497_20231231" style="text-align: right">&#160;</td><td style="text-align: left">&#160;</td><td>&#160;</td>
