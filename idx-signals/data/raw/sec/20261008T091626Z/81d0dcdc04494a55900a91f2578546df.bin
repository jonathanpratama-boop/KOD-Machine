  <tr style="vertical-align: bottom">
    <td style="text-align: justify"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font-weight: bold"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td colspan="2" style="font-weight: bold; text-align: center"><span style="font-family: Times New Roman, Times, Serif">RMB</span></td><td style="font-weight: bold"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font-weight: bold"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td colspan="2" style="font-weight: bold; text-align: center"><span style="font-family: Times New Roman, Times, Serif">RMB</span></td><td style="font-weight: bold"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
