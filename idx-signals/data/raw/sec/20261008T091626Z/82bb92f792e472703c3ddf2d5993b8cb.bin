<DESCRIPTION>PRESS RELEASE ANNOUNCING REVERSE STOCK SPLIT
<TEXT>
<HTML>
<HEAD>
     <TITLE></TITLE>
</HEAD>
<BODY STYLE="font: 10pt Times New Roman, Times, Serif">

<P STYLE="text-align: right; margin: 0"><B>Exhibit 99.1</B></P>

<P STYLE="margin: 0">&nbsp;</P>

<P STYLE="text-align: right; margin: 0"><IMG SRC="ex99-1_001.jpg" ALT=""></P>

