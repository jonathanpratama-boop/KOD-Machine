     <td style="padding-top:0in;padding-left:0in;vertical-align:middle;padding-bottom:0in;padding-right:0in;text-align:center;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:right;margin-left:0;margin-right:0;"><img src="img58969013_1.jpg" alt="img58969013_1.jpg" style="width:51px;height:47px;"></p></td>
    </tr>
   </table><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><font style="white-space:pre-wrap;font-size:1pt;font-family:'Aptos',sans-serif;font-kerning:none;min-width:fit-content;">&#160;</font></p></div>
