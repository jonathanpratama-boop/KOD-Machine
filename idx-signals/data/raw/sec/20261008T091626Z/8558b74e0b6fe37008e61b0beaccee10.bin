2025 &#8211; <ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_9_1_2024_To_5_31_2025_ifrs-full_BusinessCombinationsAxis_vmar_NauticalVenturesGroupIncMember_9CgpwI7SCk2pjWEXrX7NVw" decimals="0" format="ixt-sec:numwordsen" name="vmar:GainLossOnRevaluationOfContingentConsideration" scale="0" id="Narr_z-6UyvCXM0OQvIOInzYclQ"><ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_3_1_2025_To_5_31_2025_ifrs-full_BusinessCombinationsAxis_vmar_NauticalVenturesGroupIncMember_wDgUnhBJKE2j-gHRQgJJHA" decimals="0" format="ixt-sec:numwordsen" name="vmar:GainLossOnRevaluationOfContingentConsideration" scale="0" id="Narr_xj4HgRVfWU6tbL9Mok1OIQ">nil</ix:nonFraction></ix:nonFraction> for both periods] and a gain of $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_3_1_2026_To_5_31_2026_ifrs-full_BusinessCombinationsAxis_vmar_NauticalVenturesGroupIncMember_8h3ceCybCkytx873Tm28zw" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:GainsOnChangeInFairValueOfDerivatives" scale="0" id="Narr_WgBpqkg-8kOPhuEBWyyw9g">6,295</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_9_1_2025_To_5_31_2026_ifrs-full_BusinessCombinationsAxis_vmar_NauticalVenturesGroupIncMember_38tJpzEmU06H-m7MDn0M7A" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:GainsOnChangeInFairValueOfDerivatives" scale="0" id="Narr_vGBA_mwvXEqx1iZTq8k0OQ">366,751</ix:nonFraction> respectively related to the valuation of the derivative liabilities [May 31, 2025 &#8211; <ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_9_1_2024_To_5_31_2025_ifrs-full_BusinessCombinationsAxis_vmar_NauticalVenturesGroupIncMember_9CgpwI7SCk2pjWEXrX7NVw" decimals="0" format="ixt-sec:numwordsen" name="ifrs-full:GainsOnChangeInFairValueOfDerivatives" scale="0" id="Narr_k9gSA_rVIkmqLDn9mMwgDQ"><ix:nonFraction unitRef="Unit_Standard_USD_