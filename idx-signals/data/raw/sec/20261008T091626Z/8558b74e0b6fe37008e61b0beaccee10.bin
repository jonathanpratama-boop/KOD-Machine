-full_TypesOfFinancialLiabilitiesAxis_vmar_WarrantsIssuedToCommonShareholdersMember_G7KtH4k-rE2S9gytS8axNg" decimals="0" format="ixt:num-dot-decimal" name="vmar:ForeignCurrencyTranslationGainLossOnDerivatives" scale="0" id="Tc_FmHTKHjsu0usfMXbCzd8PA_8_4">68,789</ix:nonFraction></p></td></tr><tr style=""><td style="vertical-align:bottom;width:73.64%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Closing balance</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.29%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">&#160;</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.87%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.6pt 0pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="As_Of_5_31_2026_ifrs-full_TypesOfFinancialLiabilitiesAxis_vmar_WarrantsIssuedToCommonShareholdersMember_z6HGR-OKL0-78kzpJGtM_Q" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:NoncurrentDerivativeFinancialLiabilities" scale="0" id="Tc_84ZL_sJ3Tki7-oQsZuJ9pg_9_2">40,651</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.29%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.87%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.6pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="As_Of_8_31_2025_ifrs-full_TypesOfFinancialLiabilitiesAxis_vmar_WarrantsIssuedToCommonShareholdersMember_VmsuDlsPhk2IxCMmkzfVUw" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:NoncurrentDerivativeFinancialLiabilities" scale="0" id="Tc_SxGNPFxz7U6jeADgHXfkdw_9_4">125,227</ix:nonFraction></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">For the three-month period ended May 31, 2026, the Company recorded a gain of $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_3_1_2026_To_5_31_2026_ifrs-full_TypesOfFinancialLiabilitiesAxis_vmar_WarrantsIssuedToCommonShareholdersMember_mPi7NrWcTkSllmJk-XznbA" decimals="0" format="ixt:num-dot-decimal" name="vmar:GainLossRelatedToValuationOfDerivativeFinancialInstruments" scale="0" id="Narr_yI_Md__6W0ew_qTp_4fJDg">391,897</ix:nonFraction> related to the valuation of these instruments in net finance expense (income) [May 31, 2025 &#8211; loss of $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_3_1_2025_To_5_31_2025_ifrs-full_TypesOfFinancialLiabilitiesAxis_vmar_WarrantsIssuedToCommonShareholdersMember_mMSgSeHRTUGtKnEpeqX6Fg" decimals="0" format="ixt:num-dot-decimal" name="vmar:GainLossRelatedToValuationOfDerivativeFinancialInstruments" sign="-" scale="0" id="Narr_DD3ageinYU6KSJDJ39rJaQ">15,484</ix:nonFraction>] [<i style="font-style:italic;">note 21</i>]. For the nine-month period ended May 31, 2026, the Company recorded a gain of $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_9_1_2025_To_5_31_2026_ifrs-full_TypesOfFinancialLiabilitiesAxis_vmar_WarrantsIssuedToCommonShareholdersMember_qURmikBE7kqwkpAUHmawWA" decimals="0" format="ixt:num-dot-decimal" name="vmar:GainLossRelatedToValuationOfDerivativeFinancialInstruments" scale="0" id="Narr_OGIj9yMNc0CHcp0EW45wzA">2,944,965</ix:nonFraction> related to the valuation of these instruments in net finance expense (income) [May 31, 2025 &#8211; $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_9_1_2024_To_5_31_2025_ifrs-full_TypesOfFinancialLiabilitiesAxis_vmar_WarrantsIssuedToCommonShareholdersMember_UN1E6MMi30KtFwvnDk2Y5A" decimals="0" format="ixt:num-dot-decimal" name="vmar:GainLossRelatedToValuationOfDerivativeFinancialInstruments" scale="0" id="Narr_ZZfc7OfJOEmNW0-DyCqlXg">998,595</ix:nonFraction>] [<i style="font-style:italic;">note 21</i>].</p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;">13</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 8pt 0pt;">Vision Marine Technologies Inc.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 8pt 0pt;"><b style="font-weight:bold;">Notes to the condensed interim consolidated financial statements</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">(Unaudited)</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">May 31, 2026</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_yhWaOf3I50yp7kPTGUjnxg_cont2" continuedAt="Tb_yhWaOf3I50yp7kPTGUjnxg_cont3"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Series A Convertible Preferred Shares</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On December 13, 2023, the Company authorized the issuance of Series A Convertible Preferred Shares. This class of shares ranked senior to the Voting Common Shares but retained no voting rights. They had a stated value of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_ggFZRiqKa0a4KEAPuuMx5Q" contextRef="As_Of_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_PqCT0F6g_0i_F2toMrCp-g" decimals="INF" format="ixt:num-dot-decimal" name="vmar:StatedValuePerShare" scale="0" id="Narr_y5h_yIoiCEqEGDBY0vBFtQ">1,000</ix:nonFraction> per share and were convertible into Voting Common Shares of the Company at the election of the holder at any time at a price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_ggFZRiqKa0a4KEAPuuMx5Q" contextRef="As_Of_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_PqCT0F6g_0i_F2toMrCp-g" decimals="2" format="ixt:num-dot-decimal" name="vmar:PreferredStockConvertibleConversionPricePerShare" scale="0" id="Narr_k6aOr0YEFEGDehhvnFLoWQ">567,000.00</ix:nonFraction> per share, exercise price subject to adjustment. The Series A Convertible Preferred Shares were convertible at the election of its holder into that number of Voting Common Shares determined by dividing its stated value (plus any and all other amounts which may be owing in connection therewith) by the exercise price, subject to certain beneficial ownership limitations which prohibited any holder from converting into an amount of Voting Common Shares that would cause such holder to beneficially own more than <ix:nonFraction unitRef="Unit_Standard_pure_xMlTUlsctESFATzoIj6QFg" contextRef="As_Of_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_PqCT0F6g_0i_F2toMrCp-g" decimals="4" format="ixt:num-dot-decimal" name="vmar:ThresholdBeneficialOwnershipPercentageMoreThanWhichConversionProhibited" scale="-2" id="Narr_QjwW-wyMTUWTDUmVGxZ8fQ">4.99</ix:nonFraction>% of the then outstanding Voting Common Shares). On the one-year anniversary of the original issuance date, the Series A Convertible Preferred Shares automatically converted into Voting Common Shares at the lesser of the then exercise price, and <ix:nonFraction unitRef="Unit_Standard_pure_xMlTUlsctESFATzoIj6QFg" contextRef="As_Of_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_PqCT0F6g_0i_F2toMrCp-g" decimals="2" format="ixt:num-dot-decimal" name="vmar:PercentageOfAverageVolumeWeightedAveragePriceOfCommonSharesDuringFiveTradingDaysConsideredForConversionPrice" scale="-2" id="Narr_b-te5Ke3tEeP3hoo9B2Txw">80</ix:nonFraction>% of the average volume-weighted average price of the Company&#8217;s Voting Common Shares during the <span style="-sec-ix-hidden:Hidden_BYjZHtoisUKSyy0NqvU5VQ;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">five</span></span> trading days ending on, and including, such date. The conversion price for the Series A Convertible Preferred Shares had a floor of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_ggFZRiqKa0a4KEAPuuMx5Q" contextRef="As_Of_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_PqCT0F6g_0i_F2toMrCp-g" decimals="2" format="ixt:num-dot-decimal" name="vmar:PreferredStockConvertibleConversionPricePerShareFloor" scale="0" id="Narr_Jk0w13x4pEiHRzwvw9X-eQ">162,000.00</ix:nonFraction>. The holder also received <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_12_13_2023_To_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_4ZdmKTF2IEOlPq_Epjv38Q" decimals="INF" format="ixt:num-dot-decimal" name="vmar:NumberOfWarrantsIssuedToPurchaseCommonShares" scale="0" id="Narr_9dE0tJ4kGE6ofZQ4TG0O0g">1</ix:nonFraction> warrant to purchase Voting Common Shares per $<ix:nonFraction unitRef="Unit_Divide_USD_shares_ggFZRiqKa0a4KEAPuuMx5Q" contextRef="As_Of_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_PqCT0F6g_0i_F2toMrCp-g" decimals="INF" format="ixt:num-dot-decimal" name="vmar:StatedValuePerShare" scale="0" id="Narr_-hWwnrtOtUqn5zDh_7nOSA">1,000</ix:nonFraction> stated value of the Series A Convertible Preferred Shares held that are exercisable for a period of <ix:nonNumeric contextRef="Duration_12_13_2023_To_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_4ZdmKTF2IEOlPq_Epjv38Q" format="ixt-sec:durwordsen" name="vmar:IfrsWarrantsAndRightsOutstandingTerm" id="Narr_88e81_k0xUur_LHO8ALHQQ">5 years</ix:nonNumeric> from the issuance date at a price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_ggFZRiqKa0a4KEAPuuMx5Q" contextRef="As_Of_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_PqCT0F6g_0i_F2toMrCp-g" decimals="2" format="ixt:num-dot-decimal" name="vmar:IfrsClassOfWarrantOrRightExercisePriceOfWarrantsOrRights" scale="0" id="Narr_DOktW74xTEa71ZTJkcLwxw">567,000.00</ix:nonFraction> per share. In addition, the holder received an option to purchase <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_12_13_2023_To_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_4ZdmKTF2IEOlPq_Epjv38Q" decimals="INF" format="ixt-sec:numwordsen" name="vmar:OptionToPurchaseAdditionalSharesNumberOfSharesIssued" scale="0" id="Narr_PKtcWPhpi0G8X76mCBjDbQ">one</ix:nonFraction> additional Series A Convertible Preferred Share and <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_12_13_2023_To_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_4ZdmKTF2IEOlPq_Epjv38Q" decimals="INF" format="ixt:num-dot-decimal" name="vmar:NumberOfWarrantsIssuedToPurchaseCommonShares" scale="0" id="Narr_8sjbMJywNUOVaEwv5MDOsw">1</ix:nonFraction> warrant to purchase Voting Common Shares per each Series A Convertible Preferred Share held for a period of <ix:nonNumeric contextRef="Duration_12_13_2023_To_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_4ZdmKTF2IEOlPq_Epjv38Q" format="ixt-sec:durwordsen" name="vmar:PreferredSharesHoldingPeriodFromIssuance" id="Narr_uA6u7H-f8kCIJu4vEsgU9g">6 months</ix:nonNumeric> from the issuance date at the stated value of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_ggFZRiqKa0a4KEAPuuMx5Q" contextRef="As_Of_12_13_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_PqCT0F6g_0i_F2toMrCp-g" decimals="INF" format="ixt:num-dot-decimal" name="vmar:StatedValuePerShare" scale="0" id="Narr_rCDb-2Y4QUCjV4EIU9cdlg">1,000</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On December 21, 2023, the Company issued <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_12_21_2023_To_12_21_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_IRwKCpaEdkyfaR-2UQ_rHQ" decimals="INF" format="ixt:num-dot-decimal" name="vmar:IfrsStockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_Tep9WgIjXUO3oSx41fM01w">3,000</ix:nonFraction> Series A Convertible Preferred Shares and <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_12_21_2023_To_12_21_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_IRwKCpaEdkyfaR-2UQ_rHQ" decimals="INF" format="ixt:num-dot-decimal" name="vmar:NumberOfWarrantsIssuedToPurchaseCommonShares" scale="0" id="Narr_71zt-Qe-6UmiMGZ5ECGUbw">13</ix:nonFraction> warrants to purchase Voting Common Shares for a total cash consideration of $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_12_21_2023_To_12_21_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_IRwKCpaEdkyfaR-2UQ_rHQ" decimals="0" format="ixt:num-dot-decimal" name="vmar:ProceedsFromIssueOfConvertiblePreferredSharesAndWarrants" scale="0" id="Narr_lt4AjkXNjkit2FT-Nc-e2g">3,000,000</ix:nonFraction>. For the fiscal year ended August 31, 2024, the Company incurred transaction costs of $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_9_1_2023_To_8_31_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_Q8haOitq4E6tEJQjJVYZXw" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:ShareIssueRelatedCost" scale="0" id="Narr_dMK58JcBiEqIECfFwc3d0w">452,398</ix:nonFraction> related to this issuance.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">During the fiscal year ended August 31, 2024, <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_9_1_2023_To_8_31_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_Q8haOitq4E6tEJQjJVYZXw" decimals="INF" format="ixt:num-dot-decimal" name="vmar:PreferredStockConvertibleSharesConverted" scale="0" id="Narr_movZcu7WAES-pqdHN_UCxQ">650</ix:nonFraction> Series A Convertible Preferred Shares were converted into <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_9_1_2023_To_8_31_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_Q8haOitq4E6tEJQjJVYZXw" decimals="INF" format="ixt:num-dot-decimal" name="vmar:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleSecurities" scale="0" id="Narr_9-iP_AJ8jEWp7RPDB27HAA">13</ix:nonFraction> Voting Common Shares at a value of $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_9_1_2023_To_8_31_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_Q8haOitq4E6tEJQjJVYZXw" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:IncreaseDecreaseThroughConversionOfConvertibleInstruments" scale="0" id="Narr_nprRIJUYsEi-MEVPwCy43w">199,069</ix:nonFraction> <i style="font-style:italic;">[note 18]</i>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On August 16, 2024, <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_8_16_2024_To_8_16_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_HyFE5xyRdU2c381p_Cpcwg" decimals="INF" format="ixt:num-dot-decimal" name="vmar:NumberOfWarrantsIssuedToPurchaseCommonShares" scale="0" id="Narr_UPqqUzkIhkeG_ivG0-pWsg">13</ix:nonFraction> warrants to purchase Voting Common Shares issued to Series A Convertible Preferred shareholders were exchanged for <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_8_16_2024_To_8_16_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_HyFE5xyRdU2c381p_Cpcwg" decimals="INF" format="ixt:num-dot-decimal" name="vmar:StockIssuedDuringPeriodSharesExchangeOfWarrants" scale="0" id="Narr_M-x-0nlU2UqonMmvDmWnzg">11</ix:nonFraction> Voting Common Shares and <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_8_16_2024_To_8_16_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_ifrs-full_ComponentsOfEquityAxis_vmar_PreFundedWarrantsMember_tDq0e9GUykauDV7FzPjavw" decimals="INF" format="ixt:num-dot-decimal" name="vmar:StockIssuedDuringPeriodSharesExchangeOfWarrants" scale="0" id="Narr_iDNXGvVm4ka6ScgOHJ9_lQ">1</ix:nonFraction> Pre-Funded Warrant.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">During the fiscal year ended August 31, 2025, <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_9_1_2024_To_8_31_2025_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_l6tGRqTAoU2H9NfAakCqow" decimals="INF" format="ixt:num-dot-decimal" name="vmar:PreferredStockConvertibleSharesConverted" scale="0" id="Narr_DjXtUaPYoEuu5BoSGO8YKg">400</ix:nonFraction> Series A Convertible Preferred Shares were converted into <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_9_1_2024_To_8_31_2025_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_l6tGRqTAoU2H9NfAakCqow" decimals="INF" format="ixt:num-dot-decimal" name="vmar:IfrsStockIssuedDuringPeriodSharesConversionOfConvertibleSecurities" scale="0" id="Narr_gjdfXiiiGEivSFxPtd93sQ">4</ix:nonFraction> Voting Common Shares at a value of $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_9_1_2024_To_8_31_2025_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_l6tGRqTAoU2H9NfAakCqow" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:IncreaseDecreaseThroughConversionOfConvertibleInstruments" scale="0" id="Narr_u5zpUG0yKUST1bI8DEI8Bg">100,610</ix:nonFraction> <i style="font-style:italic;">[note 18]</i>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On December 21, 2024, the Company forced the conversion of <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="Duration_12_21_2024_To_12_21_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_2gD156Oif0K_CG4fXdE65Q" decimals="INF" format="ixt:num-dot-decimal" name="vmar:PreferredStockConvertibleSharesConverted" scale="0" id="Narr_YGkKL0HZzEKVVZ9a1on78A">1,950</ix:nonFraction> Series A Convertible Preferred Shares into <ix:nonFraction unitRef="Unit_Standard_shares_PSKhk4L0BEuBjbMNWXfihw" contextRef="As_Of_12_21_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_diilFa027k-TTCApqp4LwA" decimals="INF" format="ixt:num-dot-decimal" name="vmar:IfrsConvertiblePreferredStockSharesIssuedUponConversion" scale="0" id="Narr_kqrn_RDf4EqypJ_62IJ9nQ">16</ix:nonFraction> Common Shares at a value of $<ix:nonFraction unitRef="Unit_Standard_USD_8tOzrXACyEyiIY7tlUEziA" contextRef="Duration_12_21_2024_To_12_21_2024_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_DerivativesMember_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_2gD156Oif0K_CG4fXdE65Q" decimals="0" format="ixt:num-dot-decimal" name="vmar:ForcedConversionToCommonSharesDerivativeFinancialLiabilities" scale="0" id="Narr_pwn-WO-PfkOnXILzH6akCA">71,784</ix:nonFraction> <i style="font-style:italic;">[note 18]</i>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Given the variability associated with the various components of this instrument, these instruments were recorded as derivative liabilities and will be subject to fair value adjustments at the issuance date and at subsequent balance sheet dates. The fair value was determined using the Monte Carlo simulation run under the Geometric Brownian Motion. Since the fair value is based on valuation using unobservable market inputs, the Company did not recognize the loss on initial recognition. The difference between the fair value at initial recognition and the transaction price was deferred and is recognized over time based on the individual terms of each financial instrument. This difference determined was due to delays in negotiations, the changes in the capital market and the Company&#8217;s liquidity situation.</p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:24pt 0pt 0pt 0pt;">14</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 8pt 0pt;">Vision Marine Technologies Inc.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 8pt 0pt;"><b style="font-weight:bold;">Notes to the condensed interim consolidated financial statements</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">(Unaudited)</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">May 31, 2026</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc_riFt1Gkqw0Oy594juNNoAQ_1_2"></a><a id="Tc_m4iN_WwKSEiSOchjGQVaUw_1_4"></a><a id="Tc_0FDUU1tBokO86ZBNkF784g_2_2"></a><a id="Tc_9gf2s9Nf90uNaozy9Q8-iA_2_4"></a><a id="Tc_4Iu1ATeim0GTt_vbccss-g_3_2"></a><a id="Tc_-WnRPAJtdEyK97NUyxQDxQ_3_4"></a><a id="Tc_Y7fX7xz3CUCl9dc49wj7dQ_4_2"></a><a id="Tc_MUdarnRDmUuVybmAKkjvKA_4_4"></a><a id="Tc_fLRVEbn3iUC9nGG0NX5t3g_5_0"></a><a id="Tc_gwGnPLlo5Eei1BB_SfqvhQ_5_2"></a><a id="Tc_ScRu81-_TE-7-MXI1yC7wQ_6_0"></a><a id="Tc_SxD9k2tH8UGhgDI_ObqmzA_6_2"></a><a id="Tc_Qzn85x7pIEmxrQRixWOhqA_7_0"></a><a id="Tc_cD-RHRn0a0qzd30YBCssiQ_7_2"></a><a id="Tc_XI9KRZRcpkimp1rFpDgD0Q_8_0"></a><a id="Tc_z9ZhDECgIU2_SGOsC2aIag_8_2"></a><a id="Tc_q4rPHceGi0m98BdjiO-F7Q_9_0"></a><a id="Tc_VRGameKF9k2xDI5zR1gx-w_9_2"></a><a id="Tc_XScr62y-hEKjtskZr7Xh2Q_10_0"></a><a id="Tc_UCs_otPddUKZD66QYCMr1Q_10_2"></a><a id="Tc_nAaNuSTwnUGPGFAEmkPvdA_11_0"></a><a id="Tc__HrmA-sZ_Ui8-lcB-ErvMg_11_2"></a><a id="Tc_wM_ljh0O-EqJ2hswUvFnvQ_11_4"></a><ix:continuation id="Tb_yhWaOf3I50yp7kPTGUjnxg_cont3" continuedAt="Tb_yhWaOf3I50yp7kPTGUjnxg_cont4"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The table below summarizes the movement in the derivative liabilities related to the Series A Convertible Preferred Shares including the related warrants and option to purchase additional Series A Convertible Preferred Shares and related warrants during the nine-month period ended May 31, 2026 and the fiscal year ended August 31, 2025:</p><ix:nonNumeric contextRef="Duration_9_1_2025_To_5_31_2026_ifrs-full_ClassesOfShareCapitalAxis_vmar_SeriesConvertiblePreferredSharesMember_zV4_23yv6EuDFvlpLh2_4Q" name="vmar:ScheduleOfMovementsInDerivativeFinancialLiabilitiesTableTextBlock" id="Tb_vsm3ekourk2adtQJOVmtEg" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:73.64%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2.29%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:10.87%