    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">229,204</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">35,933</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">193,271</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">537.9</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
