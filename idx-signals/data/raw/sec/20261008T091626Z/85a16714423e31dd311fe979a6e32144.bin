    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">125,302</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">67,082</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">58,220</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">86.8</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: White">
    <TD STYLE="font-weight: bold; text-align: justify"><FONT STYLE="font-family: Times New Roman, Times, Serif">Total</FONT></TD><TD STYLE="font-weight: bold"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="font-weight: bold; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="font-weight: bold; text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">2,509,528</FONT></TD><TD STYLE="font-weight: bold; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="font-weight: bold"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="font-weight: bold; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="font-weight: bold; text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">799,677</FONT></TD><TD STYLE="font-weight: bold; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="font-weight: bold"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="font-weight: bold; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="font-weight: bold; text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">1,709,851</FONT></TD><TD STYLE="font-weight: bold; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="font-weight: bold"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="font-weight: bold; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="font-weight: bold; text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">213.8</FONT></TD><TD STYLE="font-weight: bold; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD></TR>
