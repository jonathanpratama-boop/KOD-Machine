  <TR STYLE="vertical-align: bottom">
    <TD STYLE="text-align: center">&nbsp;</TD><TD STYLE="text-align: center; font-weight: bold">&nbsp;</TD>
    <TD COLSPAN="2" STYLE="font-weight: bold; text-align: center">US$</TD><TD STYLE="text-align: center; font-weight: bold">&nbsp;</TD><TD STYLE="text-align: center">&nbsp;</TD>
