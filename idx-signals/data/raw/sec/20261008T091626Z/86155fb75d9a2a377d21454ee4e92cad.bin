    <td style="font-family: Times New Roman, Times, Serif; width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif"></span>&#160;</td><td style="font-family: Times New Roman, Times, Serif; width: 16%; text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">$<span id="xdx_90A_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExercisePrice_iI_pid_c20211231__srt--RangeAxis__srt--MinimumMember__us-gaap--OptionIndexedToIssuersEquityTypeAxis__us-gaap--EmployeeStockMember_zvAdOfDuVng5" title="Exercise price"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExercisePrice" contextRef="AsOf2021-12-31_srt_MinimumMember_us-gaap_EmployeeStockMember" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">0.41</ix:nonFraction></span>-$<span id="xdx_90B_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExercisePrice_iI_pid_c20211231__srt--RangeAxis__srt--MaximumMember__us-gaap--OptionIndexedToIssuersEquityTypeAxis__us-gaap--EmployeeStockMember_z1TpDYvo6VD9" title="Exercise price"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExercisePrice" contextRef="AsOf2021-12-31_srt_MaximumMember_us-gaap_EmployeeStockMember" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">1.81</ix:nonFraction></span></span></td><td style="font-family: Times New Roman, Times, Serif; width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
  <tr style="font-family: Times New Roman, Times, Serif; vertical-align: bottom; background-color: White">
