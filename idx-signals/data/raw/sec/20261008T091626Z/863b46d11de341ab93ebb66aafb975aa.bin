    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="nlsp:VendorPrepayments" scale="0" unitRef="usd" id="ixv-4152">65,237</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
