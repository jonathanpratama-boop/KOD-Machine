    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c1" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DeferredTaxAssetsOperatingLossCarryforwards" scale="0" unitRef="usd" id="ixv-5156">3,468,411</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
