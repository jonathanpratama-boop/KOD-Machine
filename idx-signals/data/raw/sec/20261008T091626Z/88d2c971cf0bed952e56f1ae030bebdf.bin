    <td style="border-bottom: black 1pt solid; text-align: center"><span style="font-size: 10pt">For</span></td>
    <td style="padding-bottom: 1pt">&#160;</td>
    <td style="border-bottom: black 1pt solid; text-align: center"><span style="font-size: 10pt">Against</span></td>
    <td style="padding-bottom: 1pt">&#160;</td>
    <td style="border-bottom: black 1pt solid; text-align: center"><span style="font-size: 10pt">Abstain</span></td></tr>
  <tr style="vertical-align: bottom; background-color: #CCEEFF">
    <td style="width: 34%; text-align: center"><span style="font-size: 10pt">35,257,952</span></td>
    <td style="width: 1%">&#160;</td>
    <td style="width: 33%; text-align: center"><span style="font-size: 10pt">4,775,817</span></td>
