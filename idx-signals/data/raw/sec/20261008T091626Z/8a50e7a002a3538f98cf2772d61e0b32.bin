            <td style="padding:0pt; width:3pt;">&#8203;</td>
            <td style="padding:3.5pt 0pt 1.5pt 0pt; width:302.78pt;">
              <font style="letter-spacing:0.2pt;">Office and studio/production facilities </font>
            </td>
            <td style="padding:0pt; width:3pt;">&#8203;</td>
            <td style="padding:0pt; width:3pt;">&#8203;</td>
            <td style="padding:3.5pt 0pt 1.5pt 0pt; width:37.59pt;">
              <font style="letter-spacing:0.2pt;">Own </font>
            </td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
