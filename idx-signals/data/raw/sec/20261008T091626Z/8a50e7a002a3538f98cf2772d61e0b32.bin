      <div style="margin-top:6pt;margin-left:69.66pt;width:456pt;">
        <table style="width:376pt;margin-left:40pt;margin-top:0pt;border-collapse: collapse;font-style:italic;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Times New Roman, Times, serif ;font-size:10pt;">
