            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt;padding-left:7.69pt;width:0pt;">&#8203;</td>
            <td style="padding:3.25pt 0pt 2.5pt 0pt;border-bottom:3pt double #000000; min-width:3.75pt; text-align:right; ">$</td>
            <td style="padding:3.25pt 0pt 2.5pt 0pt;border-bottom:3pt double #000000; min-width:7.5pt; text-align:right; white-space:nowrap;">20</td>
