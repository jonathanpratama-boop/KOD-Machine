            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:2.167pt 0pt 1pt 0pt; width:264.65pt;">
              <div style="text-align:center;">
                <font style="letter-spacing:-0.2pt;">SIRIUS XM HOLDINGS INC.</font>
                <br >
                <font style="letter-spacing:-0.2pt;">1221 Avenue of the Americas, 35th Floor</font>
                <br >
                <font style="letter-spacing:-0.2pt;">New York, New York 10020</font>
