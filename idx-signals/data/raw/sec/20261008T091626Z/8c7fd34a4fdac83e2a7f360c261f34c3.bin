</div><ix:nonNumeric contextRef="c0" continuedAt="syta_SegmentedInformationDisclosureTextBlock-c0_cont_1" escape="true" name="syta:SegmentedInformationDisclosureTextBlock"><table cellpadding="0" cellspacing="0" style="font: 10pt Times New Roman, Times, Serif; width: 100%">
