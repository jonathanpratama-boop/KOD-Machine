    <td style="width: 1%; font-weight: bold; text-align: left">$</td><td style="width: 9%; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:FinishedGoods" scale="0" unitRef="usd">7,392,002</ix:nonFraction></td><td style="width: 1%; font-weight: bold; text-align: left">&#160;</td></tr>
