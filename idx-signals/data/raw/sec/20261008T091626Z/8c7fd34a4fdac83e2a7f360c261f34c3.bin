    <td style="text-align: left"><b>&#160;</b></td><td style="text-align: right"><b><ix:nonFraction contextRef="c4" decimals="-3" format="ixt:num-dot-decimal" name="syta:RegulatoryAndFilingFees" scale="3" unitRef="usd">59</ix:nonFraction></b></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c5" decimals="-3" format="ixt:num-dot-decimal" name="syta:RegulatoryAndFilingFees" scale="3" unitRef="usd">44</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left; padding-bottom: 1.5pt">Shareholder relations</td><td style="font-weight: bold; padding-bottom: 1.5pt">&#160;</td>
