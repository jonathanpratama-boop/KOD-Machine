    <td style="padding-left: 10pt; text-align: left">Reserve for conversion of Class B Common Stock</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction name="MOBX:ReserveForConversionOfClassBCommonStock" contextRef="AsOf2025-12-31_us-gaap_CommonClassAMember" id="Fact001051" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">2,004,901</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
