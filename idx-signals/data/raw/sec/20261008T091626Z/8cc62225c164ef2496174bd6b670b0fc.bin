    <td style="text-align: left; padding-left: 10pt">Proceeds from Chavant trust fund</td><td>&#160;</td>
    <td style="text-align: left">$</td><td style="text-align: right"><ix:nonFraction name="us-gaap:ProceedsFromDecommissioningFund" contextRef="From2023-12-212023-12-21" id="Fact002487" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">1,264</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
