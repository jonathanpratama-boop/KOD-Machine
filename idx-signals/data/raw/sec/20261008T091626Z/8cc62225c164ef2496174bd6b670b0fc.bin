    <td style="text-align: left; padding-left: 10pt">Awards available for grant under 2023 Equity Incentive Plan</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAvailableForGrant" contextRef="AsOf2025-09-30_us-gaap_CommonClassAMember" id="Fact003285" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">2,560,898</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr id="xdx_406_ecustom--AwardsAvailableForGrantUnderEmployeeStockPurchasePlan_iI_pid_zsBeSHsPFxll" style="vertical-align: bottom; background-color: White">
    <td style="text-align: left; padding-bottom: 1pt; padding-left: 10pt">Reserve for issuance under 2023 Employee Stock Purchase Plan</td><td style="padding-bottom: 1pt">&#160;</td>
