    <TD STYLE="border-bottom: Black 1.5pt solid; text-align: left">$</TD><TD STYLE="border-bottom: Black 1.5pt solid; text-align: right">0.11</TD><TD STYLE="padding-bottom: 1.5pt; text-align: left">&nbsp;</TD><TD STYLE="padding-bottom: 1.5pt">&nbsp;</TD>
    <TD STYLE="border-bottom: Black 1.5pt solid; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1.5pt solid; text-align: right">&nbsp;</TD><TD STYLE="padding-bottom: 1.5pt; text-align: left">&nbsp;</TD></TR>
