    <DIV STYLE="break-before: page; margin-top: 6pt; margin-bottom: 6pt"><TABLE CELLSPACING="0" CELLPADDING="0" STYLE="font-size: 10pt; width: 100%; border-collapse: collapse"><TR STYLE="vertical-align: top"><TD STYLE="width: 34%; border: black 1pt solid; padding-left: 4.5pt; font-size: 10pt"><FONT STYLE="font-size: 10pt">CUSIP No. N81409109</FONT></TD><TD STYLE="width: 33%; border-top: black 1pt solid; border-right: black 1pt solid; border-bottom: black 1pt solid; padding-left: 4.5pt; font-size: 10pt"><FONT STYLE="font-size: 10pt">Schedule 13D</FONT></TD><TD STYLE="width: 33%; border-top: black 1pt solid; border-right: black 1pt solid; border-bottom: black 1pt solid; font-size: 10pt; text-align: right"><FONT STYLE="font-size: 10pt">Page <!-- Field: Sequence; Type: Arabic; Name: PageNo -->6<!-- Field: /Sequence --> of 8</FONT></TD></TR></TABLE></DIV>
    <!-- Field: /Page -->

<P STYLE="margin: 0pt 0 0pt 0.5in; font-size: 10pt">&nbsp;</P>

<TABLE CELLPADDING="0" CELLSPACING="0" STYLE="width: 100%; font-size: 10pt">
  <TR STYLE="vertical-align: top">
