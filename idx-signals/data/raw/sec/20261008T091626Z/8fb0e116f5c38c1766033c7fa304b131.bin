  <tr style="vertical-align: top; background-color: white">
    <td style="border-bottom: black 1pt solid; width: 24%; text-align: center"><span style="font-size: 10pt"><b>Votes For</b></span></td>
    <td style="width: 1%">&#160;</td>
    <td style="border-bottom: black 1pt solid; width: 24%">
    <p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: center"><b>Votes Against</b></p></td>
