<title>val-20240105</title></head><body><div style="display:none"><ix:header><ix:hidden><ix:nonNumeric contextRef="c-1" name="dei:AmendmentFlag" format="ixt:fixed-false" id="f-22">FALSE</ix:nonNumeric><ix:nonNumeric contextRef="c-1" name="dei:EntityCentralIndexKey" id="f-23">0001824293</ix:nonNumeric></ix:hidden><ix:references xml:lang="en-US"><link:schemaRef xlink:type="simple" xlink:href="val-20240105.xsd"></link:schemaRef></ix:references><ix:resources><xbrli:context id="c-1"><xbrli:entity><xbrli:identifier scheme="http://www.sec.gov/CIK">0001824293</xbrli:identifier></xbrli:entity><xbrli:period><xbrli:startDate>2024-01-05</xbrli:startDate><xbrli:endDate>2024-01-05</xbrli:endDate></xbrli:period></xbrli:context></ix:resources></ix:header></div><div id="i08bc8f7d9da849b0a41f1be83cc7525e_1"></div><div style="min-height:50pt;width:100%"><div><span><br/></span></div></div><div style="margin-top:0.3pt;text-align:center"><img src="val-20240105_g1.jpg" alt="Image_0.jpg" style="height:4px;margin-bottom:5pt;vertical-align:text-bottom;width:741px"/></div><div><span><br/></span></div><div style="margin-top:4.8pt;text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:12pt;font-weight:700;line-height:120%">UNITED STATES</span></div><div style="margin-top:0.55pt;text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:12pt;font-weight:700;line-height:120%">SECURITIES AND EXCHANGE COMMISSION</span></div><div style="margin-top:0.6pt;padding-left:233.45pt;padding-right:233.45pt;text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:8pt;font-weight:700;line-height:246%">Washington, D.C. 20549 </span><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:12pt;font-weight:700;line-height:246%">FORM <ix:nonNumeric contextRef="c-1" name="dei:DocumentType" id="f-1">8-K</ix:nonNumeric></span></div><div style="margin-top:0.05pt;text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:700;line-height:120%">CURRENT REPORT</span></div><div style="margin-bottom:9pt;text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:700;line-height:120%">Pursuant to Section 13 OR 15(d) of The Securities Exchange Act of 1934</span></div><div style="margin-bottom:9pt;margin-top:0.05pt;text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Date of Report (Date of earliest event reported): <ix:nonNumeric contextRef="c-1" name="dei:DocumentPeriodEndDate" format="ixt:date-monthname-day-year-en" id="f-2">January 5, 2024</ix:nonNumeric></span></div><div style="text-align:center"><img src="val-20240105_g2.jpg" alt="Image_8.jpg" style="height:0px;margin-bottom:5pt;vertical-align:text-bottom;width:741px"/></div><div style="padding-left:90pt;padding-right:90pt;text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%">   </span></div><div style="text-align:center;text-indent:36pt"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:12pt;font-weight:700;line-height:120%"><ix:nonNumeric contextRef="c-1" name="dei:EntityRegistrantName" id="f-3">GRI BIO, INC.</ix:nonNumeric></span></div><div style="margin-bottom:9pt;text-align:center"><span style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:8pt;font-weight:400;line-height:120%">(Exact name of registrant as specified in its charter)</span></div><div style="margin-top:1.25pt;padding-left:31.85pt;padding-right:31.85pt;text-align:center;text-indent:-16.1pt"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:99.953%"><tr><td style="width:1.0%"></td><td style="width:31.693%"></td><td style="width:0.1%"></td><td style="wid