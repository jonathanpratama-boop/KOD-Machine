    <td style="width: 1%; border-bottom: Black 1.5pt solid; text-align: left">$</td><td style="width: 9%; border-bottom: Black 1.5pt solid; text-align: right">(<ix:nonFraction contextRef="c94" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:LiabilitiesFairValueDisclosure" scale="0" unitRef="usd" id="ixv-7350">5,925,501</ix:nonFraction></td><td style="width: 1%; padding-bottom: 1.5pt; text-align: left">)</td><td style="width: 1%; padding-bottom: 1.5pt">&#160;</td>
    <td style="width: 1%; border-bottom: Black 1.5pt solid; text-align: left">$</td><td style="width: 9%; border-bottom: Black 1.5pt solid; text-align: right">(<ix:nonFraction contextRef="c94" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:FairValueNetAssetLiability" scale="0" sign="-" unitRef="usd" id="ixv-7351">5,925,501</ix:nonFraction></td><td style="width: 1%; padding-bottom: 1.5pt; text-align: left">)</td></tr>
  <tr style="vertical-align: bottom; ">
    <td style="padding-bottom: 4pt; padding-left: 5.4pt">&#160;</td><td style="padding-bottom: 4pt">&#160;</td>
