    <TD STYLE="border-bottom: Black 1.5pt solid; white-space: nowrap; width: 40%"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">/s/ <I>Wei Zhang</I></FONT></TD>
    <TD STYLE="width: 60%">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom">
    <TD STYLE="white-space: nowrap"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">Chairwoman of the Board</FONT></TD>
    <TD>&nbsp;</TD></TR>
  </TABLE>
<P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0">&nbsp;</P>

<P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0"></P>

