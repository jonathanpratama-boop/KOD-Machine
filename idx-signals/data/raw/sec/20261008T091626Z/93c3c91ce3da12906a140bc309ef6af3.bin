    <td style="background-color:rgba(255,255,255,1);word-break:break-word;white-space:pre-wrap;vertical-align:bottom;text-align:center;"><p style="text-indent:0.0pt;font-size:10.0pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:right;"><span style="font-size:8.0pt;font-family:&quot;Times New Roman&quot;, serif;background-color:rgba(0,0,0,0);color:rgba(0,0,0,1);white-space:pre-wrap;font-weight:normal;font-size:8.0pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;"><ix:nonFraction id="F_2ed28b84-6ea7-491f-abda-053f1e4abab4" contextRef="C_9fcb878a-b600-4caa-948c-26075d66da86" name="pali:NetProceedsFromInsuranceFinancingArrangementsIncludedInPrepaidAndOtherAssetsAndOherNoncurrentAsstes" unitRef="U_USD" scale="3" decimals="-3" format="ixt:num-dot-decimal">461</ix:nonFraction></span></p></td>
