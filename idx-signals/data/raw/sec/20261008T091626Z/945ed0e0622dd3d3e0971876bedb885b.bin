     <td style="padding-top:0in;border-right:0.75pt solid #000000;padding-left:0in;vertical-align:middle;padding-bottom:0in;border-bottom:0.75pt solid #000000;padding-right:0in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">806,139</span></p></td>
