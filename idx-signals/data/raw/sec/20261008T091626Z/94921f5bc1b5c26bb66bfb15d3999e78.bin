  <TR>
    <TD STYLE="padding-right: 0.1in; font: 10pt Arial, Helvetica, Sans-Serif; text-align: center; padding-left: 0.1in"><FONT STYLE="font-size: 9pt"><IMG SRC="image_001.jpg" ALT="barclays PLC logo" STYLE="height: 42px; width: 179px"></FONT></TD></TR>
