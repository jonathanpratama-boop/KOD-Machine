<td style="width: 0pt"/><td id="xdx_F01_z21iFFs9BcLe" style="width: 9pt; text-align: left">*</td><td id="xdx_F11_zlUi5BESqYNc"><ix:footnote id="Footnote001885" xml:lang="en-US">asset is not yet in use and has not started amortising</ix:footnote></td>
