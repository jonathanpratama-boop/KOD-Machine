    <td colspan="2" style="border-bottom: Black 1pt solid; white-space: nowrap; color: #4D4D4C; text-align: right"><p style="font: 10pt Times New Roman; margin: 0pt; color: #4D4D4C; text-align: right"><b>2023</b></p> <p style="font: 10pt Times New Roman; margin: 0pt; color: #4D4D4C; text-align: right"><b>&#163;&#8217;000</b></p></td><td style="border-bottom: Black 1pt solid; white-space: nowrap; color: #4D4D4C">&#160;</td><td style="border-bottom: Black 1pt solid; white-space: nowrap; color: #4D4D4C">&#160;</td>
