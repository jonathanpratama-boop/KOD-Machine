    <td style="color: #4D4D4C; text-align: left">&#160;</td><td style="color: #4D4D4C; text-align: right"><span id="xdx_905_eifrs-full--DescriptionOfExpectedVolatilityShareOptionsGranted_pid_dp_c20231201__20231231__ifrs-full--ClassesOfShareCapitalAxis__ifrs-full--WarrantsMember_fKio___zbC2RWSvjQU8" title="Volatility"><ix:nonFraction name="ifrs-full:DescriptionOfExpectedVolatilityShareOptionsGranted" contextRef="From2023-12-012023-12-31_ifrs-full_WarrantsMember" id="Fact004289" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">60</ix:nonFraction></span></td><td style="color: #4D4D4C; text-align: left">%**</td></tr>
