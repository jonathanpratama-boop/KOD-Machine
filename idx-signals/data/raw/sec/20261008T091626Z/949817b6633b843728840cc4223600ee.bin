    <td style="border-bottom: Black 1pt solid; text-align: left">Risk free rate</td><td style="border-bottom: Black 1pt solid; color: #4D4D4C">&#160;</td>
    <td style="border-bottom: Black 1pt solid; color: #4D4D4C; text-align: left">&#160;</td><td style="border-bottom: Black 1pt solid; color: #4D4D4C; text-align: right"><span id="xdx_90C_eifrs-full--DescriptionOfRiskFreeInterestRateShareOptionsGranted_pid_dp_c20230301__20230331__ifrs-full--ClassesOfShareCapitalAxis__ifrs-full--WarrantsMember_zSbBQtWDKOt5" title="Risk free rate"><ix:nonFraction name="ifrs-full:DescriptionOfRiskFreeInterestRateShareOptionsGranted" contextRef="From2023-03-012023-03-31_ifrs-full_WarrantsMember" id="Fact004297" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">4.35</ix:nonFraction></span></td><td style="border-bottom: Black 1pt solid; color: #4D4D4C; text-align: left">%</td><td style="border-bottom: Black 1pt solid; color: #4D4D4C">&#160;</td>
