    <td style="color: #4D4D4C; text-align: left">&#160;</td><td style="color: #4D4D4C; text-align: right"><span id="xdx_906_ecustom--ContractualLifeTerm_dtY_c20230601__20230630__ifrs-full--ClassesOfShareCapitalAxis__ifrs-full--WarrantsMember_zsMNVpfZeggf" title="Contractual life"><ix:nonNumeric contextRef="From2023-06-012023-06-30_ifrs-full_WarrantsMember" format="ixt-sec:duryear" id="Fact004275" name="bdrx:ContractualLifeTerm">3</ix:nonNumeric></span> years</td><td style="color: #4D4D4C; text-align: left">&#160;</td><td style="color: #4D4D4C">&#160;</td>
