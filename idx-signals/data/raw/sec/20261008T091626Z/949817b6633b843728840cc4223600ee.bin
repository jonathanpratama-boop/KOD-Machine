    <td style="color: #4D4D4C; text-align: left">&#160;</td><td style="color: #4D4D4C; text-align: right"><span id="xdx_90D_ecustom--ExpectedLifeTerm_dtY_c20231201__20231231__ifrs-full--ClassesOfShareCapitalAxis__ifrs-full--WarrantsMember_zuUlNTnADwZ7" title="Expected life"><ix:nonNumeric contextRef="From2023-12-012023-12-31_ifrs-full_WarrantsMember" format="ixt-sec:duryear" id="Fact004283" name="bdrx:ExpectedLifeTerm">3</ix:nonNumeric></span> years</td><td style="color: #4D4D4C; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td>Volatility</td><td style="color: #4D4D4C">&#160;</td>
    <td style="color: #4D4D4C; text-align: left">&#160;</td><td style="color: #4D4D4C; text-align: right"><span id="xdx_906_eifrs-full--DescriptionOfExpectedVolatilityShareOptionsGranted_pid_dp_c20230301__20230331__ifrs-full--ClassesOfShareCapitalAxis__ifrs-full--WarrantsMember_fKio___zPJ0MA7hZp5e" title="Volatility"><ix:nonFraction name="ifrs-full:DescriptionOfExpectedVolatilityShareOptionsGranted" contextRef="From2023-03-012023-03-31_ifrs-full_WarrantsMember" id="Fact004285" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">75.00</ix:nonFraction></span></td><td style="color: #4D4D4C; text-align: left">%**</td><td style="color: #4D4D4C">&#160;</td>
