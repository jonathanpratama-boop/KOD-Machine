  <tr style="vertical-align: bottom; background-color: White">
    <td><span style="font-family: Times New Roman"><span id="xdx_907_eifrs-full--NameOfSubsidiary_c20240101__20241231__ifrs-full--SignificantInvestmentsInSubsidiariesAxis__custom--BiodexaPharmaceuticalsWalesLimitedFormerlyMidatechPharmaWaleLimitedMember_zpKoez1dVt04" title="Entity"><ix:nonNumeric contextRef="From2024-01-012024-12-31_custom_BiodexaPharmaceuticalsWalesLimitedFormerlyMidatechPharmaWaleLimitedMember" id="Fact000723" name="ifrs-full:NameOfSubsidiary">Biodexa Pharmaceuticals (Wales) Limited</ix:nonNumeric></span> </span></td>
