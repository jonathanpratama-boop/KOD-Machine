</ix:nonNumeric><ix:nonNumeric contextRef="From2024-01-01to2024-12-31" escape="true" id="Fact003060" name="ifrs-full:DisclosureOfIssuedCapitalExplanatory"><p id="xdx_804_eifrs-full--DisclosureOfIssuedCapitalExplanatory_z4lX1C2c5Wg6" style="font: bold 10pt Times New Roman, Times, Serif; margin: 0pt 0; background-color: transparent">22&#160;&#160;&#160;&#160;&#160;&#160;&#160;<span id="xdx_82B_zy2uzvFftwF4">Share
capital</span></p>

