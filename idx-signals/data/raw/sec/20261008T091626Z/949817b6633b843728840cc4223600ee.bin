    <td style="border-bottom: Black 1pt solid; color: #4D4D4C; text-align: left">&#160;</td><td id="xdx_982_ecustom--GainLossOfEquitySettledDerivativeFinancialLiability_c20220101__20221231_pn3n3" title="Gain recognised in finance income within the consolidated statement of comprehensive income" style="border-bottom: Black 1pt solid; color: #4D4D4C; text-align: right">(<ix:nonFraction name="bdrx:GainLossOfEquitySettledDerivativeFinancialLiability" contextRef="From2022-01-012022-12-31" id="Fact002342" format="ixt:numdotdecimal" decimals="-3" scale="3" sign="-" unitRef="GBP">468</ix:nonFraction></td><td style="border-bottom: Black 1pt solid; color: #4D4D4C; text-align: left">)</td></tr>
