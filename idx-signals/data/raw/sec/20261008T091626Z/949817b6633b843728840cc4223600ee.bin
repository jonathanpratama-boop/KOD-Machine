  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 64%; text-align: left">Cash flows from operating activities before <br/> changes in working capital</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 15%; text-align: right">(8,654</td><td style="width: 1%; text-align: left">)</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 15%; text-align: right">(7,622</td><td style="width: 1%; text-align: left">)</td></tr>
