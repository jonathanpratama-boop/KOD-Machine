  <div class="main-content-container" style="z-index:5;position:relative;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:24pt;text-align:right;"><font style="font-variant:small-caps;color:#000000;white-space:pre-wrap;font-weight:bold;font-size:12pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">EXHIBIT 4.3</font></p><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:24pt;text-align:center;"><font style="font-variant:small-caps;color:#000000;white-space:pre-wrap;font-size:16pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">NUBURU, INC.</font></p><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:24pt;text-align:center;"><font style="font-variant:small-caps;color:#000000;white-space:pre-wrap;font-weight:bold;font-size:16pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">Debenture</font></p>
   <table style="border-spacing:0;table-layout:auto;width:56.0%;border-collapse:separate;">
