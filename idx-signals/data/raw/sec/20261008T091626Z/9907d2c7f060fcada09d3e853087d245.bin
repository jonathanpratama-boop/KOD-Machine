    <td style="border-bottom: Black 4pt double; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="border-bottom: Black 4pt double; text-align: right"><span style="font-family: Times New Roman, Times, Serif">4,209,183</span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
