    <td style="border-bottom: Black 4pt double; text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction contextRef="c4" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DeferredTaxAssetsLiabilitiesNet" scale="0" unitRef="usd">40,408</ix:nonFraction></span></td>
