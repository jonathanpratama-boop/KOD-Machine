    <td style="width: 1%; border-bottom: Black 4pt double; text-align: left">$</td><td style="width: 9%; border-bottom: Black 4pt double; text-align: right">20,188,831</td><td style="width: 1%; padding-bottom: 4pt; text-align: left">&#160;</td><td style="width: 1%; padding-bottom: 4pt">&#160;</td>
