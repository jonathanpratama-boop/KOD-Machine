    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c0" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:Revenues" scale="0" unitRef="usd">27,518,519</ix:nonFraction></td><td style="padding-bottom: 4pt; text-align: left">&#160;</td><td style="padding-bottom: 4pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c17" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:Revenues" scale="0" unitRef="usd">25,578,160</ix:nonFraction></td><td style="padding-bottom: 4pt; text-align: left">&#160;</td></tr>
