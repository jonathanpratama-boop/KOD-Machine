    <TD>&nbsp;</TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">25,451,882 Common Shares</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
    <TD>&nbsp;</TD>
    <TD>&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD><FONT STYLE="font-size: 10pt">Common Shares outstanding after this offering and the Concurrent Private Placement </FONT></TD>
    <TD>&nbsp;</TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">35,451,882 Common Shares</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
