  <TR STYLE="vertical-align: top">
    <TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%"><FONT STYLE="font-family: Symbol; font-size: 10pt">&#183;</FONT></TD>
    <TD STYLE="width: 98%; text-align: justify"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">our Quarterly Report on </FONT><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt"><A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000095017023040015/asti-20230630.htm" STYLE="-sec-extract: exhibit">Form 10-Q</A></FONT> <FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">for the quarter ended June 30, 2023, filed with the SEC on August 8, 2023;</FONT></TD></TR>
  </TABLE>
<P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0; text-align: justify">&nbsp;</P>

<TABLE CELLSPACING="0" CELLPADDING="0" STYLE="font: 11pt Calibri, Helvetica, Sans-Serif; width: 100%; background-color: white; border-collapse: collapse">
  <TR STYLE="vertical-align: top">
    <TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%"><FONT STYLE="font-family: Symbol; font-size: 10pt">&#183;</FONT></TD>
    <TD STYLE="width: 98%; text-align: justify"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">our Current Reports on Form 8-K, filed with the SEC, on <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000121390023017935/ea174705-8k_ascent.htm" STYLE="-sec-extract: exhibit">March 7</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000107997323000373/asti_8k.htm" STYLE="-sec-extract: exhibit">March 23</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000107997323000377/asti_8k.htm" STYLE="-sec-extract: exhibit">March 28</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000121390023024238/ea175998-8k_ascent.htm" STYLE="-sec-extract: exhibit">March 30</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000107997323000429/asti_8k.htm" STYLE="-sec-extract: exhibit">April 4</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000121390023029229/ea176793-8k_ascent.htm" STYLE="-sec-extract: exhibit">April 13</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000121390023030462/ea177092-8k_ascentsolar.htm" STYLE="-sec-extract: exhibit">April 18</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000107997323000506/asti_8k.htm" STYLE="-sec-extract: exhibit">April 20</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000121390023031708/ea177087-8k_ascentsolar.htm" STYLE="-sec-extract: exhibit">April 21</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000107997323000541/asti_8k.htm" STYLE="-sec-extract: exhibit">April 25</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000107997323000598/asti_8k.htm" STYLE="-sec-extract: exhibit">May 2</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000107997323000632/asti_8k.htm" STYLE="-sec-extract: exhibit">May 8</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/1350102/000107997323000664/asti_8k.htm" STYLE="-sec-extract: exhibit">May 11</A>, <A HREF="http://www.sec.gov/Archives/edgar/data/135