($<ix:nonFraction contextRef="c525" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" unitRef="usdPershares" id="ixv-27976">56.50</ix:nonFraction> before ratio change) to $<ix:nonFraction contextRef="c526" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" unitRef="usdPershares" id="ixv-27977">52.00</ix:nonFraction> ($<ix:nonFraction contextRef="c527" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" unitRef="usdPershares" id="ixv-27978">4.00</ix:nonFraction> before ratio change) per ADS.&#160;The ADSs issuable upon exercise of the Series D/E/F/G
Warrants were adjusted to <ix:nonFraction contextRef="c528" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" unitRef="shares" id="ixv-27979">134,615</ix:nonFraction>, <ix:nonFraction contextRef="c529" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" unitRef="shares" id="ixv-27980">754,615</ix:nonFraction>, <ix:nonFraction contextRef="c530" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" unitRef="shares" id="ixv-27981">769,230</ix:nonFraction>, and <ix:nonFraction contextRef="c531" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" unitRef="shares" id="ixv-27982"><ix:nonFraction contextRef="c532" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" unitRef="shares" id="ixv-27983"><ix:nonFraction contextRef="c532" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" unitRef="shares" id="ixv-27984">109,890</ix:nonFraction></ix:nonFraction></ix:nonFraction> (<ix:nonFraction contextRef="c533" decimals="0" format="ixt:num-dot-decimal" name="lghl:WarrantsAdjustedBeforeRatio" scale="0" unitRef="shares" id="ixv-27985">1,750,000</ix:nonFraction>, <ix:nonFraction contextRef="c534" decimals="0" format="ixt:num-dot-decimal" name="lghl:WarrantsAdjustedBeforeRatio" scale="0" unitRef="shares" id="ixv-27986">9,810,000</ix:nonFraction>, <ix:nonFraction contextRef="c531" decimals="0" format="ixt:num-dot-decimal" name="lghl:WarrantsAdjustedBeforeRatio" scale="0" unitRef="shares" id="ixv-27987">10,000,000</ix:nonFraction>, and <ix:nonFraction contextRef="c535" decimals="0" format="ixt:num-dot-decimal" name="lghl: