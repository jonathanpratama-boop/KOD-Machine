    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right">22,687,579</td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; padding-bottom: 4pt">&#160;</td>
