    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><div style="-sec-ix-hidden: hidden-fact-339">-</div></td><td style="padding-bottom: 4pt; text-align: left">&#160;</td></tr>
