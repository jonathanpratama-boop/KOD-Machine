    <TD STYLE="border-bottom: Black 1px solid; background-color: #BFE6F6; padding-top: 0.75pt; padding-right: 0.75pt; padding-left: 0.75pt; text-align: center"><FONT STYLE="font-size: 8pt">2.67%</FONT></TD>
    <TD STYLE="border-bottom: Black 1px solid; background-color: #BFE6F6; padding-top: 0.75pt; padding-right: 0.75pt; padding-left: 0.75pt; text-align: center"><FONT STYLE="font-size: 8pt">6.57%</FONT></TD>
    <TD STYLE="border-bottom: Black 1px solid; background-color: #BFE6F6; padding-top: 0.75pt; padding-right: 0.75pt; padding-left: 0.75pt; text-align: center"><FONT STYLE="font-size: 8pt; color: red">-6.43%</FONT></TD>
    <TD STYLE="border-bottom: Black 1px solid; background-color: #BFE6F6; padding-top: 0.75pt; padding-right: 0.75pt; padding-left: 0.75pt; text-align: center">&nbsp;</TD>
    <TD STYLE="border-bottom: Black 1px solid; background-color: #BFE6F6; padding-top: 0.75pt; padding-right: 0.75pt; padding-left: 0.75pt; text-align: center">&nbsp;</TD>
    <TD STYLE="border-right: Black 1px solid; border-bottom: Black 1px solid; border-left: Black 1px solid; background-color: #BFE6F6; padding-top: 0.75pt; padding-right: 0.75pt; padding-left: 0.75pt; text-align: center">&nbsp;</TD>
  </TR>
