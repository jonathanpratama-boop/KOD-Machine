    <TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 9%; text-align: right">52,886,224</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 1%">&nbsp;</TD>
