erif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.76%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_USD_shares_Y1bGetDX602-1YG9VpYfmA" contextRef="As_Of_6_30_2023_us-gaap_ClassOfWarrantOrRightAxis_rnaz_PlacementAgentWarrantsFromIpoMember_CGoScMYCL0CQfyie2ipG6A" decimals="2" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" id="Tc_BvKPl7v32keN7XTkl4Ml3w_3_5">100.00</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:72.45%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Placement agent warrants from February RDO</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.3%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.74%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_Hs3AMsfv0k6O26KOAtV1Fg" contextRef="As_Of_6_30_2023_us-gaap_ClassOfWarrantOrRightAxis_rnaz_PlacementAgentWarrantsFromRdoMember_jlW1JVOflE-rKhfMB69M9g" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" id="Tc_Y315N8hLSUmDIKYVKxVkUQ_4_2">9,962</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.3%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.43%;margin:0pt;padding:0pt;"><p style="font-family:'Times Ne