ace:nowrap;width:1.43%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.76%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_USD_shares_Y1bGetDX602-1YG9VpYfmA" contextRef="As_Of_6_30_2023_us-gaap_ClassOfWarrantOrRightAxis_rnaz_Seriesa2WarrantsMember_uDUKo-JaBkKfv0TFrXRc4g" decimals="2" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" id="Tc_PfkUONQgnEG2hbylu6LRFg_7_5">3.25</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:72.45%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Placement agent warrants from June RDO</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.3%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.74%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_Hs3AMsfv0k6O26KOAtV1Fg" contextRef="As_Of_6_30_2023_us-gaap_ClassOfWarrantOrRightAxis_rnaz_PlacementAgentWarrantsFromRdoTwoMember_7JnGF6_Du0W7N4d7Kb4shA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" id="Tc_oadd374ZQk24xF_bS9R5Og_8_2">140,000</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.3%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.43%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.76%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_USD_shares_Y1bGetDX602-1YG9VpYfmA" contextRef="As_Of_6_30_2023_us-gaap_ClassOfWarrantOrRightAxis_rnaz_PlacementAgentWarrantsFromRdoTwoMember_7JnGF6_Du0W7N4d7Kb4shA" decimals="2" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" id="Tc_Eu0D4GBu90av53nYT9D2jw_8_5">4.38</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:72.45%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Pre-funded warrants from June RDO</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.3%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.74%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_Hs3AMsfv0k6O26KOAtV1Fg" contextRef="As_Of_6_30_2023_us-gaap_ClassOfWarrantOrRightAxis_rnaz_PreFundedWarrantsMember_RBkNHJk9nUaHieH76C97WA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" id="Tc_FKOB9EmokkSTG18ATJaILg_9_2">950,000</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.3%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.43%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.76%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_USD_shares_Y1bGetDX602-1YG9VpYfmA" contextRef="As_Of_6_30_2023_us-gaap_ClassOfWarrantOrRightAxis_rnaz_PreFundedWarrantsMember_RBkNHJk9nUaHieH76C97WA" decimals="2" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" id="Tc_IjN9qifh4Uaf1Zl2GvISxA_9_5">0.01</ix:nonFraction></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2023_To_6_30_2023_oOUvyECQ20as3E35GlQ6sA" name="us-gaap:DisclosureOfCompensationRelatedCostsShareBasedPaymentsTextBlock" id="Tb_0SXy79xKKU-8afk-E8aTFw" continuedAt="Tb_0SXy79xKKU-8afk-E8aTFw_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;font-weight:bold;padding-left:18pt;text-indent:-18pt;margin:0pt 0pt 12pt 0pt;"><b style="font-size:10pt;font-weight:bold;">(11)</b>&#160;<b style="font-size:10pt;font-weight:bold;">Share-Based Compensation</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In April&#160;2020, the Board approved the TransCode Therapeutics,&#160;Inc. 2020 Stock Option and Incentive Plan (the &#8220;2020 Plan&#8221;) providing for the issuance of options or other awards to purchase up to <ix:nonFraction unitRef="Unit_Standard_shares_Hs3AMsfv0k6O26KOAtV1Fg" contextRef="As_Of_4_30_2020_us-gaap_PlanNameAxis_rnaz_StockOptionAndIncentivePlan2020Member_gK5UiE4lfkOCtwrGr2u4VQ" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAuthorized" scale="0" id="Narr_1rf7q6UuiUq1kS6S17gU2A">151,639</ix:nonFraction> shares of the Company&#8217;s common stock. The Board determined not to make any further awards under the 2020 Plan following the closing of the IPO. In March 2021, the Company&#8217;s 2021 Stock Option and Incentive Plan (the &#8220;2021 Plan&#8221;) was approved by the Company&#8217;s Board and stockholders and became effective upon the effectiveness of the IPO. The 2021 Plan initially provided for the issuance of options or other awards to purchase up to <ix:nonFraction unitRef="Unit_Standard_shares_Hs3AMsfv0k6O26KOAtV1Fg" contextRef="As_Of_6_30_2023_us-gaap_PlanNameAxis_rnaz_StockOptionAndIncentivePlan2021Member_sQyxiXSdkESKl4RDtalrSw" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAuthorized" scale="0" id="Narr_PnBeQ3FYkEaJtK8UH2Diqw">125,000</ix:nonFraction> shares of the Company&#8217;s common stock. The number of options or other awards available under the 2021 Plan increased <ix:nonFraction unitRef="Unit_Standard_shares_Hs3AMsfv0k6O26KOAtV1Fg" contextRef="As_Of_1_31_2022_us-gaap_PlanNameAxis_rnaz_StockOptionAndIncentivePlan2021Member_S6wDAZyeBk-iemwGm7JAlw" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAvailableForGrant" scale="0" id="Narr_gleRRMI2SkCZCnveE6N1LQ">32,261</ix:nonFraction> shares in January 2022 and <ix:nonFraction unitRef="Unit_Standard_shares_Hs3AMsfv0k6O26KOAtV1Fg" contextRef="As_Of_1_31_2023_us-gaap_PlanNameAxis_rnaz_StockOptionAndIncentivePlan2021Member_2l8SYv_0FkW-DzOJ1FHYmQ" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAvailableForGrant" scale="0" id="Narr_y8NXdwDrlkyDTtS4l_Vbyg">32,443</ix:nonFraction> in January 2023.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Both Plans provide for grants of equity in the form of stock awards, stock options and other instruments to employees, members of the Board, officers and consultants of and advisors to the Company. The Plans are administered by the Board or, at the discretion of the Board, by a committee of the Board. The amount and terms of grants are determined by the Board. The terms of options granted under the Plans generally are for ten (<ix:nonNumeric contextRef="Duration_1_1_2023_To_6_30_2023_us-gaap_PlanNameAxis_rnaz_StockOptionAndIncentivePlan2020Member_qxcastOfbky61IrnoXA15w" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardTermsOfAward" id="Narr_QpmD_18zUUahr-JLxDMomw">10</ix:nonNumeric>)&#160;years after date of grant and are exercisable in cash or as otherwise determined by the Board. The vesting period for equity-based awards is determined at the discretion of the Board and is generally <span style="-sec-ix-hidden:Hidden_KTSuY0cRyUqv2qwjohdvHg;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">two</span></span> to <ix:nonNumeric contextRef="Duration_1_1_2023_To_6_30_2023_srt_RangeAxis_srt_MaximumMember_us-gaap_PlanNameAxis_rnaz_StockOptionAndIncentivePlan2020Member_RNDlhKwsZU2GRxXzZAp0XQ" format="ixt-sec:durwordsen" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1" id="Narr_zna-EU_BEU6xFfmDJASDLg">four&#160;years</ix:nonNumeric>. If stock options granted under the 2021 Plan terminate, expire, or are surrendered or cancelled, the shares subject to such grants will again be available under the 2021 Plan.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">The exercise price for incentive stock options is determined at the discretion of the Board but for grants to any person possessing less than <ix:nonFraction unitRef="Unit_Standard_pure_bceUYNWENkynMtI-dhaVoQ" contextRef="Duration_1_1_2023_To_6_30_2023_oOUvyECQ20as3E35GlQ6sA" decimals="2" format="ixt:numdotdecimal" name="rnaz:SignificantShareholderThresholdPercentageOwnership" scale="-2" id="Narr_dRZ_5UBAjkOibnh1qDHVdw">10</ix:nonFraction>% of the total combined voting power of all classes of stock may not have an exercise price less than <ix:nonFraction unitRef="Unit_Standard_pure_bceUYNWENkynMtI-dhaVoQ" contextRef="Duration_1_1_2023_To_6_30_2023_oOUvyECQ20as3E35GlQ6sA" decimals="2" format="ixt:numdotdecimal" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardPurchasePriceOfCommonStockPercent" scale="-2" id="Narr_V9GCHj_eTEy1ctJO_uRKpw">100</ix:nonFraction>% of the fair market value of the Common Stock on the grant date (<ix:nonFraction unitRef="Unit_Standard_pure_bceUYNWENkynMtI-dhaVoQ" contextRef="Duration_1_1_2023_To_6_30_2023_oOUvyECQ20as3E35GlQ6sA" decimals="2" format="ixt:numdotdecimal" name="rnaz:ShareBasedCompensationArrangementPurchasePriceForSignificantShareholders" scale="-2" id="Narr_gu8vK1gcgESegJ9iwTZpaQ">110</ix:nonFraction>% for grants to any person possessing more than <ix:nonFraction unitRef="Unit_Standard_pure_bceUYNWENkynMtI-dhaVoQ" contextRef="Duration_1_1_2023_To_6_30_2023_oOUvyECQ20as3E35GlQ6sA" decimals="2" format="ixt:numdotdecimal" name="rnaz:SignificantShareholderThresholdPercentageOwnership" scale="-2" id="Narr_giEQuYh9fk2IsXMibGtQCA">10</ix:nonFraction>% of the total combined voting power of all classes of stock). The option term for incentive stock option awards may not be greater than ten&#160;years from the </p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">22</p></div></div>
