<td style="white-space:nowrap;vertical-align:bottom;text-align:right"><ix:nonFraction name="us-gaap:ConcentrationRiskCreditRiskFinancialInstrumentMaximumExposure" contextRef="P01_01_2024To12_31_2024" unitRef="Unit_USD" decimals="-3" scale="3" format="ixt:num-dot-decimal" id="ixv-169505">125,045</ix:nonFraction></td>
