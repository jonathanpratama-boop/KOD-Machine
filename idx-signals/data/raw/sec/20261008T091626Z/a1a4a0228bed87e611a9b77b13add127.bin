<td style="white-space:nowrap;vertical-align:bottom;text-align:right"><ix:nonFraction name="us-gaap:OffBalanceSheetCreditLossLiability" contextRef="PAsOn12_31_2024" unitRef="Unit_USD" decimals="-3" scale="3" format="ixt:num-dot-decimal" id="ixv-169529">3,821</ix:nonFraction></td>
