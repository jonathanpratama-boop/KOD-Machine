-size:12pt;margin-top:0pt;margin-bottom:0pt">&#160;</div><div style="text-align:center"><div style="line-height:6.0pt;margin-top:0pt;margin-bottom:2pt;border-bottom:1.00pt solid #000000;width:21%;text-align:center;margin-left: auto;margin-right: auto">&#160;</div></div><div style="margin-top:12pt; margin-bottom:0pt; font-size:8.5pt; font-family:Times New Roman;font-weight:bold;text-align:center"><ix:nonNumeric name="dei:ContactPersonnelName" contextRef="P01_01_2025To12_31_2025_BusinessContactMemberdeiEntityAddressesAddressTypeAxis" id="ixv-166201">Thomas J. Kemly</ix:nonNumeric> </div><div style="margin-top:0pt; margin-bottom:0pt; font-size:8.5pt; font-family:Times New Roman;font-weight:bold;text-align:center">President and Chief Executive Officer </div><div style="margin-top:0pt; margin-bottom:0pt; font-size:8.5pt; font-family:Times New Roman;font-weight:bold;text-align:center">Columbia Financial, Inc. </div><div style="margin-top:0pt; margin-bottom:0pt; font-size:8.5pt; font-family:Times New Roman;font-weight:bold;text-align:center"><div style="white-space:nowrap;display:inline;"></div><ix:nonNumeric name="dei:EntityAddressAddressLine1" contextRef="P01_01_2025To12_31_2025_BusinessContactMemberdeiEntityAddressesAddressTypeAxis" id="ixv-81"><div style="white-space:nowrap;display:inline;">19-01</div> Route 208 North</ix:nonNumeric> </div><div style="margin-top:0pt; margin-bottom:0pt; font-size:8.5pt; font-family:Times New Roman;font-weight:bold;text-align:center"><ix:nonNumeric name="dei:EntityAddressCityOrTown" contextRef="P01_01_2025To12_31_2025_BusinessContactMemberdeiEntityAddressesAddressTypeAxis" id="ixv-166202">Fair Lawn</ix:nonNumeric>, <ix:nonNumeric name="dei:EntityAddressStateOrProvince" contextRef="P01_01_2025To12_31_2025_BusinessContactMemberdeiEntityAddressesAddressTypeAxis" format="ixt-sec:stateprovnameen" id="ixv-166203">New Jersey</ix:nonNumeric> <ix:nonNumeric name="dei:EntityAddressPostalZipCode" contextRef="P01_01_2025To12_31_2025_BusinessContactMemberdeiEntityAddressesAddressTypeAxis" id="ixv-166204">07410</ix:nonNumeric> </div><div style="margin-top:0pt; margin-bottom:0pt; font-size:8.5pt; font-family:Times New Roman;font-weight:bold;text-align:center">(<ix:nonNumeric name="dei:CityAreaCode" contextRef="P01_01_2025To12_31_2025_BusinessContactMemberdeiEntityAddressesAddressTypeAxis" id="ixv-166205">800</ix:nonNumeric>) <div style="white-space:nowrap;display:inline;"><ix:nonNumeric name="dei:LocalPhoneNumber" contextRef="P01_01_2025To12_31_2025_BusinessContactMemberdeiEntityAddressesAddressTypeAxis" id="ixv-166206">522-4167</ix:nonNumeric></div> </div><div style="margin-top:0pt; margin-bottom:0pt; font-size:7pt; font-family:Times New Roman;font-weight:bold;text-align:center">(Name, address, including zip code, and telephone number, including area code, of agent for service) </div><div style="font-size:12pt;margin-top:0pt;margin-bottom:0pt">&#160;</div><div style="text-align:center"><div style="line-height:6.0pt;margin-top:0pt;margin-bottom:2pt;border-bottom:1.00pt solid #000000;width:21%;text-align:center;margin-left: auto;margin-right: auto">&#160;</div></div><div style="margin-top:12pt; margin-bottom:0pt; font-size:8.5pt; font-family:Times New Roman;font-weight:bold;text-align:center"><div style="font-style:italic;display:inline;">Copies to: </div></div><div style="font-size:6pt;margin-top:0pt;margin-bottom:0pt">&#160;</div>
