<td style="white-space:nowrap;vertical-align:bottom;text-align:right"><ix:nonFraction name="clbk:DefinedBenefitPlanAssumptionsUsedCalculatingNetPeriodicBenefitCostDiscountRateBenefitObligation" contextRef="P01_01_2023To12_31_2023_AcquiredRSIPlanMemberusgaapRetirementPlanNameAxis_OtherPostretirementBenefitPlansDefinedBenefitMemberusgaapRetirementPlanTypeAxis" unitRef="Unit_pure" decimals="4" scale="-2" format="ixt:num-dot-decimal" id="ixv-169170">5.16</ix:nonFraction></td>
