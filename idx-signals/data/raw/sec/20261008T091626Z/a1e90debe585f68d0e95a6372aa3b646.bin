    <td colspan="2" style="background-color:rgba(255,255,255,1);word-break:break-word;white-space:pre-wrap;vertical-align:bottom;text-align:center;"><p style="text-indent:0.0pt;font-size:10.0pt;margin-top:0.0pt;font-family:Times New Roman;margin-bottom:0.0pt;text-align:right;"><font style="background-color:rgba(0,0,0,0);color:rgba(0,0,0,1);white-space:pre-wrap;font-weight:normal;font-size:10.0pt;font-family:&quot;Times New Roman&quot;, serif;min-width:fit-content;">$0.0001-$4.25</font></p></td>
