    <TD STYLE="width: 1%; font-weight: bold; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="width: 9%; font-weight: bold; text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">879,509</FONT></TD><TD STYLE="width: 1%; font-weight: bold; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD></TR>
