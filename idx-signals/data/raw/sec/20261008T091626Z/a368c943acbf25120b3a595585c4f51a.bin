  <tr id="xdx_403_eus-gaap--BusinessCombinationRecognizedIdentifiableAssetsAcquiredAndLiabilitiesAssumedNet_iTI_pp0p0_za4aY3hWdYr4" style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="font-size: 10pt; font-weight: bold; text-align: left; padding-bottom: 1pt">Total net assets of Acquiree</td><td style="font-size: 10pt; padding-bottom: 1pt">&#160;</td>
    <td style="border-bottom: Black 1pt solid; font-size: 10pt; text-align: left">$</td><td style="border-bottom: Black 1pt solid; font-size: 10pt; text-align: right"><ix:nonFraction name="us-gaap:BusinessCombinationRecognizedIdentifiableAssetsAcquiredAndLiabilitiesAssumedNet" contextRef="AsOf2024-09-01_custom_SAndMiLtdAcquisitionMember" id="Fact000945" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">990,570</ix:nonFraction></td><td style="padding-bottom: 1pt; font-size: 10pt; text-align: left">&#160;</td></tr>
  </table>


</ix:nonNumeric><p id="xdx_8AD_zi6QtHhmjmAa" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0; text-align: justify">&#160;</p>




