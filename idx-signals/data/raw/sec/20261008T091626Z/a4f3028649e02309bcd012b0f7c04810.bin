 Funding Group Inc</td><td>&#160;</td> <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c242" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:LongTermNotesPayable" scale="0" unitRef="usd" id="ixv-18914">157,000</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td> <td style="text-align: right"><ix:nonFraction contextRef="c243" decimals="2" format="ixt:num-dot-decimal" name="nivf:ConversionPriceDiscount" scale="-2" unitRef="pure" id="ixv-18915">25</ix:nonFraction>% discount of lowest traded price during <ix:nonNumeric contextRef="c243" format="ixt-sec:durday" name="nivf:ConversionPriceTradingDays" id="ixv-18916">10</ix:nonNumeric> trading days immediately preceding the conversion date</td><td>&#160;</td> <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c242" decimals="2" format="ixt:num-dot-decimal" name="nivf:DebtInstrumentCouponRatePercentage" scale="-2" unitRef="pure" id="ixv-18917">10</ix:nonFraction></td><td style="text-align: left">%</td><td>&#160;</td> <td style="text-align: center"><ix:nonNumeric contextRef="c243" format="ixt:date-year-month-day" name="us-gaap:DebtInstrumentIssuanceDate1" id="ixv-18918">2025-11-04</ix:nonNumeric></td><td>&#160;</td> <td style="text-align: center"><ix:nonNumeric contextRef="c243" format="ixt:date-year-month-day" name="us-gaap:DebtInstrumentMaturityDate" id="ixv-18919">2026-07-30</ix:nonNumeric></td><td>&#160;</td> <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c242" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ConvertibleDebtFairValueDisclosures" scale="0" unitRef="usd" id="ixv-18920">235,900</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td> <td style="text-align: center">Level 2</td> <td>&#160;</td></tr> </table></ix:nonNumeric></ix:nonNumeric><div>
