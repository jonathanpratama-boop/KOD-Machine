    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right">100.0</td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left">&#160;</td></tr>
