    <td style="text-align: left">&#160;</td><td style="text-align: right">(<ix:nonFraction contextRef="c357" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:BusinessCombinationRecognizedIdentifiableAssetsAcquiredAndLiabilitiesAssumedCashAndEquivalents" scale="0" unitRef="usd" id="ixv-19190">750,000</ix:nonFraction></td><td style="text-align: left">)</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="padding-bottom: 1.5pt">Share consideration</td><td style="padding-bottom: 1.5pt">&#160;</td>
