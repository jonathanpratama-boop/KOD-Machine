    <td style="font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; text-align: right"><ix:nonFraction contextRef="c357" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:BusinessCombinationRecognizedIdentifiableAssetsAcquiredAndLiabilitiesAssumedCurrentAssets" scale="0" unitRef="usd" id="ixv-19192">2,487,835</ix:nonFraction></td><td style="font-weight: bold; text-align: left">&#160;</td></tr>
