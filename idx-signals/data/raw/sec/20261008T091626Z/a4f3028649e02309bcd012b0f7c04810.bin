    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c7" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DeferredTaxAssetsOperatingLossCarryforwards" scale="0" unitRef="usd" id="ixv-19106">160,432</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
