    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c354" decimals="0" format="ixt:num-dot-decimal" name="nivf:NodexuscomDomainAndHostingAccess" scale="0" unitRef="usd" id="ixv-19204">20,000</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
