            <td style="padding:3.25pt 0pt 2.5pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td>
            <td style="padding:3.25pt 0pt 2.5pt 0pt; min-width:13.5pt; text-align:right; white-space:nowrap;">(167<font style="position:absolute;">)%</font></td>
            <td style="padding:0pt;padding-left:7.96pt;width:0pt;">&#8203;</td>
