            <td style="padding:0pt 0pt 0.5pt 0pt; min-width:13.5pt; text-align:right; white-space:nowrap;">&#8203;</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:3.5pt;">&#8203;</td>
