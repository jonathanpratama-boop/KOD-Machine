            <td style="padding:0pt 0pt 1pt 0pt; width:366.29pt;text-align:left;">
              <font style="letter-spacing:-0.2pt;">Consideration paid</font>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt;padding-left:0pt;width:0pt;">&#8203;</td>
