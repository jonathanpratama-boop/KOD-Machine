                <div style="margin-left:10pt;">
                  <font style="letter-spacing:0.2pt;">Depreciation, depletion and amortization </font>
                </div>
              </td>
              <td style="padding:0pt;border-bottom:1px solid #CCEEFF; width:6pt;">&#8203;</td>
              <td style="padding:0pt;border-bottom:1px solid #CCEEFF; width:6pt;">&#8203;</td>
