        </div>
        <div style="margin-top:12pt; width:456pt; line-height:12pt;font-weight:bold;">
          <font style="letter-spacing:-0.2pt;">A.&nbsp;&nbsp;&nbsp;Share Capital</font><font style="font-weight:normal;letter-spacing:0.2pt;"> </font>
        </div>
