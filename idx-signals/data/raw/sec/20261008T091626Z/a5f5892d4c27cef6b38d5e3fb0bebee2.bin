                <font style="letter-spacing:-0.16pt;">Six Months Ended </font>
              </div>
            </td>
            <td style="padding:0pt;border-bottom:1px solid #FFFFFF; width:3pt;">&#8203;</td>
            <td style="padding:0pt;border-bottom:1px solid #FFFFFF; width:3pt;">&#8203;</td>
