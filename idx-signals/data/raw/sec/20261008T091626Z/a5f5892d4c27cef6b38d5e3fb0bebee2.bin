            <td style="padding:1.917pt 0pt 0.833pt 0pt; min-width:20.25pt; text-align:right; white-space:nowrap;">362</td>
            <td style="padding:0pt;padding-left:11.44pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
