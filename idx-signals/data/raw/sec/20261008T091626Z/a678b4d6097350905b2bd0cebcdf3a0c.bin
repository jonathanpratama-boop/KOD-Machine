egmentsMember_us-gaap_StatementBusinessSegmentsAxis_mdrr_FlexCenterPropertyMember_m_L0eVw7kEu-EYG_6HP-3A" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:OperatingIncomeLoss" scale="3" id="Tc_jK9Z0U8y0060a85wLO9OYg_7_15">1,773,130</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.48%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:0.92%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">$</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:8.54%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.6pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_NjDqG3w8AkqOdypjSHcttQ" contextRef="Duration_1_1_2022_To_12_31_2022_srt_ConsolidationItemsAxis_us-gaap_OperatingSegmentsMember_us-gaap_StatementBusinessSegmentsAxis_mdrr_FlexCenterPropertyMember_g7ZSdIc8eUqa-31O4ZFouQ" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:OperatingIncomeLoss" scale="3" id="Tc_gTdnKxXTykiRqyQSRTvHwA_7_18">1,836,545</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.48%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:0.92%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">$</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.47%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.6pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_NjDqG3w8AkqOdypjSHcttQ" contextRef="Duration_1_1_2023_To_12_31_2023_srt_ConsolidationItemsAxis_us-gaap_OperatingSegmentsMember_chAovo7SSkWcvd9OwNFLeg" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:OperatingIncomeLoss" scale="3" id="Tc_x1u2QihSYE-ZrKzbfjFuQA_7_21">7,609,027</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.48%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:0.92%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">$</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.47%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.6pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_NjDqG3w8AkqOdypjSHcttQ" contextRef="Duration_1_1_2022_To_12_31_2022_srt_ConsolidationItemsAxis_us-gaap_OperatingSegmentsMember_p_seBGNRykCJRwgIT6sGJg" decimals="-3" format="ixt:numdotdecimal" name="us-gaap:OperatingIncomeLoss" scale="3" id="Tc_h9tcCHgVzkWY0GHVAuq65A_7_24">7,111,639</ix:nonFraction></b></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;"><span style="font-size:1pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;"><span style="font-size:1pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2023_To_12_31_2023_YwtV0wcenUKl9_b6BjIj4Q" name="us-gaap:SubsequentEventsTextBlock" id="Tb_Hz_zxGii9k-k3KcpK_VY6Q" continuedAt="Tb_Hz_zxGii9k-k3KcpK_VY6Q_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">11.&#160;&#160;&#160;&#160;&#160;&#160;Subsequent Events</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">As of March 6, 2024, the following events have occurred subsequent to the December&#160;31,&#160;2023 effective date of the consolidated financial statements:</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><span style="font-style:italic;font-weight:bold;">Common Stock Dividend</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">On February 6, 2024, a dividend in the amount of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_7wse7kOL4kOetxcwJueEZw" contextRef="Duration_2_6_2024_To_2_6_2024_us-gaap_StatementEquityComponentsAxis_us-gaap_CommonStockMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_bQgZT73GX028ZGZilFKrwA" decimals="2" format="ixt:numdotdecimal" name="us-gaap:CommonStockDividendsPerShareCashPaid" scale="0" id="Narr_KXEzErncN0m48_959qpmLQ">0.01</ix:nonFraction> per share was paid to common stock shareholders and operating partnership unit holders of record on February 2, 2024.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Mandatorily Redeemable Preferred Stock Dividend</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">On February 6, 2024, a dividend in the amount of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_7wse7kOL4kOetxcwJueEZw" contextRef="Duration_2_6_2024_To_2_6_2024_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_baWXVYGcv024VBQ3xCDSaQ" decimals="2" format="ixt:numdotdecimal" name="us-gaap:PreferredStockDividendsPerShareCashPaid" scale="0" id="Narr_Z7CS4l_8hEOTd3Yk7BkajQ">0.50</ix:nonFraction> per share was paid to mandatorily redeemable preferred stock shareholders of record on February 2, 2024 for the period from October 21, 2023 through January 20, 2024.</p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">86</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_Hz_zxGii9k-k3KcpK_VY6Q_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><span style="font-style:italic;font-weight:bold;">Agreement to Acquire the Citibank Property</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="display:inline-block;text-align:left;text-indent:0pt;width:18pt;"></span><span style="display:inline-block;width:18pt;"></span>On February 15, 2024, the Company entered into an agreement with an entity controlled by Francis P. Kavanaugh, the Company&#8217;s CEO and President and a related party, to acquire a single tenant net lease asset referred to as the Citibank Property. Consideration for the acquisition will be paid to the related party seller in the form of Operating Partnership Units valued at $<ix:nonFraction unitRef="Unit_Divide_USD_shares_7wse7kOL4kOetxcwJueEZw" contextRef="As_Of_2_15_2024_srt_CounterpartyNameAxis_mdrr_EntityControlledByFrancisP.KavanaughMember_us-gaap_RelatedPartyTransactionAxis_mdrr_CitibankPropertyAcquisitionMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember__Fm90dYL50qwAE6R4y6Vsw" decimals="2" format="ixt:numdotdecimal" name="mdrr:OperatingPartnershipUnitsParValue" scale="0" id="Narr_fLJo7__k3UKyYzTHaIyN5Q">5.75</ix:nonFraction> per Operating Partnership Unit. &#160;Several conditions to closing on the purchase remain to be satisfied, and there can be no assurance that the Company will complete the transaction on the general terms described above or at all.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><span style="font-style:italic;font-weight:bold;">Acquisition of Noncontrolling Owner&#8217;s Interest in Hanover Square Outparcel</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><span style="display:inline-block;text-align:left;width:18pt;"></span><span style="display:inline-block;width:18pt;"></span>On February 16, 2024, the Company agreed to purchase the noncontrolling owner&#8217;s <ix:nonFraction unitRef="Unit_Standard_pure_5WsnMWNIh0WitaYuOT8hGw" contextRef="Duration_2_16_2024_To_2_16_2024_srt_RealEstateAndAccumulatedDepreciationDescriptionOfPropertyAxis_mdrr_HanverSquareOutparcelMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_HlpL6c8AHkG-mGiBZS99dw" decimals="2" format="ixt:numdotdecimal" name="mdrr:AcquisitionOfMinorityInterestOwnershipPercentage" scale="-2" id="Narr_TbI0QctXx0mN3Ev0B6yqLA">16</ix:nonFraction>% undivided interest in the Hanover Square outparcel for $<ix:nonFraction unitRef="Unit_Standard_USD_NjDqG3w8AkqOdypjSHcttQ" contextRef="As_Of_2_16_2024_srt_RealEstateAndAccumulatedDepreciationDescriptionOfPropertyAxis_mdrr_HanverSquareOutparcelMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_rg7cNxttRUWAoZSlKHvS6Q" decimals="0" format="ixt:numdotdecimal" name="mdrr:AcquisitionOfMinorityInterestAmount" scale="0" id="Narr__de5Al0ucUKZFXOuXvG_4w">98,411</ix:nonFraction>. &#160;The purchase is expected to close concurrently with the closing of the sale of the Hanover Square Shopping Center (discussed above) to an unrelated third party. &#160;However, there can be no assurance that we will complete the transaction.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><span style="font-style:italic;font-weight:bold;">Acquisition of Operating Partnership Units from Limited Partner</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">On February 16, 2024, the Company agreed to redeem <ix:nonFraction unitRef="Unit_Standard_shares_w0362txf-kqkocucHoIbqA" contextRef="Duration_2_20_2024_To_2_20_2024_us-gaap_PartnerTypeOfPartnersCapitalAccountAxis_us-gaap_LimitedPartnerMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_ug_QmxkkNUKXl2PqwWlxCg" decimals="2" format="ixt:numdotdecimal" name="mdrr:RedemptionOfOperatingPartnershipUnits" scale="0" id="Narr_FmGBmnUL70uj3FgkPSs1qQ">11,731.25</ix:nonFraction> Operating Partnership Units from a limited partner for $<ix:nonFraction unitRef="Unit_Divide_USD_shares_7wse7kOL4kOetxcwJueEZw" contextRef="As_Of_2_20_2024_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_Yzny9KkY8E2FqMUoI_TU2w" decimals="2" format="ixt:numdotdecimal" name="mdrr:OperatingPartnershipUnitsRedemptionPrice" scale="0" id="Narr_qe-qRNMAjESOTjc7974Ylw">5.25</ix:nonFraction> per operating partnership unit, the closing price of the Company&#8217;s stock on February 16, 2024, the date of the agreement. &#160;The redemption was completed on February 20, 2024. &#160;</p></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p><p style="display:none;font-family:'Times New Roman','Times','serif';line-height:0pt;text-align:center;margin:0pt;"><span style="font-size:0pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">87</p></div></div>
