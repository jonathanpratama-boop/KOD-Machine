    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">repayment of amounts received in violation of law
    or applicable payment program requirements, and related monetary penalties;</span></td></tr>
  <tr style="font-size: 10pt; vertical-align: top">
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">&#160;</span></td>
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">&#160;</span></td>
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">&#160;</span></td></tr>
  <tr style="font-size: 10pt; vertical-align: top">
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">&#160;</span></td>
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">&#9679;</span></td>
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">mandated changes to our practices or procedures that
    materially increase operating expenses;</span></td></tr>
  <tr style="font-size: 10pt; vertical-align: top">
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">&#160;</span></td>
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">&#160;</span></td>
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">&#160;</span></td></tr>
  <tr style="font-size: 10pt; vertical-align: top">
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">&#160;</span></td>
