    <td style="font-size: 10pt; vertical-align: top; text-align: justify"><span style="font-size: 10pt">&#9679;</span></td>
    <td style="font-size: 10pt; vertical-align: top; text-align: justify"><span style="font-size: 10pt">product labeling or product insert
    requirements of the FDA or other comparable foreign regulatory authorities and any limitations or warning contained in the labeling
    approved by the FDA or comparable foreign regulatory authorities;</span></td></tr>
  <tr style="font-size: 10pt">
    <td style="font-size: 10pt; text-align: justify"><span style="font-size: 10pt">&#160;</span></td>
