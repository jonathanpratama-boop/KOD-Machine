  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 76%">Below 31</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c369" decimals="2" format="ixt:num-dot-decimal" name="gfai:AnnualVoluntarilyResignationRateOfDirectCost" scale="-2" unitRef="pure">18</ix:nonFraction></td><td style="width: 1%; text-align: left">%</td><td style="width: 1%">&#160;</td>
