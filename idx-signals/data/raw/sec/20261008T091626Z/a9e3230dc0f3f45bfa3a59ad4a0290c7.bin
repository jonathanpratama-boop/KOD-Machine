    <td style="font: 10pt Times New Roman, Times, Serif">&#160;</td>
    <td colspan="2" style="font: 10pt Times New Roman, Times, Serif"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>GUARDFORCE AI CO., LIMITED</b></span></td></tr>
