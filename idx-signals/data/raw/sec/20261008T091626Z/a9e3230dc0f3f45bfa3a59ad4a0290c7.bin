    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c5" decimals="0" format="ixt:num-dot-decimal" name="gfai:StaffExpense" scale="0" unitRef="usd">2,759,505</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
