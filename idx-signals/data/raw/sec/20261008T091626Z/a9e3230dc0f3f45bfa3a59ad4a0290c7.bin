</div><div>

</div><ix:continuation continuedAt="_DisclosureOfNoncurrentAssetsHeldForSaleAndDiscontinuedOperationsExplanatory-c0_cont_5" id="_DisclosureOfNoncurrentAssetsHeldForSaleAndDiscontinuedOperationsExplanatory-c0_cont_4"><ix:nonNumeric contextRef="c0" escape="true" name="gfai:SheduleOfTotalOperatingLeaseLiabilitiesTableTextBlock"><table cellpadding="0" cellspacing="0" style="font: 10pt Times New Roman, Times, Serif; border-collapse: collapse; width: 100%">
