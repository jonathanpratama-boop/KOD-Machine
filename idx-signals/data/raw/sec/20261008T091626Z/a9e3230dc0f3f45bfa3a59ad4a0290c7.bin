  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 76%; text-align: left">Current portion</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:ShorttermBorrowings" scale="0" unitRef="usd">1,774,192</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c3" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:ShorttermBorrowings" scale="0" unitRef="usd">2,366,045</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
