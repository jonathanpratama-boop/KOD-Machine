    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c686" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:OtherCurrentReceivables" scale="0" unitRef="usd">5,833</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
