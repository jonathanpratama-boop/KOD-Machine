    <td style="font: 10pt Times New Roman, Times, Serif; border-bottom: Black 1.5pt solid; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font: 10pt Times New Roman, Times, Serif; border-bottom: Black 1.5pt solid; text-align: right"><span style="font-family: Times New Roman, Times, Serif">7,687,721</span></td><td style="font: 10pt Times New Roman, Times, Serif; padding-bottom: 1.5pt; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
