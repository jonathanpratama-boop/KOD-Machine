    <TD STYLE="text-align: left">&nbsp;</TD><TD STYLE="text-align: right">(60.9</TD><TD STYLE="text-align: left">)</TD><TD>&nbsp;</TD>
    <TD STYLE="text-align: left">&nbsp;</TD><TD STYLE="text-align: right">(78,640</TD><TD STYLE="text-align: left">)</TD><TD>&nbsp;</TD>
