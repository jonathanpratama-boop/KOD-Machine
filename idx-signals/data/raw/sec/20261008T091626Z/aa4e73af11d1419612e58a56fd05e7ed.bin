    <TD STYLE="border-bottom: Black 1.5pt solid; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1.5pt solid; text-align: right">(1,828</TD><TD STYLE="padding-bottom: 1.5pt; text-align: left">)</TD><TD STYLE="padding-bottom: 1.5pt">&nbsp;</TD>
    <TD STYLE="padding-bottom: 1.5pt; text-align: left">&nbsp;</TD><TD STYLE="padding-bottom: 1.5pt; text-align: right">(4.9</TD><TD STYLE="padding-bottom: 1.5pt; text-align: left">)</TD></TR>
