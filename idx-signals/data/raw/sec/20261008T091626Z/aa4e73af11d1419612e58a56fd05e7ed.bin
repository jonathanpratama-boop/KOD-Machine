  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
    <TD STYLE="width: 64%; text-align: justify; text-indent: -10pt; padding-left: 10pt">Net cash (used in)/provided by operating activities</TD><TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 9%; text-align: right">(107,225</TD><TD STYLE="width: 1%; text-align: left">)</TD><TD STYLE="width: 1%">&nbsp;</TD>
