    <TD STYLE="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 4pt double; font-weight: bold; text-align: right">(229,269</TD><TD STYLE="padding-bottom: 4pt; font-weight: bold; text-align: left">)</TD><TD STYLE="font-weight: bold; padding-bottom: 4pt">&nbsp;</TD>
