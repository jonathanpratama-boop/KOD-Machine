     <td style="background-color:#cceeff;word-break:break-word;white-space:nowrap;vertical-align:bottom;"><p style="text-indent:0;font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="color:#000000;font-weight:bold;font-size:10pt;font-family:Times New Roman;min-width:fit-content;">&#x20ac;</font></p></td>
