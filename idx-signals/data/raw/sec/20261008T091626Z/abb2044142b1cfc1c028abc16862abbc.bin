            <td style="padding:3.25pt 0pt 3.25pt 0pt; width:340.4pt;text-align:left;">
              <div style="margin-left:20pt;">
                <font style="letter-spacing:0.2pt;">Property and equipment, net </font>
              </div>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
