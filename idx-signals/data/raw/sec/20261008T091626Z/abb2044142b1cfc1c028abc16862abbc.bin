            <td style="padding:3.5pt 0pt 1.5pt 0pt; min-width:17.25pt; text-align:right; white-space:nowrap;">28.5<font style="position:absolute;">&#215; </font></td>
            <td style="padding:0pt;padding-left:33.71pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
          </tr>
