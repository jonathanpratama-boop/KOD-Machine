    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c3" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseLiabilityCurrent" scale="0" unitRef="usd" id="ixv-26622">187,214</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
