    <td style="border-bottom: Black 1.5pt solid; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="border-bottom: Black 1.5pt solid; text-align: right"><span style="font-family: Times New Roman, Times, Serif">2.31</span></td><td style="vertical-align: top; padding-bottom: 1.5pt; text-align: left"><span style="font-family: Times New Roman, Times, Serif">%</span></td></tr>
