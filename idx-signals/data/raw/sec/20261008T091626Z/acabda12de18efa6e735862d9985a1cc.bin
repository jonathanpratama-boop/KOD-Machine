    <td colspan="2" style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center"><span style="font-family: Times New Roman, Times, Serif">%</span></td><td style="text-align: left; padding-bottom: 1.5pt; font-weight: bold; vertical-align: top"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
