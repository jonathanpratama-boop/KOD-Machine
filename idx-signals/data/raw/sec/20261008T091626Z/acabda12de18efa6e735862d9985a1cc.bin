    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><span style="font-family: Times New Roman, Times, Serif">12,733,339</span></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font-weight: bold; padding-bottom: 4pt"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><span style="font-family: Times New Roman, Times, Serif">22,028,303</span></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
