    <TD STYLE="width: 1%; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">$</FONT></TD><TD STYLE="width: 18%; text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">4,105,130</FONT></TD><TD STYLE="width: 1%; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="width: 2%"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
