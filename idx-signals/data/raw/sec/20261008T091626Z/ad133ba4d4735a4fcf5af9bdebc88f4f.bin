    <TD STYLE="border-bottom: Black 1pt solid; font-weight: bold"><FONT STYLE="font-family: Times New Roman, Times, Serif">(US$)</FONT></TD><TD STYLE="padding-bottom: 1pt"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD COLSPAN="2" STYLE="border-bottom: Black 1pt solid; text-align: center"><P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0; text-align: center"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt"><B>Nine
                                            Months Ended</B></FONT></P> <P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0; text-align: center"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt"><B>September
                                            30, 2025</B></FONT></P></TD><TD STYLE="padding-bottom: 1pt"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="padding-bottom: 1pt"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
