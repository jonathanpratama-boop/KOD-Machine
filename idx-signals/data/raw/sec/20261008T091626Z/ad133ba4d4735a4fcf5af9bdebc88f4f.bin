    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">4,745,536</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
    <TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">2,447,497</FONT></TD><TD STYLE="text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD></TR>
