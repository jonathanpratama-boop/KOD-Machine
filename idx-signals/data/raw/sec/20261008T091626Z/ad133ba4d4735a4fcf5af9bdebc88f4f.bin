    <TD STYLE="border-bottom: Black 1pt solid; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="border-bottom: Black 1pt solid; text-align: right"><FONT STYLE="font-family: Times New Roman, Times, Serif">13,802,074</FONT></TD><TD STYLE="padding-bottom: 1pt; text-align: left"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD><TD STYLE="padding-bottom: 1pt"><FONT STYLE="font-family: Times New Roman, Times, Serif">&nbsp;</FONT></TD>
