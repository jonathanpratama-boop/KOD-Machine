<TD WIDTH="90%"></TD>

<TD VALIGN="bottom" WIDTH="6%"></TD>
<TD></TD>
<TD></TD>
<TD></TD></TR>


<TR BGCOLOR="#cceeff" STYLE="page-break-inside:avoid ; font-family:Times New Roman; font-size:10pt">
<TD VALIGN="top"> <P STYLE=" margin-top:0pt ; margin-bottom:0pt; margin-left:1.00em; text-indent:-1.00em; font-size:10pt; font-family:Times New Roman">Remaining lease term (in years)</P></TD>
<TD VALIGN="bottom">&nbsp;&nbsp;</TD>
<TD NOWRAP VALIGN="bottom">&nbsp;</TD>
<TD NOWRAP VALIGN="bottom" ALIGN="right">3.00</TD>
<TD NOWRAP VALIGN="bottom">&nbsp;</TD></TR>
