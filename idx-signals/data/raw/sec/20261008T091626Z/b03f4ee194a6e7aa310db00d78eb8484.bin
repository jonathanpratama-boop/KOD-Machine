    <TD STYLE="padding: 0.25pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="padding: 0.25pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
    <TD STYLE="font: 10pt Times New Roman, Times, Serif; padding: 0.25pt; text-align: justify"><FONT STYLE="font-size: 10pt"><B>&ldquo;In
    writing&rdquo;</B></FONT></TD>
    <TD STYLE="padding: 0.25pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
    <TD STYLE="font: 10pt Times New Roman, Times, Serif; padding: 0.25pt; text-align: justify"><FONT STYLE="font-size: 10pt">&mdash;</FONT></TD>
    <TD STYLE="padding: 0.25pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
    <TD STYLE="font: 10pt Times New Roman, Times, Serif; padding: 0.25pt; text-align: justify"><FONT STYLE="font-size: 10pt">Print, lithography,
    photocopy, telegram, telex, fax, email, and any other form of work or print of words in a visible manner;</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="padding: 0.25pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
    <TD STYLE="padding: 0.25pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
    <TD STYLE="padding: 0.25pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
