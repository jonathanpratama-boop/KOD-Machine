  <TR STYLE="vertical-align: top">
    <TD STYLE="padding: 0.25pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
    <TD STYLE="font: 10pt Times New Roman, Times, Serif; padding: 0.25pt; text-align: justify"><FONT STYLE="font-size: 10pt"><B>&ldquo;Companies
    Ordinance&rdquo;</B></FONT></TD>
    <TD STYLE="padding: 0.25pt"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></TD>
