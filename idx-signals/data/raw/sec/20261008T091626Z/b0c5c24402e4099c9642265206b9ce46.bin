    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td id="xdx_98F_ecustom--NumberOfSharesIssuedAndOutstanding_iI_pid_c20231231__ifrs-full--ClassesOfShareCapitalAxis__ifrs-full--PreferenceSharesMember_zmodBTgBVyHg" title="Number of shares issued and outstanding" style="font: 10pt Times New Roman, Times, Serif; text-align: right"><span style="-sec-ix-hidden: xdx2ixbrl1932">-</span></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td></tr>
