<table cellpadding="0" cellspacing="0" style="font: 10pt Times New Roman, Times, Serif; width: 100%; margin-top: 0; margin-bottom: 0"><tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
<td style="font: 10pt Times New Roman, Times, Serif; width: 0.5in"/><td style="font: 10pt Times New Roman, Times, Serif; width: 0.25in">h)</td><td style="font: 10pt Times New Roman, Times, Serif; text-align: justify">The Company issued <span id="xdx_906_eifrs-full--NumberOfSharesIssued_iI_pid_uShares_c20230307__ifrs-full--TypesOfContractsAxis__custom--BridgeLoansMember_zdDAafRlKAb6"><ix:nonFraction name="ifrs-full:NumberOfSharesIssued" contextRef="AsOf2023-03-07_custom_BridgeLoansMember" id="Fact001968" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">872,418</ix:nonFraction></span> ordinary shares for the conversion of bridge loan at principal amount of $<span id="xdx_90F_eifrs-full--DebtInstrumentsHeld_iI_pn3n3_c20230307__ifrs-full--TypesOfContractsAxis__custom--BridgeLoansMember_zKfKmqXv6994"><ix:nonFraction name="ifrs-full:DebtInstrumentsHeld" contextRef="AsOf2023-03-07_custom_BridgeLoansMember" id="Fact001969" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">1,350</ix:nonFraction></span>
and <span id="xdx_909_eifrs-full--NumberOfOtherEquityInstrumentsExercisedOrVestedInSharebasedPaymentArrangement_pid_uShares_c20230307__20230307__ifrs-full--ComponentsOfEquityAxis__custom--RedeemableWarrantsMember_zPkmlzm4Fcag"><ix:nonFraction name="ifrs-full:NumberOfOtherEquityInstrumentsExercisedOrVestedInSharebasedPaymentArrangement" contextRef="From2023-03-072023-03-07_custom_RedeemableWarrantsMember" id="Fact001970" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">200,000</ix:nonFraction></span> redeemable warrants ($<span id="xdx_906_ecustom--WarrantPricePerShare_iI_pid_c20230307__ifrs-full--ComponentsOfEquityAxis__custom--RedeemableWarrantsMember_zkbP2jZOagpd" title="Warrant price per share"><ix:nonFraction name="SMX:WarrantPricePerShare" contextRef="AsOf2023-03-07_custom_RedeemableWarrantsMember" id="Fact001972" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">5</ix:nonFraction></span> per warrant, <span id="xdx_90C_ecustom--WarrantsTerm_pid_dtY_c20230307__20230307__ifrs-full--ComponentsOfEquityAxis__custom--RedeemableWarrantsMember_z85aoAiS0IG8" title="Warrants term"><ix:nonNumeric contextRef="From2023-03-072023-03-07_custom_RedeemableWarrantsMember" format="ixt-sec:duryear" id="Fact001974" name="SMX:WarrantsTerm">5</ix:nonNumeric></span> years, exercise price of $<span id="xdx_901_eifrs-full--WeightedAverageExercisePriceOfOtherEquityInstrumentsExercisedOrVestedInSharebasedPaymentArrangement2019_pid_c20230307__20230307__ifrs-full--ComponentsOfEquityAxis__custom--RedeemableWarrantsMember_zjBOm4pOddv6"><ix:nonFraction name="ifrs-full:WeightedAverageExercisePriceOfOtherEquityInstrumentsExercisedOrVestedInSharebasedPaymentArrangement2019" contextRef="From2023-03-072023-03-07_custom_RedeemableWarrantsMember" id="Fact001975" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">11.5</ix:nonFraction></span> per share).</td></tr></table>

