aggregate of $<span id="xdx_903_eifrs-full--ProceedsFromIssueOfOrdinaryShares_pn3n3_c20230101__20231231_zi9SlYyeiDq9"><ix:nonFraction name="ifrs-full:ProceedsFromIssueOfOrdinaryShares" contextRef="From2023-01-012023-12-31" id="Fact001978" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">1,979</ix:nonFraction></span> net proceeds (see also note 13).</td></tr></table>

