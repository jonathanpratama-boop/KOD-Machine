        </div>
        <div style="margin-top:2.8pt; width:456pt;">
          <div style="margin-left: 0pt; width: 456pt; margin-top: 2.8pt; font-size: 1pt; line-height: 0pt; border-bottom: 1pt solid #000000; ">&#8203;</div>
        </div>
        <div style="margin-top:108.18pt; text-align:center; width:456pt; line-height:18pt;font-weight:bold;font-family:Times New Roman, Times, serif ;font-size:16pt;">
          <font style="letter-spacing:-0.32pt;">VERASTEM, INC.</font>
        </div>
        <div style="margin-top:106.49pt; text-align:center; width:456pt; line-height:15.5pt;font-weight:bold;font-family:Times New Roman, Times, serif ;font-size:14pt;">
          <font style="letter-spacing:-0.28pt;">Up to 1,200,000 Shares of Series B Convertible Preferred Stock</font>
          <br >
          <font style="letter-spacing:-0.28pt;">Up to 50,838,840 Shares of Common Stock Upon Conversion of Series B</font>
          <br >
          <font style="letter-spacing:-0.28pt;">Convertible Preferred Stock</font>
          <br >
          <font style="letter-spacing:-0.28pt;">Common Stock</font>
          <br >
          <font style="letter-spacing:-0.28pt;">Preferred Stock</font><font style="font-weight:normal;letter-spacing:0.28pt;"> </font>
        </div>
        <div style="margin-top:115.657pt; text-align:center; width:456pt;">
          <div style="margin-left: 38.158%; margin-right: 38.158%; margin-top: 115.656666666667pt; font-size: 1pt; line-height: 0pt; border-bottom: 1pt solid #000000; ">&#8203;</div>
        </div>
        <div style="margin-top:11.01pt; text-align:center; width:456pt; line-height:14pt;font-weight:bold;font-family:Times New Roman, Times, serif ;font-size:12pt;">
          <font style="letter-spacing:-0.24pt;">Prospectus</font>
        </div>
        <div style="margin-top:16.133pt; text-align:center; width:456pt;">
          <div style="margin-left: 38.158%; margin-right: 38.158%; margin-top: 16.1333333333333pt; font-size: 1pt; line-height: 0pt; border-bottom: 1pt solid #000000; ">&#8203;</div>
        </div>
        <div style="margin-top:110.08pt; text-align:center; width:456pt; line-height:12pt;font-weight:bold;font-family:Times New Roman, Times, serif ;font-size:10pt;">
          <font style="letter-spacing:-0.2pt;">April&#160;24, 2023</font><font style="font-weight:normal;letter-spacing:0.2pt;"> </font>
        </div>
        <div style="margin-top:108.58pt; width:456pt;">
          <div style="margin-left: 0pt; width: 456pt; margin-top: 108.58pt; font-size: 1pt; line-height: 0pt; border-bottom: 1pt solid #000000; ">&#8203;</div>
