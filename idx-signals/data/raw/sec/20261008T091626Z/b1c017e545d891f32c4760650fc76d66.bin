    <TD COLSPAN="2"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">with effect from 5 P.M. on December 31, Eastern time:</FONT></TD>
    <TD>&nbsp;</TD>
    <TD STYLE="text-align: center">&nbsp;</TD>
    <TD>&nbsp;</TD>
    <TD STYLE="text-align: center">&nbsp;</TD>
