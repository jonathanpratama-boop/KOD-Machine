    <td style="border-bottom: Black 1pt solid; text-align: left"><span style="font-size: 10pt">&#160;</span></td><td style="border-bottom: Black 1pt solid; text-align: right"><span style="font-size: 10pt"><ix:nonFraction name="us-gaap:LesseeOperatingLeaseLiabilityPaymentsDueAfterYearFive" contextRef="AsOf2022-12-31" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">7,200,000</ix:nonFraction></span></td><td style="padding-bottom: 1pt; text-align: left"><span style="font-size: 10pt">&#160;</span></td></tr>
