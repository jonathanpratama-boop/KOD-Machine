    <td style="text-align: right"><span id="xdx_90D_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExpectedVolatilityRate_dp_c20220101__20221231__srt--RangeAxis__srt--MinimumMember_z2pAE0SuAOeh" title="Expected volatility" style="font-size: 10pt"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExpectedVolatilityRate" contextRef="From2022-01-012022-12-31_srt_MinimumMember" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">121</ix:nonFraction></span><span style="font-size: 10pt">%
