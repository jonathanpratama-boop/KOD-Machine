    <td style="text-indent: -0.125in; padding-left: 0.125in; text-align: left"><span style="font-size: 10pt">Share price at date of grant</span></td><td><span style="font-size: 10pt">&#160;</span></td>
    <td style="text-align: right"><span style="font-size: 10pt">$<span id="xdx_90E_eus-gaap--SharePrice_iI_c20221231__srt--RangeAxis__srt--MinimumMember_zHI20lZzkvi2" title="Share price at date of grant"><ix:nonFraction name="us-gaap:SharePrice" contextRef="AsOf2022-12-31_srt_MinimumMember" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">1.00</ix:nonFraction>
    </span></span><span style="font-size: 10pt">- $<span id="xdx_90A_eus-gaap--SharePrice_c20221231__srt--RangeAxis__srt--MaximumMember_pdd"><ix:nonFraction name="us-gaap:SharePrice" contextRef="AsOf2022-12-31_srt_MaximumMember" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">5.00</ix:nonFraction></span></span></td><td style="text-align: left"><span style="font-size: 10pt">&#160;</span></td></tr>
