    a sum of $<span id="xdx_903_eus-gaap--LineOfCredit_iI_pn3n3_c20221231_zNhNHXRGjyza" title="Credit line" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNDSEVEVUxFIE9GIE1BVFVSSVRJRVMgT0YgREVCVCAoRGV0YWlscykgKFBhcmVudGhldGljYWwpAA__"><ix:nonFraction name="us-gaap:LineOfCredit" contextRef="AsOf2022-12-31" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">5,000</ix:nonFraction></span> which is a renewable monthly credit line.</ix:footnote></span></td></tr>
  </table>
</ix:nonNumeric><p id="xdx_8A1_ztBfgf8SwNRc" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p>


