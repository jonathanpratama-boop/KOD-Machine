    <td style="text-align: left">&#160;</td><td style="text-align: right">&#160;</td><td style="text-align: left">&#160;</td></tr>
  <tr id="xdx_40B_eus-gaap--AssetsCurrentAbstract_i01B_zY1c0MaUuD1k" style="vertical-align: bottom; background-color: rgb(204,238,255)">
