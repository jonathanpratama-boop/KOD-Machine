    <td style="font: 10pt Times New Roman, Times, Serif; width: 5%"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#9744;</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; width: 20%"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_90D_edei--EntityFilerCategory_c20220101__20221231_zZky1M7bQ7E5"><ix:nonNumeric contextRef="From2022-01-01to2022-12-31" format="ixt-sec:entityfilercategoryen" name="dei:EntityFilerCategory">Non-Accelerated
