				<tr class="No-Table-Style _idGenTableRowColumn-8" style="height:12pt;">
					<td class="TB" style="border-bottom-width:0pt;border-left-width:0pt;border-right-width:0pt;border-top-width:0pt;padding-bottom:3pt;padding-left:3pt;padding-right:3pt;padding-top:3pt;vertical-align:bottom;padding-left:0pt;width: 83.33%; padding: 0in 0in 3px 0in;border-width: 0pt;" valign="bottom">
						<p class="Tbody" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:10pt;margin-right:0;margin-top:0;orphans:1;page-break-after:auto;page-break-before:auto;text-align:left;text-indent:-10pt;widows:1;">Adjusted EBITDA<span class="Superscript" style="vertical-align:super;font-size:58%;">(1)</span></p>
					</td>
