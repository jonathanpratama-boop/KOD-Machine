					</td>
					<td class="TB" style="border-bottom-width:0pt;border-left-width:0pt;border-right-width:0pt;border-top-width:0pt;padding-bottom:3pt;padding-left:3pt;padding-right:3pt;padding-top:3pt;vertical-align:bottom;border-top-color:#000000;border-top-width:0pt;padding-bottom:4pt;padding-left:0pt;padding-right:0pt;padding-top:4pt;width: 1.28%; padding: 0in 0in 3px 0in;border-width: 0pt;white-space: nowrap;" valign="bottom">&#160;</td>
