					<TD CLASS="TB" STYLE="border-bottom-width:0pt;border-left-width:0pt;border-right-width:0pt;border-top-width:0pt;padding-bottom:3pt;padding-left:3pt;padding-right:3pt;padding-top:3pt;vertical-align:bottom;border-top-color:#000000;border-top-style:solid;padding-left:0pt;padding-right:0pt;vertical-align:top;width: 40.00%; padding: 0in 0in 3px 0in;border-width: 0pt;" VALIGN="top">
