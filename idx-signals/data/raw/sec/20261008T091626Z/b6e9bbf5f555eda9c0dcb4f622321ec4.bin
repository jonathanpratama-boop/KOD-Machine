  <TR STYLE="vertical-align: top">
    <TD>&#160;</TD>
    <TD>&#160;</TD>
    <TD STYLE="text-align: justify">&#160;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD>&#160;</TD>
    <TD><FONT STYLE="font-family: Symbol; font-size: 10pt">&#183;</FONT></TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">Continue performing research and development on PLC technology;</FONT></TD></TR>
