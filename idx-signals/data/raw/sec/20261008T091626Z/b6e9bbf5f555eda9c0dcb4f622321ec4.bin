    <TD STYLE="vertical-align: top; text-align: justify"><FONT STYLE="font-size: 10pt">an exchange distribution in accordance with the rules of the applicable exchange;</FONT></TD></TR>
  <TR>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">&#160;</FONT></TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">&#160;</FONT></TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">&#160;</FONT></TD></TR>
  <TR>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">&#160;</FONT></TD>
    <TD STYLE="vertical-align: top; text-align: justify"><FONT STYLE="font-family: Symbol; font-size: 10pt">&#183;</FONT></TD>
    <TD STYLE="vertical-align: top; text-align: justify"><FONT STYLE="font-size: 10pt">privately negotiated transactions;</FONT></TD></TR>
  <TR>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">&#160;</FONT></TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">&#160;</FONT></TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">&#160;</FONT></TD></TR>
  <TR>
