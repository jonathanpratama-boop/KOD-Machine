    <TD STYLE="width: 83%; text-align: justify; padding-bottom: 1pt">Year ending December 31, 2026</TD><TD STYLE="width: 2%; padding-bottom: 1pt">&#160;</TD>
    <TD STYLE="border-bottom: Black 1pt solid; width: 1%; text-align: left">$</TD><TD STYLE="border-bottom: Black 1pt solid; width: 13%; text-align: right">8,989</TD><TD STYLE="width: 1%; padding-bottom: 1pt; text-align: left">&#160;</TD></TR>
