  <tr>

    <td style="width: 18pt; vertical-align: top; color: rgb(0, 0, 0);">&#8226;</td>

    <td style="width: auto; vertical-align: top; text-align: justify;">
                <div style="color: rgb(0, 0, 0);">in whole and not in part;</div>
              </td>

  </tr>


</table>
</ix:continuation>
        <ix:continuation id="Text_ac82a32386e6406fb834de043af2006f23" continuedAt="Text_ac82a32386e6406fb834de043af2006f24">
<div style="font-family: 'Times New Roman'; font-size: 10pt;"><br />
        </div>
</ix:continuation>
