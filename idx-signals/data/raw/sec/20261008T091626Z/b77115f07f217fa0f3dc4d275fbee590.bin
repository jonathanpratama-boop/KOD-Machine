        <div style="text-align: center; color: rgb(0, 0, 0); font-weight: bold; font-family: 'Times New Roman'; font-size: 10pt;"><a id="NOTESTOTHEFINANCIALSTATEM"><!--Anchor--></a><!--Anchor--><!--Anchor--><!--Anchor--><!--Anchor--><!--Anchor--><!--Anchor--><!--Anchor-->NOTES













          TO THE FINANCIAL STATEMENTS</div>

        <div style="font-family: 'Times New Roman'; font-size: 10pt;"><span style="color: rgb(0, 0, 0);"> </span><br />
        </div>

      </div>

