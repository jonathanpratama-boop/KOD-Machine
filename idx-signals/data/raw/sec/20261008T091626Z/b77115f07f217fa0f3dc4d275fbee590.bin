    <td style="width: 18pt; vertical-align: top; color: rgb(0, 0, 0);">&#8226;</td>

    <td style="width: auto; vertical-align: top; text-align: justify;">
                <div style="color: rgb(0, 0, 0);">at a price of $<ix:nonFraction name="paci:ClassOfWarrantOrRightRedemptionPriceOfWarrantsOrRights" id="Fact_5f55af2914da4bbab065bc521fedd565" contextRef="c20230930_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_WarrantsAndRightsSubjectToMandatoryRedemptionTwoMember_StatementClassOfStockAxis_CommonClassAMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal">0.10</ix:nonFraction> per warrant provided that the holder will be able to exercise their
                  warrants on cashless basis prior to redemption and receive that number of shares based on the redemption date and the fair market value of the Class A common stock;</div>
              </td>

  </tr>


</table>
</ix:continuation>
        <ix:continuation id="Text_ac82a32386e6406fb834de043af2006f35" continuedAt="Text_ac82a32386e6406fb834de043af2006f36">
