    <td style="width: 18pt; vertical-align: top; color: rgb(0, 0, 0);">&#8226;</td>

    <td style="width: auto; vertical-align: top; text-align: justify;">
                <div style="color: rgb(0, 0, 0);">upon a minimum of <ix:nonNumeric name="paci:NoticePeriodToRedeemWarrants" id="Fact_ba94cbf81ee147d8a93762d6ea1741ac" contextRef="c20230101to20230930_RangeAxis_MinimumMember_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_WarrantsAndRightsSubjectToMandatoryRedemptionTwoMember_StatementClassOfStockAxis_CommonClassAMember" format="ixt-sec:durday">30</ix:nonNumeric> days&#8217; prior written notice of redemption;</div>
              </td>

  </tr>


</table>
