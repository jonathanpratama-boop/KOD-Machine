    <TD STYLE="text-align: left">C$</TD><TD STYLE="text-align: right"><FONT STYLE="font-size: 10pt">4.50</FONT></TD><TD STYLE="text-align: left">&nbsp;</TD><TD>&nbsp;</TD>
