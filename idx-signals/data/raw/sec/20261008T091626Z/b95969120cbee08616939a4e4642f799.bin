    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD>&nbsp;</TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">&ldquo;Notice&rdquo;</FONT></TD>
    <TD STYLE="text-align: justify"><FONT STYLE="font-size: 10pt">written notice unless otherwise specifically stated and as further defined in these Articles. </FONT></TD></TR>
  </TABLE>
