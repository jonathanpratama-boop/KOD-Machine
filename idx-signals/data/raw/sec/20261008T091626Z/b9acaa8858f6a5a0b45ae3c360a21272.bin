    <TD STYLE="text-align: left">&#160;</TD><TD STYLE="text-align: right">3,755,193</TD><TD STYLE="text-align: left">&#160;</TD><TD>&#160;</TD>
    <TD STYLE="text-align: left">&#160;</TD><TD STYLE="text-align: right">2,570,083</TD><TD STYLE="text-align: left">&#160;</TD><TD>&#160;</TD>
    <TD STYLE="text-align: left">&#160;</TD><TD STYLE="text-align: right">1,185,110</TD><TD STYLE="text-align: left">&#160;</TD><TD>&#160;</TD>
