  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 88%">Common shares</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c1" decimals="INF" format="ixt:num-dot-decimal" name="vs:CommonShares" scale="0" unitRef="shares">12,890,029</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
