    <td style="text-align: left">$</td><td style="text-align: right"><ix:nonFraction contextRef="c1" decimals="0" format="ixt:num-dot-decimal" name="vs:CashAmount" scale="0" unitRef="usd">27,124</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
