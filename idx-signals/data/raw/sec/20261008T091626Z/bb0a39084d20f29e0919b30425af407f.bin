    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c88" decimals="0" format="ixt:num-dot-decimal" name="vs:PropertyPlantAndEquipmentCost" scale="0" unitRef="usd">181,390</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td>
