    <div style="break-before: page; margin-top: 6pt"><p style="margin: 0pt">&#160;</p></div>
    <!-- Field: /Page --></ix:exclude>

<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p>

<ix:nonNumeric contextRef="From2025-10-01to2026-03-31" escape="true" id="Fact000580" name="ifrs-full:DisclosureOfOperatingSegmentsExplanatory"><p id="xdx_89A_eifrs-full--DisclosureOfOperatingSegmentsExplanatory_zgAMdnyGQsUl" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">The
following table shows the Company&#8217;s operations by business segment for the six months ended March 31, 2026 and 2025.</span></p>

