    <td style="text-align: left">$</td><td style="text-align: right">90.02</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">&#8211;</td><td style="text-align: left">&#160;</td></tr>
