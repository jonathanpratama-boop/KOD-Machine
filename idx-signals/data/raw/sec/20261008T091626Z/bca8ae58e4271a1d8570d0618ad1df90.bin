    <td style="text-align: justify; width: 74%"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Each Class A Ordinary Share is entitled to one (1)&#160;vote.</span></td></tr>
  <tr style="vertical-align: top">
    <td style="padding-left: 9pt; text-indent: -9pt">&#160;</td>
    <td>&#160;</td>
    <td style="text-align: justify">&#160;</td></tr>
