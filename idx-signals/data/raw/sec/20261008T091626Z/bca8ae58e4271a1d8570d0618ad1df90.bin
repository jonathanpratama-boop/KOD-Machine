    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 9%; text-align: right">&#160;&#160;&#160;&#160;&#160;&#160;&#160;(<ix:nonFraction contextRef="c295" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxExpenseBenefit" scale="0" sign="-" unitRef="usd" id="ixv-25967">486,706</ix:nonFraction></td><td style="width: 1%; text-align: left">)</td></tr>
