    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c6" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DebtConversionConvertedInstrumentWarrantsOrOptionsIssued1" scale="0" unitRef="shares" id="ixv-25840">3,555,678</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
