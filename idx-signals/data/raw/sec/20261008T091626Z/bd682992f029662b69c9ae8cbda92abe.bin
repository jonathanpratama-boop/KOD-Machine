    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c8" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxExpenseBenefit" scale="0" unitRef="usd" id="ixv-13723">23,000</ix:nonFraction></td><td style="padding-bottom: 4pt; text-align: left">&#160;</td></tr>
