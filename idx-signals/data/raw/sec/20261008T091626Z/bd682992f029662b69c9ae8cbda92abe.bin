    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c3" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DeferredTaxAssetsOperatingLossCarryforwardsForeign" scale="0" unitRef="usd" id="ixv-13744">4,927,995</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left">Amortization of debt discount</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="tgl:DeferredTaxAssetsAmortizationOfDebtDiscount" scale="0" unitRef="usd" id="ixv-13745">156,403</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c3" decimals="0" format="ixt:num-dot-decimal" name="tgl:DeferredTaxAssetsAmortizationOfDebtDiscount" scale="0" unitRef="usd" id="ixv-13746">70,415</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
