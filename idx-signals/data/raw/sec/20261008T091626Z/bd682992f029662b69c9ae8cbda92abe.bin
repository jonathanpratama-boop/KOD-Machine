    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c89" decimals="0" format="ixt:num-dot-decimal" name="tgl:AccountsReceivableAdditionRecovery" scale="0" unitRef="usd" id="ixv-13340">53,250</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
