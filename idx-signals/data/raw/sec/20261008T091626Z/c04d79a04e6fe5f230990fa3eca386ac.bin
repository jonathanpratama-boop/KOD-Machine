<TABLE CELLSPACING="0" CELLPADDING="0" STYLE="font: 10pt Times New Roman, Times, Serif; width: 100%">
  <TR STYLE="font-size: 10pt; vertical-align: top">
    <TD STYLE="font-size: 10pt; width: 1in"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt"><B>ANNUAL</B><BR>
    <B>REPORT:</B></FONT></TD>
    <TD STYLE="font-size: 10pt"><P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify"><FONT STYLE="font-size: 10pt">Our Annual
        Report on Form&nbsp;20-F for the fiscal year ended June&nbsp;30, 2025 (the &ldquo;2025 Annual Report&rdquo;), including the financial
        statements, and other documents filed or submitted to the United States Securities and Exchange Commission (the &ldquo;SEC&rdquo;)
        are available from the SEC&rsquo;s website at http://www.sec.gov.</FONT></P>
    <P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify"><FONT STYLE="font-size: 10pt">&nbsp;</FONT></P>
    <P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify"><FONT STYLE="font-size: 10pt">A copy of our
    2025 Annual Report is also available on the Company&rsquo;s website at&nbsp;http://bitorigin.io/ and in print by written request
    addressed to Mr.&nbsp;Jinghai Jiang as follows:</FONT></P>
