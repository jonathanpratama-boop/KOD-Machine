    <td style="border-bottom: Black 1.5pt solid; font: 10pt Times New Roman, Times, Serif; text-align: center; width: 20%"><span id="xdx_904_edei--TradingSymbol_c20231022__20231022_z13FoYyXgaL3" style="font-family: Times New Roman, Times, Serif; font-size: 10pt; color: Black"><b><ix:nonNumeric contextRef="AsOf2023-10-22" name="dei:TradingSymbol">INVO</ix:nonNumeric></b></span></td>
