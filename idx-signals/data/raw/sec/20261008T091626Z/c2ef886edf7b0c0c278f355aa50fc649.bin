              <div style="color: rgb(0, 0, 0);"><ix:nonFraction name="us-gaap:AllowanceForDoubtfulAccountsReceivable" id="Fact_1bcca5cbef25485c8dcc4b169878fdcb" contextRef="c20221231" unitRef="U002" decimals="0" scale="0" format="ixt:num-dot-decimal">1,961,034</ix:nonFraction></div>
