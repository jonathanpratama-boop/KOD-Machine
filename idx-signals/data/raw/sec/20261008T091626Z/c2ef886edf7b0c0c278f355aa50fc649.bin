  <tr>

    <td valign="bottom" style="vertical-align: top; border-bottom: 2px solid rgb(0, 0, 0); border-left: 2px solid rgb(0, 0, 0);">
              <div style="text-align: right; color: rgb(0, 0, 0);">(Expressed in U.S. Dollars)</div>
            </td>

    <td valign="bottom" colspan="1" style="vertical-align: bottom; border-left: 2px solid rgb(0, 0, 0); border-bottom: 2px solid rgb(0, 0, 0);">&#160;</td>

    <td valign="bottom" colspan="6" style="vertical-align: top; border-bottom: 2px solid rgb(0, 0, 0);">
