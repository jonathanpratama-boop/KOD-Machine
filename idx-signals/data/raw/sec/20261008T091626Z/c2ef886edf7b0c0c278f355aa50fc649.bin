        <ix:continuation id="Text_8d9906c5e9524baf9c98c675db3b45425">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt;">For the nine months ended September 30, 2023 and 2022, the impairment loss recognized by the Company for slow-moving inventory with cost lower than net realizable
          value was <span style="-sec-ix-hidden:Fact_06c3ecbcc1464da2a0054906efcfe5aa">nil</span> and $<ix:nonFraction name="cenn:ImpairmentLossRecognizedForInventory" id="Fact_481090fb51db46e180330c798ff6e6cd" contextRef="c20220101to20220930" unitRef="U002" decimals="0" scale="0" format="ixt:num-dot-decimal">587,027</ix:nonFraction>,
          respectively.</div>
</ix:continuation>
