      <ix:continuation id="Text_ea94d66a7bdc4cce9e2ccf54dc644f4b5">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt;">Amortization expenses for the nine months ended September 30, 2023 and 2022 were $<ix:nonFraction name="us-gaap:AmortizationOfIntangibleAssets" id="Fact_020df13a463046b1a674cbef09cca3bd" contextRef="c20230101to20230930" unitRef="U002" decimals="0" scale="0" format="ixt:num-dot-decimal">83,367</ix:nonFraction> and $<ix:nonFraction name="us-gaap:AmortizationOfIntangibleAssets" id="Fact_e006846b3b554c9c82eb1315fa9e3f0d" contextRef="c20220101to20220930" unitRef="U002" decimals="0" scale="0" format="ixt:num-dot-decimal">328,142</ix:nonFraction>, respectively.</div>
</ix:continuation>

      <div style="font-family: 'Times New Roman'; font-size: 10pt;"><br />
      </div>

