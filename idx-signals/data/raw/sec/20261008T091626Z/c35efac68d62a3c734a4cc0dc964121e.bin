          <!--blacklining:none;-->
          <font style="letter-spacing:0.2pt;">No GEHI Material Adverse Effect (as defined below) shall have occurred since the date of the Merger Agreement. </font>
        </div>
        <div style="clear:both; padding:0pt; margin:0pt;font-size:0pt;line-height:0pt;">&#8203;</div>
