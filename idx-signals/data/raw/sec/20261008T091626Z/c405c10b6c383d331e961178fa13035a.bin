wM8kFSJw" contextRef="Duration_1_1_2023_To_3_31_2023_mBJe94Chz065Qv1d0be-KQ" decimals="0" format="ixt:numdotdecimal" name="mdrr:AmortizationOfIntangibleAssetsWriteOff" scale="0" id="Narr_ykAj1zDO90e74axmeEMMgw">273,252</ix:nonFraction>, respectively, in accumulated amortization related to fully amortized intangible assets, and $<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="Duration_1_1_2024_To_3_31_2024_c98__lW_mkiq4m2Cg5AVMw" decimals="0" format="ixt:numdotdecimal" name="mdrr:AmortizationOfTenantDefaultsWrittenOff" scale="0" id="Narr_YpBcDZ6R-kysYguuIDxOSg">0</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="Duration_1_1_2023_To_3_31_2023_mBJe94Chz065Qv1d0be-KQ" decimals="0" format="ixt:numdotdecimal" name="mdrr:AmortizationOfTenantDefaultsWrittenOff" scale="0" id="Narr_hYGjHunAl0OLbFSO0Eu0sA">21,407</ix:nonFraction>, respectively, in accumulated amortization related to the write off of intangible assets related to the early terminated leases, discussed above.</p></ix:nonNumeric></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">10</p></div></div>
