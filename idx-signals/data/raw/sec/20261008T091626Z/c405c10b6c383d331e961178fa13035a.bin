2uqGk6DQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DebtInstrumentPeriodicPayment" scale="0" id="Narr_eD0N3GcQnkW1dPpJ5kL-HA">56,882</ix:nonFraction></span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;"> increased to </span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">$<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="Duration_2_1_2023_To_2_1_2023_srt_RealEstateAndAccumulatedDepreciationDescriptionOfPropertyAxis_mdrr_HanoverSquarePropertyMember_us-gaap_DebtInstrumentAxis_mdrr_MortgagesPayableMember_yp2n3e7o2E6EBqRAcI2oDw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DebtInstrumentPeriodicPayment" scale="0" id="Narr_6tzuXob-t0abXFF1EQriQQ">78,098</ix:nonFraction></span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;"> which included interest at the fixed rate, and principal, based on a </span><ix:nonNumeric contextRef="Duration_2_1_2023_To_2_1_2023_srt_RealEstateAndAccumulatedDepreciationDescriptionOfPropertyAxis_mdrr_HanoverSquarePropertyMember_us-gaap_DebtInstrumentAxis_mdrr_MortgagesPayableMember_yp2n3e7o2E6EBqRAcI2oDw" format="ixt-sec:durwordsen" name="mdrr:DebtInstrumentAmortizationSchedule" id="Narr_77VI60BH_0KHfhnXIKP5cg"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">twenty-five-year</span></ix:nonNumeric><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;"> amortization schedule. &#160;On March 13, 2024, the Company sold the Hanover Square Shopping Center Property and repaid the mortgage loan for the Hanover Square Property. &#160;</span></td></tr></table><div style="margin-top:12pt;"></div></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-style:italic;font-weight:bold;">Loss on Extinguishment of Debt &#8211; Hanover Square Property Mortgage Payable </span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;">On March 13, 2024, the Company sold the Hanover Square Shopping Center Property and repaid the mortgage loan for the Hanover Square Property. The Company accounted for the repayment of the mortgage payable under debt extinguishment accounting in accordance with ASC 470. During the three months ended March&#160;31,&#160;2024, the Company recorded a loss on extinguishment of debt of $<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="Duration_1_1_2024_To_3_31_2024_srt_RealEstateAndAccumulatedDepreciationDescriptionOfPropertyAxis_mdrr_HanoverSquarePropertyMember_H-8Q8Y0nOEG1UdvbGV2w9w" decimals="0" format="ixt:numdotdecimal" name="us-gaap:GainsLossesOnExtinguishmentOfDebt" sign="-" scale="0" id="Narr_HmuxiSVyd0yaf7Pjonip2Q">51,837</ix:nonFraction> consisting of unamortized loan issuance costs. <ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="Duration_1_1_2023_To_3_31_2023_srt_RealEstateAndAccumulatedDepreciationDescriptionOfPropertyAxis_mdrr_HanoverSquarePropertyMember_fhGncd40VEuX7mSOpSOFgQ" decimals="0" format="ixt-sec:numwordsen" name="us-gaap:GainsLossesOnExtinguishmentOfDebt" scale="0" id="Narr_Han0pRoAu0-JBh_WhyvF1w">No</ix:nonFraction> such loss was recorded during the three months ended March&#160;31,&#160;2023.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><span style="font-style:italic;font-weight:bold;">Interest rate protection transaction</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;">On October 28, 2021, the Company entered into an interest rate protection transaction to limit its exposure to increases in interest rates on the variable rate mortgage loan on the Parkway Property (the &#8220;Interest Rate Protection Transaction&#8221;). &#160;Under this agreement, the Company&#8217;s interest rate exposure is <ix:nonNumeric contextRef="Duration_10_28_2021_To_10_28_2021_srt_OwnershipAxis_mdrr_ParkwayPropertyMember_us-gaap_DerivativeInstrumentRiskAxis_us-gaap_InterestRateCapMember_9WMqbJgtRk6RtUbaqzJL3Q" name="us-gaap:DebtInstrumentDescriptionOfVariableRateBasis" id="Narr_6jrndXZShEWI7QoBPI1wdg">capped at 5.25% if USD 1-Month ICE LIBOR exceeds 3%</ix:nonNumeric>. Effective on July 1, 2023, the interest rate index under the Interest Rate Protection Transaction automatically converted to SOFR. &#160;SOFR was <ix:nonNumeric contextRef="Duration_1_1_2024_To_3_31_2024_srt_OwnershipAxis_mdrr_ParkwayPropertyMember_us-gaap_DerivativeInstrumentRiskAxis_us-gaap_InterestRateCapMember_us-gaap_VariableRateAxis_us-gaap_SecuredOvernightFinancingRateSofrOvernightIndexSwapRateMember_bZX0C03xwUefBbI694HNKA" name="us-gaap:DebtInstrumentDescriptionOfVariableRateBasis" id="Narr_gbUx0-6WXkO1Jj6gsVnAQQ">5.33%</ix:nonNumeric> and </p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">23</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="_Hlk150255693"></a><a id="_76771bde_de0e_48fa_8914_017c4b095a47"></a><a id="Tc_ztdvWO4I1E6C92MIecg3ZA_1_2"></a><a id="Tc_QAzhteyCFUuWfHEb6zbX6w_2_2"></a><a id="Tc_iCtY2A4ioUKWGisQSlAQFg_3_5"></a><a id="Tc_WwEYUJyZzkaci76hCfw27A_3_8"></a><a id="Tc_lKvRgxDF7EyMS074xmU3gA_4_2"></a><a id="Tc_5gtnrn3830uKTqY6jZHm7g_4_5"></a><a id="Tc_cTxwv5j0D0afWGGYu-P6WA_4_8"></a><a id="Tc_sT_uHC1byEeicl_apRy2kw_4_11"></a><a id="Tc_YX6JYV5SMUKryQ0aWhtkwg_5_2"></a><a id="Tc_mNXBpzcJNEeEMCxUuvBWyg_5_5"></a><a id="Tc_tqxMjdqde0KqF0txQuBR9Q_5_8"></a><a id="Tc_QdZhpvwsmEiqbKY-6BSIZw_5_11"></a><a id="Tc_7kkO7T-YoEOZjAR74b0LiA_6_2"></a><a id="Tc_nwbX0BdEw0iTrq-Xy0sjKQ_6_5"></a><a id="Tc_2GHGzVLJ-02fftVZngErmQ_6_8"></a><a id="Tc_KGLqXTA_Wka5rOgAnCWzjg_6_11"></a><a id="Tc_77QS7H_kPk6uZIe90u7AwQ_6_14"></a><a id="Tc_zEvxeHCbYkmNTGxiN5UgbQ_7_0"></a><a id="Tc_JjbLfhgJEES9i5GZlN0FHQ_7_2"></a><a id="Tc_8v7DTqIT2EGgnGDsEjfTHg_7_5"></a><a id="Tc_mKQBA5YEaU2fZEF2PUfP_g_7_8"></a><a id="Tc_S6T0XQYNI0agQOEf_MAZhw_7_9"></a><a id="Tc_RYJuftvda0CyrCrTLnOUew_7_11"></a><a id="Tc_Lfvn9t1Q4kyDhzdsYmSTwg_7_12"></a><a id="Tc_Q9l6YplitEqHCynyHl3YJw_7_14"></a><a id="Tc_eEYC-k7WDUqP5XzX_2171g_8_0"></a><a id="Tc_1Mz8F3TOEkOIbH5Qdn2L0w_8_6"></a><a id="Tc_VS7qY2opgE6H0zG9acT4dg_8_9"></a><a id="Tc__X7-i6Hwkk2QH0aRaEMGyA_8_12"></a><a id="Tc_2-oYWPEYAkeKlwyNKODHCg_9_0"></a><a id="Tc_M9kNNSdwHUKOzS-aFSn98A_9_9"></a><a id="Tc_hBhJN9ZahE-ept2AYkltRQ_9_12"></a><a id="Tc_468jXAhQk06fSm0KyY-J9A_10_0"></a><a id="Tc_0vmbwrBNrk2ZSsljgn6cgw_10_9"></a><a id="Tc_RMetDxEklE2rXmSnqEvo5A_10_12"></a><a id="Tc_G8gt0oaCpUGNAk8inMh0PQ_11_0"></a><a id="Tc_538_ZxxFEE2GDN0yl3Y-eg_11_12"></a><a id="Tc_PAhjHTPnEkGLIFFmmDVcrg_12_0"></a><a id="Tc_5_XHHHewi0q5i2qcBp-lag_12_9"></a><a id="Tc_TggA59Vp4UyM6Ixp-8dPaQ_12_12"></a><a id="Tc_iqN8DApsuEeHUfIEb2yTbQ_13_0"></a><a id="Tc_5poEOXuhuEOL3rsPF2OSpQ_13_3"></a><a id="Tc_9cIdxNDYwUSNMJmp4roQUw_13_6"></a><a id="Tc_hPU4QLj4AEGTZXPmdF20sQ_13_9"></a><a id="Tc_OHpA4xOM2UCoa0JkZm_uUw_14_0"></a><a id="Tc_pjljG2mdQk-6LV8XZODm8g_14_3"></a><a id="Tc_9reFIR4KEU-MBrwPNd-JUg_14_9"></a><a id="Tc_G71v7_LabkeXOhsD-aCd1A_15_0"></a><a id="Tc_JafDzwLMSE-NYWmt6Wtd4g_15_3"></a><a id="Tc_EKRMQIsBfkGnzDGLKNWjmA_15_6"></a><a id="Tc_uk5PSN9Hnk68tjEplJSRZg_15_9"></a><a id="Tc_oc3RpVKdFU6wmmjPHwKUTg_16_0"></a><a id="Tc_YOvmsPDGHkCI3AQRBdE1UQ_16_2"></a><a id="Tc_zffqi01iHkSXODKF5RUt6g_16_5"></a><a id="Tc_dX4WRiaNuU2GV8E27yJ3DA_16_8"></a><a id="Tc_xBm1JwjX-keS06WlV8h8Xw_16_11"></a><a id="Tc_Ip-feuXEs0Kj1wN46QkElQ_16_14"></a><ix:continuation id="Tb_dGAijTfABEuzAwEv03nk2w_cont2" continuedAt="Tb_dGAijTfABEuzAwEv03nk2w_cont3"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><ix:nonNumeric contextRef="Duration_1_1_2023_To_12_31_2023_srt_OwnershipAxis_mdrr_ParkwayPropertyMember_us-gaap_DerivativeInstrumentRiskAxis_us-gaap_InterestRateCapMember_us-gaap_VariableRateAxis_us-gaap_SecuredOvernightFinancingRateSofrOvernightIndexSwapRateMember_7qnX_NPkkUCEYGAL2CrPCw" name="us-gaap:DebtInstrumentDescriptionOfVariableRateBasis" id="Narr_yKuC9L5TJkqRz7wjYpBeqg">5.35%</ix:nonNumeric> as of March&#160;31,&#160;2024 and December&#160;31,&#160;2023, respectively. &#160;In accordance with the guidance on derivatives and hedging, the Company records all derivatives on the balance sheet at fair value under other assets. The Company determines fair value based on the three-level valuation hierarchy for fair value measurement. &#160;Level 1 inputs are quoted prices in active markets for identical assets or liabilities. &#160;Level 2 inputs are quoted prices for similar assets or liabilities in active markets; quoted prices for identical or similar assets in markets that are not active; and inputs other than quoted prices. Level 3 inputs are unobservable inputs that are supported by little or no market activity and that are significant to the fair value of the assets or liabilities. The fair value of the Interest Rate Protection Transaction is valued by an independent, third-party consultant which uses observable inputs such as yield curves, volatilities and other current market data, all of which are considered Level 2 inputs. As of March&#160;31,&#160;2024 and December&#160;31,&#160;2023, the fair value of the Interest Rate Protection Transaction was $<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="As_Of_3_31_2024_srt_OwnershipAxis_mdrr_ParkwayPropertyMember_us-gaap_DerivativeInstrumentRiskAxis_us-gaap_InterestRateCapMember_KUe8uTGkM0yUafsKUE7vyw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DerivativeFairValueOfDerivativeNet" scale="0" id="Narr_keWQ9MiXzUqd-Eay0i05Sw">209,053</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="As_Of_12_31_2023_srt_OwnershipAxis_mdrr_ParkwayPropertyMember_us-gaap_DerivativeInstrumentRiskAxis_us-gaap_InterestRateCapMember_GNbTD17oaUmhSt8eS3MXhw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DerivativeFairValueOfDerivativeNet" scale="0" id="Narr_CxNlaJVMN0-4duprD0CMBA">173,715</ix:nonFraction>, respectively, and is recorded under other assets on the Company&#8217;s balance sheets. The Company reports changes in the fair value of the derivative in other income on its condensed consolidated statements of operations. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;">For the period from September 1, 2022 through June 30, 2023, LIBOR, and for the period from July 1, 2023 through March 31, 2024, SOFR exceeded the <ix:nonFraction unitRef="Unit_Standard_pure_JP5OB9LUA02PwG4Yf5p1Eg" contextRef="As_Of_6_30_2023_srt_RealEstateAndAccumulatedDepreciationDescriptionOfPropertyAxis_mdrr_ParkwayPropertyMember_us-gaap_DerivativeInstrumentRiskAxis_us-gaap_InterestRateCapMember_us-gaap_VariableRateAxis_mdrr_IntercontinentalExchangeLondonInterbankOfferedRateIceLiborMember_55kKHiGAlUyhsFuVPbOENA" decimals="2" format="ixt:numdotdecimal" name="us-gaap:DerivativeCapInterestRate" scale="-2" id="Narr_zJbesAuluUaznj07CnP6Vw">3</ix:nonFraction>% <span style="-sec-ix-hidden:Hidden_CR1egu8tW0KO3CjanTQlUQ;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">cap</span></span>, and payments from the Interest Rate Protection Transaction reduced the Company&#8217;s net interest expense. Payments to the Company from the Interest Rate Protection Transaction are recorded as an offset to interest expense on the Company&#8217;s condensed consolidated statements of operations for the three months ended March&#160;31,&#160;2024 and 2023. &#160;</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:36pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><span style="font-style:italic;font-weight:bold;">Wells Fargo Line of Credit</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;"><span style="display:inline-block;text-align:left;text-indent:0pt;width:18pt;"></span>On June 13, 2022, the Company, through its wholly-owned subsidiaries, entered into a loan agreement with Wells Fargo Bank for a $<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="As_Of_6_13_2022_us-gaap_DebtInstrumentAxis_mdrr_WellFargoLineOfCreditMember_sIUSGmG3xE-o8oqJXPwj4A" decimals="0" format="ixt:numdotdecimal" name="us-gaap:LineOfCreditFacilityMaximumBorrowingCapacity" scale="0" id="Narr_oUDmiOfABUapfKc9uKTlQw">1,500,000</ix:nonFraction> line of credit (the &#8220;Wells Fargo Line of Credit&#8221;). &#160;On May 2, 2023, the Company and Wells Fargo Bank entered into the First Amendment to Revolving Line of Credit Note which extended the maturity date of the Wells Fargo Line of Credit to June 9, 2024. &#160;As of March&#160;31,&#160;2024 and December&#160;31,&#160;2023 the Wells Fargo Line of Credit had an outstanding balance of $<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="As_Of_3_31_2024_us-gaap_DebtInstrumentAxis_mdrr_WellFargoLineOfCreditMember_KybUPjdXX0ONL4PdpjUm8Q" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ShortTermBorrowings" scale="0" id="Narr_RjcaqBWYxkO1nGx28vAN3w">0</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="As_Of_12_31_2023_us-gaap_DebtInstrumentAxis_mdrr_WellFargoLineOfCreditMember_64fgcBNa0kifanHKnJ8gzg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ShortTermBorrowings" scale="0" id="Narr_L8R6S4YLiUmV2to6RFX5Nw">1,000,000</ix:nonFraction>, respectively. &#160;Outstanding balances on the Wells Fargo Line of Credit will bear interest at a floating rate of <ix:nonFraction unitRef="Unit_Standard_pure_JP5OB9LUA02PwG4Yf5p1Eg" contextRef="Duration_6_13_2022_To_6_13_2022_us-gaap_DebtInstrumentAxis_mdrr_WellFargoLineOfCreditMember_HqXhCoF3k0i0V0xskKnTxg" decimals="4" format="ixt:numdotdecimal" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" scale="-2" id="Narr_6GmS0zEIrkew5cdQszWbJg">2.25</ix:nonFraction>% above daily SOFR. &#160;As of March&#160;31,&#160;2024 and December&#160;31,&#160;2023, SOFR was <ix:nonFraction unitRef="Unit_Standard_pure_JP5OB9LUA02PwG4Yf5p1Eg" contextRef="As_Of_3_31_2024_us-gaap_DebtInstrumentAxis_mdrr_WellFargoLineOfCreditMember_us-gaap_VariableRateAxis_us-gaap_SecuredOvernightFinancingRateSofrOvernightIndexSwapRateMember_egI7ypvFNk-8ZixD6ma8DA" decimals="4" format="ixt:numdotdecimal" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_951aExkOa0GGQjuwHNlBXQ">5.33</ix:nonFraction>% and <ix:nonFraction unitRef="Unit_Standard_pure_JP5OB9LUA02PwG4Yf5p1Eg" contextRef="As_Of_12_31_2023_us-gaap_DebtInstrumentAxis_mdrr_WellFargoLineOfCreditMember_us-gaap_VariableRateAxis_us-gaap_SecuredOvernightFinancingRateSofrOvernightIndexSwapRateMember_DEDDFT2DckyO6EwmVxGxOg" decimals="4" format="ixt:numdotdecimal" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_u4qRb3N-K0uFhwIxujQdjg">5.35</ix:nonFraction>%, respectively. &#160;The Wells Fargo Line of Credit is secured by the Lancer Center Property, the Greenbrier Business Center Property and the Salisbury Marketplace Property, has a <ix:nonNumeric contextRef="Duration_6_13_2022_To_6_13_2022_us-gaap_DebtInstrumentAxis_mdrr_WellFargoLineOfCreditMember_HqXhCoF3k0i0V0xskKnTxg" format="ixt-sec:durwordsen" name="us-gaap:DebtInstrumentTerm" id="Narr_LZjBN-FX3U27dwhJwoM-9Q">one-year</ix:nonNumeric> term, is unconditionally guaranteed by the Company, and any outstanding balances are due on the June 9, 2024 maturity date. &#160;The Company is currently in discussions with Wells Fargo to extend the maturity date of Wells Fargo Line of Credit, but there can be no assurance that it will be successful. &#160;</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;font-weight:bold;margin:0pt 0pt 8pt 0pt;">Interest expense</p><p style="font-fam