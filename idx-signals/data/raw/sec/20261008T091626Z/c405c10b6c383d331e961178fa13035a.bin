i','Helvetica','sans-serif';font-size:11pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:29.89%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">October 21, 2023 - January 20, 2024</p></td></tr><tr><td style="vertical-align:bottom;white-space:nowrap;width:29.9%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">April 25, 2024</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.64%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-family:'Calibri','Helvetica','sans-serif';font-size:11pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:20.17%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">April 22, 2024</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.64%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-family:'Calibri','Helvetica','sans-serif';font-size:11pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.65%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-family:'Calibri','Helvetica','sans-serif';font-size:11pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.44%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_USD_shares_oqoAh1iy2UGxOWXMFrn7FQ" contextRef="Duration_4_25_2024_To_4_25_2024_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_FGv8uJco0ESxnpl_Y5rJUQ" decimals="2" format="ixt:numdotdecimal" name="us-gaap:PreferredStockDividendsPerShareCashPaid" scale="0" id="Tc_VmRzZKO4PkK_a-gedIyEeQ_19_5">0.50</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.63%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-family:'Calibri','Helvetica','sans-serif';font-size:11pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:29.89%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">January 21, 2024 - April 21, 2024</p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;text-indent:36pt;margin:0pt 0pt 12pt 0pt;"><span style="font-weight:normal;">As of March&#160;31,&#160;2024 and December&#160;31,&#160;2023, the Company recorded </span><span style="font-weight:normal;">$<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="As_Of_3_31_2024_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_9eWI5XzLn06ShsPrE-lMqA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DividendsPayableCurrentAndNoncurrent" scale="0" id="Narr_xMnae2mJ7k-6BkPglkAL4w">70,004</ix:nonFraction></span><span style="font-weight:normal;"> and </span><span style="font-weight:normal;">$<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="As_Of_12_31_2023_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_Iml8zdNOEUya2xkkC5r_vw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DividendsPayableCurrentAndNoncurrent" scale="0" id="Narr_wFJZ6fSIl0yx-1JLoQn_Ow">70,004</ix:nonFraction></span><span style="font-weight:normal;">, respectively, in accrued but unpaid dividends on the mandatorily redeemable preferred stock. This amount is reported in accounts payable and accrued liabilities on the Company&#8217;s condensed consolidated balance sheets. &#160;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">The mandatorily redeemable preferred stock was issued at $<ix:nonFraction unitRef="Unit_Divide_USD_shares_oqoAh1iy2UGxOWXMFrn7FQ" contextRef="As_Of_2_19_2020_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_PLb3bWuvGkajlSGjUBQ4cQ" decimals="2" format="ixt:numdotdecimal" name="us-gaap:SharesIssuedPricePerShare" scale="0" id="Narr_KF3yJA_wSE2QnctRFys0MA">23.00</ix:nonFraction> per share, a $<ix:nonFraction unitRef="Unit_Divide_USD_shares_oqoAh1iy2UGxOWXMFrn7FQ" contextRef="Duration_2_19_2020_To_2_19_2020_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_JwnJzDsYxkafL14vQY6BXw" decimals="2" format="ixt:numdotdecimal" name="mdrr:StockIssuedDuringPeriodDiscountPerShareNewIssues" scale="0" id="Narr_AgiNv7AxPEC9dEAOB4wqLg">2.00</ix:nonFraction> per share discount. The total discount of $<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="As_Of_2_19_2020_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_PLb3bWuvGkajlSGjUBQ4cQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:PreferredStockDiscountOnShares" scale="0" id="Narr_T757-Vc8zkeknnXcU9ISoA">400,000</ix:nonFraction> is being amortized over the <ix:nonNumeric contextRef="Duration_2_19_2020_To_2_19_2020_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_JwnJzDsYxkafL14vQY6BXw" format="ixt-sec:durwordsen" name="mdrr:PreferredStockDiscountAmortizationPeriod" id="Narr_AJ-oQuQoWkeXXhsCfk3BYA">five-year</ix:nonNumeric> life of the shares using the effective interest method. Additionally, the Company incurred $<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="Duration_2_19_2020_To_2_19_2020_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_JwnJzDsYxkafL14vQY6BXw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:LegalFees" scale="0" id="Narr_DAEbGgvh8EmvUSVe3rjJRw">739,118</ix:nonFraction> in legal, accounting, other professional fees and underwriting discounts related to this offering. These costs were recorded as deferred financing costs on the accompanying condensed consolidated balance sheets as a direct deduction from the carrying amount of the mandatorily redeemable preferred stock liability and are being amortized using the effective interest method over the term of the agreement.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:justify;text-indent:36pt;margin:0pt 0pt 12pt 0pt;"><span style="font-weight:normal;">Amortization of the discount and deferred financing costs related to the mandatorily redeemable preferred stock totaling </span><span style="font-weight:normal;background:#ffffff;">$<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="Duration_1_1_2024_To_3_31_2024_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_ZPiaEdhh9k-jfoeYa8kQ1g" decimals="0" format="ixt:numdotdecimal" name="mdrr:AmortizationOfDiscountAndDeferredFinancingCostsOnMandatorilyRedeemablePreferredStock" scale="0" id="Narr_Qy74tAfjhE6PdgnCiJLm9Q">64,126</ix:nonFraction></span><span style="font-weight:normal;background:#ffffff;">&#160;and&#160;</span><span style="font-weight:normal;background:#ffffff;">$<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="Duration_1_1_2023_To_3_31_2023_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_1bvaXfO2ukOPhu_qTD-JTw" decimals="0" format="ixt:numdotdecimal" name="mdrr:AmortizationOfDiscountAndDeferredFinancingCostsOnMandatorilyRedeemablePreferredStock" scale="0" id="Narr_HueErLOgLkGlWz44R8LPVg">58,804</ix:nonFraction></span><span style="font-weight:normal;background:#ffffff;">&#160;was included in interest expense for the three months ended March&#160;31,&#160;2024 and 2023, respectively, in the accompany</span><span style="font-weight:normal;">ing condensed consolidated statements of operations. Accumulated amortization of the discount and deferred financing costs was </span><span style="font-weight:normal;">$<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="As_Of_3_31_2024_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_9eWI5XzLn06ShsPrE-lMqA" decimals="0" format="ixt:numdotdecimal" name="mdrr:AccumulatedAmortizationOfDiscountAndDeferredFinancingCostsOnMandatorilyRedeemablePreferredStock" scale="0" id="Narr_Uhx5JFCUi0aHR0nqdl6eVw">896,819</ix:nonFraction></span><span style="font-weight:normal;"> and </span><span style="font-weight:normal;">$<ix:nonFraction unitRef="Unit_Standard_USD_DIRRZ6XS10yefRwM8kFSJw" contextRef="As_Of_12_31_2023_us-gaap_ScheduleOfSharesSubjectToMandatoryRedemptionBySettlementTermsAxis_us-gaap_CumulativePreferredStockSubjectToMandatoryRedemptionMember_Iml8zdNOEUya2xkkC5r_vw" decimals="0" format="ixt:numdotdecimal" name="mdrr:AccumulatedAmortizationOfDiscountAndDeferredFinancingCostsOnMandatorilyRedeemablePreferredStock" scale="0" id="Narr_YCVRkNPi7UqYNjApVgEotQ">832,693</ix:nonFraction></span><span style="font-weight:normal;"> as of March&#160;31,&#160;2024 and December&#160;31,&#160;2023, respectively.</span></p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">21</p></div></div>
