<ix:nonNumeric contextRef="From2024-09-01to2025-05-31" escape="true" id="Fact000676" name="PAPLF:ScheduleOfCommonSharePurchaseWarrantTableTextBlock"><p id="xdx_89F_ecustom--ScheduleOfCommonSharePurchaseWarrantTableTextBlock_zCMHBCVMqkfh" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span><span id="xdx_8B4_zYcg3ISDqf99" style="display: none">Schedule of common share purchase warrant</span></p>

