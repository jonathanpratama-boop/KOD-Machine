    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c5" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DeferredTaxAssetsOperatingLossCarryforwards" scale="0" unitRef="usd" id="ixv-30408">414,904</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
