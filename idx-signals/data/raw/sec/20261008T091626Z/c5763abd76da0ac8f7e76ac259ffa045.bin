    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right">(<ix:nonFraction contextRef="c18" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest" scale="0" sign="-" unitRef="usd" id="ixv-30402">8,312,576</ix:nonFraction></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">)</td><td style="font-weight: bold; padding-bottom: 4pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right">(<ix:nonFraction contextRef="c19" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest" scale="0" sign="-" unitRef="usd" id="ixv-30403">6,526,322</ix:nonFraction></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">)</td></tr>
