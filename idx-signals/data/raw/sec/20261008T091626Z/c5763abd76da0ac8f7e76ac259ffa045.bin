    <td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="width: 9%; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction contextRef="c18" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DisposalGroupIncludingDiscontinuedOperationRevenue" scale="0" unitRef="usd" id="ixv-30169">2,429,726</ix:nonFraction></span></td><td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="width: 1%"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="width: 9%; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction contextRef="c19" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DisposalGroupIncludingDiscontinuedOperationRevenue" scale="0" unitRef="usd" id="ixv-30170">3,225,505</ix:nonFraction></span></td><td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
  <tr style="vertical-align: bottom; ">
