    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c19" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:BusinessAcquisitionsProFormaRevenue" scale="0" unitRef="usd" id="ixv-30209">13,969</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
