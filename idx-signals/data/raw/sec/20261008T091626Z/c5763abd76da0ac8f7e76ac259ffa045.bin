    <td style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center"><span style="font-family: Times New Roman, Times, Serif">December&#160;31,<br/>
    2025</span></td><td style="font-weight: bold; padding-bottom: 1.5pt"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center"><span style="font-family: Times New Roman, Times, Serif">December&#160;31,<br/>
    2024</span></td><td style="font-weight: bold; padding-bottom: 1.5pt"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: center"><span style="font-family: Times New Roman, Times, Serif">December&#160;31,<br/>
    2023</span></td></tr>
  <tr style="vertical-align: bottom; ">
