    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction contextRef="c5" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:FinancingReceivableAllowanceForCreditLosses" scale="0" unitRef="usd" id="ixv-30248">2,740</ix:nonFraction></span></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
