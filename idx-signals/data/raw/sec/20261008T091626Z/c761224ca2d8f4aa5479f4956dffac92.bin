    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c80" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" scale="0" unitRef="shares" id="ixv-7140">450,000</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
