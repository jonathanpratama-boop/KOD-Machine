    <td style="border-bottom: Black 4pt double; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c92" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:BusinessAcquisitionEquityInterestsIssuedOrIssuableNumberOfSharesIssued" scale="0" unitRef="shares" id="ixv-7166">1,635,342</ix:nonFraction></td><td style="padding-bottom: 2.5pt; text-align: left">&#160;</td></tr>
  </table></ix:nonNumeric>


<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify; ">&#160;&#160;&#160;</p>

<ix:nonNumeric contextRef="c0" escape="true" name="us-gaap:ScheduleOfCommonStockOutstandingRollForwardTableTextBlock" id="ixv-4272"><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify; ">The number of Predecessor
HBC shares was determined as follows:</p>

<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify; ">&#160;</p>

<table cellpadding="0" style="border-collapse: collapse; width: 100%; font: 10pt Times New Roman, Times, Serif; border-spacing: 0px;">
