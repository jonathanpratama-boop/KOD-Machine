  <tr style="vertical-align: bottom; ">
    <td style="text-align: left; text-indent: -9pt; padding-left: 9pt">Net cash received from NUBI Trust</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><div style="-sec-ix-hidden: hidden-fact-127">-</div></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left; text-indent: -9pt; padding-left: 9pt">Add: cash from NUBI operating account</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c88" decimals="0" format="ixt:num-dot-decimal" name="sti:CashFromNUBIOperatingAccount" scale="0" sign="-" unitRef="usd" id="ixv-7158">17,555</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; ">
    <td style="text-align: left; text-indent: -9pt; padding-left: 9pt">Add: prepaid expenses</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c88" decimals="0" format="ixt:num-dot-decimal" name="sti:PrepaidExpensesofReverseRecapitalization" scale="0" sign="-" unitRef="usd" id="ixv-7159">165,407</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left; text-indent: -9pt; padding-left: 9pt">Less: derivative liabilities</td><td>&#160;</td>
