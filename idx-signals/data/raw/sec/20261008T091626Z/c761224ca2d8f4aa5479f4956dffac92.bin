    <td style="text-align: left">$</td><td style="text-align: right"><ix:nonFraction contextRef="c0" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:StockIssued1" scale="0" unitRef="usd" id="ixv-7017">414</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
