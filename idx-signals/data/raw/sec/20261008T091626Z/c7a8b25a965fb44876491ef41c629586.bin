            <td style="padding:3.5pt 0pt 1.5pt 0pt; min-width:3.75pt; text-align:right; ">$</td>
            <td style="padding:3.5pt 0pt 1.5pt 0pt; min-width:17.25pt; text-align:right; white-space:nowrap;">11.50</td>
            <td style="padding:0pt;padding-left:0.209999999999999pt;width:0pt;">&#8203;</td>
