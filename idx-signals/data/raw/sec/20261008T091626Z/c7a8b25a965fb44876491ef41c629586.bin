            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:3.25pt 0pt 1.5pt 0pt; width:96pt;">
              <font style="letter-spacing:0.2pt;">Amortized cost </font>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:3.25pt 0pt 1.5pt 0pt; width:96pt;">
              <font style="letter-spacing:0.2pt;">Amortized cost </font>
            </td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
          </tr>
