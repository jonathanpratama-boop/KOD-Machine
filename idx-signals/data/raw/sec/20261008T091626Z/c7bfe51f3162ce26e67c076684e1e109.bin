    <TD STYLE="border-bottom: Black 1pt solid; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1pt solid; text-align: right">51,709</TD><TD STYLE="padding-bottom: 1pt; text-align: left">&nbsp;</TD><TD STYLE="padding-bottom: 1pt">&nbsp;</TD>
    <TD STYLE="border-bottom: Black 1pt solid; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1pt solid; text-align: right">0.06</TD><TD STYLE="padding-bottom: 1pt; text-align: left">%</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: White">
