  <tr>

    <td style="width: 18pt; vertical-align: top; font-weight: bold;">(4)</td>

    <td style="width: auto; vertical-align: top;">
              <div style="font-weight: bold;">Cash and Cash Equivalents</div>
            </td>

  </tr>


</table>
</ix:nonNumeric>
      <ix:continuation id="Text_0432a89afda645abbc90e6647e2289d51" continuedAt="Text_0432a89afda645abbc90e6647e2289d52">
<div>&#160;</div>
</ix:continuation>
      <ix:continuation id="Text_0432a89afda645abbc90e6647e2289d52">
<div><span style="background-color: rgb(255, 255, 255); font-weight: normal; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-variant: normal; text-transform: none;">As of December 31, 2022 and 2021,
          money market funds included in cash and cash equivalents on the balance sheets were $<ix:nonFraction name="us-gaap:CashAndCashEquivalentsFairValueDisclosure" id="Fact_67666a07c5f94c718be6ac2c725528d4" contextRef="c20221231_FairValueByAssetClassAxis_MoneyMarketFundsMember_FairValueByFairValueHierarchyLevelAxis_FairValueInputsLevel1Member" unitRef="U001" decimals="0" scale="0" format="ixt:num-dot-decimal">12,553,557</ix:nonFraction> and $<ix:nonFraction name="us-gaap:CashAndCashEquivalentsFairValueDisclosure" id="Fact_b3549977508049eaa8c655349f272fb5" contextRef="c20211231_FairValueByAssetClassAxis_MoneyMarketFundsMember_FairValueByFairValueHierarchyLevelAxis_FairValueInputsLevel1Member" unitRef="U001" decimals="0" scale="0" format="ixt:num-dot-decimal">24,388,443</ix:nonFraction>, respectively, which represent Level 1 within the fair value hierarchy (see note 3).</span></div>
</ix:continuation>

      <div>&#160;</div>

      <div style="clear: both; margin-top: 10pt; margin-bottom: 10pt;" class="BRPFPageBreakArea">
        <div style="text-align: center;" class="BRPFPageNumberArea"><span style="font-family: 'Times New Roman'; font-size: 8pt; font-weight: normal; font-style: normal;">20</span></div>

