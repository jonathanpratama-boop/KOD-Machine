      <ix:continuation id="Text_db154650a5544158865d1fb33a659ecc5"><ix:continuation id="Text_4ff0dddd8a2f44dfa8d7e9c6e7493d8516" continuedAt="Text_4ff0dddd8a2f44dfa8d7e9c6e7493d8517">
<div style="font-weight: normal; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-variant: normal; text-transform: none;"><span style="font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; text-align: left; text-indent: 0px; white-space: normal; word-spacing: 0px; text-decoration-style: initial; text-decoration-color: initial; display: inline ! important; float: none;">The Company has prepared the
          accompanying financial statements pursuant to the rules and regulations of the U.S. Securities and Exchange Commission (SEC).</span></div>
</ix:continuation></ix:continuation><ix:continuation id="Text_4ff0dddd8a2f44dfa8d7e9c6e7493d8517" continuedAt="Text_4ff0dddd8a2f44dfa8d7e9c6e7493d8518">
