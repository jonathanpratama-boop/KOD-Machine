      <ix:continuation id="Text_236d690998bc4d1db00fe7c23565535284" continuedAt="Text_236d690998bc4d1db00fe7c23565535285"><ix:continuation id="Text_85d1babbe44a4a209837db9a9fa49f4a6">
<div style="margin-left: 36pt; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-variant: normal; text-transform: none;">Amortization expense for intangible assets for the years ended December 31, 2022 and
        2021 was $<ix:nonFraction name="us-gaap:AmortizationOfIntangibleAssets" id="Fact_8bc00c7e8d03438fad6ed1fc648efc0f" contextRef="c20220101to20221231" unitRef="U001" decimals="0" scale="0" format="ixt:num-dot-decimal">21,799</ix:nonFraction> and $<ix:nonFraction name="us-gaap:AmortizationOfIntangibleAssets" id="Fact_09e26fd93aa541839c3a152eba9ff7d5" contextRef="c20210101to20211231" unitRef="U001" decimals="0" scale="0" format="ixt:num-dot-decimal">39,976</ix:nonFraction>,
        respectively. Amortization expense related to intangible assets is expected to be $<ix:nonFraction name="us-gaap:FiniteLivedIntangibleAssetsAmortizationExpenseNextTwelveMonths" id="Fact_8c86d7478eae4157bad798d2093df459" contextRef="c20221231" unitRef="U001" decimals="0" scale="0" format="ixt:num-dot-decimal">3,294</ix:nonFraction> for the year ended December 31, 2023.</div>
</ix:continuation></ix:continuation>

