<div><span style="color: rgb(0, 0, 0); font-size: 10pt; font-variant: normal; text-transform: none;"> <span style="font-weight: normal; font-family: 'Times New Roman'; font-style: normal;"> </span></span>
      <span style="color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-variant: normal; text-transform: none;"><span style="font-weight: normal; color: rgb(0, 0, 0); font-size: 10pt; font-variant: normal; text-transform: none;"> </span></span><span style="color: rgb(0, 0, 0); font-size: 10pt; font-variant: normal; text-transform: none;"> </span></div>
</ix:continuation></ix:nonNumeric></ix:continuation>
      <ix:continuation id="Text_285b295ebd24481786fd49919d27b67913" continuedAt="Text_285b295ebd24481786fd49919d27b67914"><ix:continuation id="Text_63e9739f74e24d8fbf9872422e86c8be1" continuedAt="Text_63e9739f74e24d8fbf9872422e86c8be2"><ix:continuation id="Text_236d690998bc4d1db00fe7c23565535249" continuedAt="Text_236d690998bc4d1db00fe7c23565535250">
<div style="margin-top: 0px; margin-bottom: 0px; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: normal; text-transform: none; margin-left: 36pt;">Inventory stated at cost,
        net of reserve, consisted of the following as of December 31:</div>
</ix:continuation></ix:continuation></ix:continuation>
      <ix:continuation id="Text_285b295ebd24481786fd49919d27b67914" continuedAt="Text_285b295ebd24481786fd49919d27b67915"><ix:continuation id="Text_63e9739f74e24d8fbf9872422e86c8be2" continuedAt="Text_63e9739f74e24d8fbf9872422e86c8be3"><ix:continuation id="Text_236d690998bc4d1db00fe7c23565535250" continuedAt="Text_236d690998bc4d1db00fe7c23565535251">
