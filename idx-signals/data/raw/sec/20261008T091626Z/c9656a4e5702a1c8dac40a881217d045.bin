    <td style="width: 18pt; vertical-align: top; font-style: italic; font-weight: bold; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-variant: normal; text-transform: none;">(f)</td>

    <td style="width: auto; vertical-align: top;">
