      <ix:continuation id="Text_236d690998bc4d1db00fe7c23565535297" continuedAt="Text_236d690998bc4d1db00fe7c23565535298"><ix:continuation id="Text_10ff0c5a74d84280aa12e11c808a7eb11" continuedAt="Text_10ff0c5a74d84280aa12e11c808a7eb12">
<div style="color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-variant: normal; text-transform: none;">&#160;</div>
</ix:continuation></ix:continuation>
      <ix:continuation id="Text_236d690998bc4d1db00fe7c23565535298" continuedAt="Text_236d690998bc4d1db00fe7c23565535299"><ix:continuation id="Text_10ff0c5a74d84280aa12e11c808a7eb12" continuedAt="Text_10ff0c5a74d84280aa12e11c808a7eb13">
<div style="margin-left: 36pt; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-variant: normal; text-transform: none;">Accrued clinical trial expenses include research and development costs for
        third-party services, largely related to the Company&#8217;s clinical trials, that are estimated based upon the services provided but not yet invoiced. These costs, at times, may be a significant component of the research and development expenses and the
        Company makes estimates in determining the accrued expense each period.&#160; As actual costs become known, the Company adjusts its accrual. <span style="font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; text-align: left; text-indent: 0px; white-space: normal; word-spacing: 0px; text-decoration-style: initial; text-decoration-color: initial; display: inline ! important; float: none;">Accrued other expenses include director fees, sales
          taxes and other accrued expenses.</span></div>
</ix:continuation></ix:continuation>
      <ix:continuation id="Text_236d690998bc4d1db00fe7c23565535299" continuedAt="Text_236d690998bc4d1db00fe7c235655352100"><ix:continuation id="Text_10ff0c5a74d84280aa12e11c808a7eb13" continuedAt="Text_10ff0c5a74d84280aa12e11c808a7eb14">
<div style="color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-variant: normal; text-transform: none;">&#160;</div>
</ix:continuation></ix:continuation>

