    <td style="width: 18pt; vertical-align: top; font-style: normal; font-weight: normal; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-variant: normal; text-transform: none;">(iii)</td>

    <td style="width: auto; vertical-align: top;">
              <div style="font-style: normal; font-weight: bold; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-variant: normal; text-transform: none;">Dividend Yield</div>
