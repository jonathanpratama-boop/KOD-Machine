    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 14%; text-align: right">0.70</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 2%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 14%; text-align: right">1,200,000</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD></TR>
