		<P CLASS="Text_flush" STYLE="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:0;margin-top:8pt;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:0;widows:3;margin-top:8pt;">July&#x00a0;24, 2023</P>
