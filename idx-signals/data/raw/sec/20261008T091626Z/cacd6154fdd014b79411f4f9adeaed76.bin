    <td style="padding-right: 5.4pt; padding-left: 5.4pt; text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">1,354</span></td>
    <td style="padding-right: 5.4pt; padding-left: 5.4pt; text-align: center">&#160;</td>
