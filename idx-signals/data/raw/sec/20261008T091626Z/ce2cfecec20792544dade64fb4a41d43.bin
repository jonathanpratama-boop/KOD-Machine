                <div style="white-space:nowrap;">
                  <font style="letter-spacing:0.2pt;">Withholding tax at tax treaty rate of 5% </font>
                </div>
              </td>
              <td style="padding:0pt; width:6pt;">&#8203;</td>
              <td style="padding:0pt; width:6pt;">&#8203;</td>
              <td style="padding:0pt;padding-left:0pt;width:0pt;">&#8203;</td>
