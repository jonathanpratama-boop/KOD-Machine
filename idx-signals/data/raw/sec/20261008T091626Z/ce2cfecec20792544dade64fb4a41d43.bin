            <td style="padding:3.25pt 0pt 1.5pt 0pt; width:428.87pt;text-align:left;">
              <div style="white-space:nowrap;">
                <font style="letter-spacing:0.2pt;">Public offering price </font> </div>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
