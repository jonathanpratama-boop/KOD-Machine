    <td style="border-top: rgb(0, 0, 0) 1px solid; width: 13.85%; vertical-align: middle; border-left: rgb(0, 0, 0) 1px solid">
        <div style="text-align: center; line-height: 1.25">94.12% (16/17)</div> </td>
    <td style="border-top: rgb(0, 0, 0) 1px solid; width: 16.75%; vertical-align: middle; border-left: rgb(0, 0, 0) 1px solid">
