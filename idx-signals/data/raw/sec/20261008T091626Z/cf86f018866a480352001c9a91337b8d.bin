                      </table>
                    </div>
                    <div style="line-height:1.25;font-family:'Times New Roman',Times,serif;clear:both">&#160;</div>
                    <table cellpadding="0" cellspacing="0" style="font-family:'Times New Roman', Times, serif;font-size:10pt;width:100%;text-align:left;color:#000000">

                        <tr>
                          <td style="width:85.05pt;font-family:'Times New Roman',Times,serif">&#160;</td>
                          <td style="width:28.35pt;vertical-align:top;font-family:'Times New Roman',Times,serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">*)</span></span></td>
                          <td style="width:auto;vertical-align:top;text-align:justify;font-family:'Times New Roman',Times,serif">
                            <div><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">The Company does not hold directly interest or voting rights in Focus. The Company's wholly-owned subsidiary holds an option to buy the ownership of the <ix:nonFraction id="Fxbrl_20230327200414092" name="ifrs-full:ProportionOfOwnershipInterestInSubsidiary" contextRef="C_20230101to20231231_ifrsfullSignificantInvestmentsInSubsidiariesAxis_imcFocusMedicalHerbsLtdMember" unitRef="Percentage" scale="-2" decimals="2" format="ixt:num-dot-decimal">74</ix:nonFraction>% of Focus shares. According to accounting criteria in IFRS 10, the Company is viewed as effectively exercising control over Focus, and therefore, the accounts of Focus are consolidated with those of the Company (see also note 26).</span></span></div>
                          </td>
                        </tr>

                    </table>
                    <div style="line-height:1.25;font-family:'Times New Roman',Times,serif">&#160;</div>
                    <table cellpadding="0" cellspacing="0" style="font-family:'Times New Roman', Times, serif;font-size:10pt;width:100%;text-align:left;color:#000000">

                        <tr>
                          <td style="width:85.05pt;font-family:'Times New Roman',Times,serif">&#160;</td>
                          <td style="width:28.35pt;vertical-align:top;font-family:'Times New Roman',Times,serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">**)</span></span></td>
                          <td style="width:auto;vertical-align:top;text-align:justify;font-family:'Times New Roman',Times,serif">
                            <div><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">Deconsolidated effective November 7, 2022, when Trichome filed to commence proceedings under the Companies&#8217; Creditors Arrangement Act (CCAA) (see Note 1).</span></span></div>
                          </td>
                        </tr>

                    </table>
                    <div style="line-height:1.25;font-family:'Times New Roman',Times,serif">&#160;</div>
                    <table cellpadding="0" cellspacing="0" style="font-family:'Times New Roman', Times, serif;font-size:10pt;width:100%;text-align:left;color:#000000">

                        <tr>
                          <td style="width:85.05pt;font-family:'Times New Roman',Times,serif">&#160;</td>
                          <td style="width:28.35pt;vertical-align:top;font-family:'Times New Roman',Times,serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">***)</span></span></td>
                          <td style="width:auto;vertical-align:top;text-align:justify;font-family:'Times New Roman',Times,serif">
                            <div><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">Dissolved as of December 31, 2023.</span></span></div>
                          </td>
                        </tr>

                    </table>
                  </div>
                </ix:nonNumeric>
