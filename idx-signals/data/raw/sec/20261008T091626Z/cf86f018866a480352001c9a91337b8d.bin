                            <div style="text-align:justify;line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">Customer relationship</span></span></div>
                          </td>
                          <td colspan="1" style="font-family:'Times New Roman',Times,serif;vertical-align:bottom;width:1.04%;background-color:rgb(204, 238, 255);vertical-align:bottom">&#160;</td>
