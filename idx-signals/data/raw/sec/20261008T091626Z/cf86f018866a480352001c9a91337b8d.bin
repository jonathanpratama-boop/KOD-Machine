                <div>
                  <div style="clear:both;margin-top:10pt;margin-bottom:0pt"><div style="text-align:center"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:10pt"><span>F - </span>18</span></span></div><hr style="border-width:0px;clear:both;margin:4px 0px;width:100%;height:2px;color:#000000;background-color:#000000;margin-bottom:10pt;page-break-after:always;margin-top:5pt;margin-bottom:10pt"/></div><div style="line-height:1.25"><div style="text-align:right;text-indent:18.25pt;margin-left:350.3pt;line-height:1.25;font-family:Times New Roman, Times, serif"><div><div style="line-height:1.25;font-family:Times New Roman, Times, serif;font-weight:bold;margin-top:10pt"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><span><strong>IM CANNABIS CORP. AND ITS SUBSIDIARIES</strong></span></span></span><p style="margin:0pt">&#160;</p></div></div></div><div style="line-height:1.25"><div style="text-align:justify;line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><span><strong>NOTES TO CONSOLIDATED FINANCIAL STATEMENTS</strong></span></span></span></div><div style="text-align:justify;line-height:1.25"><hr style="height:2px;color:#000000;background-color:#000000;text-align:center;margin-left:auto;margin-right:auto;border:none;margin-top:5pt;margin-bottom:5pt;text-align:center"/></div></div><div style="text-align:justify;line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><span><strong>Canadian Dollars in thousands, except share and per share data</strong></span></span></span></div></div><p style="margin-top:0pt;margin-bottom:0pt;font-family:Times New Roman,Times,serif;text-align:left">&#160;</p>
                </div>
              </div>
              <div style="text-align:justify;line-height:1.25">
                <table border="0" cellpadding="0" cellspacing="0" style="font-size:10pt;font-family:Times New Roman, Times, serif;width:100%;border:0px">

                    <tr>
                      <td style="font-size:10pt;vertical-align:top;width:56.7pt">
                        <p style="margin-top:0pt;margin-bottom:0pt;font-size:10pt;font-family:Times New Roman, Times, serif"><span style="font-size:10pt;font-family:Times New Roman, Times, serif;font-weight:bold">NOTE 2:-</span></p>
                      </td>
                      <td style="font-size:10pt;width:auto">
                        <p style="font-size:10pt;font-family:Times New Roman, Times, serif;margin-top:0pt;margin-bottom:0pt"><strong>SIGNIFICANT ACCOUNTING POLICIES (Cont.)</strong></p>
                      </td>
                    </tr>
                    <tr>
                      <td style="font-size:10pt;vertical-align:top;width:56.7pt">&#160;</td>
                      <td style="font-size:10pt;width:auto">&#160;</td>
                    </tr>

                </table>
