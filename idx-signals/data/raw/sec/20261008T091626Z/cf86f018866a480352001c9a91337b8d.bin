                    <td colspan="1" style="font-family:'Times New Roman',Times,serif;vertical-align:bottom;text-align:right;width:9%;border-bottom:4px double rgb(0, 0, 0);background-color:rgb(204, 238, 255);vertical-align:bottom">
                      <div style="line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><ix:nonFraction id="Fxbrl_20220331142226473" name="ifrs-full:NumberOfOtherEquityInstrumentsExercisableInSharebasedPaymentArrangement" contextRef="C_20231231_ifrsfullComponentsOfEquityAxis_imcRestrictedShareUnitMember" unitRef="Shares" scale="0" decimals="0" format="ixt:fixed-zero">-</ix:nonFraction></span></span></div>
