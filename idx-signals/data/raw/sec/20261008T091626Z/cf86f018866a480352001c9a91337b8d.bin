    <td style="width: auto; vertical-align: top; text-align: justify">
        <div>Itay Vago, former CFO of the Company;</div> </td> </tr>
  </table>

<div style="line-height: 1.25">&#160;</div>

<table cellspacing="0" cellpadding="0" id="z9b9ac66cef014aa1bf6c28f2955ba8a8" class="DSPFListTable" style="font: 10pt Times New Roman, Times, serif; width: 100%; text-align: left; color: #000000">
  <tr>
    <td style="width: 18pt"><br/> </td>
    <td style="width: 18pt; vertical-align: top">(4)</td>
    <td style="width: auto; vertical-align: top; text-align: justify">
        <div>Shai Shemesh, former CFO of the Company;</div> </td> </tr>
  </table>

<div style="line-height: 1.25">&#160;</div>

<table cellspacing="0" cellpadding="0" id="zf2665997aaec400493fb69bd257ed365" class="DSPFListTable" style="font: 10pt Times New Roman, Times, serif; width: 100%; text-align: left; color: #000000">
  <tr>
    <td style="width: 18pt"><br/> </td>
    <td style="width: 18pt; vertical-align: top">(5)</td>
    <td style="width: auto; vertical-align: top; text-align: justify">
        <div>Marc Lustig, Executive Chairman and a director of the Company;</div> </td> </tr>
  </table>

<div style="line-height: 1.25">&#160;</div>

<table cellspacing="0" cellpadding="0" id="z199cb57c92404e2cbce362c8ca2e7cdb" class="DSPFListTable" style="font: 10pt Times New Roman, Times, serif; width: 100%; text-align: left; color: #000000">
  <tr>
    <td style="width: 18pt"><br/> </td>
    <td style="width: 18pt; vertical-align: top">(6)</td>
    <td style="width: auto; vertical-align: top; text-align: justify">
        <div>Eyal Fisher, CEO of the IMC Holdings and each of the Israeli Subsidiaries; and</div> </td> </tr>
