</div><div style="">
  <div>
    <ix:nonNumeric id="Fxbrl_20230327124030285" name="ifrs-full:DisclosureOfChangesInAccountingPoliciesAccountingEstimatesAndErrorsExplanatory" contextRef="C_20230101to20231231" escape="true">
      <div>
        <div>
          <div>
            <div style="text-align:justify;line-height:1.25">
              <table border="0" cellpadding="0" cellspacing="0" style="font-size:10pt;font-family:Times New Roman, Times, serif;width:100%">

                  <tr>
                    <td style="font-size:10pt;vertical-align:top;width:56.7pt">
                      <p style="font-size:10pt;font-family:Times New Roman, Times, serif;margin-top:0pt;margin-bottom:0pt"><span style="font-weight:bold">NOTE 2:-</span></p>
                    </td>
                    <td style="font-size:10pt;width:auto"><span style="font-size:10pt;font-weight:bold">SIGNIFICANT ACCOUNTING POLICIES</span></td>
                  </tr>

              </table>
            </div>
            <div style="line-height:1.25;font-family:'Times New Roman',Times,serif">&#160;</div>
            <div style="text-align:justify;line-height:1.25;font-family:Times New Roman, Times, serif;margin-left:56.7pt"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">The following accounting policies have been applied consistently in the financial statements for all periods presented, unless otherwise stated.</span></span></div>
            <div style="text-align:justify;line-height:1.25;font-family:Times New Roman, Times, serif;margin-left:56.7pt">&#160;</div>
            <ix:nonNumeric id="Fxbrl_20220329175807659" name="imc:DescriptionOfAccountingPolicyForBasisOfPresentationExplanatory" contextRef="C_20230101to20231231" escape="true">
              <div>
                <table cellpadding="0" cellspacing="0" style="font-family:'Times New Roman', Times, serif;font-size:10pt;width:100%;text-align:left;color:#000000">

                    <tr>
                      <td style="width:56.7pt;font-family:'Times New Roman',Times,serif">&#160;</td>
                      <td style="width:28.35pt;vertical-align:top;font-family:'Times New Roman',Times,serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">a.</span></span></td>
                      <td style="width:auto;vertical-align:top;text-align:justify;font-family:'Times New Roman',Times,serif">
                        <div><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">Basis of presentation:</span></span></div>
                      </td>
                    </tr>

                </table>
                <div style="line-height:1.25;font-family:'Times New Roman',Times,serif">&#160;</div>
                <div style="text-align:justify;margin-left:85.05pt;line-height:1.25;font-family:'Times New Roman',Times,serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">The consolidated financial statements of the Group have been prepared in accordance with International Financial Reporting Standards ("IFRS"), as issued by the International Accounting Standards Board ("IASB").</span></span></div>
                <div style="line-height:1.25;font-family:'Times New Roman',Times,serif">&#160;</div>
                <div style="text-align:justify;margin-left:85.05pt;line-height:1.25;font-family:'Times New Roman',Times,serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">The Group's financial statements have been prepared on a cost basis, except for:</span></span></div>
                <div style="line-height:1.25;font-family:'Times New Roman',Times,serif">&#160;</div>
                <table cellpadding="0" cellspacing="0" style="font-family:'Times New Roman', Times, serif;font-size:10pt;width:100%;text-align:left;color:#000000">

                    <tr>
                      <td style="width:85.05pt;font-family:'Times New Roman',Times,serif">&#160;</td>
                      <td style="width:28.35pt;vertical-align:top;font-family:'Times New Roman',Times,serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">-</span></span></td>
                      <td style="width:auto;vertical-align:top;text-align:justify;font-family:'Times New Roman',Times,serif">
                        <div><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">Financial instruments which are presented at fair value through profit or loss.</span></span></div>
                      </td>
                    </tr>

                </table>
                <table cellpadding="0" cellspacing="0" style="font-family:'Times New Roman', Times, serif;font-size:10pt;width:100%;text-align:left;color:#000000">

                    <tr>
                      <td style="width:85.05pt;font-family:'Times New Roman',Times,serif">&#160;</td>
                      <td style="width:28.35pt;vertical-align:top;font-family:'Times New Roman',Times,serif"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">-</span></span></td>
                      <td style="width:auto;vertical-align:top;text-align:justify;font-family:'Times New Roman',Times,serif">
                        <div><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">Biological assets which are presented at fair value less cost to sell up to the point of harvest.</span></span></div>
                      </td>
                    </tr>

                </table>
                <p style="margin-top:0pt;margin-bottom:0pt;font-family:Times New Roman,Times,serif;text-align:left">&#160;</p>
                <div><ix:exclude>
                  <div style="clear:both;margin-top:0pt;margin-bottom:0pt">
                    <div>
                      <div style="clear:both;margin-top:10pt;margin-bottom:0pt"><div style="text-align:center"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:10pt"><span>F - </span>16</span></span></div><hr style="border-width:0px;clear:both;margin:4px 0px;width:100%;height:2px;color:#000000;background-color:#000000;margin-bottom:10pt;page-break-after:always;margin-top:5pt;margin-bottom:10pt"/></div><div style="line-height:1.25"><div style="text-align:right;text-indent:18.25pt;margin-left:350.3pt;line-height:1.25;font-family:Times New Roman, Times, serif"><div><div style="line-height:1.25;font-family:Times New Roman, Times, serif;font-weight:bold;margin-top:10pt"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><span><strong>IM CANNABIS CORP. AND ITS SUBSIDIARIES</strong></span></span></span><p style="margin:0pt">&#160;</p></div></div></div><div style="line-height:1.25"><div style="text-align:justify;line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><span><strong>NOTES TO CONSOLIDATED FINANCIAL STATEMENTS</strong></span></span></span></div><div style="text-align:justify;line-height:1.25"><hr style="height:2px;color:#000000;background-color:#000000;text-align:center;margin-left:auto;margin-right:auto;border:none;margin-top:5pt;margin-bottom:5pt;text-align:center"/></div></div><div style="text-align:justify;line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif"><span><strong>Canadian Dollars in thousands, except share and per share data</strong></span></span></span></div></div><p style="margin-top:0pt;margin-bottom:0pt;font-family:Times New Roman,Times,serif;text-align:left">&#160;</p>
                    </div>
                  </div>
                  <div style="text-align:justify;line-height:1.25">
                    <table border="0" cellpadding="0" cellspacing="0" style="font-size:10pt;font-family:Times New Roman, Times, serif;width:100%;border:0px">

                        <tr>
                          <td style="font-size:10pt;vertical-align:top;width:56.7pt">
                            <p style="margin-top:0pt;margin-bottom:0pt;font-size:10pt;font-family:Times New Roman, Times, serif"><span style="font-weight:bold">NOTE 2:-</span></p>
                          </td>
                          <td style="font-size:10pt;width:auto">
                            <p style="font-size:10pt;font-family:Times New Roman, Times, serif;margin-top:0pt;margin-bottom:0pt"><strong>SIGNIFICANT ACCOUNTING POLICIES (Cont.)</strong></p>
