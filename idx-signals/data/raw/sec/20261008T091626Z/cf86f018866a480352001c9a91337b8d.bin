diariesAxis_imcTrichomeAssetFundingCorpMember" id="Fxbrl_20230308122448162" unitRef="Percentage" xsi:nil="true"/><ix:nonFraction name="ifrs-full:ProportionOfOwnershipInterestInSubsidiary" contextRef="C_20220101to20221231_ifrsfullSignificantInvestmentsInSubsidiariesAxis_imcTrichomeJwcAcquisitionCorpMember" id="Fxbrl_20230308122457614" unitRef="Percentage" xsi:nil="true"/><ix:nonFraction name="ifrs-full:ProportionOfOwnershipInterestInSubsidiary" contextRef="C_20220101to20221231_ifrsfullSignificantInvestmentsInSubsidiariesAxis_imcTrichomeRetailCorpMember" id="Fxbrl_20230308122505533" unitRef="Percentage" xsi:nil="true"/><ix:nonFraction name="ifrs-full:ProportionOfOwnershipInterestInSubsidiary" contextRef="C_20220101to20221231_ifrsfullSignificantInvestmentsInSubsidiariesAxis_imcMymNutraceuticalsIncMember" id="Fxbrl_20230308122516034" unitRef="Percentage" xsi:nil="true"/><ix:nonFraction name="ifrs-full:ProportionOfOwnershipInterestInSubsidiary" contextRef="C_20220101to20221231_ifrsfullSignificantInvestmentsInSubsidiariesAxis_imcSublimecultureIncMember" id="Fxbrl_20230308122523513" unitRef="Percentage" xsi:nil="true"/><ix:nonFraction name="ifrs-full:ProportionOfOwnershipInterestInSubsidiary" contextRef="C_20220101to20221231_ifrsfullSignificantInvestmentsInSubsidiariesAxis_imcCannacanadaIncMember" id="Fxbrl_20230308122535351" unitRef="Percentage" xsi:nil="true"/><ix:nonFraction name="ifrs-full:ProportionOfOwnershipInterestInSubsidiary" contextRef="C_20220101to20221231_ifrsfullSignificantInvestmentsInSubsidiariesAxis_imcMymInternationalBrandsIncMember" id="Fxbrl_20230308122551176" unitRef="Percentage" xsi:nil="true"/><ix:nonFraction name="ifrs-full:ProportionOfOwnershipInterestInSubsidiary" contextRef="C_20220101to20221231_ifrsfullSignificantInvestmentsInSubsidiariesAxis_imcHighlandGrowIncMember" id="Fxbrl_20230308122559834" unitRef="Percentage" xsi:nil="true"/><ix:footnote id="FN20240323115457424" xml:lang="en-US">	 The Company does not hold directly interest or voting rights in Focus. The Company's wholly-owned subsidiary holds an option to buy the ownership of the 74% of Focus shares. According to accounting criteria in IFRS 10, the Company is viewed as effectively exercising control over Focus, and therefore, the accounts of Focus are consolidated with those of the Company (see also note 26).</ix:footnote>
<ix:footnote id="FN20240323115524142" xml:lang="en-US">Dissolved as of December 31, 2023.</ix:footnote>
<ix:footnote id="FN20230328095430512" xml:lang="en-US">Deconsolidated effective November 7, 2022, when Trichome filed to commence proceedings under the Companies&#8217; Creditors Arrangement Act (CCAA) (see Note 1).</ix:footnote>
<ix:footnote id="FN20230327182602133" xml:lang="en-US">The licenses consist of GMP and GDP licenses.</ix:footnote>
