                    </td>
                    <td colspan="1" style="font-family:'Times New Roman',Times,serif;vertical-align:bottom;width:1%;background-color:rgb(204, 238, 255);vertical-align:bottom;white-space:nowrap">&#160;</td>
                  </tr>
                  <tr>
                    <td style="vertical-align:top;font-family:'Times New Roman',Times,serif;width:88%;vertical-align:bottom">
                      <div style="text-indent:-8.5pt;margin-left:8.5pt;line-height:1.25"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">Common shares issued in settlement of purchase consideration of business combination</span></span></div>
                    </td>
                    <td colspan="1" style="font-family:'Times New Roman',Times,serif;vertical-align:bottom;width:1%;vertical-align:bottom">&#160;</td>
