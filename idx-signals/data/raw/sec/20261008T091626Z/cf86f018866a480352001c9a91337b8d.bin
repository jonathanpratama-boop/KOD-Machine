                  </tr>
                  <tr>
                    <td style="vertical-align:top;font-family:'Times New Roman',Times,serif;width:76%;vertical-align:bottom">
                      <div style="text-indent:-8.5pt;margin-left:14.15pt;line-height:1.25"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:10pt"><span><span><span><span>Cash and cash equivalents</span></span></span></span></span></span></div>
