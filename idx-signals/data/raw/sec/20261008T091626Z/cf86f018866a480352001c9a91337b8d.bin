                    </td>
                    <td colspan="1" style="vertical-align:bottom;text-align:right;width:9%;vertical-align:bottom">
                      <div style="line-height:1.25"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:10pt"><span><span><span><span><span><ix:nonFraction id="Fxbrl_20230308220336616_57" name="ifrs-full:CashAndCashEquivalents" contextRef="C_20211231_ifrsfullAssetsAndLiabilitiesClassifiedAsHeldForSaleAxis_ifrsfullAssetsAndLiabilitiesClassifiedAsHeldForSaleMember" unitRef="CAD" scale="3" decimals="-3" format="ixt:num-dot-decimal">3,171</ix:nonFraction></span></span></span></span></span></span></span></div>
