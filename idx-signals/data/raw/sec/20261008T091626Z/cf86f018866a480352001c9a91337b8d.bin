                      <div style="text-indent:-8.5pt;margin-left:14.15pt;line-height:1.25"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:10pt"><span><span><span><span>Trade receivables</span></span></span></span></span></span></div>
                    </td>
                    <td colspan="1" style="font-family:'Times New Roman',Times,serif;vertical-align:bottom;width:1%;background-color:rgb(204, 238, 255);vertical-align:bottom">&#160;</td>
