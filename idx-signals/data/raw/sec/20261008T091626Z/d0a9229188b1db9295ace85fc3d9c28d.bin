			<td style="width: 12%; text-align: right; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt; border-bottom: 1px solid rgb(0, 0, 0);"><ix:nonFraction id="c1014" contextRef="i_2023-06-30" unitRef="USD" name="slgg:FinitelivedIntangibleAssetExpectedAmortizationAfterYearFour" scale="0" format="ixt:numdotdecimal" decimals="0">807,000</ix:nonFraction></td>
