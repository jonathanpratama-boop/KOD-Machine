			<td style="width: 9%; text-align: right; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);"><ix:nonFraction id="c1246" contextRef="i_2022-06-30_BusinessAcquisitionAxis-SuperbizAcquisitionMember" unitRef="USD" name="us-gaap:BusinessCombinationContingentConsiderationLiability" scale="0" format="ixt:zerodash" decimals="0">-</ix:nonFraction></td>
