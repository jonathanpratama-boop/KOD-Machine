			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);">$</td>
			<td style="width: 9%; text-align: right; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);"><ix:nonFraction id="c1245" contextRef="i_2023-06-30_BusinessAcquisitionAxis-SuperbizAcquisitionMember" unitRef="USD" name="us-gaap:BusinessCombinationContingentConsiderationLiability" scale="0" format="ixt:numdotdecimal" decimals="0">709,000</ix:nonFraction></td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; padding-bottom: 3px; margin-left: 0pt; vertical-align: top;"><sup style="vertical-align:top;line-height:120%;">(1)&#xa0;</sup></td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt;">&#xa0;</td>
