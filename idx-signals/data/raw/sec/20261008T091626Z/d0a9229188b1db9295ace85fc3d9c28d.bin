<table border="0" cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px;">

		<tbody><tr style="vertical-align: top;">
			<td style="width: 3%;">
			<p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt; font-variant: normal; margin: 0pt;">(1)&#xa0; -</p>
			</td>
			<td style="width: 97%;">
			<p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt; font-variant: normal; margin: 0pt;">Issued on May 26, 2023 upon final closing of the convertible preferred financings.</p>
			</td>
