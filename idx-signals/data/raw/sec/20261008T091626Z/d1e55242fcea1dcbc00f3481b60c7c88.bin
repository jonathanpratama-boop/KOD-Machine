    <td style="width: 1%; font-size: 10pt; text-align: left">$</td><td style="width: 15%; font-size: 10pt; text-align: right">22,132</td><td style="width: 1%; font-size: 10pt; text-align: left">&nbsp;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
