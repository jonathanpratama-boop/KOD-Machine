    <td style="border-bottom: Black 2.5pt double; font-size: 10pt; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 2.5pt double; font-size: 10pt; font-weight: bold; text-align: right">487</td><td style="padding-bottom: 2.5pt; font-size: 10pt; font-weight: bold; text-align: left">&nbsp;</td></tr>
