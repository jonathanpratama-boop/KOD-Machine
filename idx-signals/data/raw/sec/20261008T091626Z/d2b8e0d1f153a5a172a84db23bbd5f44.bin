<TD VALIGN="top"> <P STYLE=" margin-top:0pt ; margin-bottom:0pt; margin-left:1.00em; text-indent:-1.00em; font-size:10pt; font-family:Times New Roman">License</P></TD>
<TD VALIGN="bottom">&nbsp;&nbsp;</TD>
<TD NOWRAP VALIGN="bottom">&nbsp;</TD>
<TD NOWRAP VALIGN="bottom" ALIGN="right">3&nbsp;years&nbsp;and&nbsp;2&nbsp;months&nbsp;&#150;&nbsp;7&nbsp;years</TD>
<TD NOWRAP VALIGN="bottom">&nbsp;</TD></TR>
<TR STYLE="page-break-inside:avoid ; font-family:Times New Roman; font-size:10pt">
<TD VALIGN="top"> <P STYLE=" margin-top:0pt ; margin-bottom:0pt; margin-left:1.00em; text-indent:-1.00em; font-size:10pt; font-family:Times New Roman">Software</P></TD>
