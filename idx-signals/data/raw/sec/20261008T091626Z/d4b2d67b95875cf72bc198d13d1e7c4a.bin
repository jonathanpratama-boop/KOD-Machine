    <TD STYLE="border-right: black 1pt solid; border-bottom: black 1pt solid; border-left: black 1pt solid; padding-top: 2pt; padding-right: 2pt; padding-left: 2pt"><FONT STYLE="font-size: 10pt">LGBTQ+</FONT></TD>
    <TD STYLE="border-right: black 1pt solid; border-bottom: black 1pt solid; padding-top: 2pt; padding-right: 2pt; padding-left: 2pt; text-align: center">&nbsp;</TD>
