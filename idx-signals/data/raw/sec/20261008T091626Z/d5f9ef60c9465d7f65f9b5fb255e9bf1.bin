:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.29%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:8.17%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2021_To_12_31_2021_wyOEktPVKUexFLeqpjvtxw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="0" id="Tc_oq3PmFlscE6xZsJ1utJRwA_5_6">314,650</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.05%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.29%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:8.15%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2020_To_12_31_2020_uAn1Q3oP2U6MOLr6LPzsoQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="0" id="Tc_nm9kqNIKtEatViwYgilVxg_5_9">325,523</ix:nonFraction></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;">As of December 31, 2022, total unrecognized compensation cost related to unvested share-based payment awards was $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="As_Of_12_31_2022_jk1p7YKeKEu_EF44ovLRzg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensationCostNotYetRecognized" scale="0" id="Narr_reoHMm41Gke6nZ0lrz5dNg">2,739,097</ix:nonFraction>, which is expected to be recognized over a weighted average period of <ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_0uirX0xCxEGYKKY-deGFbg" format="ixt-sec:duryear" name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensationCostNotYetRecognizedPeriodForRecognition1" id="Narr_xhpe89gHDEWPWAjxU3fEdw">3.1</ix:nonNumeric> years.</p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-22</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">AKARI THERAPEUTICS, Plc</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;">NOTES TO CONSOLIDATED FINANCIAL STATEMENTS</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;">December 31, 2022</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;">(in U.S. dollars)</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_0uirX0xCxEGYKKY-deGFbg" name="us-gaap:RelatedPartyTransactionsDisclosureTextBlock" id="Tb_KE44r7v2lUqQUUTnfLpVog" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><span style="font-size:1pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-bottom:1pt;padding-top:1pt;border-bottom:1px solid #000000;border-top:1px solid #000000;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTE&#160;6&#160;&#8211; Related Party Transactions</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">London Office Lease&#160;- </b>The Company leases its offices in London from The Doctors Laboratory (&#8220;TDL&#8221;) and has incurred expenses of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_aktx_DoctorsLaboratoryMember_cyoCT09hQkSnk3TXDtK_fQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:OperatingLeaseExpense" scale="0" id="Narr_yKIY5ZXUt069kN8AvwZiWA">129,000</ix:nonFraction>, $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_aktx_DoctorsLaboratoryMember_lJaJa7LZTECH9kXEipglgg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:OperatingLeaseExpense" scale="0" id="Narr_tBxi_ZZkRkW5dzgoZGv_lQ">146,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2019_To_12_31_2019_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_aktx_DoctorsLaboratoryMember_VpywnpQzrUKLc8SsssmPHw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:OperatingLeaseExpense" scale="0" id="Narr_sw9EIjC6tU-Lmy8jK4-Lww">133,000</ix:nonFraction> plus VAT during the years ended December 31, 2022, 2021 and 2020, respectively. David Byrne, a non-employee director of the Company, is the Chief Executive Officer of TDL and Dr. Ray Prudo, the Company&#8217;s former Executive Chairman, is the non-Executive Chairman of the Board of Directors of TDL.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Laboratory Testing Services -</b> The Company received laboratory testing services for its clinical trials provided by TDL, including certain administrative services, and has incurred expenses of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RelatedPartyTransactionAxis_aktx_LaboratoryTestingServicesMember_dLDBrPxsXUaDCTTU0iKQyg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_lfeU7F5XS0iLnz9HShLYVQ">89,000</ix:nonFraction>, $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_RelatedPartyTransactionAxis_aktx_LaboratoryTestingServicesMember_Gfk6ROmbPkG_YvcTRcWa-w" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_QXyd2N22wE6QQAotK-49pQ">102,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2019_To_12_31_2019_us-gaap_RelatedPartyTransactionAxis_aktx_LaboratoryTestingServicesMember_K0CY92Emm02TQV8yGoRi9w" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_cEbvJ_QFukurYQaf7UI9ew">234,000</ix:nonFraction> plus VAT during the years ended December 31, 2022, 2021 and 2020, respectively. The Company recorded payable balances to TDL of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="As_Of_12_31_2022_us-gaap_RelatedPartyTransactionAxis_aktx_LaboratoryTestingServicesMember_N5Np0AUm-UOTCb1zIl6vmw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToRelatedPartiesCurrentAndNoncurrent" scale="0" id="Narr_fnThg60UDUq1CSMTCmPhiw">23,000</ix:nonFraction>, $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="As_Of_12_31_2021_us-gaap_RelatedPartyTransactionAxis_aktx_LaboratoryTestingServicesMember_sBIT9mJbk0mL-OtjlmwT8g" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToRelatedPartiesCurrentAndNoncurrent" scale="0" id="Narr_heWXJ3lmOkGmsaO2yx9F6A">32,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="As_Of_12_31_2019_us-gaap_RelatedPartyTransactionAxis_aktx_LaboratoryTestingServicesMember_Ts1L9XaPS0mbta0kcqyKxw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToRelatedPartiesCurrentAndNoncurrent" scale="0" id="Narr_WldoNgVcCkmMP7bqiD6cIg">100,000</ix:nonFraction> plus VAT as of December 31, 2022, 2021 and 2020, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><b style="font-weight:bold;">Consulting -</b> A non-employee director of the Company began providing business development consulting services in January 2018. The consulting agreement was terminated in November 2022. The Company incurred expenses of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2022_To_12_31_2022_us-gaap_RelatedPartyTransactionAxis_aktx_ConsultingServicesMember_AdnmZFX0fkqlNp7FVB5_jQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_6MdNIxGR40KMTy_kJ1NJlg">92,000</ix:nonFraction>, $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_RelatedPartyTransactionAxis_aktx_ConsultingServicesMember_V0V43cORKkSFbouGg41Rrg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_Ena9Ni_lsUuEGXw893bGJg">100,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2019_To_12_31_2019_us-gaap_RelatedPartyTransactionAxis_aktx_ConsultingServicesMember_iJspm7aCeUuIeaZFO6x9Nw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_YP1-W3ZnC0y-fiY6iOcBNA">100,000</ix:nonFraction> during the years ended December 31, 2022, 2021 and 2020, respectively, relating to these consulting services.</p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_0uirX0xCxEGYKKY-deGFbg" name="us-gaap:CommitmentsAndContingenciesDisclosureTextBlock" id="Tb_KOszgN8GTEmr_OEkqSjR_g" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-bottom:1pt;padding-top:1pt;text-align:justify;text-indent:0pt;border-bottom:1px solid #000000;border-top:1px solid #000000;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTE 7 &#8211; Commitments and Contingencies</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Lease commitment &#8211;</b> The Company currently leases its offices in London and New York on a month-to-month basis.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;">For the years ended December 31, 2022, 2021 and 2020, the Company incurred total rental expense in the amount of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2022_To_12_31_2022_0uirX0xCxEGYKKY-deGFbg" decimals="0" format="ixt:numdotdecimal" name="aktx:OperatingLeaseRentExpense" scale="0" id="Narr_z5E2lncxd0Cazx0VaS0w-Q">169,000</ix:nonFraction>, $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2021_To_12_31_2021_wyOEktPVKUexFLeqpjvtxw" decimals="0" format="ixt:numdotdecimal" name="aktx:OperatingLeaseRentExpense" scale="0" id="Narr_f5mLszjqC0iTnlYvybUeqA">183,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_wfDCJ28O70GCVLuaWEr9Fg" contextRef="Duration_1_1_2020_To_12_31_2020_uAn1Q3oP2U6MOLr6LPzsoQ" decimals="0" format="ixt:numdotdecimal" name="aktx:OperatingLeaseRentExpense" scale="0" id="Narr_3vLFQd1NNEiqIQXcnoA_NQ">173,000</ix:nonFraction>, respectively.</p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><a id="Tc_5IMhRdcQlEiEpSrjmWkeuQ_1_2"></a><a id="Tc_EZ-vQqq6xU6q_5dRElNZZQ_2_2"></a><a id="Tc_lcvv3DbKtke34ozlN5irvQ_2_4"></a><a id="Tc_aUtqMEnc6kqmoVviUd19dw_2_6"></a><a id="Tc_kcdBLgo7HkmUoC8E_lLsZA_3_0"></a><a id="Tc_szBhPTw-3keax1cSTjn7sQ_3_2"></a><a id="Tc_TlZZRitDK0eI5Ut4vETriQ_3_4"></a><a id="Tc_VeXnew4MlU-3UVvUD0r31g_3_6"></a><a id="Tc_wzP-cTOAh0-GiCzOWJal1w_4_0"></a><a id="Tc_lKEaw04uj0mcmcAPY0wvPA_5_0"></a><a id="Tc_xQIEvd-4KUqzpdYCg-CUYg_5_2"></a><a id="Tc_5eHVMZvOhUSa5wSHuc2LPA_5_4"></a><a id="Tc_2SfRWfBLwU2tEvpu_7HVSA_5_6"></a><a id="Tc_Dw6ZiqNUYECRLU77t9PHFw_6_0"></a><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_0uirX0xCxEGYKKY-deGFbg" name="us-gaap:EarningsPerShareTextBlock" id="Tb_MTNzbbDzR0e0-T1JoKvCHg" continuedAt="Tb_MTNzbbDzR0e0-T1JoKvCHg_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><span style="font-size:1pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-bottom:1pt;padding-top:1pt;border-bottom:1px solid #000000;border-top:1px solid #000000;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTE&#160;8&#160;&#8211; Loss Per Share</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt 0pt 12pt 0pt;">Basic loss per ordinary share is computed by dividing net loss available to ordinary shareholders by the weighted-average number of ordinary shares outstanding during the period. Diluted loss per ordinary share is computed by dividing net loss available to ordinary shareholders by the sum of (1)&#160;the weighted-average number of ordinary shares outstanding during the period, (2)&#160;the dilutive effect of the assumed exercise of share options using the treasury stock method, and (3)&#160;the dilutive effect of other potentially dilutive securities.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;">The following is the calculation of the basic and diluted&#160;weighted&#160;average shares outstanding for the&#160;years ended December 31,2022, 2021 and 2020, respectively:</p><ix:nonNumeric contextRef="Duration_1_1_2022_To_12_31_2022_0uirX0xCxEGYKKY-deGFbg" name="us-gaap:ScheduleOfEarningsPerShareBasicAndDilutedTableTextBlock" id="Tb_hO7BrgDBPEeFHxMRLoohWA" continuedAt="Tb_hO7BrgDBPEeFHxMRLoohWA_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:60.41%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span