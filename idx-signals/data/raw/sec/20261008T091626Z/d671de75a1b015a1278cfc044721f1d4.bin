23_To_9_30_2023_t1V84dcu0UC9aTLzL8wINQ" name="dei:EntitySmallBusiness" id="Tc_J_LvAebd-UWCCuJaQBGItQ_2_3"><span style="font-family:'Segoe UI Symbol';font-size:9pt;">&#9746;</span></ix:nonNumeric></p></td></tr><tr style="height:14.15pt;"><td style="vertical-align:bottom;width:28.88%;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:12pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;width:6.55%;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:12pt;margin-bottom:12pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;width:59.05%;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:9pt;margin:0pt 0pt 0pt 108pt;">Emerging growth company</p></td><td style="vertical-align:bottom;width:5.5%;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:center;margin:0pt 0pt 0pt 21pt;"><ix:nonNumeric format="ixt-sec:boolballotbox" contextRef="Duration_1_1_2023_To_9_30_2023_t1V84dcu0UC9aTLzL8wINQ" name="dei:EntityEmergingGrowthCompany" id="Tc_PAq8smmFwk6DGUCMObv6Ng_3_3"><span style="font-family:'Segoe UI Symbol';font-size:9pt;">&#9744;</span></ix:nonNumeric></p></td></tr></table><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:9pt;text-align:justify;text-indent:16.15pt;margin:0pt 0pt 8pt 0pt;">If an emerging growth company, indicate by check mark if the registrant has elected not to use the extended transition period for complying with any new or revised financial accounting standards provided pursuant to Section&#160;13(a)&#160;of the Exchange Act. <span style="font-family:'MS PGothic';">&#9744;</span></p><p style="