t="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsOutstandingWeightedAverageExercisePrice" scale="0" unitRef="usdPershares" id="ixv-3092">2.25</ix:nonFraction></span></td> <td style="vertical-align: bottom; text-align: justify">&#160;</td> <td style="vertical-align: bottom">&#160;</td> <td style="vertical-align: bottom; text-align: justify">&#160;</td> <td style="vertical-align: bottom; text-align: right"><span style="font-size: 10pt"><ix:nonFraction contextRef="c51" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationSharesAuthorizedUnderStockOptionPlansExercisePriceRangeNumberOfExercisableOptions" scale="0" unitRef="shares" id="ixv-3093">69,090</ix:nonFraction></span></td> <td style="vertical-align: bottom; text-align: justify">&#160;</td></tr> <tr style="background-color: #CCEEFF"> <td style="vertical-align: top"><span style="font-size: 10pt">2023</span></td> <td style="vertical-align: bottom">&#160;</td> <td style="vertical-align: bottom; text-align: justify">&#160;</td> <td style="vertical-align: top; text-align: center"><ix:nonNumeric contextRef="c52" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardPlanModificationDescriptionAndTerms" id="ixv-2649"><span style="font-size: 10pt">Services rendered</span></ix:nonNumeric></td> <td style="vertical-align: bottom; text-align: justify">&#160;</td> <td style="vertical-align: bottom">&#160;</td> <td style="vertical-align: bottom; text-align: justify">&#160;</td> <td style="vertical-align: bottom; text-align: right"><span style="font-size: 10pt"><ix:nonFraction contextRef="c52" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardSharesIssuedInPeriod" scale="0" unitRef="shares" id="ixv-3094">100,000</ix:nonFraction></span></td> <td style="vertical-align: bottom; text-align: justify">&#160;</td> <td style="vertical-align: bottom">&#160;</td> <td style="vertical-align: bottom; text-align: justify"><span style="font-size: 10pt">$</span></td> <td style="white-space: nowrap; vertical-align: bottom; text-align: right"><span style="font-size: 10pt"><ix:nonFraction contextRef="c53" decimals="3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsOutstandingWeightedAverageExercisePrice" scale="0" unitRef="usdPershares" id="ixv-3095">0.546</ix:nonFraction></span></td> <td style="vertical-align: bottom; text-align: justify">&#160;</td> <td style="vertical-align: bottom">&#160;</td> <td style="vertical-align: bottom; text-align: justify">&#160;</td> <td style="vertical-align: bottom; text-align: right"><span style="font-size: 10pt"><ix:nonFraction contextRef="c53" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationSharesAuthorizedUnderStockOptionPlansExercisePriceRangeNumberOfExercisableOptions" scale="0" unitRef="shares" id="ixv-3096">51,111</ix:nonFraction></span></td> <td style="vertical-align: bottom; text-align: justify">&#160;</td></tr> </table></ix:continuation></ix:continuation><div>

</div><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 0.75in">&#160;</p><div>

