                    <div style="text-align: left; color: rgb(0, 0, 0); font-weight: normal; font-style: italic; font-size: 8pt;"> <span style="font-weight: normal; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 8pt; font-style: italic; font-variant: normal; text-transform: none;"><a href="#TableofContents">Table of Contents</a><a href="#TableofContents"><br/>
                        </a></span></div>

                  </div>

                </div>

              </div>

            </div>

            </div>

          <div style="font-family: 'Times New Roman'; font-size: 10pt;">
            <div>
              <ix:continuation id="Text_dcd7c127cf8c4a4fa84f1d99dce0866916" continuedAt="Text_dcd7c127cf8c4a4fa84f1d99dce0866917"><ix:nonNumeric name="us-gaap:FairValueLiabilitiesMeasuredOnRecurringBasisUnobservableInputReconciliationTextBlock" id="Text_b8cd77f063634f1e81756ccfa1e26d85" contextRef="c20240101to20241231" escape="true" continuedAt="Text_8acc0fd1328d4535a269b3aeecb460f81">
<div style="text-align: left; font-family: 'Times New Roman'; font-size: 10pt;">The following is a roll-forward of the fair value of Level 3 warrants:</div>
</ix:nonNumeric></ix:continuation>
            </div>

            <ix:continuation id="Text_dcd7c127cf8c4a4fa84f1d99dce0866917" continuedAt="Text_dcd7c127cf8c4a4fa84f1d99dce0866918"><ix:continuation id="Text_8acc0fd1328d4535a269b3aeecb460f81" continuedAt="Text_8acc0fd1328d4535a269b3aeecb460f82">
<div> <br/>
            </div>
</ix:continuation></ix:continuation>
            <ix:continuation id="Text_dcd7c127cf8c4a4fa84f1d99dce0866918" continuedAt="Text_dcd7c127cf8c4a4fa84f1d99dce0866919"><ix:continuation id="Text_8acc0fd1328d4535a269b3aeecb460f82">
<table cellspacing="0" cellpadding="0" style="font-family: 'Times New Roman'; letter-spacing: normal; text-transform: none; word-spacing: 0px; text-decoration-style: initial; text-decoration-color: initial; font-size: 10pt; text-align: left; color: rgb(0, 0, 0); width: 100%; border-spacing: 0;" class="cfttable">


  <tr>

    <td valign="bottom" style="vertical-align: bottom; font-weight: normal; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-variant: normal; text-transform: none; padding-bottom: 2px;">
                    <div style="font-style: italic;">(in thousands)</div>
                  </td>

    <td valign="bottom" style="font-weight: bold; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-variant: normal; text-transform: none; font-style: normal; text-align: center; vertical-align: bottom; padding-bottom: 2px; border-top: #000000 solid 2px;" colspan="1">&#160;</td>

    <td valign="bottom" style="vertical-align: bottom; font-weight: bold; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-variant: normal; text-transform: none; font-style: normal; text-align: center; border-bottom: 2px solid rgb(0, 0, 0); border-top: 2px solid rgb(0, 0, 0);" colspan="2"> 2024</td>

    <td valign="bottom" style="font-weight: bold; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-variant: normal; text-transform: none; font-style: normal; text-align: left; vertical-align: bottom; padding-bottom: 2px; white-space: nowrap;" colspan="1">&#160;</td>

  </tr>

  <tr>

    <td valign="bottom" style="vertical-align: bottom; font-weight: normal; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; font-variant: normal; text-transform: none; width: 88%; background-color: #CCEEFF;" rowspan="1">Balance






















                    at December 31, 2022<br/>
                  </td>

