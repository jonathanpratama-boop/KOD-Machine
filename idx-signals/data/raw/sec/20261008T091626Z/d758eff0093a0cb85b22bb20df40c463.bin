                    <div><ix:nonFraction name="us-gaap:AllocatedShareBasedCompensationExpense" id="Fact_3b7d4ddbda9f48babf31be3ca6583adc" contextRef="c20230101to20231231" unitRef="U001" decimals="-3" scale="3" format="ixt:num-dot-decimal">670</ix:nonFraction></div>
