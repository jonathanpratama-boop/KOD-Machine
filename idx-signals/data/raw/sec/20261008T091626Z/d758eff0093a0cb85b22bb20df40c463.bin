            <ix:continuation id="Text_82682b1c18364dd5a7ed74a8f63363b62" continuedAt="Text_82682b1c18364dd5a7ed74a8f63363b63"><ix:nonNumeric name="us-gaap:ScheduleOfIncomeBeforeIncomeTaxDomesticAndForeignTableTextBlock" id="Text_a89eb79ae9504ae4944dff10e5826345" contextRef="c20240101to20241231" escape="true" continuedAt="Text_d6cf45ad28b048eb8876e0c53d581a9e1">
