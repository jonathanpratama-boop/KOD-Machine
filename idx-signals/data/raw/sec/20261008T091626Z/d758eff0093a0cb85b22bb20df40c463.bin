<div style="font-family: 'Times New Roman'; font-size: 10pt;"> <span style="color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 13.3333px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;"><span style="font-size: 10pt;">Depreciation and amortization expense was $<ix:nonFraction name="us-gaap:DepreciationAndAmortization" id="Fact_e3211d150f98427fa3a32149deb5b198" contextRef="c20240101to20241231" unitRef="U001" decimals="-3" scale="3" format="ixt:num-dot-decimal">310</ix:nonFraction>,000 and $<ix:nonFraction name="us-gaap:DepreciationAndAmortization" id="Fact_0ddad69d644f4397bed66b9a8ded68c2" contextRef="c20230101to20231231" unitRef="U001" decimals="-3" scale="3" format="ixt:num-dot-decimal">362</ix:nonFraction>,000 for the
                  years ended December 31, 2024, and 2023, respectively.</span></span></div>
</ix:continuation>

