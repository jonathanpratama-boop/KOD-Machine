  <div style="margin: 0px; color: #000000; font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: normal; text-align: left; text-transform: none;">
    <div style="font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-weight: normal;">
      <div style="font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-weight: normal;">
        <div style="font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-weight: normal;">
          <div style="font-family: 'Times New Roman'; font-size: 10pt; font-style: normal; font-weight: normal;">
            <div style="font-family: 'Times New Roman'; font-size: 10pt;">
              <div style="text-align: center; font-family: 'Times New Roman'; font-size: 10pt; font-weight: bold; color: rgb(0, 0, 0); font-style: normal; font-variant: normal; text-transform: none;">NUWELLIS,&#160;INC. AND SUBSIDIARY</div>

              <div style="text-align: center; font-family: 'Times New Roman'; font-size: 10pt; font-weight: bold;"> <br/>
              </div>

