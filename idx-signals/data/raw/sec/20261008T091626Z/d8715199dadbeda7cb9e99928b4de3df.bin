			<div style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">Stephen Cotton,</div>
			</td>
		</tr>
		<tr>
			<td style="vertical-align: top; width: 50%;">&#160;</td>
			<td style="vertical-align: top; width: 50%;">
			<div style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">President and Chief Executive Officer</div>
			</td>
		</tr>

