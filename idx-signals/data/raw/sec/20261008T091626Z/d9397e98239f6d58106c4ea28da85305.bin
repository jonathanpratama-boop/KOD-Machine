    <div style="line-height: 1.25;">
      <div style="line-height: 1.25;">&#160;</div>
    </div>
    <div style="line-height: 1.25;">
      <div style="text-align: justify; line-height: 1.25;">For more information, please visit:&#160;<u>www.evogene.com.</u></div>
    </div>
