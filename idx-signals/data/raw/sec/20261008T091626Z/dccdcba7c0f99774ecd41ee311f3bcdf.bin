    <span id="xdx_905_edei--SecurityExchangeName_c20231127__20231127_zqP3Bh4Wswz4"><ix:nonNumeric contextRef="AsOf2023-11-27" format="ixt-sec:exchnameen" name="dei:SecurityExchangeName">Nasdaq</ix:nonNumeric></span> Capital Market</span></td></tr>
