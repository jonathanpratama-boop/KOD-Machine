mal" name="us-gaap:DueToRelatedPartiesCurrent" scale="0" id="Tc_2SGOWDxbGEGWwW-1zqstrg_3_6">3,984,000</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:73.84%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:7.2pt;text-indent:-7.2pt;margin:0pt 0pt 0.05pt 0pt;">Invoices paid on behalf of the Company</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.41%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.37%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_us-gaap_RelatedPartyTransactionAxis_qnrx_InvoicesPaidOnBehalfOfCompanyMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_OfficerMember_MAjAVzYnIkWiAyq3QV9HYQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToRelatedPartiesCurrent" scale="0" id="Tc_E71CjtXK1EG6bCLjR4eqtA_4_3">615,232</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.44%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.36%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2020_us-gaap_RelatedPartyTransactionAxis_qnrx_InvoicesPaidOnBehalfOfCompanyMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_OfficerMember_XWa7yLpwIk-AxygaHh3mOw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToRelatedPartiesCurrent" scale="0" id="Tc_CcxxNf1v70OPdHqOiTifHw_4_6">904,913</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:73.84%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:7.2pt;text-indent:-7.2pt;margin:0pt 0pt 0.05pt 0pt;">Total</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.41%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.37%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_OfficerMember_SCcQJf8XgkyMwAX76dqZtA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToRelatedPartiesCurrent" scale="0" id="Tc_kuprUJaXkkKjz1K5DtmGdA_5_3">4,723,732</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.44%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.36%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2020_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_OfficerMember__ORuf_9v906Sdu1u1KlXWg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToRelatedPartiesCurrent" scale="0" id="Tc_Toka0FyWEEm6cuBJHTDwnA_5_6">4,888,913</ix:nonFraction></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">During 2021, the Company incurred $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_RelatedPartyTransactionAxis_qnrx_ConsultingExpenseMember_ujMo4WvQqEmQVPol6NT-lg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_QKn4YZDhKESoC6oGKgg3Uw">108,000</ix:nonFraction> of consulting expense from related parties, primarily from a related party company controlled by a member of the Board of Directors.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">See Note&#160;4 for related party debt and Note&#160;12 for employment agreements.</p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2021_To_12_31_2021_OJr2skXNqkqIByWrd_VGSQ" name="us-gaap:CommitmentsDisclosureTextBlock" id="Tb_ZdRfsHmSpUqX3WwepFOniA" continuedAt="Tb_ZdRfsHmSpUqX3WwepFOniA_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTE&#160;12&#160;&#8211; RESEARCH, CONSULTING AGREEMENTS AND COMMITMENTS</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Research and consulting agreement</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Quoin Inc. entered into a research and consulting agreement (the &#8220;Research Agreement&#8221;) which commits it to pay the former owner of Polytherapeutics (the &#8220;Consultant&#8221; or &#8220;Seller&#8221;) to transfer the technical know-how of Polytherapeutics with respect to (i)&#160;good manufacturing practices (&#8220;GMP&#8221;), clinical and commercial manufacturing of the Company&#8217;s PolyDur polymer and (ii)&#160;formulation development of products utilizing the Company&#8217;s PharmaDur polymer (See Note&#160;9). The agreement required&#160;monthly consulting payments of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_2_28_2021_srt_CounterpartyNameAxis_qnrx_PolytherapeuticsMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_4q8tX1jslkiVoBIAsL9KmA" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementMonthlyPayment" scale="0" id="Narr_PSA2Jnv3ckuedsP5eTqHQA">20,833</ix:nonFraction> beginning on July&#160;31, 2018 and ending February&#160;28, 2021 (the &#8220;Post-Closing Period&#8221;) for a total of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_2_28_2021_srt_CounterpartyNameAxis_qnrx_PolytherapeuticsMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_4q8tX1jslkiVoBIAsL9KmA" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_v_11tYcDn06NHuvHfzQqyg">666,667</ix:nonFraction> over the consulting period. Pursuant to an amendment, the Post-Closing Period was revised to terminate on December&#160;31, 2020.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Through December&#160;31, 2021 and the financial statement issuance date, the Company has not made any payments, the Consultant has not performed any services and the Company has not incurred or accrued for any expenses. See Note&#160;15 for Consultant&#8217;s notification of breach of contract.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Other research consulting agreements</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">Quoin Inc. entered into <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_7_31_2018_To_7_31_2018_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_cgPXJecYwEOXdwSlFiSowQ" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfAgreement" scale="0" id="Narr_MHZkrJUApkCFPUgu-9DisQ">three</ix:nonFraction> consulting agreements with Axella Research LLC (&#8220;Axella&#8221;) to provide regulatory and pre- clinical/clinical services to the Company with respect to QRX003 and QRX004. The combined fees of the three agreements are approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_7_31_2018_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_FLuNNvf4iEOGTiAojdn7ZA" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_BWJMckm5akmrUPMHlS7Uyg">270,000</ix:nonFraction>, payable as milestones under the three agreements are met. Quoin Inc. has also engaged Axella for additional services pursuant to separate work orders. Further, Quoin Inc. has <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_7_31_2018_To_7_31_2018_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_cgPXJecYwEOXdwSlFiSowQ" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:ConsultingOrServiceAgreementNumberOptionsToPay" scale="0" id="Narr_F_x_BDRyoECSwHeRufnW5w">two</ix:nonFraction> options to pay the milestones due 1) <span style="-sec-ix-hidden:Hidden_lWaEWX-Bp0uiiKGIcPycZg;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">one half</span></span> in equity of Quoin Inc. (at a pre-negotiated valuation) and <span style="-sec-ix-hidden:Hidden_Rabb4dV49EuxV7X90aK-TQ;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">one-half</span></span> in cash or 2) entirely in cash, in which case a discount of approximately <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_7_31_2018_To_7_31_2018_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_cgPXJecYwEOXdwSlFiSowQ" decimals="2" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementPayOption2CashPaymentDiscount" scale="-2" id="Narr_z7Is0S19ikqmMoZq3fWsvQ">20</ix:nonFraction>% would </p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-39</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">QUOIN PHARMACEUTICALS LTD.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">Notes to Consolidated Financial Statements</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">December 31, 2021, 2020 and 2019</b></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_ZdRfsHmSpUqX3WwepFOniA_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;">be applicable. The Company recognized research and development expenses for services provided and milestones met of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2021_To_12_31_2021_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_q_KYLMc4qEy-tRKK1aeVwg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_zwQU5TxtFUCyPUvByGi63g">247,000</ix:nonFraction>, $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2020_To_12_31_2020_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_Powh5rws9EmMtisMSTnb7g" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_sKIm_w6c70WxzxLcYazM6Q">50,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2019_To_12_31_2019_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_6qqVgiGYd0eUr98-8xMrHw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_S5H67BtJNU-PO_RtgV5YGw">25,000</ix:nonFraction> for the&#160;years ended December&#160;31, 2021, 2020 and 2019, respectively and has accrued expenses of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_5chL0kaSeEe-9d974REK0Q" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="0" id="Narr_ZtNC7j-GvUq9Py6o9VbC4g">193,537</ix:nonFraction>, $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2020_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_ks7ZmI6kTE2iKOh0rz2ABQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="0" id="Narr_bffcXSMgG0-oFxRqC20JXw">105,052</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2019_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_hx92IfmQf0O-XsMieZM9Gw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="0" id="Narr_PVjclwrYNUmZmDXp2e-hhw">24,940</ix:nonFraction> at December&#160;31, 2021, 2020 and 2019, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In November&#160;2020, Quoin Inc. entered into a Master Service Agreement for an initial term of <ix:nonNumeric contextRef="Duration_11_1_2020_To_11_30_2020_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_UGw-XqSnrkmJnP6Q9_jkWw" format="ixt-sec:durwordsen" name="qnrx:AgreementInitialTerm" id="Narr_eKg15hJ18kO1teph-z2RdQ">three years</ix:nonNumeric> with Therapeutics&#160;Inc. for managing preclinical and clinical development for new products in the field of dermatology. The agreement required the execution of individual work orders. Quoin Inc. may terminate any work order for any reason with <ix:nonNumeric contextRef="Duration_11_1_2020_To_11_30_2020_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_UGw-XqSnrkmJnP6Q9_jkWw" format="ixt-sec:durwordsen" name="qnrx:AgreementWrittenTerminationNotice" id="Narr_1-iKwm4Gq0CSlSGa4_rp0Q">90&#160;days</ix:nonNumeric> written notice subject to costs incurred through termination and a defined termination fee, unless there is a material breach by Therapeutics&#160;Inc. The first work order was entered into in late 2020 for a clinical study at an expected estimated cost of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_11_30_2020_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_fa8Unb4lsEi1woBWTiKSMg" decimals="-5" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="6" id="Narr_CZtgfpviVE6S1Iop7vZr2A">3.5</ix:nonFraction> million and expected timing through the first quarter of 2023. For the&#160;year ended December&#160;31, 2021, the Company incurred approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2021_To_12_31_2021_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_4MixiykTjEOFDnV0voFh8A" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_FoZxPX2Kyk6-tT94lXmUjQ">340,000</ix:nonFraction> of research and development costs related to this agreement.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In November&#160;2021, the Company entered into a commitment for research related services associated with Netherton Syndrome of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_11_30_2021_srt_CounterpartyNameAxis_qnrx_NethertonSyndromeMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_8OFEGp6kn0-yg4BnKlvhvA" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_M3cD5Lq7oEiXR7_ZWzC9nQ">250,000</ix:nonFraction> for an expected period of eighteen&#160;months, of which an initial $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_CounterpartyNameAxis_qnrx_NethertonSyndromeMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_Tmz6bpIQW0yk6ZFPg6gtuA" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementInitialExpenses" scale="0" id="Narr_XZ67FHfNG0WGAJxk4fRgDw">25,000</ix:nonFraction> expense was incurred in 2021.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Employment agreements</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The employment agreements entered into by Quoin Inc. with its <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="As_Of_3_31_2018_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_1aYrPUGuTUmgsENH2j4Frg" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfFoundersUnderEmploymentAgreement" scale="0" id="Narr_m0H9IWPTSUiK3f0aellqpg">two</ix:nonFraction> founders/officers provide for a combined base salary, including&#160;monthly allowances, of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_3_31_2018_srt_TitleOfIndividualAxis_qnrx_TwoFoundersMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_5UQcso6AHE2EtbRI5NNjxA" decimals="0" format="ixt:numdotdecimal" name="qnrx:EmploymentAgreementBaseSalaryAndBenefits" scale="0" id="Narr_AecBTis_eUW9NWWRtkeHsQ">996,000</ix:nonFraction> per annum, a discretionary bonus and certain allowances and benefits. In the event of termination of the <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="As_Of_3_31_2018_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_1aYrPUGuTUmgsENH2j4Frg" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfFoundersUnderEmploymentAgreement" scale="0" id="Narr_uesDPYg5iEiisfAv3V3I0w">two</ix:nonFraction> founders/officers for reason other than cause, as defined in the employment agreements, the founders shall be entitled to <ix:nonFraction unitRef="Unit_Standard_Y_NgoQ05jOskWjULKQ1sEv4w" contextRef="Duration_1_1_2021_To_12_31_2021_srt_TitleOfIndividualAxis_qnrx_TwoFoundersMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_6DSvmKK21EKMcLBEexGr4Q" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:EmploymentAgreementTerminationBenefitsEquivalentYears" scale="0" id="Narr_MSwOlWBub0ecE1amozUtzg">two</ix:nonFraction>&#160;years of based salary and bonus.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In November&#160;2021, the Company appointed and entered into an employment agreement with its Chief Financial Officer which provides for a base salary of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_11_1_2021_To_11_30_2021_srt_TitleOfIndividualAxis_srt_ChiefFinancialOfficerMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_JUJwkwIjMkaIY5dX3c__RQ" decimals="0" format="ixt:numdotdecimal" name="qnrx:MergerTransactionBonusFounders" scale="0" id="Narr_ZizhR7vZU02RgglI-eFfmg">360,000</ix:nonFraction> per annum, a discretionary bonus and certain allowances and benefits.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In November 2021, the Board of Directors of the Company approved amendments to the employment agreements increasing base level compensation by <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_11_1_2021_To_11_30_2021_srt_TitleOfIndividualAxis_qnrx_TwoFoundersMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_vAqfKdiQbUSc_e8taa-BhQ" decimals="2" format="ixt:numdotdecimal" name="qnrx:PercentageOfIncreaseInBaseLevelCompensation" scale="-2" id="Narr_UAqoFRgiREm9rpvsAwyojQ">10</ix:nonFraction>% for the <ix:nonFraction unitRef="Unit_Standard_item_Aw5bScmEv0qP_d_lDSMZrQ" contextRef="As_Of_11_30_2021_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_8SQD0jecNUCBazltfCz0DA" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfFoundersUnderEmploymentAgreement" scale="0" id="Narr_sP0lUoe1QEKxjJ6R5ys65w">two</ix:nonFraction> founders and increasing the annual target discretionary bonus to not less than <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_11_1_2021_To_11_30_2021_srt_TitleOfIndividualAxis_qnrx_TwoFoundersMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_vAqfKdiQbUSc_e8taa-BhQ" decimals="2" format="ixt:numdotdecimal" name="qnrx:MinimumPercentageOfDiscretionaryBonusOnBaseSalary" scale="-2" id="Narr_M9QlDWkQ5EafipZiOrEC2A">45</ix:nonFraction>% of base salary for the <ix:nonFraction unitRef="Unit_Standard_item_Aw5bScmEv0qP_d_lDSMZrQ" contextRef="As_Of_11_30_2021_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_8SQD0jecNUCBazltfCz0DA" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfFoundersUnderEmploymentAgreement" scale="0" id="Narr_TVO_lscLjka4NfWMJdDOGw">two</ix:nonFraction> founders and the Chief Financial Officer. Further a transaction bonus related to the closing of the Merger and private placements aggregating approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_11_1_2021_To_11_30_2021_srt_TitleOfIndividualAxis_qnrx_TwoFoundersMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_vAqfKdiQbUSc_e8taa-BhQ" decimals="0" format="ixt:numdotdecimal" name="qnrx:TransactionBonusRelatedToMergerAndPrivatePlacementPaid" scale="0" id="Narr_Z-9vVltNAkCLZcMkN8beHw">324,000</ix:nonFraction> was paid to the <ix:nonFraction unitRef="Unit_Standard_item_Aw5bScmEv0qP_d_lDSMZrQ" contextRef="As_Of_11_30_2021_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_8SQD0jecNUCBazltfCz0DA" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfFoundersUnderEmploymentAgreement" scale="0" id="Narr_BeBgZcaYIEOwqUQiGK5btg">two</ix:nonFraction> founders in November 2021. See Note 17 describing subsequent shareholder approval of the employment agreements of the <ix:nonFraction unitRef="Unit_Standard_item_Aw5bScmEv0qP_d_lDSMZrQ" contextRef="As_Of_11_30_2021_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_EmploymentContractsMember_8SQD0jecNUCBazltfCz0DA" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfFoundersUnderEmploymentAgreement" scale="0" id="Narr_Z8GW-Y1dbkOjfQwZvjPw3Q">two</ix:nonFraction> founders/officers.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Performance milestones and Royalties</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">See Note&#160;9 for asset and in-licensed technology commitments.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 2.15pt 12pt 0pt;"><b style="font-weight:bold;">Merger agreement commitment</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In consideration for the Share Transfer disclosed in Note 1, the pre-closing Cellect shareholders received a contingent value right (&#8220;CVR&#8221;) entitling the holders to earnouts during the Payment Period (as such term is defined in the Share Transfer Agreement), comprised mainly of payments upon sale, milestone payments, license fees and exit fees realized by EnCellX. In order to secure such right, shares constituting <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_1_1_2021_To_12_31_2021_OJr2skXNqkqIByWrd_VGSQ" decimals="2" format="ixt:numdotdecimal" name="qnrx:PercentageOfShareCapitalHeldInEscrow" scale="-2" id="Narr_I0cymNY0tk6MHKdNeZWnTw">40</ix:nonFraction>% of EnCellX share capital are held in escrow by Altshuler Shaham Trusts Ltd.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In connection with the Share Transfer, Cellect entered into a CVR Agreement with Mr. Eyal Leibovitz, in the capacity of Representative for the holders of CVRs, and Computershare Trust Company, N.A., a federally chartered trust company (the &#8220;Rights Agent&#8221;). Under the terms of the CVR Agreement, the holders of the Cellect ADSs immediately prior to the Merger had the right to receive, through their ownership of CVRs, their pro-rata share of the net Share Transfer consideration, making such holders of CVRs the indirect beneficiaries of the net payments under the Share Transfer. CVRs were recorded in a register administered by the Rights Agent but were not certificated.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">Since the Company will not receive any net proceeds from the CVR&#8217;s, there is no asset or liability recorded in the consolidated financial statements.</p></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-40</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">QUOIN PHARMACEUTICALS LTD.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">Notes to Consolidated Financial Statements</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">December 31, 2021, 2020 and 2019</b></p></div><div style="clear:both;max-width:100%;position:relative;min-height:11.5pt;"><a id="_39159b9a_8655_4242_98ba_2b6b7edfeb3d"></a><a id="Tc_vwBYEpfKt0S4umAg8Rs4_Q_1_2"></a><a id="Tc_0RwlJiTv6UOuNbfcyayyww_1_4"></a><a id="Tc_Tax1b_HKrE-mnitoFgZdOw_1_7"></a><a id="Tc_g77ZHYIEF0qUVszKuh6l2g_2_0"></a><a id="Tc_iHv6pK7Df0CFrUrsT58fvw_2_4"></a><a id="Tc_z9x6Z_XoD02w__KVs8JrGw_2_7"></a><a id="Tc_503RIWnpNEyHwtTdyoL29A_3_0"></a><a id="Tc_mTWEiJyUkE2pMoJLEZ0RSA_3_4"></a><a id="Tc_Ujlw0hN1K0alqpTw1gzOUA_3_7"></a><a id="Tc_qrK3At71ck--KsctM8oSlQ_4_0"></a><a id="Tc_zEXkWJtmBUGiltTvs23s3A_4_7"></a><a id="Tc_EWTXEO3Y1EK5BB5Xrf4Cnw_5_0"></a><a id="Tc_9RKBY-myEEytuB9Q7iLkvQ_5_4"></a><a id="Tc_nN-yCQTm4USg402zf_j5Dg_5_7"></a><a id="Tc_u72jiXE_ekOTFg6ByDe00w_6_0"></a><ix:nonNumeric contextRef="Duration_1_1_2021_To_12_31_2021_OJr2skXNqkqIByWrd_VGSQ" name="us-gaap:StockholdersEquityNoteDisclosureTextBlock" id="Tb_mUW4Z5BQ1E6U-kANfeUlpQ" continuedAt="Tb_mUW4Z5BQ1E6U-kANfeUlpQ_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTE&#160;13&#160;&#8211; SHAREHOLDERS&#8217; EQUITY AND SHARE OWNERSHIP AND RIGHTS</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Quoin Inc.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Quoin Inc.&#8217;s authorized capital stock consisted of <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_3_5_2018_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_mL60jmsrmESUakXkL-fdRA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_F9Za4AIttEaaNKexHMeBvg">10,000</ix:nonFraction> shares of common stock. On March&#160;5, 2018, in connection with the incorporation as a Delaware corporation, Quoin Inc. issued <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="Duration_3_5_2018_To_3_5_2018_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_5bHdfwxqSEq6ZHsm_ywf2Q" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_BF4xrO9ISEScM07zF3NcuA">100</ix:nonFraction> shares for a consideration of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_3_5_2018_To_3_5_2018_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_5bHdfwxqSEq6ZHsm_ywf2Q" decimals="0" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodValueNewIssues" scale="0" id="Narr_n209iAzIr0WviIYfmMzOeA">100</ix:nonFraction> split equally between the two founders and officers of Quoin Inc. In connection with the Merger transaction, the <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_10_28_2021_To_10_28_2021_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_mUqRXFqR1ECf-wx_GoaCVw" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfFounderShareholders" scale="0" id="Narr_hOcEYcFBWkGbtl71XJLMEA">two</ix:nonFraction> founders exchanged their shares in Quoin Inc. for <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="Duration_10_28_2021_To_10_28_2021_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_diR-VbZf8UOv3DslL7EeEg" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesConversionOfConvertibleSecurities" scale="0" id="Narr_UhIEQW2aTU-2KtIQCvLpjA">240,292</ix:nonFraction> ADSs in Quoin&#160;Ltd., which was subsequently reduced to <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="Duration_5_1_2022_To_5_31_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_7-HAWnoFVkKyMoHyk-x1Jg" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesConversionOfConvertibleSecurities" scale="0" id="Narr_EC8j9kNILkG1ElxxmUT1-Q">224,388</ix:nonFraction> ADSs in May 2022 following the determination of the number of shares held in escrow allocated to certain former shareholders of Cellect. All share and per share amounts have been adjusted to reflect this recapitalization.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Quoin Ltd.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">As of December&#160;31, 2021, Quoin Ltd.&#8217;s authorized share capital consisted of <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_12_31_2021_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_WJAIbiybYUq9ZrQ4R4OxFg" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_GkAjUVWPyUSmSn-pMyTHRw">12,000,000,000</ix:nonFraction> ordinary shares, no par value. These ordinary shares are not redeemable and do not have any preemptive rights. However, the Investor has certain approval rights in connection with the issuance of additional shares. Holders of our ordinary shares have <ix:nonFraction unitRef="Unit_Standard_Vote_Ehgjm50frEulBVLsIRgMmw" contextRef="As_Of_12_31_2021_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_WJAIbiybYUq9ZrQ4R4OxFg" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:SharesNumberOfVotes" scale="0" id="Narr_cy2ekkySc0ST04-lMeOdNw">one</ix:nonFraction> vote for each ordinary share held on all matters submitted to a vote of shareholders at a shareholders meeting. Shareholders may vote at shareholders meetings either in person, by proxy or by written ballot. Israeli law does not allow public companies to adopt shareholder resolutions by means of written consent in lieu of a shareholders meeting. The board of directors shall determine and provide a record date for each shareholders meeting and all shareholders at such record date may vote. Unless stipulated differently in the Companies Law or in the articles of association, all shareholders&#8217; resolutions shall be approved by a simple majority vote.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Under Israeli law, the Company may declare and pay dividends only if, upon the determination of our board of directors, there is no reasonable concern that the distribution will prevent us from being able to meet the terms of our existing and foreseeable obligations as they become due. Under the Companies Law, the distribution amount is further limited to the greater of retained earnings or earnings generated over the <ix:nonFraction unitRef="Unit_Standard_Y_NgoQ05jOskWjULKQ1sEv4w" contextRef="As_Of_12_31_2021_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_WJAIbiybYUq9ZrQ4R4OxFg" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfYearsIncomeForDistributionLimit" scale="0" id="Narr_vWjVxYvddESUOrfkusP81Q">two</ix:nonFraction> most recent&#160;years legally available for distribution according to our then last reviewed or audited financial statements, provided that the date of the financial statements is not more than <ix:nonNumeric contextRef="Duration_1_1_2021_To_12_31_2021_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_CBGmWCk68kq1gG1FuWFXhQ" format="ixt-sec:durwordsen" name="qnrx:DateOfFinancialStatementsAndDistributionPeriodMaximum" id="Narr_rDh7UYjS7U2nsJQIIzyOZA">six&#160;months</ix:nonNumeric> prior to the date of distribution. In the event that the Company does not have retained earnings or earnings generated over the <ix:nonFraction unitRef="Unit_Standard_Y_NgoQ05jOskWjULKQ1sEv4w" contextRef="As_Of_12_31_2021_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_WJAIbiybYUq9ZrQ4R4OxFg" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfYearsIncomeForDistributionLimit" scale="0" id="Narr_CMLUJS2cK0mQil8ofIIw3Q">two</ix:nonFraction> most recent&#160;years legally available for distribution, the Company may seek the approval of the court in order to distribute a dividend. The court may approve our request if it determines that there is no reasonable concern that the payment of a dividend will prevent the Company from satisfying our existing and foreseeable obligations as they become due.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Bank of New York Mellon, as depositary, has registered and delivered American Depositary Shares, also referred to as ADSs. Post August 1, 2022 change in ADS ratio, each ADS represents (<ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_8_1_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_NUGeGsYnbU2t4glCBBCieQ" decimals="INF" format="ixt:numdotdecimal" name="qnrx:NumberOfOrdinarySharesForAmericanDepositaryShares" scale="0" id="Narr_-2hgxxlxSUyvKDfC6hgPgA">5,000</ix:nonFraction>) ordinary shares (or a right to receive five thousand (<ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_8_1_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_NUGeGsYnbU2t4glCBBCieQ" decimals="INF" format="ixt:numdotdecimal" name="qnrx:NumberOfOrdinarySharesForAmericanDepositaryShares" scale="0" id="Narr_Lk2Ygdcti0uAE0vcftWGhQ">5,000</ix:nonFraction>) ordinary shares). Each ADS will also represent any other securities, cash or other property which may be held by the depositary. ADSs may be held either (a)&#160;directly (1)&#160;by having an American Depositary Receipt, also referred to as an ADR, which is a certificate evidencing a specific number of ADSs or (2)&#160;by having uncertificated ADSs, or (b)&#160;indirectly by holding a security entitlement in ADSs through a broker or other financial institution that is a direct or indirect participant in The Depository Trust Company, also called DTC.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Warrants and Options</b></p><ix:nonNumeric contextRef="Duration_1_1_2021_To_12_31_2021_OJr2skXNqkqIByWrd_VGSQ" name="us-gaap:ScheduleOfStockholdersEquityNoteWarrantsOrRightsTextBlock" id="Group_Mk0O0jBk5k6k62Cr0N4jIA" continuedAt="Group_Mk0O0jBk5k6k62Cr0N4jIA_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">The following vested stock options and warrants were outstanding at December&#160;31, 2021, exercisable into ADSs:</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:64.34%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.63%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.82%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.63%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.01%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.63%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.98%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td></tr><tr><td style="vertical-align:bottom;white-space:nowrap;width:64.34%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:8pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.63%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt 0pt 0.05pt 0pt;">&#160;&#160;&#160;&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.82%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">ADSs</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.63%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt 0pt 0.05pt 0pt;">&#160;&#160;&#160;&#160;</p></td><td colspan="2" style="vertical-align:bottom;white-space:nowrap;width:11.93%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">Exercise Price</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.63%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt 0pt 0.05pt 0pt;">&#160;&#160;&#160;&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.98%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">Year of maturity</b></p></td></tr><tr><td style="vertical-align:bottom;width:64.34%;back