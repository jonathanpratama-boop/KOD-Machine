.89%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Research contract expenses</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.29%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.46%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.37%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_r0zB2TDpJE2o8Ldkynx9Gw" decimals="0" format="ixt:numdotdecimal" name="qnrx:Accruedresearchcontractexpensescurrent" scale="0" id="Tc_EKZztGK5XEeQsImH6wSybA_7_3">193,537</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.29%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.46%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.2%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2020_f1EhT_zVtUu_YseciKC3uw" decimals="0" format="ixt:numdotdecimal" name="qnrx:Accruedresearchcontractexpensescurrent" scale="0" id="Tc_W4JlJJstNUWdZnLQ8exB2Q_7_6">105,052</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:73.89%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Other expenses</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.29%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.46%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.37%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_r0zB2TDpJE2o8Ldkynx9Gw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:OtherAccruedLiabilitiesCurrent" scale="0" id="Tc_qAfKlLCzTEOUTR7bvSG9Qg_8_3">5,976</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.29%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.46%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.2%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2020_f1EhT_zVtUu_YseciKC3uw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:OtherAccruedLiabilitiesCurrent" scale="0" id="Tc_aMH4Uy8jUUCfAWQuTTfxVw_8_6">5,802</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:73.89%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Total</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.29%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.46%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">$</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.37%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_r0zB2TDpJE2o8Ldkynx9Gw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="0" id="Tc_MhUqxyg24UiFIwCaoSDpIw_9_3">1,685,409</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.29%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.46%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">$</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.2%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2020_f1EhT_zVtUu_YseciKC3uw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="0" id="Tc_TUD4yi-VmES9N78i56DSSw_9_6">960,848</ix:nonFraction></b></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2021_To_12_31_2021_OJr2skXNqkqIByWrd_VGSQ" name="us-gaap:AssetAcquisitionTextBlock" id="Tb_iR5NNuGxWkaLQk4R_mamYw" continuedAt="Tb_iR5NNuGxWkaLQk4R_mamYw_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTE&#160;9&#160;&#8211; ASSET ACQUISITION AND IN-LICENSED TECHNOLOGY</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Polytherapeutics</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">On March&#160;24, 2018, Quoin Inc. entered into a securities purchase agreement (the &#8220;Acquisition Agreement&#8221;), in which it agreed to acquire all of the equity interests in Polytherapeutics,&#160;Inc. (the &#8220;Seller&#8221; or &#8220;Polytherapeutics&#8221;) for $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_3_24_2018_To_3_24_2018_us-gaap_AssetAcquisitionAxis_qnrx_SecuritiesPurchaseAgreementInPolytherapeuticsincMember_GhrNA9Fm_E2KjrTec77Egw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AssetAcquisitionConsiderationTransferred" scale="0" id="Narr_p5M4nf_GCki-3hU4N2K-gg">40,833</ix:nonFraction> and future royalties provided Quoin Inc. commercializes products using the technology developed by the Seller. The terms of any royalty payments to the Seller are <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="As_Of_3_24_2018_us-gaap_AssetAcquisitionAxis_qnrx_SecuritiesPurchaseAgreementInPolytherapeuticsincMember_eZ_UOsWIQECdKKmIZCMmGw" decimals="3" format="ixt:numdotdecimal" name="qnrx:Acquisitionagreementroyaltypaymentspercentageofnetrevenue" scale="-2" id="Narr_SA1lO-gVME-DJ6wb09ljHw">4.0</ix:nonFraction>% of the net revenue of royalty products, as defined in the Acquisition Agreement, received by Quoin Inc. during the ten (<ix:nonNumeric contextRef="Duration_3_24_2018_To_3_24_2018_us-gaap_AssetAcquisitionAxis_qnrx_SecuritiesPurchaseAgreementInPolytherapeuticsincMember_GhrNA9Fm_E2KjrTec77Egw" format="ixt-sec:duryear" name="qnrx:Royaltypaymentperiod" id="Narr_WPAWP0JUJUqvo-XJDYAATg">10</ix:nonNumeric>)&#160;year period commencing from the date of first sale of a royalty product. If a generic product is introduced by a third party to the market, during the royalty period, the royalty fees shall be reduced from <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_1_1_2020_To_12_31_2020_us-gaap_AssetAcquisitionAxis_qnrx_SecuritiesPurchaseAgreementInPolytherapeuticsincMember_U5hRlwsLD0KON3BFoE3otw" decimals="2" format="ixt:numdotdecimal" name="qnrx:Acquisitionagreementroyaltypaymentspercentageofnetrevenuewithonegenericproductintroduced" scale="-2" id="Narr_0Lo3jDwty0GekevqEQCevw">4</ix:nonFraction>% to <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_AssetAcquisitionAxis_qnrx_SecuritiesPurchaseAgreementInPolytherapeuticsincMember_j0-Y1cGuYU-nfA04MN_Zjg" decimals="2" format="ixt:numdotdecimal" name="qnrx:Acquisitionagreementroyaltypaymentspercentageofnetrevenuewithonegenericproductintroduced" scale="-2" id="Narr_dGZWVqtEH0WnlDKMaD0VfA">2</ix:nonFraction>%. If, during the royalty period, two or more generic products are introduced, the royalty fees shall be reduced from <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_1_1_2020_To_12_31_2020_us-gaap_AssetAcquisitionAxis_qnrx_SecuritiesPurchaseAgreementInPolytherapeuticsincMember_U5hRlwsLD0KON3BFoE3otw" decimals="2" format="ixt:numdotdecimal" name="qnrx:Acquisitionagreementroyaltypaymentspercentageofnetrevenuewithtwogenericproductintroduced" scale="-2" id="Narr_O3w9a-ard0eOk2zfZxCCqA">2</ix:nonFraction>% to <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_1_1_2021_To_12_31_2021_us-gaap_AssetAcquisitionAxis_qnrx_SecuritiesPurchaseAgreementInPolytherapeuticsincMember_j0-Y1cGuYU-nfA04MN_Zjg" decimals="2" format="ixt:numdotdecimal" name="qnrx:Acquisitionagreementroyaltypaymentspercentageofnetrevenuewithtwogenericproductintroduced" scale="-2" id="Narr_wnuH7l9IUUiVhE1xoKEXjQ">0</ix:nonFraction>%.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Seller had the option to repurchase the intellectual property for $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_9_30_2021_us-gaap_AssetAcquisitionAxis_qnrx_SecuritiesPurchaseAgreementInPolytherapeuticsincMember_k6G5xbKRdEuAx1cqJ8wbLg" decimals="0" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionrepurchaseofintellectualproperty" scale="0" id="Narr_WuDqiCNHIEyZ2gpqoSDIgw">100,000</ix:nonFraction> if there were no products in clinical development using such technology.<span style="font-size:12pt;"> </span>The repurchase option was not exercised and has lapsed.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Quoin Inc. also entered into a research and consulting agreement which commits Quoin Inc. to pay the Seller for additional research and development consulting services (See Notes&#160;12 and 15).</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">Skinvisible</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">On October&#160;17, 2019, Quoin Inc. entered into an exclusive license agreement with Skinvisible&#160;Inc. (&#8220;Skinvisible&#8221;), pursuant to which Skinvisible granted a license to use certain patented technology for the development of products for commercial sale in the </p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-37</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">QUOIN PHARMACEUTICALS LTD.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">Notes to Consolidated Financial Statements</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">December 31, 2021, 2020 and 2019</b></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_iR5NNuGxWkaLQk4R_mamYw_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;">orphan rare skin disease field, and for the use of a proprietary polymer deliver system technology. This technology is currently being used in the development of QRX003. In exchange for the license, Quoin Inc. agreed to pay Skinvisible $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_10_17_2019_To_10_17_2019_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_Cdb7Ss5n1kS4tQhbxeYzHA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AssetAcquisitionConsiderationTransferred" scale="0" id="Narr_petC1qRd5U-Mw9z8jFwvsQ">1,000,000</ix:nonFraction>, as well as development and sales milestone payments and a single digit royalty on all net sales, as defined.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The development milestones originally required payments upon achieving development milestones for the first Rare Skin Disease drug product developed using the licensed technology and the first two Ketamine products, as defined. Payments were originally due upon successful completions of certain clinical milestones ($<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_MoIcvNGxZUuatkRWkCk7Vg" decimals="-5" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementclinicalmilestone" scale="6" id="Narr_fBvJfV_o4EmEAsJzF4dLFw">7.5</ix:nonFraction> million) and obtaining US and EU regulatory approval ($<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_MoIcvNGxZUuatkRWkCk7Vg" decimals="-6" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementregulatoryapprovalmilestone" scale="6" id="Narr_84KG_oCbD0G9yiEcb3TXPw">15</ix:nonFraction> million). The sales milestones required for every licensed product commercialized by Quoin Inc. are $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_StatementScenarioAxis_qnrx_SalesmilestonestieroneMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_f0AXT_RzTUuaAWeYAiXT-Q" decimals="-6" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementsalesmilestone" scale="6" id="Narr_LAW2KDEsGE6Y5YDfMQgSjw">10</ix:nonFraction> million upon achievement of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_StatementScenarioAxis_qnrx_SalesmilestonestieroneMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_f0AXT_RzTUuaAWeYAiXT-Q" decimals="-6" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementsalesmilestonesalesachievement" scale="6" id="Narr_FFft0v468keEIm512Cxtxg">100</ix:nonFraction> million in sales being achieved in the annual period; $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_StatementScenarioAxis_qnrx_SalesmilestonestiertwoMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_sX8dmfQMjk2MY_YNNFuipQ" decimals="-6" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementsalesmilestone" scale="6" id="Narr_Avi5whlSPEeLu2VZoX5thg">25</ix:nonFraction> million upon achievement of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_StatementScenarioAxis_qnrx_SalesmilestonestiertwoMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_sX8dmfQMjk2MY_YNNFuipQ" decimals="-6" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementsalesmilestonesalesachievement" scale="6" id="Narr_2FithwFTy06blcIo5jiCsg">250</ix:nonFraction> million in sales and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_StatementScenarioAxis_qnrx_SalesmilestonestierthreeMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_0s4V-qkNX0SOUPd28MKkrA" decimals="-6" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementsalesmilestone" scale="6" id="Narr_VZ9wy-uc4EaXr97DSiyDLA">50</ix:nonFraction> million upon the achievement of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_StatementScenarioAxis_qnrx_SalesmilestonestierthreeMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_0s4V-qkNX0SOUPd28MKkrA" decimals="-6" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementsalesmilestonesalesachievement" scale="6" id="Narr__I47-PSqDEevB8McBIbzgg">400</ix:nonFraction> million in sales in an annual period. On January&#160;27, 2021, Quoin Inc. and Skinvisible entered into an amendment which modified the clinical milestone payment requirements such that $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_1_27_2021_srt_StatementScenarioAxis_qnrx_AmendmentnumberthreeMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_o3J4Ua9JTUuJyIpzpUj9oA" decimals="0" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementclinicalmilestone" scale="0" id="Narr_X_hKLq6bwESHnOGgxg4T9A">750,000</ix:nonFraction> would be payable to Skinvisible upon achievement of specified clinical milestones, and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_1_27_2021_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_5JhLYFPzN0S-9kTEPh7oNA" decimals="-4" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementregulatoryapprovalmilestone" scale="6" id="Narr_OAaSKV3_u0WlzwC3MPIfig">21.75</ix:nonFraction> million upon regulatory approval in the U.S. and EU respectively.<span style="font-size:12pt;"> </span>No development milestones, sales milestones or royalty payments were due through in 2019, 2020 or 2021.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The agreement has a termination clause that is triggered if no product has commenced clinical testing 12 months after the date of the agreement or the latest subsequent amendment. On April 19, 2021, Quoin Inc. and Skinvisible entered into another amendment which established the development deadline as December 31, 2022. Should the Company not commence clinical testing as defined by the development deadline, the license agreement will terminate immediately except in certain circumstances as specified in the agreement.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The license fee was originally due in two equal installments of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2019_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_h29pLFOGQUSxtdfDn-6MHw" decimals="0" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionconsiderationtransferredinstallmentamounts" scale="0" id="Narr_9cQhsdjs-kKG1UHAxj7L7w">500,000</ix:nonFraction> payable no later than December 31, 2019 and June 30, 2020, which were not paid. The agreement was subsequently amended for payment due on July 31, 2020. On July 31, 2020, the agreement was amended to further extend the payment until September 30, 2020. On September 30, 2020, the agreement was again amended, requiring payment of the license fee only when outside financing is received, as defined in the agreement. On June&#160;21, 2021, the parties entered into an additional amendment which modified the payment terms and required a payment of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_6_26_2021_srt_StatementScenarioAxis_qnrx_AmendmentnumberfiveMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_wwC68UdQi02wzRJl-kjEUQ" decimals="0" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionconsiderationtransferredfirstpayment" scale="0" id="Narr_-YExEymwp06f1fanfZVZ1A">107,500</ix:nonFraction> on June&#160;26, 2021, a payment of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_7_10_2021_srt_StatementScenarioAxis_qnrx_AmendmentnumberfiveMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_g3_fxpIR5kq0dk9RIPdwzg" decimals="0" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionconsiderationtransferredsecondpayment" scale="0" id="Narr_n5nPLsXVAEKg74hkapD_tQ">250,000</ix:nonFraction> within 10&#160;days of the Primary Financing, and the remaining $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_StatementScenarioAxis_qnrx_AmendmentnumberfiveMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_8d1a3NDdh0uReNzlBaEyhw" decimals="0" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionconsiderationtransferredthirdpayment" scale="0" id="Narr_NTAictW9cU2mpe1chuZqwg">250,000</ix:nonFraction> upon the earlier of approval of an Investigatory New Drug application by the FDA or December&#160;31, 2021. This amendment also eliminated the $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_1_27_2021_srt_StatementScenarioAxis_qnrx_AmendmentnumberthreeMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_o3J4Ua9JTUuJyIpzpUj9oA" decimals="0" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementclinicalmilestone" scale="0" id="Narr_-IhoiDx-9E-gEztF06J1Sw">750,000</ix:nonFraction> clinical milestone payments described above and reduced the milestone payment upon regulatory approval of the product containing the Skinvisible technology in either the U.S. or E.U., whichever happens first to a total of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_1_27_2021_srt_StatementScenarioAxis_qnrx_AmendmentnumberthreeMember_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_o3J4Ua9JTUuJyIpzpUj9oA" decimals="0" format="ixt:numdotdecimal" name="qnrx:Assetacquisitionagreementregulatoryapprovalmilestone" scale="0" id="Narr__Kx3-sg4y0CQWmsdHHUZ-w">5,000,000</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">At December&#160;31, 2021 and December&#160;31, 2020, the license acquisition liability due was $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_MoIcvNGxZUuatkRWkCk7Vg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AssetAcquisitionContingentConsiderationLiability" scale="0" id="Narr_V5tRrp4nV0mxKU7rU_BypA">250,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2020_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_KmlTdHiESUmNSxDVBlD_pg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AssetAcquisitionContingentConsiderationLiability" scale="0" id="Narr_QFyckBrMa0iuiuKSYFUjqQ">875,000</ix:nonFraction> respectively. In March 2022, the Company paid $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_3_1_2022_To_3_31_2022_us-gaap_AssetAcquisitionAxis_qnrx_SkinvisiblelicenseagreementMember_pff7qm6JTkmfExNY6pzbNQ" decimals="0" format="ixt:numdotdecimal" name="qnrx:AssetAcquisitionPaymentsForContingentConsideration" scale="0" id="Narr_WmLTP4sUvk-3qZKxcMG4Yg">50,000</ix:nonFraction> against this liability. The remaining license acquisition liability has not been paid in accordance with the terms but has not impaired the Company&#8217;s rights to the technology as the Company is in the process of renegotiating this payment with Skinvisible.</p></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><a id="Tc_vpR1Z_tj002XAWYMZCvBrQ_1_2"></a><a id="Tc_4sClJx31jkCxls0q1AgW1Q_2_2"></a><a id="Tc_2MWWj3mTXUSAmHYlsIywmg_2_5"></a><a id="Tc_ghg4uoacaU-Whm7L4RvDRw_3_0"></a><a id="Tc_gwH6uJc1uUeLNsxyZNPLuw_3_2"></a><a id="Tc_KHcqDbUHnEuR7GDZGvHH8g_3_5"></a><a id="Tc_3LIGIv6yIECx9J0pSbIiaQ_4_0"></a><a id="Tc_HH43_CBcl06r79Btrwjm3g_5_0"></a><a id="Tc_Kfoj8HpoZ06B02kjJoVS9g_6_0"></a><a id="Tc_YpO7pYHOJEGNPezjCNnl3A_7_0"></a><a id="Tc_JKoOUd0sXUGtHc0gpDK8AQ_7_2"></a><a id="Tc_QmcOTdEa2Ey2LUmjjnFt1A_7_5"></a><ix:nonNumeric contextRef="Duration_1_1_2021_To_12_31_2021_OJr2skXNqkqIByWrd_VGSQ" name="us-gaap:IntangibleAssetsDisclosureTextBlock" id="Tb_JPAL6h8lp0iupl-K_1aPeQ" continuedAt="Tb_JPAL6h8lp0iupl-K_1aPeQ_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTE&#160;10&#160;- INTANGIBLE ASSETS</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">Intangible assets are as follows:</p><ix:nonNumeric contextRef="Duration_1_1_2021_To_12_31_2021_OJr2skXNqkqIByWrd_VGSQ" name="us-gaap:ScheduleOfFiniteLivedIntangibleAssetsTableTextBlock" id="Tb_PQMSZUPP-0Gy9lrivz2-Zg" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:73.84%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.41%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.37%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.44%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.36%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></td></tr><tr><td style="vertical-align:bottom;width:73.84%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:8pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">&#160;&#160;&#160;&#160;</b></p></td><td colspan="5" style="vertical-align:bottom;white-space:nowrap;width:23.87%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">December&#160;31,&#160;</b></p></td></tr><tr><td style="vertical-align:bottom;width:73.84%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:8pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td colspan="2" style="vertical-align:bottom;white-space:nowrap;width:10.79%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">2021</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">&#160;&#160;&#160;&#160;</b></p></td><td colspan="2" style="vertical-align:bottom;white-space:nowrap;width:10.8%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">2020</b></p></td></tr><tr><td style="vertical-align:bottom;width:73.84%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Acquired technology &#8211; Polytherapeutics</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.41%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.37%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_us-gaap_FiniteLivedIntangibleAssetsByMajorClassAxis_us-gaap_TechnologyBasedIntangibleAssetsMember_TN3Hss6ytkeWNFjLB6LRdA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:FiniteLivedIntangibleAssetsGross" scale="0" id="Tc_1Nu_Hw9Ng0S1BOAmIgdvyQ_3_3">40,433</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.44%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.36%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2020_us-gaap_FiniteLivedIntangibleAssetsByMajorClassAxis_us-gaap_TechnologyBasedIntangibleAssetsMember_EDH7BJjUCUmvccZKZQgWAw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:FiniteLivedIntangibleAssetsGross" scale="0" id="Tc_PC9ftTbM6UWNzhatet0ndA_3_6">40,433</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:73.84%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Technology license &#8211; Skinvisible</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.27%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.41%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.37%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt