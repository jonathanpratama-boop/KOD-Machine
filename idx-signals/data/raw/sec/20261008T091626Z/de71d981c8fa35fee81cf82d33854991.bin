s New Roman','Times','serif';font-size:10pt;margin:0pt;">Long-term portion</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.36%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.5%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">$</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:8.72%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_9_30_2022_7GIExDBHm02Re8_tZEquCw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToOfficersOrStockholdersNoncurrent" scale="0" id="Tc_gqjQ1NOQMUqRPOJYw0_uZg_7_3">3,673,733</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.36%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.5%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">$</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:8.72%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_r0zB2TDpJE2o8Ldkynx9Gw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:DueToOfficersOrStockholdersNoncurrent" scale="0" id="Tc_bGllXOppS02fHaCrHiVDTQ_7_6">4,123,732</ix:nonFraction></b></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Expenses:</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Research and development expense to a related party, incurred in the three and nine&#160;months ended September&#160;30, 2022 and 2021 was approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2022_To_9_30_2022_us-gaap_RelatedPartyTransactionAxis_qnrx_ConsultingExpenseMember__qIWGytlm06HXXrpRcI-NA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_HwPx0gpX6USxxE89hwAYDA">12,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2021_To_9_30_2021_us-gaap_RelatedPartyTransactionAxis_qnrx_ConsultingExpenseMember_u50duBBgaEyisgGhpXxi_w" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_av_dHyc090SE_fGaRiuRCw">0</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2022_To_9_30_2022_us-gaap_RelatedPartyTransactionAxis_qnrx_ConsultingExpenseMember_odE2d8aqoUOIzk89vpIcWw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_1wbZlesWZkK728kSzj9QUA">36,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2021_To_9_30_2021_us-gaap_RelatedPartyTransactionAxis_qnrx_ConsultingExpenseMember_dvvsINrafEGZBPAUbhQ5ZQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:RelatedPartyTransactionExpensesFromTransactionsWithRelatedParty" scale="0" id="Narr_54mG_hOaN0aGc7uU7Gnsbw">0</ix:nonFraction>, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">For the nine months ended September 30, 2021, the Company paid a consulting fee of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2021_To_9_30_2021_3K9oeaghRUK7qOQ2iko1mQ" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingFees" scale="0" id="Narr_bG5AWAaSiEqxF4UkzFZChQ">100,000</ix:nonFraction> to a board member.</p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-17</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">QUOIN PHARMACEUTICALS LTD.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Notes to Consolidated Financial Statements</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">September 30, 2022 and 2021</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_rNyK1b6gNUCK2rzjQvb4RA_cont1"></ix:continuation><ix:nonNumeric contextRef="Duration_1_1_2022_To_9_30_2022_95QvxpsMLEadfRLkB6vVPg" name="us-gaap:CommitmentsDisclosureTextBlock" id="Tb_zQQMijLrOUOuV8nm6L913Q" continuedAt="Tb_zQQMijLrOUOuV8nm6L913Q_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">NOTE&#160;13&#160;&#8211; RESEARCH, CONSULTING AND OTHER COMMITMENTS</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Research and consulting agreement:</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Quoin&#160;Inc. entered into a research and consulting agreement which commits it to pay the former owner of Polytherapeutics (the &#8220;Consultant&#8221; or &#8220;Seller&#8221;) to transfer the technical know-how of Polytherapeutics with respect to (i)&#160;good manufacturing practices (&#8220;GMP&#8221;), clinical and commercial manufacturing of the Company&#8217;s PolyDur polymer and (ii)&#160;formulation development of products utilizing the Company&#8217;s PharmaDur polymer. The agreement required&#160;monthly consulting payments of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_2_28_2021_srt_CounterpartyNameAxis_qnrx_PolytherapeuticsMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_4q8tX1jslkiVoBIAsL9KmA" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementMonthlyPayment" scale="0" id="Narr_7Cmr8BO41EKK7cG7Y0sgfg">20,833</ix:nonFraction> beginning on July&#160;31, 2018 and ending February&#160;28, 2021 (the &#8220;Post-Closing Period&#8221;) for a total of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_2_28_2021_srt_CounterpartyNameAxis_qnrx_PolytherapeuticsMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_4q8tX1jslkiVoBIAsL9KmA" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_leJVCO64B0asErMx6Da_SQ">666,667</ix:nonFraction> over the consulting period. Pursuant to an amendment, the Post-Closing Period was revised to terminate on December&#160;31, 2020.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Through September&#160;30, 2022 and the financial statement issuance date, the Company has not made any payments, the Consultant has not performed any services and the Company has not incurred or accrued for any expenses. See Note&#160;15 for Consultant&#8217;s notification of breach of contract.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Other research consulting agreements:</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Quoin Inc. entered into <ix:nonFraction unitRef="Unit_Standard_agreement_9p6FVc7vOUSrtDYQ4do14w" contextRef="Duration_7_1_2018_To_7_31_2018_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_u_TEzJHTjUiUqxLi8nD58A" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfAgreement" scale="0" id="Narr_oK8XhEsV50-8CRawpBP04Q">three</ix:nonFraction> consulting agreements with Axella Research LLC (&#8220;Axella&#8221;) to provide regulatory and pre- clinical/clinical services to the Company with respect to QRX003 and QRX004. The combined fees of the three agreements are approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2018_To_7_31_2018_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_3wvVc29z7k6cLcRn9wcwZg" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementNumberOptionsToPay" scale="0" id="Narr_nN8rp9o59ESC6-LTZXIGgQ">270,000</ix:nonFraction>, payable as milestones were met. The Company incurred accrued expenses of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_uyoJwJLwv06Fugip5IBOYQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="0" id="Narr_mzgMbn0m4kSHyll3hIGwWw">194,000</ix:nonFraction> in relation to Axella consulting agreements as of December 31, 2021. In September 2022 the Company issued <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="Duration_1_1_2022_To_9_30_2022_95QvxpsMLEadfRLkB6vVPg" decimals="INF" format="ixt:numdotdecimal" name="qnrx:StockIssuedDuringPeriodSharesSettlementOfAccruedLiabilities" scale="0" id="Narr_-e50qZeXR0KP7TooLyespw">44,187</ix:nonFraction> ADS&#8217;s to one of Axella&#8217;s principals to settle the outstanding liability in full. The Company incurred <ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2021_To_9_30_2021_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_OYZaJuw1qUej5zwKJWsKrQ" decimals="0" format="ixt-sec:numwordsen" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_Ke5gWValUkq_H1Aj4H6Q3A"><ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2021_To_9_30_2021_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_Fzu1_cmdZUGIrj_fUBI05w" decimals="0" format="ixt-sec:numwordsen" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_2b5ITwlxOUy9tw2VGT4iSw"><ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2022_To_9_30_2022_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_qPqQHY92rkyIN9QPxO8Tag" decimals="0" format="ixt-sec:numwordsen" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_DFWEQG-AnE69KGsK5TcFJA"><ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2022_To_9_30_2022_srt_CounterpartyNameAxis_qnrx_AxellaResearchLlcMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_QM-r3urCEUStkzXDcwqHPA" decimals="0" format="ixt-sec:numwordsen" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_qCGci2rze0Gbx51i8e8jVA">no</ix:nonFraction></ix:nonFraction></ix:nonFraction></ix:nonFraction> research and development expenses in connection with these agreements, for both of the three and nine months ended September 30, 2022 and 2021, as no services were provided.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In November&#160;2020, Quoin&#160;Inc. entered into a Master Service Agreement for an initial term of <span style="-sec-ix-hidden:Hidden_uP9IyzYKfU60amHrv2oceQ;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">three&#160;years</span></span> with Therapeutics&#160;Inc. for managing preclinical and clinical development for new products in the field of dermatology. The agreement required the execution of individual work orders. Quoin&#160;Inc. may terminate any work order for any reason with <ix:nonNumeric contextRef="Duration_11_1_2020_To_11_30_2020_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_UGw-XqSnrkmJnP6Q9_jkWw" format="ixt-sec:durwordsen" name="qnrx:AgreementWrittenTerminationNotice" id="Narr_nb24snGzkU65rZgNejuxvg">90&#160;days</ix:nonNumeric> written notice subject to costs incurred through termination and a defined termination fee, unless there is a material breach by Therapeutics&#160;Inc. The latest work order was entered into in June&#160;2022 for a clinical study at an expected estimated cost of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_6_30_2022_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_PY1tZpJ8SU-JsmRTc4JBMA" decimals="-5" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="6" id="Narr_NN8rNRBxRU2OLsIAFN1bAw">4.4</ix:nonFraction> million through the second quarter of 2024. For the three and&#160;nine&#160;months ended September&#160;30, 2022 and 2021, the Company incurred a research and development expense under this agreement of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2022_To_9_30_2022_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_nZc8esK2b0Gg_Nh-ma5fnw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_byjUXkL2ekqsTS_Ow11eNg">423,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2022_To_9_30_2022_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_ypu0HlOKsUGroTkEQIbAXw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_vcpII7lfqUK0EiEbXLtQVQ">904,000</ix:nonFraction>, and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2021_To_9_30_2021_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_ns178e_0_kOzqQR4ksAleA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_fgL_7YT3FEuEw-PPUedXVQ">88,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2021_To_9_30_2021_srt_CounterpartyNameAxis_qnrx_TherapeuticsInc.Member_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_1eS4Igbv70GBjP_sZ3-vgA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_QSy6_0Kj70C63KG1yixbqg">232,000</ix:nonFraction> respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In November&#160;2021, the Company entered into a commitment with Queensland University of Technology for research related services associated with Netherton Syndrome of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_11_30_2021_srt_CounterpartyNameAxis_qnrx_NethertonSyndromeMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_8OFEGp6kn0-yg4BnKlvhvA" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_gUWE0bSI0USoAlAbldzkxg">250,000</ix:nonFraction> for an expected period of eighteen&#160;months. For the&#160;three and nine&#160;months ended September&#160;30, 2022, the Company incurred research and development costs related to this agreement of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2022_To_9_30_2022_srt_CounterpartyNameAxis_qnrx_NethertonSyndromeMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_efRa5aQej0SCU0wlerxL3w" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_3IdOQglPPkmbKjPdeeud3A">35,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2022_To_9_30_2022_srt_CounterpartyNameAxis_qnrx_NethertonSyndromeMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_tANx5uTw9Uiar5whZLsaqg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_MDjFSAkDmUGeYmASi9b0-A">112,000</ix:nonFraction>, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In May&#160;2022, the Company entered into a commitment with Queensland University of Technology for research related services associated with Scleroderma of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_5_31_2022_srt_CounterpartyNameAxis_qnrx_SclerodermaMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_oVewi5Ai60SZKyC7dI_xiQ" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementAgreedAmount" scale="0" id="Narr_2RxnAOSoHk6Q5Z2fGTv1cg">610,000</ix:nonFraction> for an expected period of eighteen&#160;months. The Company incurred research and development expenses of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2022_To_9_30_2022_srt_CounterpartyNameAxis_qnrx_SclerodermaMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_JGIh95WP9UC48Lzp9o2fhA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_pgEkB7Sw2EKCS0ru4DN5lA"><ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2022_To_9_30_2022_srt_CounterpartyNameAxis_qnrx_SclerodermaMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_kW05yALTH0mtDq8EvL9qNw" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ResearchAndDevelopmentExpense" scale="0" id="Narr_0OijXdnp606NAZoBLldXSg">138,000</ix:nonFraction></ix:nonFraction> for the three and nine months ended September 30, 2022. As of September 30, 2022, the Company recorded prepaid research and development costs related to this agreement of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_9_30_2022_srt_CounterpartyNameAxis_qnrx_SclerodermaMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_us-gaap_ResearchAndDevelopmentArrangementMember_vuIPIc4gMUyHDKhtlfwMGw" decimals="0" format="ixt:numdotdecimal" name="qnrx:PrepaidResearchAndDevelopmentCosts" scale="0" id="Narr_X0Gr2AvNsUG6K9aFM_QRpA">85,000</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Consulting agreement:</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">Quoin&#160;Inc. entered into a consulting agreement with an Investor Relations (IR) firm, which provides for a&#160;monthly fee of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_9_30_2022_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_3fQA2ctR8EeDt7E8NrrG2Q" decimals="0" format="ixt:numdotdecimal" name="qnrx:ConsultingOrServiceAgreementMonthlyPayment" scale="0" id="Narr_cPkhlibiJkeNPncSH1TTvQ">14,000</ix:nonFraction>. The agreement had an automatic annual renewal clause and has been in effect since November&#160;2017. The Company owed the IR firm $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="As_Of_12_31_2021_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_6c-j1muNNkCZRbEqnZ_Lyg" decimals="0" format="ixt:numdotdecimal" name="us-gaap:AccruedLiabilitiesCurrent" scale="0" id="Narr_JeQDksyql06Ca06uqWYBbQ">584,000</ix:nonFraction> as of December&#160;31, 2021, which was included in accrued expenses in the accompanying balance sheet. In March&#160;2022, the Company entered into a settlement agreement with the IR firm reducing the liability to $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_3_1_2022_To_3_31_2022_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_-DnylUZfuEqLN-Fc3gnVFA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:GainsLossesOnExtinguishmentOfDebt" scale="0" id="Narr_hJivtERz5EO_QU9d8bzrqg">168,000</ix:nonFraction>, and recognized $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_3_1_2022_To_3_31_2022_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_-DnylUZfuEqLN-Fc3gnVFA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:NonoperatingIncomeExpense" scale="0" id="Narr_7mHU44iWhEG0muE1VaksaQ">416,000</ix:nonFraction> as other income in the accompanying consolidated statement of operations. As of September&#160;30, 2022, the balance of this liability is $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_6_30_2022_To_6_30_2022_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_i6qI_Srkl0WJPxx_JU0vVQ" decimals="0" format="ixt:numdotdecimal" name="us-gaap:GainsLossesOnExtinguishmentOfDebt" scale="0" id="Narr_qW_aJUIaRUmPnMqkVHwbwQ">98,000</ix:nonFraction>. </p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-18</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">QUOIN PHARMACEUTICALS LTD.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Notes to Consolidated Financial Statements</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">September 30, 2022 and 2021</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_zQQMijLrOUOuV8nm6L913Q_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;">For the three and nine&#160;months ended September&#160;30, 2021, the Company incurred expenses of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2021_To_9_30_2021_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_DJQnPA66-km9-15MBg4NZA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ProfessionalFees" scale="0" id="Narr_x3-7o9bI2EyiJWUUUcM2mg">42,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2021_To_9_30_2021_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_o5uaYbO-z0ylXtw4JM1fsA" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ProfessionalFees" scale="0" id="Narr_nPbSwfWHykuwkqCo86SRsA">42,000</ix:nonFraction>, respectively. For the three and nine&#160;months ended September&#160;30, 2022, the Company incurred expenses of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_7_1_2022_To_9_30_2022_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_o2Lql8csTEC9MRzPeogUig" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ProfessionalFees" scale="0" id="Narr_OVHJpRXUBEWI0PRdW69v7A">42,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_1_1_2022_To_9_30_2022_srt_CounterpartyNameAxis_qnrx_InvestorRelationsFirmMember_us-gaap_LongTermPurchaseCommitmentByCategoryOfItemPurchasedAxis_qnrx_ConsultingAgreementMember_WKt7s4bMWkWj5OqFHKEB9g" decimals="0" format="ixt:numdotdecimal" name="us-gaap:ProfessionalFees" scale="0" id="Narr_xtuwVccjx0uMOeboJRnS-Q">70,000</ix:nonFraction>, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Performance milestones and royalties:</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">See Note&#160;10 for asset and in-licensed technology commitments.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Merger agreement commitment:</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In consideration for the Share Transfer disclosed in Note&#160;1, the pre-closing Cellect shareholders received a contingent value right (&#8220;CVR&#8221;) entitling the holders to earnouts during the Payment Period (as such term is defined in the Share Transfer Agreement), comprised mainly of payments upon sale, milestone payments, license fees and exit fees realized by EnCellX. In order to secure such right, shares constituting <ix:nonFraction unitRef="Unit_Standard_pure_C5G16pBtF0ugU8N3BZav8w" contextRef="Duration_1_1_2022_To_9_30_2022_95QvxpsMLEadfRLkB6vVPg" decimals="2" format="ixt:numdotdecimal" name="qnrx:PercentageOfShareCapitalHeldInEscrow" scale="-2" id="Narr_1eT1QZVOtEWwPWzWSN4Fog">40</ix:nonFraction>% of EnCellX share capital are held in escrow.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In connection with the Share Transfer, Cellect entered into a CVR Agreement with Mr.&#160;Eyal Leibovitz, in the capacity of Representative for the holders of CVRs, and Computershare Trust Company, N.A., a federally chartered trust company (the &#8220;Rights Agent&#8221;). Under the terms of the CVR Agreement, the holders of the Cellect ADSs immediately prior to the Merger had the right to receive, through their ownership of CVRs, their pro-rata share of the net Share Transfer consideration, making such holders of CVRs the indirect beneficiaries of the net payments under the Share Transfer. CVRs were recorded in a register administered by the Rights Agent but were not certificated. Since the Company will not receive any net proceeds from the CVR&#8217;s, there is no asset or liability recorded in the consolidated financial statements.</p></ix:continuation><ix:nonNumeric contextRef="Duration_1_1_2022_To_9_30_2022_95QvxpsMLEadfRLkB6vVPg" name="us-gaap:StockholdersEquityNoteDisclosureTextBlock" id="Tb_wnFFdchKWECzRVZS6F3oxQ" continuedAt="Tb_wnFFdchKWECzRVZS6F3oxQ_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">NOTE&#160;14&#160;&#8211; SHAREHOLDERS&#8217; EQUITY</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Company held a Special General Meeting on February 28, 2022, at which the Company&#8217;s shareholders adopted the Amended and Restated Articles of Association of the Company. The Company held its Annual General Meeting on April 12, 2022, at which the Company&#8217;s shareholders approved an increase to the authorized share capital to <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_4_12_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_TrjVrF3G1kinkbwdeLigYw" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_PdE8sR3-NkOcF4xFso7kHg">50,000,000,000</ix:nonFraction> ordinary shares from <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_4_11_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_p7qpE5kF60SSp-qCRTaWPQ" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_NO-3ELt8_UGqDLf5lZkfxA">12,500,000,000</ix:nonFraction>, <ix:nonFraction unitRef="Unit_Divide_USD_shares_GM7M0fpeUEeWbxQzVezuXQ" contextRef="As_Of_4_12_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_TrjVrF3G1kinkbwdeLigYw" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:CommonStockParOrStatedValuePerShare" scale="0" id="Narr_A08KOI0EqkmMxpM72k9NvQ">no</ix:nonFraction> par value. The Company held a further Annual General Meeting on November 3, 2022, at which the Company&#8217;s shareholders approved an increase to the authorized share capital to <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_11_3_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_javhEmEUPkWwBoc_A4SFhA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_M7GurcbL8kCc-CZJFk4zHw">500,000,000,000</ix:nonFraction> ordinary shares from <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_11_2_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_MxGocBarOU2LF6N6o3z13Q" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_oAGVP7hKKkyPOGXULOZHTg">50,000,000,000</ix:nonFraction>, <ix:nonFraction unitRef="Unit_Divide_USD_shares_GM7M0fpeUEeWbxQzVezuXQ" contextRef="As_Of_11_3_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_javhEmEUPkWwBoc_A4SFhA" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:CommonStockParOrStatedValuePerShare" scale="0" id="Narr_puJtiQdVrEi9Ow2mbuMhKg">no</ix:nonFraction> par value (see Note 17). These ordinary shares are not redeemable and do not have any preemptive rights.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Holders of the Company&#8217;s ordinary shares have <ix:nonFraction unitRef="Unit_Standard_Vote_Ehgjm50frEulBVLsIRgMmw" contextRef="As_Of_9_30_2022_7GIExDBHm02Re8_tZEquCw" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:SharesNumberOfVotes" scale="0" id="Narr_S2hU7Yj7oUONTnA2Ev-mug">one</ix:nonFraction> vote for each ordinary share held on all matters submitted to a vote of shareholders at a shareholders meeting. The board of directors shall determine and provide a record date for each shareholders meeting and all shareholders at such record date may vote. Unless stipulated differently in the Companies Law or in the articles of association, all shareholders&#8217; resolutions shall be approved by a simple majority vote.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Under Israeli law, the Company may declare and pay dividends only if, upon the determination of our board of directors, there is no reasonable concern that the distribution will prevent the Company from being able to meet the terms of our existing and foreseeable obligations as they become due. Under the Companies Law, the distribution amount is further limited to the greater of retained earnings or earnings generated over the <ix:nonFraction unitRef="Unit_Standard_Y_NgoQ05jOskWjULKQ1sEv4w" contextRef="As_Of_9_30_2022_7GIExDBHm02Re8_tZEquCw" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfYearsIncomeForDistributionLimit" scale="0" id="Narr_QnQAk4IxIkS1jggWQvnaAg">two</ix:nonFraction> most recent&#160;years legally available for distribution according to our then last reviewed or audited financial statements, provided that the date of the financial statements is not more than <ix:nonNumeric contextRef="Duration_1_1_2022_To_9_30_2022_95QvxpsMLEadfRLkB6vVPg" format="ixt-sec:durwordsen" name="qnrx:DateOfFinancialStatementsAndDistributionPeriodMaximum" id="Narr_ExTKx_WtvUOeSdvX4UyXXg">six months</ix:nonNumeric> prior to the date of distribution. In the event that the Company does not have retained earnings or earnings generated over the <ix:nonFraction unitRef="Unit_Standard_Y_NgoQ05jOskWjULKQ1sEv4w" contextRef="As_Of_9_30_2022_7GIExDBHm02Re8_tZEquCw" decimals="INF" format="ixt-sec:numwordsen" name="qnrx:NumberOfYearsIncomeForDistributionLimit" scale="0" id="Narr_1CIcl-gKIEaYd2RB4ryQSg">two</ix:nonFraction> most recent&#160;years legally available for distribution, the Company may seek the approval of the court in order to distribute a dividend. The court may approve our request if it determines that there is no reasonable concern that the payment of a dividend will prevent the Company from satisfying existing and foreseeable obligations as they become due.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">The Bank of New York Mellon, as depositary, has registered and delivered American Depositary Shares, also referred to as ADSs. Following an ADS ratio adjustment effective August 1, 2022, each ADS represents five thousand (<ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_8_1_2022_us-gaap_StatementClassOfStockAxis_dei_AdrMember_VZ5Ksb5uGEqBHF0r_eeqCQ" decimals="INF" format="ixt:numdotdecimal" name="qnrx:NumberOfOrdinarySharesForAmericanDepositaryShares" scale="0" id="Narr_8MH4ZoEsAU2kmaY9ePgoVw">5,000</ix:nonFraction>) ordinary shares (or a right to receive five thousand (<ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_8_1_2022_us-gaap_StatementClassOfStockAxis_dei_AdrMember_VZ5Ksb5uGEqBHF0r_eeqCQ" decimals="INF" format="ixt:numdotdecimal" name="qnrx:NumberOfOrdinarySharesForAmericanDepositaryShares" scale="0" id="Narr_rk84_1Hq1EGF9OyZsWDsxA">5,000</ix:nonFraction>) ordinary shares). Each ADS will also represent any other securities, cash or other property which may be held by the depositary. ADSs may be held either (a) directly (1) by having an American Depositary Receipt, also referred to as an ADR, which is a certificate evidencing a specific number of ADSs or (2) by having uncertificated ADSs, or (b) indirectly by </p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-19</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">QUOIN PHARMACEUTICALS LTD.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Notes to Consolidated Financial Statements</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">September 30, 2022 and 2021</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc_rPtpZlsy6Emz-AadiVwcKA_1_4"></a><a id="Tc_eEO-tih6pU239SVpvmNs8g_2_2"></a><a id="Tc_wNA-gVPzVUud3zO2sAknWQ_2_4"></a><a id="Tc_cKFuOyTjO0-aua-Q1fctSQ_3_2"></a><a id="Tc_SCXO1X8Qz0ClLLXTCrHxKg_3_4"></a><a id="Tc_QmWz9aJO3E-y1F0qs01gnw_4_2"></a><a id="Tc_GXM6j7mw6kCzoESnNI4x-g_4_4"></a><a id="Tc_N7z3E1Ln90GyUWtA39bvnw_5_0"></a><a id="Tc_D2-MgNve7EuwEa3tJZEjCA_5_4"></a><a id="Tc_W_iBZcGOqUC41MiZXlRWDw_6_0"></a><a id="Tc_1TBd05Gt5UaEiN6c0ZUwww_7_0"></a><a id="Tc_fCVOUagxqUOO9x4OUb5Ejw_8_0"></a><a id="Tc_Ci9M-UatkkirrrwQJ7OMtA_8_5"></a><a id="Tc_Np-z6kpf7E6606OywsdSIQ_9_0"></a><a id="Tc_0WkXpIKWMUeyGsolcFtsZw_9_4"></a><ix:continuation id="Tb_wnFFdchKWECzRVZS6F3oxQ_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;">holding a security entitlement in ADSs through a broker or other financial institution that is a direct or indirect participant in The Depository Trust Company, also called DTC.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">On August 9, 2022 the Company completed an offering (the &#8220;Offering&#8221;) of <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="Duration_8_9_2022_To_8_9_2022_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_RwY8lbXLhUW12zBdTpNwdA" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_wKSBadnE3EC8NSeVxg7q_A">11,050,000,000</ix:nonFraction> ordinary shares represented by <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="Duration_8_9_2022_To_8_9_2022_dei_LegalEntityAxis_qnrx_QuoinPharmaceuticalsIncMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_DN4QuI63eEGWrB10J2o3_g" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_mAftcPtg9UGk5CN5ULU17g">2,210,000</ix:nonFraction> ADSs at a purchase price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_GM7M0fpeUEeWbxQzVezuXQ" contextRef="As_Of_8_9_2022_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_dYtFxYCpiU2kATLaA4Lddw" decimals="2" format="ixt:numdotdecimal" name="us-gaap:SharePrice" scale="0" id="Narr_7Qkxxr4Ps0yT8wZVclN3jw">5.00</ix:nonFraction> per ADS and pre-funded warrants (the &#8220;Pre-Funded Warrants&#8221;) to purchase <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_f3aY8K7oekaHxlhWm3w_xg" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByEachWarrantOrRight" scale="0" id="Narr_BTDr5yf63ECUJYlMGocXjA">5,750,000,000</ix:nonFraction> ordinary shares represented by <ix:nonFraction unitRef="Unit_Standard_shares_Qbnw6BUOh0qJRl-bb0S5Xg" contextRef="As_Of_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_OjgdooHw7kmg5HfsVmkcgw" decimals="INF" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByEachWarrantOrRight" scale="0" id="Narr_J42lJf8Jlk6b5MhW01btBQ">1,150,000</ix:nonFraction> ADSs at a per pre-funded warrant price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_GM7M0fpeUEeWbxQzVezuXQ" contextRef="As_Of_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_OjgdooHw7kmg5HfsVmkcgw" decimals="4" format="ixt:numdotdecimal" name="us-gaap:SharePrice" scale="0" id="Narr_ePPW0tMP80qNB3UQ4CuifA">4.9999</ix:nonFraction>, with each ADS and Pre-Funded Warrant accompanied by an ordinary warrant (the &#8220;Common Warrant&#8221;), for aggregate gross proceeds of $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_8_9_2022_To_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_Sy5-w-jYG0mprdbRg8-l2w" decimals="-5" format="ixt:numdotdecimal" name="qnrx:ProceedsFromIssuancePublicOffering" scale="6" id="Narr_SENJA1cyi0uKsbYtrkUnaQ">16.8</ix:nonFraction> million, resulting in net proceeds of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_PRkgl4PSWEeJlMDgLsg-WQ" contextRef="Duration_8_9_2022_To_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_PreFundedWarrantsMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_Sy5-w-jYG0mprdbRg8-l2w" decimals="-5" format="ixt:numdotdecimal" name="qnrx:NetProceedsFromIssuancePublicOfferingAfterIssuanceCosts" scale="6" id="Narr_2LwfS8tI7EmF3WGAc3337g">14.9</ix:nonFraction> million. Each Common Warrant has an exercise price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_GM7M0fpeUEeWbxQzVezuXQ" contextRef="As_Of_8_9_2022_us-gaap_ClassOfWarrantOrRightAxis_qnrx_CommonWarrantsMember_us-gaap_StatementClassOfStockAxis_dei_AdrMember_us-gaap_SubsidiarySaleOfStockAxis_qnrx_PublicOfferingMember_9Hny5e1UdUiw9T0NOgCRmQ" decimals="2" format="ixt:numdotdecimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" id="Narr_Nkm1EwTniESvfD0Bnuo7Sw">5.00</ix:nonFraction> per ADS and expires on the fifth anniversary of the Closing Date. On the Closing Date, the holder of Pre-Funded Warrants sold in the Offering exercised its Pre-Funded Warrants in full.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In connection with the Offering, the Company entered into a Securities Purchase Agreement (the &#8220;Purchase Agreement&#8221;) with certain institutional investors. The Purchase Agreement provided that for a period of <ix:nonNumeric contextRef="Duration_8_9_2022_To_8_9_2022_t32okcxl5U2U9I8xuOtQ0g" format="ixt-sec:durwordsen" name="qnrx:ThresholdPeriodForNotToEnterInToAgreementForVariableRateTransactionFromDateOfClosingOfOffering" id="Narr_kvuMYU5NPEqpKzM9osvXsw">180 days</ix:nonNumeric> following the closing of the Offering, the Company will not effect or enter into an agreement to effect a &#8220;variable rate transaction&#8221; as defined in the Purchase Agreement. Further, the Company has agreed in the Purchase Agreement not to issue, enter into any agreement to issue or announce the issuance or proposed issuance of any ADSs or ordinary shares or their equivalents, subject to certain exceptions, for a period of <ix:nonNumeric contextRef="Duration_8_9_2022_To_8_9_2022_t32okcxl5U2U9I8xuOtQ0g" format="ixt-sec:durwordsen" name="qnrx:ThresholdPeriodForNotToIssueOrProposedIssuanceOfAnyAdssOrOrdinaryShares" id="Narr_j02HMz5T8UOEzXeJIaf-Dw">90 days</ix:nonNumeric> after the closing of the Offering. The Purchase Agreement also contained representations, warranties, indemnification and other provisions customary for transactions of this nature.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><span style="text-decoration-line:underline;text-decoration-style:solid;">Warrants</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The following table summarizes warrant activities during the year ended December 31, 2021 and the nine months ended September 30, 2022:</p><ix:nonNumeric contextRef="Duration_1_1_2022_To_9_30_2022_95QvxpsMLEadfRLkB6vVPg" name="qnrx:SummaryOfWarrantActivitiesTableTextBlock" id="Tb_41C6ACJBQk-xZBgnu2OwfQ" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:75%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2.37%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font