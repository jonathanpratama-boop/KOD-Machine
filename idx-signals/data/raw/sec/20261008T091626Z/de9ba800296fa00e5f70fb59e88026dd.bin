ine-height:120%;text-decoration:underline"><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#0000ff;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:underline">REPORT ON CORPORATE GOVERNANCE</a></font><font style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%"><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:none">&#160;&#160;&#160;&#160;</a><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:none">21</a></font></div><div style="margin-bottom:6pt;padding-left:108pt;padding-right:36pt;text-indent:-108pt"><font style="color:#0000ff;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:underline"><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#0000ff;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:underline">AUDIT COMMITTEE DISCLOSURE</a></font><font style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%"><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:none">&#160;&#160;&#160;&#160;</a><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:none">21</a></font></div><div style="margin-bottom:6pt;padding-left:108pt;padding-right:36pt;text-indent:-108pt"><font style="color:#0000ff;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:underline"><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#0000ff;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:underline">INTERESTS OF INFORMED PERSONS IN MATERIAL TRANSACTIONS</a></font><font style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%"><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:none">&#160;&#160;&#160;&#160;</a><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:none">23</a></font></div><div style="margin-bottom:6pt;padding-left:108pt;padding-right:36pt;text-indent:-108pt"><font style="color:#0000ff;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:underline"><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#0000ff;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:underline">PARTICULARS OF MATTERS TO BE ACTED UPON</a></font><font style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%"><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:none">&#160;&#160;&#160;&#160;</a><a href="#i0b41d918c9f54fea8a8f8c8e203b2939_7" style="color:#000000;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:none">23</a></font></div><div style="margin-bottom:6pt;padding-left:108pt;padding-right:36pt;text-indent:-108pt"><font style="color:#0000ff;font-family:'Times New Roman',sans-serif;font-size:11pt;font-weight:400;line-height:120%;text-decoration:underline"><a href="#i0b41d