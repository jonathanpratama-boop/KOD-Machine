<td style="white-space:nowrap;vertical-align:bottom;text-align:right;"><div style="letter-spacing: 0px; top: 0px;;display:inline;"><div style="font-weight:bold;display:inline;"><ix:nonFraction name="us-gaap:TemporaryEquityCarryingAmountAttributableToParent" contextRef="PAsOn06_30_2023" unitRef="Unit_USD" decimals="0" scale="0" format="ixt:num-dot-decimal">49,262,200</ix:nonFraction></div></div></td>
