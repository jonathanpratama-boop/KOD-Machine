<td style="vertical-align:bottom">&#160;</td></tr>


<tr style="page-break-inside:avoid ; font-family:Times New Roman; font-size:10pt;background-color:#cceeff">
<td style="vertical-align:top"> <p style=" margin-top:0pt ; margin-bottom:0pt; margin-left:1.00em; text-indent:-1.00em; font-size:10pt; font-family:Times New Roman">Revenue</p></td>
<td style="vertical-align:bottom">&#160;&#160;</td>
<td style="white-space:nowrap;vertical-align:bottom">&#160;</td>
<td style="white-space:nowrap;vertical-align:bottom" align="right">78.9</td>
<td style="white-space:nowrap;vertical-align:bottom">&#160;</td>
