<tr style="page-break-inside:avoid">
<td style="width:13%">&#160;</td>
<td style="width:5%;vertical-align:top" align="left">(i)</td>
<td align="left" style="vertical-align:top"> <p style=" margin-top:0pt ; margin-bottom:0pt; font-size:10pt; font-family:Times New Roman;text-align:left">Approval from Reserve Bank of India and any other regulatory approvals, if required; <span style="font-weight:bold"><span style="text-decoration:underline">and</span></span> </p></td></tr></table> <p style="font-size:12pt;margin-top:0pt;margin-bottom:0pt">&#160;</p>
<table style="BORDER-COLLAPSE:COLLAPSE; font-family:Times New Roman; font-size:10pt;border:0;width:100%" cellpadding="0" cellspacing="0">
