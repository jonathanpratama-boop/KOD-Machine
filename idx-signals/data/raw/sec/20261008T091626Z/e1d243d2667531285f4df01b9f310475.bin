    <td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="width: 9%; text-align: right"><span style="font-family: Times New Roman, Times, Serif">(<ix:nonFraction contextRef="c0" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxReconciliationIncomeTaxExpenseBenefitAtFederalStatutoryIncomeTaxRate" scale="0" sign="-" unitRef="usd" id="ixv-6916">352,226</ix:nonFraction></span></td><td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">)</span></td><td style="width: 1%"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
