 style="vertical-align: bottom; background-color: rgb(204,238,255)"> <td style="padding-left: 9pt; text-indent: -9pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Sunoro Holdings Limited (&#8220;Sunoro Holdings&#8221;)</span></td> <td>&#160;</td> <td style="text-align: center"><ix:nonNumeric contextRef="c59" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipState" id="ixv-3217"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Hong Kong, China</span></ix:nonNumeric></td> <td>&#160;</td> <td>&#160;</td> <td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction contextRef="c59" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipOwnershipInterest" scale="-2" unitRef="pure" id="ixv-6677">100</ix:nonFraction></span></td> <td><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">%</span></td></tr> <tr style="vertical-align: bottom; "> <td style="padding-left: 9pt; text-indent: -9pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Beijing ReTo Hengda Technology Co., Ltd. (&#8220;Reto Hengda&#8221;)*</span></td> <td>&#160;</td> <td style="text-align: center"><ix:nonNumeric contextRef="c60" id="ix_13_fact" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipState"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Beijing, China</span></ix:nonNumeric></td> <td>&#160;</td> <td>&#160;</td> <td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction contextRef="c60" decimals="2" format="ixt:num-dot-decimal" id="ix_14_fact" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipOwnershipInterest" scale="-2" unitRef="pure">100</ix:nonFraction></span></td> <td><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">