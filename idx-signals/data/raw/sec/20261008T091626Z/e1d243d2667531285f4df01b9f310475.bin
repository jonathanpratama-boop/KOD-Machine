    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c1" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:OtherLoansPayableCurrent" scale="0" unitRef="usd" id="ixv-6909">155,000</ix:nonFraction></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; padding-bottom: 4pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:OtherLoansPayableCurrent" scale="0" unitRef="usd" id="ixv-6910">109,600</ix:nonFraction></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">&#160;</td></tr>
