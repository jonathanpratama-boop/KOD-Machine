man, Times, Serif; font-size: 10pt">%</span></td></tr> <tr style="vertical-align: bottom; background-color: rgb(204,238,255)"> <td style="padding-left: 9pt; text-indent: -9pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Beijing ReTo Hengye Technology Co., Ltd. (&#8220;ReTo Hengye&#8221;)**</span></td> <td>&#160;</td> <td style="text-align: center"><ix:nonNumeric contextRef="c63" id="ix_15_fact" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipState"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Beijing, China</span></ix:nonNumeric></td> <td>&#160;</td> <td>&#160;</td> <td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction contextRef="c63" decimals="2" format="ixt:num-dot-decimal" id="ix_16_fact" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipOwnershipInterest" scale="-2" unitRef="pure">100</ix:nonFraction></span></td> <td><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">%</span></td></tr> <tr style="vertical-align: bottom; "> <td style="padding-left: 9pt; text-indent: -9pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">MeinMalzeBier Holdings Limited (&#8220;MMB&#8221;)</span></td> <td>&#160;</td> <td style="text-align: center"><ix:nonNumeric contextRef="c64" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipState" id="ixv-3282"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Hong Kong, China</span></ix:nonNumeric></td> <td>&#160;</td> <td>&#160;</td> <td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction contextRef="c64" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipOwnershipInterest" scale="-2" unitRef="pure" id="ixv-6682">51</ix:nonFraction>% controlled by ReTo</span></td> <td>&#160;</td></tr> <tr style="vertical-align: bottom; background-color: rgb(204,238,255)"> <td style="white-space: nowrap; padding-left: 9pt; text-indent: -9pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">MeinMalzeBier Global Limited (&#8220;MMB HK&#8221;)</span></td> <td style="white-space: nowrap">&#160;</td> <td style="white-space: nowrap; text-align: center"><ix:nonNumeric contextRef="c65" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipState" id="ixv-3294"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Hong Kong, China</span></ix:nonNumeric></td> <td style="white-space: nowrap">&#160;</td> <td style="white-space: nowrap">&#160;</td> <td style="white-space: nowrap"> <p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: right"><ix:nonFraction contextRef="c65" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipOwnershipInterest" scale="-2" unitRef="pure" id="ixv-6683">100</ix:nonFraction>% controlled by &#160;MMB</p></td> <td style="white-space: nowrap">&#160;</td></tr> <tr style="vertical-align: bottom; "> <td style="padding-left: 9pt; text-indent: -9pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Shenzhen Dirong Century Big Data Technology Co., Ltd. (&#8220;Dirong&#8221;)</span></td> <td>&#160;</td> <td style="text-align: center"><ix:nonNumeric contextRef="c66" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipState" id="ixv-3306"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Shenzhen China</span></ix:nonNumeric></td> <td>&#160;</td> <td>&#160;</td> <td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction contextRef="c66" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipOwnershipInterest" scale="-2" unitRef="pure" id="ixv-6684">100</ix:nonFraction>% controlled by MMB HK </span></td> <td>&#160;</td></tr> <tr style="vertical-align: bottom; background-color: rgb(204,238,255)"> <td style="padding-left: 9pt; text-indent: -9pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Shenzhen Melody Catering Management Co., Ltd. (&#8220;Melody&#8221;)</span></td> <td>&#160;</td> <td style="text-align: center"><ix:nonNumeric contextRef="c67" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipState" id="ixv-3318"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Shenzhen, China</span></ix:nonNumeric></td> <td>&#160;</td> <td>&#160;</td> <td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction contextRef="c67" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipOwnershipInterest" scale="-2" unitRef="pure" id="ixv-6685">100</ix:nonFraction>% controlled by MMB HK</span></td> <td>&#160;</td></tr> </table>
<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0"><b>&#160;</b></p>

<table cellpadding="0" style="font: 10pt Times New Roman, Times, Serif; margin-top: 0pt; margin-bottom: 0pt; width: 100%; border-spacing: 0px;"><tr style="vertical-align: top; text-align: justify">
