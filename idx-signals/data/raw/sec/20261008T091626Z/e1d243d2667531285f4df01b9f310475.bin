</div><ix:nonNumeric contextRef="c0" escape="true" name="reto:LoansFromThirdPartiesCurrentTextBlock" id="ixv-5068"><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0"><b>NOTE 12 &#8211; LOANS FROM THIRD PARTIES - CURRENT</b></p>

<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0">&#160;</p>

<ix:nonNumeric contextRef="c0" escape="true" name="reto:ScheduleOfLoansFromThirdPartiesCurrentTableTextBlock" id="ixv-5072"><table cellpadding="0" style="border-collapse: collapse; width: 100%; font: 10pt Times New Roman, Times, Serif; border-spacing: 0px;">
  <tr style="vertical-align: bottom">
    <td style="font-weight: bold; border-bottom: Black 1.5pt solid">Loans from Third Parties</td><td style="font-weight: bold; padding-bottom: 1.5pt">&#160;</td>
    <td colspan="2" style="font-weight: bold; text-align: center; border-bottom: Black 1.5pt solid">As of<br/> June 30,<br/> 2025</td><td style="padding-bottom: 1.5pt; font-weight: bold">&#160;</td><td style="font-weight: bold; padding-bottom: 1.5pt">&#160;</td>
    <td colspan="2" style="font-weight: bold; text-align: center; border-bottom: Black 1.5pt solid">As of<br/> December&#160;31,<br/> 2024</td><td style="padding-bottom: 1.5pt; font-weight: bold">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 76%; text-align: left"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Ms. Qingcai Guan<sup>(2)</sup></span></td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c156" decimals="0" format="ixt:num-dot-decimal" id="ix_21_fact" name="us-gaap:OtherLoansPayable" scale="0" unitRef="usd">155,000</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td>
