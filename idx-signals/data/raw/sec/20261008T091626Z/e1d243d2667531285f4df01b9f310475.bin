    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:FinancingReceivableAllowanceForCreditLosses" scale="0" unitRef="usd" id="ixv-6837">2,740</ix:nonFraction></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">&#160;</td></tr>
