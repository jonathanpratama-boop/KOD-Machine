    <td style="border-bottom: Black 1.5pt solid; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="border-bottom: Black 1.5pt solid; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction contextRef="c11" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxReconciliationChangeInDeferredTaxAssetsValuationAllowance" scale="0" unitRef="usd" id="ixv-6922">28,817</ix:nonFraction></span></td><td style="padding-bottom: 1.5pt; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
