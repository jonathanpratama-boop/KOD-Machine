    <TD STYLE="padding-right: 5.4pt; padding-bottom: 14pt; padding-left: 0pt; font-weight: normal; text-align: justify; text-indent: 0pt; line-height: 14pt"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt; color: Black">&#9;</FONT></TD>
    <TD STYLE="padding-right: 5.4pt; padding-bottom: 14pt; padding-left: 0pt; font-weight: normal; text-align: justify; text-indent: 0pt; line-height: 14pt"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt; color: Black">&Oslash;vrige vilk&aring;r for de udstedte warrants
