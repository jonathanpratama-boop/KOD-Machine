    <TD STYLE="text-align: justify">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="padding-left: 0.25in; text-align: justify">&nbsp;</TD>
    <TD STYLE="padding-left: 25.5pt; text-align: justify; text-indent: -25.5pt"><FONT STYLE="font-size: 10pt">K&nbsp;&nbsp;&nbsp;=&nbsp;&nbsp;&nbsp;aktiens markedskurs / lukkekurs &#9;dagen forinden annoncering af &#9;&aelig;ndringen i aktiekapitalen, og</FONT></TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="padding-left: 25.5pt; text-align: justify; text-indent: -25.5pt"><FONT STYLE="font-size: 10pt">K&nbsp;&nbsp;&nbsp;=&nbsp;&nbsp;&nbsp;market price / closing price of &#9;the share on the day prior to &#9;the announcement of the &#9;change in the share capital, &#9;and</FONT></TD></TR>
