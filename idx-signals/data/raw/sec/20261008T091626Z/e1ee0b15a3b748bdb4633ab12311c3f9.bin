    <TD COLSPAN="2" STYLE="padding-left: 0pt; padding-right: 5.4pt; padding-bottom: 14pt; font-weight: normal; text-align: justify; text-indent: 0pt; line-height: 14pt"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt; color: Black">WHEREAS</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
