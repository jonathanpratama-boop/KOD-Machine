    <TD STYLE="padding-left: 25.5pt; text-align: justify; text-indent: -25.5pt"><FONT STYLE="font-size: 10pt">A&nbsp;&nbsp;&nbsp;=&nbsp;&nbsp;&nbsp;nominal share capital before &#9;the change in capital</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="padding-left: 0.25in; text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="padding-left: 25.5pt; text-align: justify; text-indent: -25.5pt">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="padding-left: 0.25in; text-align: justify">&nbsp;</TD>
    <TD STYLE="padding-left: 25.5pt; text-align: justify; text-indent: -25.5pt"><FONT STYLE="font-size: 10pt">B&nbsp;&nbsp;&nbsp;=&nbsp;&nbsp;&nbsp;den nominelle &aelig;ndring i aktie-&#9;kapitalen</FONT></TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
    <TD STYLE="padding-left: 25.5pt; text-align: justify; text-indent: -25.5pt"><FONT STYLE="font-size: 10pt">B&nbsp;&nbsp;&nbsp;=&nbsp;&nbsp;&nbsp;nominal change in the share &#9;capital</FONT></TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="padding-left: 0.25in; text-align: justify">&nbsp;</TD>
    <TD STYLE="text-align: justify">&nbsp;</TD>
