  <TR STYLE="vertical-align: top">
    <TD STYLE="padding-left: 0.25in; text-align: justify; width: 8%">&nbsp;</TD>
    <TD STYLE="width: 45%">
    <P STYLE="font-size: 10pt; text-align: justify; margin: 0pt 0">&nbsp;</P>
    <P STYLE="font-size: 10pt; text-align: justify; margin: 0pt 0">&nbsp;</P></TD>
    <TD STYLE="padding-left: 1.95pt; text-align: justify; width: 2%">&nbsp;</TD>
    <TD STYLE="text-align: justify; width: 45%">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: top">
    <TD STYLE="padding-left: 0.25in; text-align: justify">&nbsp;</TD>
    <TD>
    <P STYLE="font-size: 10pt; text-align: center; margin: 0pt 0"><FONT STYLE="font-family: Symbol">a</FONT> = ___<U>A</U>___</P>
