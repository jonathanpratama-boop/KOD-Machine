        <tr>
          <td style="width: 53.29%; vertical-align: top;">
            <div style="line-height: 1.25; color: rgb(0, 0, 0); font-family: 'Times New Roman',Times,serif; font-weight: bold;">Company contact:</div>
            <div style="line-height: 1.25; color: rgb(0, 0, 0); font-family: 'Times New Roman',Times,serif;">Adi Frish</div>
            <div style="line-height: 1.25; color: rgb(0, 0, 0); font-family: 'Times New Roman',Times,serif;">Chief Corporate and Business Development Officer</div>
            <div style="line-height: 1.25; color: rgb(0, 0, 0); font-family: 'Times New Roman',Times,serif;">RedHill Biopharma</div>
