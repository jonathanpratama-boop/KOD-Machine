    <TD COLSPAN="2" STYLE="font-weight: bold; text-align: center; border-bottom: Black 1.5pt solid">30/06/2025</TD><TD STYLE="padding-bottom: 1.5pt; font-weight: bold">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom">
    <TD>&nbsp;</TD><TD>&nbsp;</TD>
    <TD COLSPAN="2">&nbsp;</TD><TD>&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
    <TD STYLE="width: 88%; text-align: left">Total comprehensive income attributable to the shareholders of the company</TD><TD STYLE="width: 1%">&nbsp;</TD>
