    <TD STYLE="border-bottom: Black 4pt double; text-align: left">$</TD><TD STYLE="border-bottom: Black 4pt double; text-align: right">648,232</TD><TD STYLE="padding-bottom: 2.5pt; text-align: left">&nbsp;</TD></TR>
