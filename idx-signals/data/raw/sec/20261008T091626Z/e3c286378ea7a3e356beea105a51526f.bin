    <td style="text-align: left">&#160;</td><td style="text-align: right"><span id="xdx_909_eus-gaap--EquityMethodInvestmentOwnershipPercentage_iI_dp_uPure_c20251231__srt--ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis__custom--GDWellnessPtyLtdMember_zRqb6aECxNbj" title="Percentage of effective ownership"><ix:nonFraction name="us-gaap:EquityMethodInvestmentOwnershipPercentage" contextRef="AsOf2025-12-31_custom_GDWellnessPtyLtdMember" id="Fact000559" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">100</ix:nonFraction></span></td><td style="text-align: left">%</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span id="xdx_907_eus-gaap--EquityMethodInvestmentOwnershipPercentage_iI_dp_uPure_c20250630__srt--ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis__custom--GDWellnessPtyLtdMember_zGI9AoF1NdAc" title="Percentage of effective ownership"><ix:nonFraction name="us-gaap:EquityMethodInvestmentOwnershipPercentage" contextRef="AsOf2025-06-30_custom_GDWellnessPtyLtdMember" id="Fact000561" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">100</ix:nonFraction></span></td><td style="text-align: left">%</td><td>&#160;</td>
    <td style="text-align: center"><span id="xdx_908_ecustom--EquityMethodInvestmentPlaceOfIncorporation_c20250701__20251231__srt--ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis__custom--GDWellnessPtyLtdMember_zhk2AXmkEEi7" title="Place of incorporation"><ix:nonNumeric contextRef="From2025-07-012025-12-31_custom_GDWellnessPtyLtdMember" id="Fact000563" name="GMEX:EquityMethodInvestmentPlaceOfIncorporation">Australia</ix:nonNumeric></span></td><td>&#160;</td>
    <td style="text-align: center"><span id="xdx_903_eus-gaap--EquityMethodInvestmentDescriptionOfPrincipalActivities_c20250701__20251231__srt--ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis__custom--GDWellnessPtyLtdMember_zjTlymQyMMMd" title="Principal activities"><ix:nonNumeric contextRef="From2025-07-012025-12-31_custom_GDWellnessPtyLtdMember" id="Fact000565" name="us-gaap:EquityMethodInvestmentDescriptionOfPrincipalActivities">Sales of gym and fitness equipment</ix:nonNumeric></span></td></tr>
  </table>
