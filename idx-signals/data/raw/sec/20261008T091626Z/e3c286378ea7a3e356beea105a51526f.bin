<table cellspacing="0" cellpadding="0" style="font: 10pt Times New Roman, Times, Serif; width: 100%; border-collapse: collapse">
  <tr style="font: 10pt Times New Roman, Times, Serif">
    <td style="font: 10pt Times New Roman, Times, Serif; vertical-align: top; width: 0.25in"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>11.
    </b></span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b><span id="xdx_821_z9WX1p2XTu6c">Income
    taxes</span></b></span></td></tr>
