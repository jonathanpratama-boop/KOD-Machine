    <td style="font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; text-align: right">(<ix:nonFraction contextRef="c75" decimals="0" format="ixt:num-dot-decimal" name="mlec:CostOfOwnShareHeld" scale="0" sign="-" unitRef="usd" id="ixv-7878">303,768</ix:nonFraction></td><td style="font-weight: bold; text-align: left">)</td></tr>
