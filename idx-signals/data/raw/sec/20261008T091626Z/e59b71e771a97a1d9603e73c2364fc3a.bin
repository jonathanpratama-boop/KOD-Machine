    <td style="text-align: left">&#160;</td><td style="text-align: right">(<ix:nonFraction contextRef="c76" decimals="0" format="ixt:num-dot-decimal" name="mlec:SharesToBeIssuedAmountSettlementWithShareholdersBusinessCombination" scale="0" sign="-" unitRef="usd" id="ixv-7882">641</ix:nonFraction></td><td style="text-align: left">)</td><td>&#160;</td>
