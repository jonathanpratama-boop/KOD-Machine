    <td style="border-bottom: Black 1.5pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; text-align: right">(<ix:nonFraction contextRef="c101" decimals="0" format="ixt:num-dot-decimal" name="mlec:FairValueRemeasurementGain" scale="0" sign="-" unitRef="usd" id="ixv-7993">332,189</ix:nonFraction></td><td style="padding-bottom: 1.5pt; text-align: left">)</td></tr>
