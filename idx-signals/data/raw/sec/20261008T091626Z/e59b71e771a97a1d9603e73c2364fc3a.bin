    <td style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: right">(<ix:nonFraction contextRef="c165" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:CurrentAssetsLiabilities" scale="0" sign="-" unitRef="usd" id="ixv-8271">10,878,022</ix:nonFraction></td><td style="padding-bottom: 1.5pt; font-weight: bold; text-align: left">)</td></tr>
