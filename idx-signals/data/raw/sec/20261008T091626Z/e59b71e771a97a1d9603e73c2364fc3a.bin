    <td style="font-weight: bold; text-align: left">$</td><td style="font-weight: bold; text-align: right"><ix:nonFraction contextRef="c94" decimals="2" format="ixt:num-dot-decimal" name="mlec:ExercisePriceAtTheEnding" scale="0" unitRef="usdPershares" id="ixv-7939">8.00</ix:nonFraction></td><td style="font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold">&#160;</td>
