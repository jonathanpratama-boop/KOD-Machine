    <td style="border-bottom: Black 1.5pt solid; width: 1%; text-align: left">$</td><td style="border-bottom: Black 1.5pt solid; width: 9%; text-align: right"><div style="-sec-ix-hidden: hidden-fact-90">&#160;-</div></td><td style="padding-bottom: 1.5pt; width: 1%; text-align: left">&#160;</td></tr>
