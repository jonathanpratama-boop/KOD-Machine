    <td style="border-bottom: Black 4pt double; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonNumeric contextRef="c0" format="ixt-sec:duryear" name="us-gaap:SharebasedCompensationSharesAuthorizedUnderStockOptionPlansExercisePriceRangeExercisableOptionsWeightedAverageRemainingContractualTerm2">0.10</ix:nonNumeric></td><td style="padding-bottom: 4pt; text-align: left">&#160;</td></tr>
