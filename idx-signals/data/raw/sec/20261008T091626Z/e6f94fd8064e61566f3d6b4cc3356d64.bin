    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c70" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:BusinessCombinationRecognizedIdentifiableAssetsAcquiredAndLiabilitiesAssumedDeferredTaxLiabilities" scale="0" unitRef="usd">363</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
