    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c4" decimals="0" format="ixt:num-dot-decimal" name="gdc:IncomeTaxesPayable" scale="0" unitRef="usd">1,272,670</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
