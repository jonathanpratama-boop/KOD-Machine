    <td style="width: 76%; text-align: left">VAT taxes payable</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c3" decimals="0" format="ixt:num-dot-decimal" name="gdc:ValueAddedTaxTaxesPayable" scale="0" sign="-" unitRef="usd">8,478</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c4" decimals="0" format="ixt:num-dot-decimal" name="gdc:ValueAddedTaxTaxesPayable" scale="0" sign="-" unitRef="usd">973,748</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
