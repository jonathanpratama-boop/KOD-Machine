    <td style="text-align: left">$</td><td title="Related party demand notes" id="xdx_98D_eus-gaap--DebtInstrumentFaceAmount_iI_c20230930__us-gaap--DebtInstrumentAxis__custom--NotePayableMember_zSIM5Abp03fl" style="text-align: right"><ix:nonFraction name="us-gaap:DebtInstrumentFaceAmount" contextRef="AsOf2023-09-30_custom_NotePayableMember" format="ixt:numdotdecimal" decimals="0" unitRef="USD">1,500,000</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">$</td><td title="Related party demand notes" id="xdx_98B_eus-gaap--DebtInstrumentFaceAmount_iI_c20221231__us-gaap--DebtInstrumentAxis__custom--NotePayableMember_z2o0NqnPD2P2" style="text-align: right"><span style="-sec-ix-hidden: xdx2ixbrl1106">-</span></td><td style="text-align: left">&#160;</td></tr>
<tr style="vertical-align: bottom; background-color: White">
    <td style="width: 70%; text-align: left">Related party demand notes with a <span id="xdx_90D_ecustom--FinancingFeeRelatedPartyDemandNotesPercentage_iI_pid_dp_uPure_c20230930_ztnPTQ0wCuck" title="Financing fee related party demand notes percentage" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNjaGVkdWxlIG9mIE5vdGVzIFBheWFibGUgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="INVO:FinancingFeeRelatedPartyDemandNotesPercentage" contextRef="AsOf2023-09-30" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">10</ix:nonFraction></span>% financing fee. <span id="xdx_905_ecustom--AnnualInterestRelatedPartyDemandNotesPercentage_iI_pid_dp_uPure_c20230930_zTPWBB2rxqBg" title="Annual interest  related party demand notes percentage" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNjaGVkdWxlIG9mIE5vdGVzIFBheWFibGUgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="INVO:AnnualInterestRelatedPartyDemandNotesPercentage" contextRef="AsOf2023-09-30" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">10</ix:nonFraction></span>% annual interest from issuance. Notes are callable starting September 30, 2023</td><td style="width: 2%">&#160;</td>
    <td style="width: 1%; text-align: left">&#160;</td><td id="xdx_98D_eus-gaap--DebtInstrumentFaceAmount_iI_c20230930__us-gaap--DebtInstrumentAxis__custom--RelatedPartyDemandNotesMember_z1Bx3uSyewAe" title="Related party demand notes" style="width: 11%; text-align: right"><ix:nonFraction name="us-gaap:DebtInstrumentFaceAmount" contextRef="AsOf2023-09-30_custom_RelatedPartyDemandNotesMember" format="ixt:numdotdecimal" decimals="0" unitRef="USD">880,000</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 2%">&#160;</td>
    <td style="width: 1%; text-align: left">&#160;</td><td id="xdx_980_eus-gaap--DebtInstrumentFaceAmount_iI_c20221231__us-gaap--DebtInstrumentAxis__custom--RelatedPartyDemandNotesMember_zGa6DBiZL7Ak" title="Related party demand notes" style="width: 11%; text-align: right"><ix:nonFraction name="us-gaap:DebtInstrumentFaceAmount" contextRef="AsOf2022-12-31_custom_RelatedPartyDemandNotesMember" format="ixt:numdotdecimal" decimals="0" unitRef="USD">770,000</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left">Convertible notes. <span id="xdx_909_ecustom--AnnualInterestRelatedPartyDemandNotesPercentage_iI_pid_dp_uPure_c20230930_zHeExJQrIi07" title="Annual interest  related party demand notes percentage" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNjaGVkdWxlIG9mIE5vdGVzIFBheWFibGUgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="INVO:AnnualInterestRelatedPartyDemandNotesPercentage" contextRef="AsOf2023-09-30" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">10</ix:nonFraction></span>% annual interest. Conversion price of $<span id="xdx_90C_ecustom--AnnualInterestRelatedPartyDemandConversionPrice_iI_pid_c20230930__srt--RangeAxis__srt--MinimumMember_zhBfvE2Mz5U9" title="Annual interest related party demand conversion price" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNjaGVkdWxlIG9mIE5vdGVzIFBheWFibGUgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="INVO:AnnualInterestRelatedPartyDemandConversionPrice" contextRef="AsOf2023-09-30_srt_MinimumMember" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">10.00</ix:nonFraction></span>-$<span id="xdx_909_ecustom--AnnualInterestRelatedPartyDemandConversionPrice_iI_pid_c20230930__srt--RangeAxis__srt--MaximumMember_zFHk0PRBnW5l" title="Annual interest related party demand conversion price" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNjaGVkdWxlIG9mIE5vdGVzIFBheWFibGUgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="INVO:AnnualInterestRelatedPartyDemandConversionPrice" contextRef="AsOf2023-09-30_srt_MaximumMember" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">12.00</ix:nonFraction></span></td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td id="xdx_986_eus-gaap--DebtInstrumentFaceAmount_iI_c20230930__us-gaap--DebtInstrumentAxis__custom--DemandNotesMember_zGebbSKcL3be" title="Related party demand notes" style="text-align: right"><ix:nonFraction name="us-gaap:DebtInstrumentFaceAmount" contextRef="AsOf2023-09-30_custom_DemandNotesMember" format="ixt:numdotdecimal" decimals="0" unitRef="USD">410,000</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
