    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ContractualObligationDueInSecondYear" scale="0" unitRef="cny" id="ixv-13665">1,233,085</ix:nonFraction></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; padding-bottom: 4pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ContractualObligationDueInThirdYear" scale="0" unitRef="cny" id="ixv-13666">5,153,193</ix:nonFraction></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">&#160;</td></tr>
