    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">&#160;</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c0" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:Revenues" scale="0" unitRef="cny" id="ixv-12687">280,628,305</ix:nonFraction></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; padding-bottom: 4pt">&#160;</td>
