    <td style="text-align: center">HKD<ix:nonFraction contextRef="c124" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-12590">1</ix:nonFraction>=RMB<ix:nonFraction contextRef="c125" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-12591">0.9126</ix:nonFraction></td><td style="text-align: center">&#160;</td>
    <td style="text-align: center">HKD<ix:nonFraction contextRef="c126" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-12592">1</ix:nonFraction>=RMB<ix:nonFraction contextRef="c127" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-12593">0.9249</ix:nonFraction></td><td style="text-align: center">&#160;</td>
    <td style="text-align: center">HKD<ix:nonFraction contextRef="c128" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-12594">1</ix:nonFraction>=RMB<ix:nonFraction contextRef="c129" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-12595">0.9113</ix:nonFraction></td></tr>
