    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c102" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:WeightedAverageNumberOfDilutedSharesOutstanding" scale="0" unitRef="shares" id="ixv-13698"><ix:nonFraction contextRef="c102" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:WeightedAverageNumberOfSharesOutstandingBasic" scale="0" unitRef="shares" id="ixv-13699">93,826,802</ix:nonFraction></ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
