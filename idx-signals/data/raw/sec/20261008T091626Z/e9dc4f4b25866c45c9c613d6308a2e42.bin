x:nonNumeric></td> <td>&#160;</td> <td style="vertical-align: top; text-align: center"><ix:nonNumeric contextRef="c93" format="ixt:date-monthname-day-year-en" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipDate" id="ixv-12565">August 23, 2024</ix:nonNumeric></td> <td>&#160;</td> <td style="vertical-align: top; text-align: center"><ix:nonNumeric contextRef="c93" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipState" id="ixv-12566">PRC</ix:nonNumeric></td> <td>&#160;</td> <td style="text-align: left">&#160;</td> <td style="text-align: right"><ix:nonFraction contextRef="c93" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipOwnershipInterest" scale="-2" unitRef="pure" id="ixv-12567">100</ix:nonFraction></td> <td style="text-align: left">%</td> <td>&#160;</td> <td style="vertical-align: top; text-align: center"><ix:nonNumeric contextRef="c93" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipBusinessPurpose" id="ixv-12568">Freight forwarding</ix:nonNumeric></td></tr> <tr style="vertical-align: bottom; background-color: rgb(204,238,255)"> <td style="vertical-align: top; text-align: left; text-indent: -9pt; padding-left: 9pt">EZhou Jayud International Logistics Co., Ltd. (&#8220;EZ GJHY&#8221;&#65289;</td> <td>&#160;</td> <td style="vertical-align: top; text-align: center"><ix:nonNumeric contextRef="c94" name="jyd:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipControlled" id="ixv-12569">EZ WLKJ</ix:nonNumeric></td> <td>&#160;</td> <td style="vertical-align: top; text-align: center"><ix:nonNumeric contextRef="c94" format="ixt:date-monthname-day-year-en" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipDate" id="ixv-12570">September 2, 2024</ix:nonNumeric></td> <td>&#160;</td> <td style="vertical-align: top; text-align: center"><ix:nonNumeric contextRef="c94" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipState" id="ixv-12571">PRC</ix:nonNumeric></td> <td>&#160;</td> <td style="text-align: left">&#160;</td> <td style="text-align: right"><ix:nonFraction contextRef="c94" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipOwnershipInterest" scale="-2" unitRef="pure" id="ixv-12572">51</ix:nonFraction></td> <td style="text-align: left">%</td> <td>&#160;</td> <td style="vertical-align: top; text-align: center"><ix:nonNumeric contextRef="c94" name="us-gaap:SubsidiaryOfLimitedLiabilityCompanyOrLimitedPartnershipBusinessPurpose" id="ixv-12573">Freight forwarding</ix:nonNumeric></td></tr> </table></ix:nonNumeric></ix:nonNumeric><div>


