    <td style="font: 10pt Times New Roman, Times, Serif; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_902_edei--EntityEmergingGrowthCompany_c20220101__20221231_z3RdLu9fG0L1"><ix:nonNumeric contextRef="From2022-01-01to2022-12-31" format="ixt:booleanfalse" name="dei:EntityEmergingGrowthCompany">&#9744;</ix:nonNumeric></span></span></td></tr>
