    <td style="border-bottom: Black 1.5pt solid; text-align: left">$</td><td style="border-bottom: Black 1.5pt solid; text-align: right">11,498,688</td><td style="padding-bottom: 1.5pt; text-align: left">&#160;</td></tr>
