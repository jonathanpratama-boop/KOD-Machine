  <tr style="vertical-align: bottom; background-color: White">
    <td style="text-align: left">Expected Remaining Term (in years)</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">-</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span id="xdx_901_eus-gaap--DebtInstrumentTerm_dtY_c20250701__20260331__us-gaap--MeasurementInputTypeAxis__us-gaap--MeasurementInputExpectedTermMember__us-gaap--ShortTermDebtTypeAxis__us-gaap--ConvertibleDebtMember_zuJj7T4zZoU6" title="Debt instrument, measurement input, term"><ix:nonNumeric contextRef="From2025-07-012026-03-31_us-gaap_MeasurementInputExpectedTermMember_us-gaap_ConvertibleDebtMember" format="ixt-sec:duryear" id="Fact003109" name="us-gaap:DebtInstrumentTerm">0.002</ix:nonNumeric></span></td><td style="text-align: left">&#160;</td></tr>
