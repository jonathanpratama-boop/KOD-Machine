    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 9%; text-align: right">37,500,000</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 9%; text-align: right">37,500,000</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: White">
    <TD STYLE="text-align: left">Total liabilities</TD><TD>&nbsp;</TD>
    <TD STYLE="text-align: left">$</TD><TD STYLE="text-align: right">7,100,000</TD><TD STYLE="text-align: left">&nbsp;</TD><TD>&nbsp;</TD>
