    <TD STYLE="border-bottom: Black 4pt double; text-align: left">$</TD><TD STYLE="border-bottom: Black 4pt double; text-align: right">(995,667</TD><TD STYLE="padding-bottom: 4pt; text-align: left">)</TD></TR>
