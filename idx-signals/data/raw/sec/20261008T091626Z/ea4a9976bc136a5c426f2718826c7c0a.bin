t-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_AggregateContinuingAndDiscontinuedOperationsMember_ifrs-full_TypesOfContractsAxis_naas_AdvancesFromPlatformUserMember_DD64MPJHqk-P6iItr_y8_g" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_Zw-vS03MH0ubZueovOCShA_5_2">12,682</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_AggregateContinuingAndDiscontinuedOperationsMember_ifrs-full_TypesOfContractsAxis_naas_AdvancesFromPlatformUserMember_1tk5ynlfuECkL-SrY8AfUA" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_kJS_dMBee0G0UWbrAHP7Xg_5_4">11,669</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:73.53%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:7.2pt;text-indent:-7.2pt;margin:0pt;">Advances from customers for energy solutions</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.89%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_AggregateContinuingAndDiscontinuedOperationsMember_ifrs-full_TypesOfContractsAxis_naas_AdvancesReceivedFromCustomerToPurchaseEnergyMember_C7VGATE_x0yef5eDov3g_A" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_IKQmB6llU0emUpg7-3QXHg_6_2">51,926</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_AggregateContinuingAndDiscontinuedOperationsMember_ifrs-full_TypesOfContractsAxis_naas_AdvancesReceivedFromCustomerToPurchaseEnergyMember_chFaYu0JAEaYiQq1j1Gi-A" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_NjeAwH8g70G-s5X3BCWp5A_6_4">6,501</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:73.53%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:7.2pt;text-indent:-7.2pt;margin:0pt;">Deferred income</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.89%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_AggregateContinuingAndDiscontinuedOperationsMember_ifrs-full_TypesOfContractsAxis_naas_DeferedIncomeMember_eqU1becxDUCCaI56oP_PdQ" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_dc7E-PIQ1UWbl4pF9NvkQQ_7_2">3,342</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> &#8212;</p></td></tr><tr><td style="vertical-align:bottom;width:73.53%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:7.2pt;text-indent:-7.2pt;margin:0pt;">Others</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.89%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_AggregateContinuingAndDiscontinuedOperationsMember_ifrs-full_TypesOfContractsAxis_naas_OtherContractLiabilitiesMember__6UBrJHtGkaMUrOiwhFraw" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_GZsvAVKUu02BZN7_LwKo4Q_8_2">657</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_AggregateContinuingAndDiscontinuedOperationsMember_ifrs-full_TypesOfContractsAxis_naas_OtherContractLiabilitiesMember_0Ll7_Xgr_0WzQyL2VBaGZA" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_cCxLoJxHtUWpGRUjfw4N4Q_8_4">384</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:73.53%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.89%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_AggregateContinuingAndDiscontinuedOperationsMember_2FStrn6isUOyvHljZ7DcZA" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_dPLQzu_Ex0mighnmQj4Fxg_9_2">101,053</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_AggregateContinuingAndDiscontinuedOperationsMember_W_33jkx8nkGs9lkZ9WF7Cg" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_KgFlIINyGkGQ7tCJLjZ_7A_9_4">32,509</ix:nonFraction></b></p></td></tr><tr><td style="vertical-align:bottom;width:73.53%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:7.2pt;text-indent:-7.2pt;margin:0pt;">Included in other payables and accruals per balance sheet</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.89%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_a5gxuVH8Y0a9uyImGkqFOQ" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_eNxYoOB6ekmIV7eu45kwxQ_10_2">101,053</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_8Hl4eTAz2UibicoE-XXWqg" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_mIk1te7MQE2Revf0P3oB1A_10_4">30,644</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:73.53%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:7.2pt;text-indent:-7.2pt;margin:0pt;">Included in liabilities relating to assets classified as held for sale</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.89%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> &#8212;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_DisposalGroupsClassifiedAsHeldForSaleMember_CssegChy7ESJIGyQIxdi6w" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractLiabilities" scale="3" id="Tc_RQJqkXycgEu9NpubgsLBog_11_4">1,865</ix:nonFraction></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Advances received from customers for charging service discount packages mainly arise from sales of VIP membership and coupons.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">During the years ended December 31, 2024 and 2023, revenue recognized that was included in the contract liability balance at the beginning of the year amounted to RMB<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" decimals="-5" format="ixt:num-dot-decimal" name="ifrs-full:RevenueThatWasIncludedInContractLiabilityBalanceAtBeginningOfPeriod" scale="6" id="Narr_x3cqfAPjIUiIrbIzvkYSlA">54.1</ix:nonFraction> million and RMB<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="Duration_1_1_2023_To_12_31_2023_h-5RiJIdRUWk_UP9KnsQKQ" decimals="-5" format="ixt:num-dot-decimal" name="ifrs-full:RevenueThatWasIncludedInContractLiabilityBalanceAtBeginningOfPeriod" scale="6" id="Narr_QW9fuNUDck2eUnOM4vcQXQ">33.5</ix:nonFraction> million, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Group has elected the practical expedient not to disclose the remaining performance obligations for its contracts with customers because the duration of the Group&#8217;s contracts with customers was expected to be one year or less.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Deferred income is unconsumed carbon credits granted to platform users with a validity term of <ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" format="ixt-sec:durwordsen" name="naas:DeferedIncomeMaturityPeriod" id="Narr_KB7J8he-3UqlNT1T6nEP2Q">6 months</ix:nonNumeric>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Group obtained revenue-based financing from a third party where the Group receives capital to fund its cost of charging stations under full operation model in exchange for an agreed portion of the Group&#8217;s daily revenue from the relevant charging stations for a fixed period. The Group was not obliged to repay any minimum or fixed amounts under such arrangement.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Other taxes payable primarily represents value-added tax (&#8220;VAT&#8221;) and related surcharges and PRC individual income tax of employees withheld by the Group.</p></ix:continuation><ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" name="naas:DisclosureOfConvertibleNotesExplanatory" id="Tb_56kxrq3IE0u26YsaDV7ifA" continuedAt="Tb_56kxrq3IE0u26YsaDV7ifA_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;"><span style="display:inline-block;text-indent:0pt;width:18pt;"><b style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:bold;">20.</b></span>Convertible bonds</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">On July&#160;6, 2023 and September&#160;5, 2023, the Company issued convertible bonds to LMR Multi-Strategy Master Fund Limited (&#8220;LMR&#8221;) with a principal amount of US$<ix:nonFraction unitRef="Unit_Standard_USD_vynp2i_E2UmnONV-hluxMw" contextRef="As_Of_7_6_2023_ifrs-full_BorrowingsByNameAxis_naas_July2023LmrConvertibleBondMember_LMTQ-11-60qfFR6niFus_w" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:NotionalAmount" scale="0" id="Narr_9L_ZRhLxtkWPB0bWFvzi7Q">30,000,000</ix:nonFraction>&#160;which is due and mandatorily convertible to the Company&#8217;s ADSs on&#160;<ix:nonNumeric contextRef="Duration_7_6_2023_To_7_6_2023_ifrs-full_BorrowingsByNameAxis_naas_July2023LmrConvertibleBondMember_CeTjGolvGUO5TcNp715_Yg" name="ifrs-full:BorrowingsMaturity" id="Narr_no94EY2L20Gm0rImjXYlbg">July&#160;3, 2024</ix:nonNumeric>&#160; (the &#8220;July 2023 LMR Convertible Note&#8221;), and a principal amount of US$<ix:nonFraction unitRef="Unit_Standard_USD_vynp2i_E2UmnONV-hluxMw" contextRef="As_Of_9_5_2023_ifrs-full_BorrowingsByNameAxis_naas_September2023LmrConvertibleBondMember_h5gE-b8LDkqO1joJ-9XK8Q" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:NotionalAmount" scale="0" id="Narr_r3gH_DbdsUWQ2MI4OufhJw">40,000,000</ix:nonFraction>&#160;which is due on&#160;<ix:nonNumeric contextRef="Duration_9_5_2023_To_9_5_2023_ifrs-full_BorrowingsByNameAxis_naas_September2023LmrConvertibleBondMember_sFDsNrCjakKG0Je0mmkIQQ" name="ifrs-full:BorrowingsMaturity" id="Narr_La5DG_dEbUiBApiqkEYzQQ">September&#160;2, 2024</ix:nonNumeric> (the &#8220;September 2023 LMR Convertible Note&#8221;), respectively. For the outstanding principal amount of convertible bonds, the Company would issue payment in kind note to LMR at the end of each quarter, the amount of which is calculated at&#160;<ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2024_ifrs-full_TypesOfAntidilutiveInstrumentsAxis_ifrs-full_ConvertibleInstrumentsMember_JfYroJjg2kC1Nta-j3hcWA" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_wg2L0p78A0OjDGOClzmsOA">5</ix:nonFraction>% per annum with reference to the principal amount of convertible bonds outstanding during the relevant quarter. Such convertible bonds and payment in kind notes are convertible to the Company&#8217;s ADSs, at certain variable price determined with reference to the market price of the Company&#8217;s ADSs prevailing shortly prior to the conversion. In the event that the entire principal amount of the July&#160;2023 LMR Convertible Note is fully converted prior to its maturity date of July&#160;3, 2024, the Company agreed to further issue and sell, and LMR agrees to purchase, an additional note in the principal amount of US$<ix:nonFraction unitRef="Unit_Standard_USD_vynp2i_E2UmnONV-hluxMw" contextRef="As_Of_12_31_2024_ifrs-full_BorrowingsByNameAxis_naas_July2024LmrConvertibleBondMember_srt_StatementScenarioAxis_srt_ScenarioForecastMember_XWgrzsi96EiR2TzaDFLPJg" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:NotionalAmount" scale="0" id="Narr_1dr6vX5UUECt5HTdvy01Cw">25,000,000</ix:nonFraction>&#160;at the issue price of US$<ix:nonFraction unitRef="Unit_Standard_USD_vynp2i_E2UmnONV-hluxMw" contextRef="As_Of_12_31_2024_ifrs-full_BorrowingsByNameAxis_naas_July2024LmrConvertibleBondMember_srt_StatementScenarioAxis_srt_ScenarioForecastMember_XWgrzsi96EiR2TzaDFLPJg" decimals="0" format="ixt:num-dot-decimal" name="naas:DebtSecuritiesPrice" scale="0" id="Narr_ZOqwZAKnW0KQVN2b9EoPwQ">25,000,000</ix:nonFraction>&#160;with substantially similar terms as the July&#160;2023 LMR Convertible Note.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">These convertible bonds were initially measured at fair value and subsequently carried at fair value through profit or loss pursuant to the Company&#8217;s election to apply the fair value option.</p></ix:nonNumeric></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-49</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 15pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt 0pt 12pt 0pt;">NAAS TECHNOLOGY INC</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTES&#160;TO THE CONSOLIDATED FINANCIAL STATEMENTS</b></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><a id="Tc_saDaeNWcfE-01Un7xSONGQ_1_2"></a><a id="Tc_aQ_cFpLyh0C4GYUS6ySaGw_2_2"></a><a id="Tc_vymWBg2aoECvT1VQUvAkAA_2_4"></a><a id="Tc_XOv5lK8HN0u84emXnHnW3Q_3_2"></a><a id="Tc_iDWntarPPEq-rkiSBWboXg_3_4"></a><a id="Tc_af-E8fx4u0aYURQyorWpAA_4_0"></a><a id="Tc_wfBiVziIUEyMXRUFk5THqQ_5_0"></a><a id="Tc_-y2QW-WXrkOvNYOp8M9L3A_6_0"></a><a id="Tc_rEUz47ZRSkKD3arbf9nNNw_7_0"></a><a id="Tc_wWSed71U_EOvOEA30AZlkg_8_0"></a><a id="Tc_ab7IVJAfkUe53NhMn2vRgA_9_0"></a><a id="Tc_fssq7nFOu0ujjbBFkUv7vQ_10_0"></a><ix:continuation id="Tb_56kxrq3IE0u26YsaDV7ifA_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">On October 4, 2024, the Company entered into a convertible note exchange agreement (the &#8220;Convertible Note Exchange Agreement&#8221;) with LMR, under which LMR agreed to deliver to the Company for cancellation and termination of the US$<ix:nonFraction unitRef="Unit_Standard_USD_vynp2i_E2UmnONV-hluxMw" contextRef="As_Of_10_4_2024_ifrs-full_BorrowingsByNameAxis_naas_July2023AndSeptember2023LmrConvertibleNotesMember_vY2-JqdWzEOXBK-RXrrXnA" decimals="-5" format="ixt:num-dot-decimal" name="naas:IfrsDebtConversionOriginalDebtAmount" scale="6" id="Narr_cWpSEzWSH0am61luLSXRhA">35.5</ix:nonFraction> million aggregate outstanding amount of the July 2023 LMR Convertible Note and the September 2023 LMR Convertible Note. In exchange, the Company issued to LMR a convertible note (the &#8220;New Note&#8221;) in the principal amount of US$<ix:nonFraction unitRef="Unit_Standard_USD_vynp2i_E2UmnONV-hluxMw" contextRef="As_Of_10_4_2024_ifrs-full_BorrowingsByNameAxis_naas_October2024LmrConvertibleBondMember_IKore0AexEGO3RXwYDXqlA" decimals="-5" format="ixt:num-dot-decimal" name="ifrs-full:CurrentDebtInstrumentsIssued" scale="6" id="Narr_iQEdzYazwUqZQHnHHdtvjA">35.0</ix:nonFraction> million and agreed to pay US$<ix:nonFraction unitRef="Unit_Standard_USD_vynp2i_E2UmnONV-hluxMw" contextRef="Duration_10_4_2024_To_10_4_2024_ifrs-full_BorrowingsByNameAxis_naas_July2023AndSeptember2023LmrConvertibleNotesMember_d67JvP934km0FXFV9tJD8Q" decimals="-5" format="ixt:num-dot-decimal" name="ifrs-full:RepaymentsOfCurrentBorrowings" scale="6" id="Narr_DaZ7Cf8TsEOlnKfkBB6B5w">0.5</ix:nonFraction> million to LMR in cash.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The movement in the fair value of convertible bonds during the years indicated is set out below:</p><ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" name="naas:DisclosureOfConvertibleNoteDuringTheReportingPeriodExplanatoryTableTextBlock" id="Tb_JNp8QhNTyUi5g2zxVe7cdg" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:73.53%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:10.89%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td></tr><tr><td style="vertical-align:bottom;width:73.53%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td colspan="3" style="vertical-align:bottom;white-space:nowrap;width:24.13%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">As&#160;of&#160;December&#160;31,</b></p></td></tr><tr><td style="vertical-align:bottom;width:73.53%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.89%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">2023</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">2024</b></p></td></tr><tr><td style="vertical-align:bottom;width:73.53%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">&#160;&#160;&#160;&#160;</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.89%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">RMB&#8217;000</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">&#160;&#160;&#160;&#160;</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">RMB&#8217;000</b></p></td></tr><tr><td style="vertical-align:bottom;width:73.53%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">Opening balance</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">&#160;</b></p></td><td style="vertical-align:bottom