="vertical-align:bottom;white-space:nowrap;width:1.52%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.66%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="Duration_1_1_2023_To_12_31_2023_h-5RiJIdRUWk_UP9KnsQKQ" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ProfitLossAttributableToOrdinaryEquityHoldersOfParentEntity" sign="-" scale="3" id="Tc_krC74tvYykyLEFdDOy_mFA_4_4">1,306,913</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.53%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.66%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ProfitLossAttributableToOrdinaryEquityHoldersOfParentEntity" sign="-" scale="3" id="Tc_kLUm4XXMqE2t1MmFmOjTyA_4_6">913,484</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:60.4%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Weighted average number of ordinary shares in issue</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.52%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.66%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="Duration_1_1_2022_To_12_31_2022_r0WZAwVVWUiAws7Vp25qcA" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:WeightedAverageShares" scale="0" id="Tc_DTwSF05BiECZa3S0FeOIJg_5_2">1,927,746,700</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.52%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.66%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="Duration_1_1_2023_To_12_31_2023_h-5RiJIdRUWk_UP9KnsQKQ" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:WeightedAverageShares" scale="0" id="Tc_BLGfMzy8RUW1Xmo_u7ENGQ_5_4">2,259,760,407</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.53%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.66%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:WeightedAverageShares" scale="0" id="Tc_eqBPDDlvtEaplhxI1Jg_3g_5_6">2,630,750,526</ix:nonFraction></p></td></tr><tr><td style="vertical-align:bottom;width:60.4%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Basic loss per share (RMB per share)</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.52%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.66%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_CNY_shares_RG5zs6gSWEGzZem75IXzhg" contextRef="Duration_1_1_2022_To_12_31_2022_r0WZAwVVWUiAws7Vp25qcA" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:BasicEarningsLossPerShare" sign="-" scale="0" id="Tc_VbHTXVn8KkG_WAtuOvM8zQ_6_2">2.92</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.52%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.66%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_CNY_shares_RG5zs6gSWEGzZem75IXzhg" contextRef="Duration_1_1_2023_To_12_31_2023_h-5RiJIdRUWk_UP9KnsQKQ" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:BasicEarningsLossPerShare" sign="-" scale="0" id="Tc_c-ZuhY8YDkKYPHAHHpQ96Q_6_4">0.58</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.53%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.66%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_CNY_shares_RG5zs6gSWEGzZem75IXzhg" contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:BasicEarningsLossPerShare" sign="-" scale="0" id="Tc_Sul1uAz050O5jflclzfdAw_6_6">0.35</ix:nonFraction></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:0pt;margin-top:0pt;table-layout:fixed;width:100%;border:0pt;"><tr><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:18pt;padding:0pt;">(b)</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">Diluted loss per share</span></td></tr></table><div style="margin-top:10pt;"></div><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">Diluted loss per share is calculated by adjusting the weighted average number of ordinary shares outstanding to assume conversion of all dilutive potential ordinary shares. During the&#160;years ended December&#160;31, 2023 and 2024, the Company had&#160;<ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="Duration_1_1_2023_To_12_31_2023_h-5RiJIdRUWk_UP9KnsQKQ" decimals="0" format="ixt-sec:numwordsen" name="ifrs-full:NumberOfPotentialOrdinarySharesThatAreAntidilutiveInPeriodPresented" scale="0" id="Narr_mEeN2yWQckCOCxkmIhOSBQ"><ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" decimals="0" format="ixt-sec:numwordsen" name="ifrs-full:NumberOfPotentialOrdinarySharesThatAreAntidilutiveInPeriodPresented" scale="0" id="Narr_DyFNxswrAEylJmXESb7Z0Q">no</ix:nonFraction></ix:nonFraction>&#160;dilutive potential ordinary shares as the effect of all potential ordinary shares are determined to be anti-dilutive.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">The computations of basic and diluted loss per Class&#160;A, Class&#160;B and Class&#160;C ordinary share are the same as they have the same rights to participate in profits and are all treated as ordinary shares on an as converted basis.</p></ix:nonNumeric><ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" name="ifrs-full:DisclosureOfSharebasedPaymentArrangementsExplanatory" id="Tb_vbtiKvNxqk2SGZwIC6y8Ww" continuedAt="Tb_vbtiKvNxqk2SGZwIC6y8Ww_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 10pt 0pt;"><span style="display:inline-block;text-indent:0pt;width:18pt;"><b style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:bold;">28.</b></span>Share-based payments</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 10pt 18pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">RISE &#160;Share &#160;Incentive &#160;Plans</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">Before the Merger, RISE operated several Share Incentive Plans (the &#8220;RISE Plans&#8221;) under which the outstanding granted share options of&#160;<ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="Duration_6_10_2022_To_6_10_2022_VGxoklFlWE-76cHk0jTCyA" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfShareOptionsGrantedInSharebasedPaymentArrangement" scale="0" id="Narr_44lpTjY5-kyB-8C6P49q_g">3,966,704</ix:nonFraction>&#160;were all vested and exercisable as of June&#160;10, 2022. All awards under RISE Plans that were outstanding immediately prior to the Merger were automatically cancelled and extinguished, except that each vested option to purchase ordinary shares that was outstanding immediately prior to the Merger was converted into an option to purchase Class&#160;A ordinary shares of the Company. During the period from June&#160;10, 2022 to December&#160;31, 2022,&#160;<ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="Duration_6_10_2022_To_12_31_2022_6Sv27IWzGkSKRm2iCifq7A" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfShareOptionsExercisedInSharebasedPaymentArrangement" scale="0" id="Narr_ni3Kyxfs6U2RDXUFqIkEBA">3,170,010</ix:nonFraction>&#160;share options exercised resulted in the issuance of&#160;<ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="As_Of_12_31_2023_ifrs-full_ClassesOfOrdinarySharesAxis_naas_ClassAOrdinarySharesMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_RiseShareIncentivePlansMember_Z6yxGs5JmkuvRg92bYdAYA" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfSharesIssued" scale="0" id="Narr_v4j5IEvlrEqd0_iGXn_cKw">3,170,010</ix:nonFraction>&#160;Class&#160;A ordinary shares of the Company. The weighted average exercise price at the date of exercise of these options was US$<ix:nonFraction unitRef="Unit_Divide_USD_shares_eftmtc4MbUeE0ZIGck3tCw" contextRef="Duration_1_1_2023_To_12_31_2023_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_RiseShareIncentivePlansMember_vaQ8dMSYqU6Xm-QPdGp2Ow" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:WeightedAverageExercisePriceOfShareOptionsExercisedInSharebasedPaymentArrangement2019" scale="0" id="Narr_isUu7H9K9EaqKKGRLfxHug">0.25</ix:nonFraction>. As of December&#160;31, 2022, the remaining unexercised share options were expired.</p></ix:nonNumeric></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-55</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 15pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt 0pt 12pt 0pt;">NAAS TECHNOLOGY INC</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTES&#160;TO THE CONSOLIDATED FINANCIAL STATEMENTS</b></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><ix:continuation id="Tb_vbtiKvNxqk2SGZwIC6y8Ww_cont1" continuedAt="Tb_vbtiKvNxqk2SGZwIC6y8Ww_cont2"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 10pt 18pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">2022 Share Incentive Plan</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">In January&#160;2022, the Board of Directors of Dada approved the Dada Share Incentive Plan (the &#8220;2022 Share Incentive Plan&#8221;), which has a term of&#160;<ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_DadaShareIncentivePlanMember_OeYCXLDzT02PU9fXdpR2Kg" name="naas:IfrsShareBasedCompensationArrangementByShareBasedPaymentAwardTermsOfAward" id="Narr_gRY30eur4Eag2FNapcIIOw">10&#160;years</ix:nonNumeric>. Under the 2022 Share Incentive Plan, Dada reserved options to its eligible employees, directors and officers for the purchase of Dada&#8217;s&#160;<ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="As_Of_1_31_2022_ifrs-full_ClassesOfOrdinarySharesAxis_naas_ClassAOrdinarySharesMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_DadaShareIncentivePlanMember_0ASFa9F7IkGK71HH2NtnRA" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfSharesIssued" scale="0" id="Narr_6M7-9WmAiEuraRhH9timBw">224,665,915</ix:nonFraction>&#160;ordinary shares in aggregate. The exercise price of such options is US$<ix:nonFraction unitRef="Unit_Divide_USD_shares_eftmtc4MbUeE0ZIGck3tCw" contextRef="As_Of_1_31_2022_ifrs-full_RangeAxis_ifrs-full_BottomOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_DadaShareIncentivePlanMember_l9LvmlKpoU-G39Oa6k5SgQ" decimals="6" format="ixt:num-dot-decimal" name="ifrs-full:ExercisePriceOfOutstandingShareOptions2019" scale="0" id="Narr_tLr_gMoIPk2EUduCL6Daxg">0.000003</ix:nonFraction>&#160;to US$<ix:nonFraction unitRef="Unit_Divide_USD_shares_eftmtc4MbUeE0ZIGck3tCw" contextRef="As_Of_1_31_2022_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_DadaShareIncentivePlanMember_tyjf70a4oEqOHI7KggHrwQ" decimals="1" format="ixt:num-dot-decimal" name="ifrs-full:ExercisePriceOfOutstandingShareOptions2019" scale="0" id="Narr_JucSWlcDIEm4bg-cQ2Z6AQ">0.3</ix:nonFraction>&#160;per share.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">During the&#160;year ended December&#160;31, 2022, the Company granted certain share options under the 2022 Share Incentive Plan. Most of those share options granted under the 2022 Share Incentive Plan were to be vested over <ix:nonNumeric contextRef="Duration_1_1_2023_To_12_31_2023_ifrs-full_RangeAxis_ifrs-full_BottomOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanMember_qUqdzxMcgkOHMIQkmPsmrQ" format="ixt-sec:duryear" name="naas:IfrsShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod" id="Narr_LNOfGv2EVEiyGvw2Toc9AA">3</ix:nonNumeric> to <ix:nonNumeric contextRef="Duration_1_1_2023_To_12_31_2023_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanMember_5F4PSK5BGEygcRxcMchIbg" format="ixt-sec:durwordsen" name="naas:IfrsShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod" id="Narr_AuuvMrXd00KB3-QR0g6j4g">5&#160;years</ix:nonNumeric>. The contractual term of those share options is <ix:nonNumeric contextRef="Duration_1_1_2023_To_12_31_2023_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanMember_v_zWzJtYE0Ck2ImW2aC0rA" name="naas:IfrsShareBasedCompensationArrangementByShareBasedPaymentAwardTermsOfAward" id="Narr_B5OoOnIUSkyeF8raLKbBuQ">10&#160;years</ix:nonNumeric>. The fair value of the share options was determined using the binomial option valuation model. The binomial model requires the input of a few key assumptions. For expected volatility, the Company made reference to the Company&#8217;s own listed share price and historical volatility of several comparable companies due to its short history of being listed.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">On March&#160;18, 2022, the Board of Directors of Dada approved certain grants to two of the Group&#8217;s directors and executive officers of share options with vesting condition that <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="Duration_3_18_2022_To_3_18_2022_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_NaasDadaShareIncentivePlanMember_srt_TitleOfIndividualAxis_srt_DirectorMember_H5FTLQpUD0eHk4qRp4-Dug" decimals="INF" format="ixt:num-dot-decimal" name="naas:PercentageOfShareOptionsVestingBasedOnCompletionOfMerger" scale="-2" id="Narr_VmO3VIyvsEq68Gmu_9Ebtw">50</ix:nonFraction>% will vest subject to completion of the Merger, and with market conditions that <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="Duration_3_18_2022_To_3_18_2022_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_DadaShareIncentivePlanMember_srt_TitleOfIndividualAxis_srt_DirectorMember_ms8neT195E2dcyfowoDH5A" decimals="INF" format="ixt:num-dot-decimal" name="naas:PercentageOfShareOptionsVestingBasedOnMarketCondition" scale="-2" id="Narr_46WEMkxB30maM_-C3K66MA">25</ix:nonFraction>% and <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="Duration_3_18_2022_To_3_18_2022_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_DadaShareIncentivePlanMember_srt_TitleOfIndividualAxis_srt_ExecutiveOfficerMember_PgSvI9d3vkOXlLS3j7ckyA" decimals="INF" format="ixt:num-dot-decimal" name="naas:PercentageOfShareOptionsVestingBasedOnMarketCondition" scale="-2" id="Narr_2oBkFt9hHkK_3pB71eFHfQ">25</ix:nonFraction>% will vest, respectively, when the market capitalization of the equity securities of the Company after the consummation of the Merger equals or exceeds two targeted market capitalization over a period of pre-agreed consecutive trading&#160;days, respectively. The fair value of the share options granted subject to market conditions is estimated at the date of grant using a Monte-Carlo simulation model, taking into account the terms and conditions on which the share options were granted. As the grant has a variable vesting period due to the market conditions, share-based compensation expense is recognized based on an estimated expected vesting period of <ix:nonNumeric contextRef="Duration_3_18_2022_To_3_18_2022_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_DadaShareIncentivePlanMember_srt_TitleOfIndividualAxis_srt_DirectorMember_ms8neT195E2dcyfowoDH5A" format="ixt-sec:duryear" name="naas:IfrsShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod" id="Narr_fjGKHaT5ikicMY1FArghng">9.13</ix:nonNumeric>&#160;years and <ix:nonNumeric contextRef="Duration_3_18_2022_To_3_18_2022_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_DadaShareIncentivePlanMember_srt_TitleOfIndividualAxis_srt_ExecutiveOfficerMember_PgSvI9d3vkOXlLS3j7ckyA" format="ixt-sec:duryear" name="naas:IfrsShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod" id="Narr_anuGjJ6360SoQIMp8kX6EA">9.53</ix:nonNumeric>&#160;years, respectively, consistent with the assumptions used in the Monte-Carlo simulation model.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In February and March 2022, certain employees resigned and joined Anji Datacom. The Group agreed that all unvested options of those employees became immediately vested upon resignation. The Group expensed all unvested options upon the accelerated vesting in the consolidated statements of profit or loss and other comprehensive loss.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">On June 10, 2022, the Company assumed the then-effective 2022 Share Incentive Plan. Each option to purchase the ordinary shares of Dada that was outstanding immediately prior to June 10, 2022, whether vested or unvested, was converted into an option to purchase a number of Class A ordinary shares of the Company at a conversion ratio of <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_6_10_2022_ifrs-full_ClassesOfOrdinarySharesAxis_naas_ClassAOrdinarySharesMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_DadaShareIncentivePlanMember_aaiqPSbWsUapyQZwahWJSw" decimals="3" format="ixt:num-dot-decimal" name="naas:OrdinarySharesConversionRatio" scale="0" id="Narr_EFT7Ajeo1UWoHm6zHUaXXA">32.951</ix:nonFraction> in accordance with the Merger. In September 2022, the 2022 Share Incentive Plan was replaced with further explanation below.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:0pt;margin:0pt 0pt 12pt 18pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">The New 2022 Share Incentive Plan</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In September&#160;2022, the Board of Directors of NaaS approved the New 2022 Share Incentive Plan of NaaS (the &#8220;New 2022 Share Incentive Plan&#8221;) to replace the 2022 Share Incentive Plan. The New 2022 Share Incentive Plan has a term of 10&#160;years. The maximum number of Class&#160;A ordinary shares available to be issued under the New 2022 Share Incentive Plan is initially <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="As_Of_6_10_2022_ifrs-full_ClassesOfOrdinarySharesAxis_naas_ClassAOrdinarySharesMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember_kou7RpEsK0GHhVN873LjDA" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfSharesIssued" scale="0" id="Narr_RIgF9-ZDCUiLyiopkXYWKg">249,770,760</ix:nonFraction> and will be increased on the first day of each fiscal&#160;year from January&#160;1, 2023 by an amount equal to <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="Duration_6_10_2022_To_6_10_2022_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember_EAnpBqnqNk638YUy2NZ1Iw" decimals="2" format="ixt:num-dot-decimal" name="naas:PercentageOfNumberOfSharesIssuedAndOutstanding" scale="-2" id="Narr_EkauS0BecECeqyZf7pZzEw">1</ix:nonFraction>% of the total number of shares issued and outstanding on the last day of the immediately preceding fiscal&#160;year, unless otherwise decided by the Board of Directors of the Company. The exercise price for such options is US$<ix:nonFraction unitRef="Unit_Divide_USD_shares_eftmtc4MbUeE0ZIGck3tCw" contextRef="As_Of_9_30_2022_ifrs-full_RangeAxis_ifrs-full_BottomOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember_Kxhw_pmFCES5nLIET5IynQ" decimals="4" format="ixt:num-dot-decimal" name="ifrs-full:ExercisePriceOfOutstandingShareOptions2019" scale="0" id="Narr_8b7xMP_EJ0iKmIOIbsDsZQ">0.0001</ix:nonFraction> to US$<ix:nonFraction unitRef="Unit_Divide_USD_shares_eftmtc4MbUeE0ZIGck3tCw" contextRef="As_Of_9_30_2022_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember_vCO5mtXe00WnARowLXG7ZQ" decimals="1" format="ixt:num-dot-decimal" name="ifrs-full:ExercisePriceOfOutstandingShareOptions2019" scale="0" id="Narr_GVabzhwZaU-hn60-EgBghA">0.3</ix:nonFraction> per share.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In June&#160;2023, the Board of Directors of NaaS approved the Amended and Restated New 2022 Share Incentive Plan, pursuant to which the maximum number of Class&#160;A ordinary shares of the Company available to be issued under the Amended and Restated New 2022 Share Incentive Plan will be initially <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="As_Of_6_30_2023_ifrs-full_ClassesOfOrdinarySharesAxis_naas_ClassAOrdinarySharesMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoAmendedShareIncentivePlanOneMember_u9SPrXEt5UyjD8kBktGcrQ" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfSharesIssued" scale="0" id="Narr_fHZY641kPUapcX7tG_LjUg">413,921,180</ix:nonFraction>, plus commencing no earlier than January&#160;1, 2024, an increase on the first day of each fiscal&#160;year, a number equal to <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="Duration_6_1_2023_To_6_30_2023_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoAmendedShareIncentivePlanOneMember_VrHHnFbupk6h0LaUzMiMWQ" decimals="2" format="ixt:num-dot-decimal" name="naas:PercentageOfNumberOfSharesIssuedAndOutstanding" scale="-2" id="Narr_nk0tIaex4ES0KAQD1IVR1g">1</ix:nonFraction>% of the then total number of shares issued and outstanding on an as converted and fully-diluted basis on the last day of the immediately preceding fiscal&#160;year, unless otherwise decided by the Board of Directors of the Company.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">In December&#160;2023, the Board of Directors of NaaS approved the Second Amended and Restated New 2022 Share Incentive Plan, pursuant to which the maximum number of Class&#160;A ordinary shares of the Company available to be issued under the Amended and Restated New 2022 Share Incentive Plan will be initially <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="As_Of_12_31_2023_ifrs-full_ClassesOfOrdinarySharesAxis_naas_ClassAOrdinarySharesMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoAmendedShareIncentivePlanTwoMember_reu210Q2bE-2SgzP6K188w" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfSharesIssued" scale="0" id="Narr_XmRqLTUv60WDbnz-keXyBA">490,563,333</ix:nonFraction>, plus commencing no earlier than January&#160;1, 2024, an increase on the first day of each fiscal&#160;year, a number equal to <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="Duration_12_1_2022_To_12_31_2022_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoAmendedShareIncentivePlanTwoMember__ULahNQooEe0A1Mrepx45g" decimals="2" format="ixt:num-dot-decimal" name="naas:PercentageOfNumberOfSharesIssuedAndOutstanding" scale="-2" id="Narr_3GwsgsP4JEW1MgFeRrh0YQ">1</ix:nonFraction>% of the then total number of shares issued and outstanding on an as converted and fully-diluted basis on the last day of the immediately preceding fiscal&#160;year, unless otherwise decided by the Board of Directors of the Company.</p></ix:continuation></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-56</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 15pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt 0pt 12pt 0pt;">NAAS TECHNOLOGY INC</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTES&#160;TO THE CONSOLIDATED FINANCIAL STATEMENTS</b></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><ix:continuation id="Tb_vbtiKvNxqk2SGZwIC6y8Ww_cont2" continuedAt="Tb_vbtiKvNxqk2SGZwIC6y8Ww_cont3"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">In May 2024, the Board of Directors of NaaS approved the Third Amended and Restated New 2022 Share Incentive Plan, pursuant to which the maximum number of Class A ordinary shares of the Company available to be issued under the Amended and Restated New 2022 Share Incentive Plan will be initially <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="As_Of_5_31_2024_ifrs-full_ClassesOfOrdinarySharesAxis_naas_ClassAOrdinarySharesMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoAmendedShareIncentivePlanThreeMember_q915wcgYPkKkvpIdddy2vw" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfSharesIssued" scale="0" id="Narr_dDwyHGGHbESeo-VOv13OJQ">644,746,682</ix:nonFraction>, plus commencing no earlier than January 1, 2025, an increase on the first day of each fiscal year, a number equal to <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="Duration_5_1_2024_To_5_31_2024_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoAmendedShareIncentivePlanThreeMember_dKF3lwwHhEyiabGev7Fqpg" decimals="2" format="ixt:num-dot-decimal" name="naas:PercentageOfNumberOfSharesIssuedAndOutstanding" scale="-2" id="Narr_DdB4ABtDj0e-JdCDm9XK0A">1</ix:nonFraction>% of the then total number of shares issued and outstanding on an as converted and fully-diluted basis on the last day of the immediately preceding fiscal year, unless otherwise decided by the Board of Directors of the Company. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">In August 2024, the Board of Directors of NaaS approved the Fourth Amended and Restated New 2022 Share Incentive Plan, pursuant to which the maximum number of Class A ordinary shares of the Company available to be issued under the Amended and Restated New 2022 Share Incentive Plan will be initially <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="As_Of_8_31_2024_ifrs-full_ClassesOfOrdinarySharesAxis_naas_ClassAOrdinarySharesMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoAmendedShareIncentivePlanFourMember_BgIzEU4jO0S6jxfRBYIhXg" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfSharesIssued" scale="0" id="Narr_XhvdTOaxFUibv8bV8_0U2g">779,385,082</ix:nonFraction>, plus commencing no earlier than January 1, 2025, an increase on the first day of each fiscal year, a number equal to <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="Duration_8_1_2024_To_8_31_2024_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoAmendedShareIncentivePlanFourMember_omH1oJZYo0az4LPeXypJgA" decimals="2" format="ixt:num-dot-decimal" name="naas:PercentageOfNumberOfSharesIssuedAndOutstanding" scale="-2" id="Narr_3n3jGgwhHECUvnk0eetyIQ">1</ix:nonFraction>% of the then total number of shares issued and outstanding on an as converted and fully-diluted basis on the last day of the immediately preceding fiscal year, unless otherwise decided by the Board of Directors of the Company.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">Outstanding awards under the 2022 Share Incentive Plan remained valid and were governed by, and counted towards the total number of shares available under the New 2022 Share Incentive Plan. The Company reserved options to its eligible employees, directors and officers for the purchase of the Company&#8217;s <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="As_Of_12_31_2022_ifrs-full_ClassesOfOrdinarySharesAxis_naas_ClassAOrdinarySharesMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember_I-Eq9efiBkGsz4C2mOLLog" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfSharesIssued" scale="0" id="Narr_34QW1nVLHUGXzxL-kpryDA">224,665,915</ix:nonFraction><span style="white-space:pre-wrap;"> Class A ordinary shares in aggregate. The Company granted  </span><ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="Duration_1_1_2022_To_12_31_2022_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember_kFscfk4rMUq7q5eLoWy2Xw" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfShareOptionsGrantedInSharebasedPaymentArrangement" scale="0" id="Narr_EP7MhLHeHUGTyptZgOEoSA">195,763,865</ix:nonFraction> share options under the New 2022 Share Incentive Plan to the original grantees as the replacement awards for the 2022 Share Incentive Plan. Such replacement was accounted for as a modification of share options. The incremental cost immediately before and after the replacement was immaterial.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">During the period from September 29, 2022 to December 31, 2022, the Company granted additional share options under the New 2022 Share Incentive Plan. Most of the share options granted under the 2022 Share Incentive Plan were to be vested over <ix:nonNumeric contextRef="Duration_6_1_2022_To_12_31_2022_sxdJPA2rak-zsS0ddWwq4Q" format="ixt-sec:duryear" name="naas:IfrsShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod" id="Narr_awecRc1QhkKLl0QOlOaiAg">3</ix:nonNumeric> to <ix:nonNumeric contextRef="Duration_6_1_2022_To_12_31_2022_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember_jydV3hRiqk-fIeJCNFDUXg" format="ixt-sec:durwordsen" name="naas:IfrsShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod" id="Narr_3ZnpMkyM-kGnTDSJNfn7dw">5&#160;years</ix:nonNumeric>. The contractual term of those share options is <ix:nonNumeric contextRef="Duration_6_1_2022_To_12_31_2022_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember_jydV3hRiqk-fIeJCNFDUXg" format="ixt-sec:duryear" name="ifrs-full:WeightedAverageRemainingContractualLifeOfOutstandingShareOptions2019" id="Narr_Pp8VqbHyUU2lfCNnmRm35w">10</ix:nonNumeric>&#160;years.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">During the years ended December 31, 2023 and 2024, the Company granted <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="Duration_1_1_2023_To_12_31_2023_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember_ey5Pi6o850C_OD8TtP8C5Q" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfShareOptionsGrantedInSharebasedPaymentArrangement" scale="0" id="Narr_8F1yXmOtfUymaLW1pEttow">7,656,590</ix:nonFraction> and <ix:nonFraction unitRef="Unit_Standard_shares_EOecAnSCyEGzRUCEJ6Z4HQ" contextRef="Duration_1_1_2024_To_12_31_2024_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember__jy9UeYGCUivuMUJcY3KwQ" decimals="INF" format="ixt:num-dot-decimal" name="ifrs-full:NumberOfShareOptionsGrantedInSharebasedPaymentArrangement" scale="0" id="Narr_rcN0kqh96ki2CFKTm8va-g">74,161,000</ix:nonFraction> shares to certain suppliers in lieu of cash payment, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">During the year ended December 31, 2023, share-based compensation from ESOP included RMB<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="Duration_1_1_2024_To_12_31_2024_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_TwoThousandAndTwentyTwoShareIncentivePlanOfNaasMember__jy9UeYGCUivuMUJcY3KwQ" decimals="-5" format="ixt:num-dot-decimal" name="ifrs-full:IncrementalFairValueGrantedModifiedSharebasedPaymentArrangements" scale="6" id="Narr_VjbGSdcVI0GaKxQwapCK0Q">186.1</ix:nonFraction> million arose from modification of the terms of certain share options granted during the year ended December 31, 2022.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">During the year ended December 31, 2024, share-based compensation from ESOP included RMB<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="Duration_1_1_2024_To_12_31_2024_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_naas_EmployeeStockOptionsMember_rg_qT5Kd_EKYeZYaLFKhsA" decimals="-5" format="ixt:num-dot-decimal" name="ifrs-full:IncrementalFairValueGrantedModifiedSharebasedPaymentArrangements" scale="6" id="Narr_bvDE4kU9nUmQnM7Gy5hXHQ">0.6</ix:nonFraction> million arose from modification of the terms of certain share options granted in during the years ended December 31, 2023 and 2024.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 10pt 0pt;">There were no cash settlement alternatives for employees, and the Group did not have a past practice of cash settlement for those awards. The Group&#8217;s awards were accounted for as equity awards.</p></ix:continuation></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-57</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 15pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt 0pt 12pt 0pt;">NAAS TECHNOLOGY INC</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTES&#160;TO THE CONSOLIDATED FINANCIAL STATEMENTS</b></p></div><div style="clear:both;margin-left:-10.0pt;margin-right:-10.0pt;max-width:100%;position:relative;width:calc(100% + 20.0pt);min-height:13.8pt;"><div style="padding-left:10pt;padding-right:10pt;position:relative;width:100%;"><a id="_63937261_dc6b_4154_972a_7a8628ec25b6"></a><a id="Tc_8m_PyPbkSEisqZdhYXPckQ_1_4"></a><a id="Tc_veGsfu7NrEKBeDvpALsC4Q_2_4"></a><a id="Tc_gQzsVoHzwEq7Rz5Rm65YQg_3_2"></a><a id="Tc_w996Nd2aKEiHNsk0r8R4Kw_3_4"></a><a id="Tc_Atld5fsaLUKaHWRJthwUdA_4_2"></a><a id="Tc_QVQT68TuaUWKcAu7AZA_Lw_4_4"></a><a id="Tc_2mDYthCiwE-c2JH0Qxadjg_5_4"></a><a id="Tc_LG5D2lzjwkiQlZ5g7jJy9Q_6_0"></a><a id="Tc_wuMjhYQ1oUKPLypcCCSxiQ_6_5"></a><a id="Tc_GvRf_rOnxUCCjiN8tZ6MKQ_7_0"></a><a id="Tc_6xX0o47is06QkH9lXap3sw_8_0"></a><a id="Tc_oJyVoKB66EKocve_jlbx0g_9_0"></a><a id="Tc_znQz_Glr902-Hek2tKH6gw_10_0"></a><a id="Tc_Wh6N2aVTDkmvuXPGyMhd8Q_11_0"></a><a id="Tc_NOhMOYVoOEmrDPon4KUoxw_11_5"></a><a id="_5da0a162_87b5_49e3_9202_309670b14ddf"></a><a id="Tc_uPblUhBVqU2rcXG1XG__LA_3_2"></a><a id="Tc_T8-wLsNQLkilSZP-AQ9ERQ_3_4"></a><a id="Tc_XpWYmPmxN0-IF09toXngsg_4_2"></a><a id="Tc_SuhzqmittEKN86jxS2xeXA_4_4"></a><a id="Tc_xTTZ9hnCxka8sMH46OwKKw_5_4"></a><a id