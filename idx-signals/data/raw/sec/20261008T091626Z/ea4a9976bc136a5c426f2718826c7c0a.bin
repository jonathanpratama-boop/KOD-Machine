41%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.5%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"> (<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_8Hl4eTAz2UibicoE-XXWqg" decimals="-3" format="ixt:num-dot-decimal" name="naas:ProvisionOnImpairmentOfContractAssets" scale="3" id="Tc_0ZP1zD1OkUmSb4uz5WZOAQ_5_4">2,194</ix:nonFraction>)</p></td></tr><tr><td style="vertical-align:bottom;width:76.14%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.41%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.51%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_a5gxuVH8Y0a9uyImGkqFOQ" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:ContractAssets" scale="3" id="Tc_zqPh6ex5aECM6l5dWoCcmg_6_2">77,684</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.41%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.5%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> &#8212;</p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Group considers historical default rates taking into consideration forward-looking information to assess ECL for contract assets. As of December 31, 2023, with RMB<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_ifrs-full_GrossCarryingAmountMember_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_ContractAssetsMember_ifrs-full_PastDueStatusAxis_ifrs-full_NotLaterThanOneYearMember_x4ovMEfbFky7myR7ceJQeQ" decimals="-5" format="ixt:num-dot-decimal" name="ifrs-full:ContractAssets" scale="6" id="Narr_IU6kGr8YVkad9kpgiSCaUw">85.9</ix:nonFraction> million of the contract assets expected to be recovered within one year, the Group applied an expected loss rate of <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2023_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_ContractAssetsMember_ifrs-full_PastDueStatusAxis_ifrs-full_NotLaterThanOneYearMember_qVJmSyEurUqZAlC_kJZ3hA" decimals="3" format="ixt:num-dot-decimal" name="ifrs-full:ExpectedCreditLossRate" scale="-2" id="Narr_xrTUt3YkQUynQI-9JC0kTA">9.6</ix:nonFraction>% and made a loss allowance of RMB<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_ifrs-full_AllowanceForCreditLossesMember_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_ContractAssetsMember_ifrs-full_PastDueStatusAxis_ifrs-full_NotLaterThanOneYearMember_Yh3twKItOkSpb32mk1yiEQ" decimals="-5" format="ixt:num-dot-decimal" name="ifrs-full:ContractAssets" scale="6" id="Narr_NaP2n2Y5yUuYZgQ-gWBMgg">8.2</ix:nonFraction> million.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">Besides from the above ECL allowance, as of December 31, 2023 and 2024, loss allowance was fully made for specific contract assets with gross amount of RMB<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_ifrs-full_AccumulatedImpairmentMember_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_ContractAssetsMember_VR-m2gukJk-JLT-bffj1Ww" decimals="-5" format="ixt:num-dot-decimal" name="ifrs-full:CurrentContractAssets" scale="6" id="Narr_E1ePFiY9kUiRds-HxZIH4Q">2.7</ix:nonFraction> million and RMB<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_ifrs-full_AccumulatedImpairmentMember_ifrs-full_ClassesOfFinancialInstrumentsAxis_ifrs-full_ContractAssetsMember_OgyUbj_MwkmwF7C5hDkBSw" decimals="-5" format="ixt:num-dot-decimal" name="ifrs-full:CurrentContractAssets" scale="6" id="Narr_tJTl08yW60WwYGVm0Ot1pg">2.2</ix:nonFraction> million, respectively, which were considered to be in default due to conditions indicating that the Group was unlikely to receive the outstanding contractual amounts.</p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-41</p></div></div>
