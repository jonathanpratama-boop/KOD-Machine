putMember_h4OJFKwNW0u0gaCEQcEtPw" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:FinancialAssetsAtFairValueThroughProfitOrLoss" scale="3" id="Tc_TWy642mV40qeWLa8V_pRYg_6_4">3,160</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.22%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:12.44%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_ifrs-full_ClassesOfAssetsAxis_naas_InvestmentsInUnlistedCompany1Member_ifrs-full_UnobservableInputsAxis_naas_ExpectedVolatilityMeasurementInputMember_xk21yuBJokqSrq0wBXl9-w" name="naas:SignificantUnobservableInputsDescription" id="Tc_JY3hLwSxNE6eaXWhaJiQYQ_6_6">Expected volatility</ix:nonNumeric></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.5%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:7.58%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2023_ifrs-full_ClassesOfAssetsAxis_naas_InvestmentsInUnlistedCompany1Member_ifrs-full_UnobservableInputsAxis_naas_ExpectedVolatilityMeasurementInputMember_UBMnEYBwzk6sxBC4EDUzXw" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:PercentageOfReasonablyPossibleIncreaseInUnobservableInputAssets" scale="-2" id="Tc_PhY0lbOzX0u5akwtlXvgeQ_6_8">26</ix:nonFraction></p></td><td style="vertical-align:top;width:2.47%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">%&#160;&#160;</p></td><td style="vertical-align:top;width:7.58%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2024_ifrs-full_ClassesOfAssetsAxis_naas_InvestmentsInUnlistedCompany1Member_ifrs-full_UnobservableInputsAxis_naas_ExpectedVolatilityMeasurementInputMember_CEKcaj2g1kC7SMp3yNFK1g" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:PercentageOfReasonablyPossibleIncreaseInUnobservableInputAssets" scale="-2" id="Tc_WT4CUREGPkSLOcaAHYdw-A_6_10">26</ix:nonFraction></p></td><td style="vertical-align:top;width:2.47%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">%&#160;&#160;</p></td><td style="vertical-align:top;width:15.46%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_ifrs-full_ClassesOfAssetsAxis_naas_InvestmentsInUnlistedCompany1Member_ifrs-full_UnobservableInputsAxis_naas_ExpectedVolatilityMeasurementInputMember_xk21yuBJokqSrq0wBXl9-w" name="ifrs-full:DescriptionOfInterrelationshipsBetweenUnobservableInputsAndOfHowTheyMightMagnifyOrMitigateEffectOfChangesInUnobservableInputsOnFairValueMeasurementAssets" id="Tc_Q-M2-PS2xE2atiC7C06rWw_6_12">The higher the expected volatility, the lower the fair value</ix:nonNumeric></p></td></tr><tr><td style="vertical-align:bottom;width:30.69%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.49%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.71%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.65%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.7%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.22%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:12.44%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_ifrs-full_UnobservableInputsAxis_naas_DiscountForLackOfMarketabilityMember_VVq5fFgiXkGrZPqYGoJI7A" name="naas:SignificantUnobservableInputsDescription" id="Tc__5D1NpS3OEa_ElUUJGk0-g_7_6">Discount for lack of marketability (&#8220;DLOM&#8221;)</ix:nonNumeric></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.5%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:7.58%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EW