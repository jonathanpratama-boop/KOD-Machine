-decimal" name="ifrs-full:NoncurrentPortionOfNoncurrentLoansReceived" scale="3" id="Tc_ZNdA79UKcE6knpN22dV60w_7_2">681,821</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_8Hl4eTAz2UibicoE-XXWqg" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:NoncurrentPortionOfNoncurrentLoansReceived" scale="3" id="Tc_y2VRlQvPyUKB9jlClBTr_Q_7_4">51,067</ix:nonFraction></b></p></td></tr><tr><td style="vertical-align:bottom;width:73.53%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">&#160;</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.89%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_a5gxuVH8Y0a9uyImGkqFOQ" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:Borrowings" scale="3" id="Tc_EwjZBYF-uUqMP4QAtm7MHA_8_2">754,774</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><b style="font-weight:bold;">&#160;</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.91%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_8Hl4eTAz2UibicoE-XXWqg" decimals="-3" format="ixt:num-dot-decimal" name="ifrs-full:Borrowings" scale="3" id="Tc_0J2UuyJQA0-PVAZJtgvpow_8_4">824,045</ix:nonFraction></b></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">As of December 31, 2024, the interest rates of current borrowings, repayable within one year or on demand, ranged from&#160;<ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2024_ifrs-full_MaturityAxis_ifrs-full_NotLaterThanOneYearMember_ifrs-full_RangeAxis_ifrs-full_BottomOfRangeMember_X3T6wAf-tESOQoCwcmuzOg" decimals="3" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_GgwETtZP60CankOmVYzy6Q">4.2</ix:nonFraction>% to&#160;<ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2024_ifrs-full_MaturityAxis_ifrs-full_NotLaterThanOneYearMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_Kw4_HcTzW02xTvQVqV1UrA" decimals="3" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_sIe5ZRijg0Csw61bePwDiQ">6.2</ix:nonFraction>% (2023: <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2023_ifrs-full_MaturityAxis_ifrs-full_NotLaterThanOneYearMember_ifrs-full_RangeAxis_ifrs-full_BottomOfRangeMember_qbEVrOvrv0i5pil1xr1wTw" decimals="3" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_6OrARWoEAkO3LvuiaFhhGA">3.5</ix:nonFraction>% to&#160;<ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2023_ifrs-full_MaturityAxis_ifrs-full_NotLaterThanOneYearMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_bkpPtdTjMEewDxnzAyKjYw" decimals="3" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_TdnoYJuNlkOX9E8KUbjmsg">15.0</ix:nonFraction>%) per annum.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">As of December&#160;31, 2024, the interest rate of non-current borrowings was&#160;<ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2024_8Hl4eTAz2UibicoE-XXWqg" decimals="2" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_pRUUYLa6M0ea-ZgnCeypbQ">3</ix:nonFraction>% (2023: ranging from&#160;<ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2023_ifrs-full_RangeAxis_ifrs-full_BottomOfRangeMember_LozD2Kd8c0SaVjJshTyYPQ" decimals="3" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_BZg21-DZbEyrw1PfkHcxLA">4.2</ix:nonFraction>% to <ix:nonFraction unitRef="Unit_Standard_pure_D85r2EWBuUqsB_GqmC2vSw" contextRef="As_Of_12_31_2023_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember_FUAxADCYEEqEEgXO2AyzGQ" decimals="3" format="ixt:num-dot-decimal" name="ifrs-full:BorrowingsInterestRate" scale="-2" id="Narr_9LljaqHM70iysKdfXspQ-g">5.5</ix:nonFraction>%) per annum.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The Group&#8217;s borrowings were primarily denominated in RMB.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">During the year ended December 31, 2024, the Group obtained new borrowing facilities amounting to RMB<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2024_8Hl4eTAz2UibicoE-XXWqg" decimals="-5" format="ixt:num-dot-decimal" name="naas:TotalAmountOfBorrowingsNewBankingFacility" scale="6" id="Narr_24tmRlfLqUCHZVqJxmbW4A">125.0</ix:nonFraction>&#160;million (2023: RMB<ix:nonFraction unitRef="Unit_Standard_CNY_0qCbWPYWEEK2xacD2l1cCw" contextRef="As_Of_12_31_2023_a5gxuVH8Y0a9uyImGkqFOQ" decimals="-5" format="ixt:num-dot-decimal" name="naas:TotalAmountOfBorrowingsNewBankingFacility" scale="6" id="Narr_sTe8XddirEyll9dSakAfdg">380.3</ix:nonFraction> million). The Group&#8217;s borrowings were mostly repayable in&#160;<ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_ifrs-full_BorrowingsByNameAxis_naas_LpreightybpMember_ifrs-full_MaturityAxis_naas_BorrowingsDueOnJuneTwoThousandAndTwentyFiveMember_XrAGhGHTWkmDsKRXOHj_Hg" name="ifrs-full:BorrowingsMaturity" id="Narr_tXz6HcwxGUOQf2qBL7teSg">June&#160;2025</ix:nonNumeric>, partially in <span style="-sec-ix-hidden:Hidden_afWMVDVkU0Sx8YHMaJgxlA;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">January</span></span>, <span style="-sec-ix-hidden:Hidden_naMZwbrUC0OeaC9PeAeh_Q;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">February</span></span> and <span style="-sec-ix-hidden:Hidden_xd8z3teT3EuYZDDFqnHiOQ;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">December&#160;2025</span></span>&#160;and&#160;<span style="-sec-ix-hidden:Hidden_YbitowXwo0-3wujviMgjsA;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">October&#160;2027</span></span>, some of which were guaranteed by Newlink and its two subsidiaries.</p></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><a id="Tc_r9gHrtH-Gk6Prl9bSe3edw_1_2"></a><a id="Tc_sIXxBynQF0aWGD7NDyC57A_2_2"></a><a id="Tc_v756J_1wbUexyo0CH02WhQ_2_4"></a><a id="Tc_wZV1NC3FZ0yQdvRitappKA_3_2"></a><a id="Tc_gT3_I0BZ1Uq8iQwnaWeYIA_3_4"></a><a id="Tc_HD64PxQ6SEuXQ4YGwMhodw_4_0"></a><a id="Tc_utkOIJY_PEyr5XsdzoGLGQ_5_0"></a><a id="Tc_yv4esbaMZEKmaESlcZ3xrw_7_0"></a><a id="Tc_bndmxFFxF0u4VMhYQi50Yg_8_0"></a><a id="Tc_MGUhzfNSg0KR4kmbEqQQVg_8_2"></a><ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" name="ifrs-full:DisclosureOfTradeAndOtherPayablesExplanatory" id="Tb_mJOSlPvZskuA8_CMHl7VvQ" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;"><span style="display:inline-block;text-indent:0pt;width:18pt;"><b style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:bold;">18.</b></span>Trade payables</p><ix:nonNumeric contextRef="Duration_1_1_2024_To_12_31_2024_gTXMK1-s4EOsKWmn_xm7UA" name="naas:DisclosureOfTradePayableExplanatoryTextBlock" id="Tb_nYqoxluOlUqvzj2vieTHiA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:73.53%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times 