<P STYLE="margin: 0; font-size: 10pt; text-align: justify"><B>&nbsp;</B></P>

<!-- Field: Page; Sequence: 92; Value: 9 -->
    <DIV STYLE="border-bottom: Black 4pt solid; margin-top: 6pt; margin-bottom: 6pt"><TABLE CELLPADDING="0" CELLSPACING="0" STYLE="border-collapse: collapse; width: 100%; font-size: 10pt"><TR STYLE="vertical-align: top; text-align: left"><TD STYLE="width: 33%">&nbsp;</TD><TD STYLE="width: 34%; text-align: center"><!-- Field: Sequence; Type: Arabic; Name: PageNo -->17<!-- Field: /Sequence --></TD><TD STYLE="width: 33%; text-align: right">&nbsp;</TD></TR></TABLE></DIV>
    <DIV STYLE="break-before: page; margin-top: 6pt; margin-bottom: 6pt"><P STYLE="margin: 0; font-size: 10pt; color: #004799"><B>XORTX THERAPEUTICS INC.</B></P><P STYLE="margin: 0; font-size: 10pt"><B>Notes to the Consolidated Financial Statements</B></P><P STYLE="margin: 0; font-size: 10pt"><B>For the years ended December 31, 2025, 2024 and 2023</B></P><P STYLE="border-bottom: Black 0.5pt solid; margin: 0; font-size: 10pt"><FONT STYLE="letter-spacing: -0.1pt"><B>(Expressed in U.S. Dollars)</B></FONT>&#160;</P></DIV>
    <!-- Field: /Page -->

<P STYLE="margin: 0 0 10pt; font-size: 10pt"><FONT STYLE="letter-spacing: -0.1pt"><B></B></FONT></P>

<TABLE CELLPADDING="0" CELLSPACING="0" STYLE="width: 100%; font-size: 10pt; margin-top: 0; margin-bottom: 0"><TR STYLE="vertical-align: top">
<TD STYLE="width: 0%"></TD><TD STYLE="width: 20pt"><FONT STYLE="letter-spacing: -0.1pt"><B>6.</B></FONT></TD><TD><FONT STYLE="letter-spacing: -0.1pt"><B>Prepaid expenses </B></FONT></TD></TR></TABLE>

<P STYLE="margin: 0; font-size: 10pt"><B>&nbsp;</B></P>

<P STYLE="margin: 0; font-size: 10pt">The Company&rsquo;s prepaid expenses relate to the following:</P>

<P STYLE="margin: 0; font-size: 10pt">&nbsp;</P>

<TABLE CELLPADDING="0" CELLSPACING="0" STYLE="border-collapse: collapse; width: 100%">
  <TR STYLE="vertical-align: bottom">
