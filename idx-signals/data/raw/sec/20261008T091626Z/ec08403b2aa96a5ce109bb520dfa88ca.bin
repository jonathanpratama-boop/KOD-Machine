    <TD STYLE="width: 1%; border-bottom: Black 1pt solid; font-size: 10pt; text-align: left">&nbsp;</TD><TD STYLE="width: 12%; border-bottom: Black 1pt solid; font-size: 10pt; text-align: right">6,962,218</TD><TD STYLE="border-right: Black 1pt solid; width: 1%; border-bottom: Black 1pt solid; font-size: 10pt; text-align: left">&nbsp;</TD></TR>
