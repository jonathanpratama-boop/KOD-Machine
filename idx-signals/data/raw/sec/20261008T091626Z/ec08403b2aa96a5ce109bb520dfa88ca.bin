    <TD STYLE="width: 1%; border-bottom: Black 1pt solid; font-size: 10pt; text-align: left">&nbsp;</TD><TD STYLE="width: 10%; border-bottom: Black 1pt solid; font-size: 10pt; text-align: right">321,000</TD><TD STYLE="width: 1%; border-bottom: Black 1pt solid; font-size: 10pt; text-align: left">&nbsp;</TD></TR>
