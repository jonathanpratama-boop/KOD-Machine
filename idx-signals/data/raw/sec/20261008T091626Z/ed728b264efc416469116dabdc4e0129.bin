    <TD STYLE="text-align: left">&nbsp;</TD><TD STYLE="text-align: right">6,600,000</TD><TD STYLE="text-align: left">&nbsp;</TD><TD>&nbsp;</TD>
    <TD STYLE="text-align: left">&nbsp;</TD><TD STYLE="text-align: right">17.22</TD><TD STYLE="text-align: left">%</TD><TD>&nbsp;</TD>
