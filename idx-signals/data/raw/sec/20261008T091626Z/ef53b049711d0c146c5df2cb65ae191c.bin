                                            &amp; <span id="xdx_905_eifrs-full--NumberOfInstrumentsOtherEquityInstrumentsGranted_pid_uUSDPShares_c20200525__20200527__ifrs-full--RangeAxis__ifrs-full--TopOfRangeMember_z29v0nrXy1Af" title="Share price at date of grant"><ix:nonFraction name="ifrs-full:NumberOfInstrumentsOtherEquityInstrumentsGranted" contextRef="From2020-05-252020-05-27_ifrs-full_TopOfRangeMember" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">0.64</ix:nonFraction></span></span></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
  <tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom; background-color: White">
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">Exercise
    price at date of grant (investors and placement agent, respectively) (pre-reverse stock split)</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">US$</span></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><span id="xdx_907_eifrs-full--ExercisePriceShareOptionsGranted2019_pid_uUSDPShares_c20200525__20200527__ifrs-full--RangeAxis__ifrs-full--BottomOfRangeMember_zuckKm7ifft9" title="Exercise price at date of grant"><ix:nonFraction name="ifrs-full:ExercisePriceShareOptionsGranted2019" contextRef="From2020-05-252020-05-27_ifrs-full_BottomOfRangeMember" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">0.79</ix:nonFraction>
</span>                                            &amp; <span id="xdx_905_eifrs-full--ExercisePriceShareOptionsGranted2019_pid_uUSDPShares_c20200525__20200527__ifrs-full--RangeAxis__ifrs-full--TopOfRangeMember_zRM8vTmzyKZh" title="Exercise price at date of grant"><ix:nonFraction name="ifrs-full:ExercisePriceShareOptionsGranted2019" contextRef="From2020-05-252020-05-27_ifrs-full_TopOfRangeMember" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">0.85</ix:nonFraction></span></span></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
  <tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="font: 10pt Times New Roman, Times, Serif; width: 78%"><span style="font-family: Times New Roman, Times, Serif">Volatility</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; width: 2%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font: 10pt Times New Roman, Times, Serif; width: 18%; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><span id="xdx_90A_eifrs-full--DescriptionOfExpectedVolatilityShareOptionsGranted_pid_dp_uPure_c20200525__20200527__ifrs-full--RangeAxis__ifrs-full--BottomOfRangeMember_zeAKc7tK2NRk" title="Volatility"><ix:nonFraction name="ifrs-full:DescriptionOfExpectedVolatilityShareOptionsGranted" contextRef="From2020-05-252020-05-27_ifrs-full_BottomOfRangeMember" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">100</ix:nonFraction></span></span></td><td style="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">%</span></td></tr>
  <tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom; background-color: White">
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">Warrant
    life</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_90D_ecustom--WarrantLife_dtY_c20200525__20200527_z0ls046UOAeh" title="Warrant life"><ix:nonNumeric contextRef="From2020-05-252020-05-27" format="ixt-sec:duryear" name="aehl:WarrantLife">5</ix:nonNumeric></span>
                                            years</span></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
  <tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom; background-color: rgb(204,238,255)">
