    <td style="border-right: black 1.5pt solid; border-bottom: black 1.5pt solid; font: 10pt Times New Roman, Times, Serif; padding-top: 0.25pt; padding-right: 0.5pt; padding-left: 0.25pt; text-align: center">0</td></tr>
