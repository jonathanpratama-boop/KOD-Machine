    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AccruedPayrollTaxesCurrent" scale="0" unitRef="usd" id="ixv-5954">909,904</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
