    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c4" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:OtherReceivablesNetCurrent" scale="0" unitRef="usd" id="ixv-6108">417,563</ix:nonFraction></td><td style="padding-bottom: 2.5pt; text-align: left">&#160;</td></tr>
