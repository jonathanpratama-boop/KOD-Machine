    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AccruedProfessionalFeesCurrent" scale="0" unitRef="usd" id="ixv-5958">194,222</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
