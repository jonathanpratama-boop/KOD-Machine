    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c1" decimals="0" format="ixt:num-dot-decimal" id="ix_14_fact" name="sxtc:OtherPayablesForConstructionDeposit" scale="0" unitRef="usd">1,184,429</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" id="ix_15_fact" name="sxtc:OtherPayablesForConstructionDeposit" scale="0" unitRef="usd">1,159,135</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
