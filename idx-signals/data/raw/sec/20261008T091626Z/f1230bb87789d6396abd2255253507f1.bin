    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c132" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebt" scale="0" unitRef="usd" id="ixv-5854">96,264</ix:nonFraction></td><td style="padding-bottom: 2.5pt; text-align: left">&#160;</td></tr>
