    <td style="border-bottom: Black 1.5pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; text-align: right">(<ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DeferredTaxAssetsValuationAllowance" scale="0" unitRef="usd" id="ixv-6104">1,441,907</ix:nonFraction></td><td style="padding-bottom: 1.5pt; text-align: left">)</td></tr>
