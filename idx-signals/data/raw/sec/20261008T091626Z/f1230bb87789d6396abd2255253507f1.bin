    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c1" decimals="0" format="ixt:num-dot-decimal" name="sxtc:DeferredTaxAssetsImpairmentProvisionForLongtermDeposit" scale="0" unitRef="usd" id="ixv-6101">152,970</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="sxtc:DeferredTaxAssetsImpairmentProvisionForLongtermDeposit" scale="0" unitRef="usd" id="ixv-6102">150,068</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
