    <td style="border-bottom: Black 1.5pt solid; width: 1%; text-align: left">$</td><td style="border-bottom: Black 1.5pt solid; text-align: right; width: 9%">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;<ix:nonFraction contextRef="c279" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:OtherReceivablesNetCurrent" scale="0" unitRef="usd" id="ixv-6106">417,563</ix:nonFraction></td><td style="padding-bottom: 1.5pt; width: 1%; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="padding-bottom: 2.5pt">&#160;</td><td style="padding-bottom: 2.5pt">&#160;</td>
