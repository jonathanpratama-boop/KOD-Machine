     <td style="width:50.04%;box-sizing:content-box;"></td>
    </tr>
    <tr style="height:18pt;white-space:pre-wrap;word-break:break-word;">
     <td style="padding-top:0in;text-indent:5pt;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0in;"><p style="margin-left:0.92%;text-indent:0;font-size:18pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="color:#2b4b86;white-space:pre-wrap;font-family:Arial;font-kerning:none;min-width:fit-content;">Supplemental Definitions</font></p></td>
     <td style="padding-top:0in;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;text-align:center;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:right;"><img src="img155105510_2.jpg" alt="img155105510_2.jpg" style="width:157px;height:57px;"></p></td>
    </tr>
