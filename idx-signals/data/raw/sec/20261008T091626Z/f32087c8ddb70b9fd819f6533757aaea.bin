    <td style="font: 10pt Times New Roman, Times, Serif; text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_902_edei--SecurityExchangeName_c20260603__20260603__us-gaap--StatementClassOfStockAxis__custom--RedeemableWarrantsEachWholeWarrantExercisableForOneShareOfClassCommonStockAtExercisePriceOf11.50Member_zOhELBY8AGxi"><ix:nonNumeric contextRef="From2026-06-032026-06-03_custom_RedeemableWarrantsEachWholeWarrantExercisableForOneShareOfClassCommonStockAtExercisePriceOf11.50Member" format="ixt-sec:exchnameen" id="Fact000032" name="dei:SecurityExchangeName">The Nasdaq Stock Market,
    LLC</ix:nonNumeric></span></span></td></tr>
