    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c1" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DisposalGroupIncludingDiscontinuedOperationDeferredRevenueCurrent" scale="3" unitRef="cny" id="ixv-7938">99,230</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
