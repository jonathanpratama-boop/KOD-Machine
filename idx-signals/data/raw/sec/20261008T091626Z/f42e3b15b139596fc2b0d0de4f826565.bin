    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c1" decimals="-3" format="ixt:num-dot-decimal" name="xhg:DisposalGroupIncludingDiscontinuedOperationShortTermDebt" scale="3" unitRef="cny" id="ixv-7939">103,552</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; ">
    <td style="text-align: left">Rental instalment loans</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c1" decimals="-3" format="ixt:num-dot-decimal" name="xhg:DisposalGroupIncludingDiscontinuedOperationRentalInstalmentLoans" scale="3" unitRef="cny" id="ixv-7940">15,756</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left">Deposits from tenants</td><td>&#160;</td>
