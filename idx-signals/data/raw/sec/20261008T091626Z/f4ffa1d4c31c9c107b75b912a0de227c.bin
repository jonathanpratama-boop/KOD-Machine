   <body><div style="display:none"> <ix:header> <ix:hidden> <ix:nonNumeric id="Hidden_dei_EntityRegistrantName" name="dei:EntityRegistrantName" contextRef="duration_2023-10-30_to_2023-10-30">AILERON THERAPEUTICS INC</ix:nonNumeric> <ix:nonNumeric id="Hidden_dei_SecurityExchangeName" name="dei:SecurityExchangeName" contextRef="duration_2023-10-30_to_2023-10-30">NASDAQ</ix:nonNumeric> <ix:nonNumeric name="dei:AmendmentFlag" contextRef="duration_2023-10-30_to_2023-10-30">false</ix:nonNumeric> <ix:nonNumeric id="Hidden_dei_EntityCentralIndexKey" name="dei:EntityCentralIndexKey" contextRef="duration_2023-10-30_to_2023-10-30">0001420565</ix:nonNumeric> <ix:nonNumeric id="Hidden_dei_CurrentFiscalYearEndDate_duration_2023-10-30_to_2023-10-30" name="dei:CurrentFiscalYearEndDate" contextRef="duration_2023-10-30_to_2023-10-30">--12-31</ix:nonNumeric> </ix:hidden> <ix:references> <link:schemaRef xlink:type="simple" xlink:href="alrn-20231030.xsd" xlink:arcrole="http://www.xbrl.org/2003/linkbase" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:link="http://www.xbrl.org/2003/linkbase"></link:schemaRef> </ix:references> <ix:resources> <xbrli:context id="duration_2023-10-30_to_2023-10-30"> <xbrli:entity> <xbrli:identifier scheme="http://www.sec.gov/CIK">0001420565</xbrli:identifier> </xbrli:entity> <xbrli:period> <xbrli:startDate>2023-10-30</xbrli:startDate> <xbrli:endDate>2023-10-30</xbrli:endDate> </xbrli:period> </xbrli:context> </ix:resources> </ix:header> </div> <div style="text-align:center"> <div style="width:8.5in;text-align:left;margin-left: auto;margin-right: auto"> <p style="line-height:1.0pt;margin-top:0pt;margin-bottom:0pt;border-bottom:1px solid #000000">&#160;</p> <p style="line-height:3.0pt;margin-top:0pt;margin-bottom:2pt;border-bottom:1px solid #000000">&#160;</p> <p style="margin-top:8pt; margin-bottom:0pt; font-size:18pt; font-family:Times New Roman;font-weight:bold;text-align:center">UNITED STATES</p> <p style="margin-top:0pt; margin-bottom:0pt; font-size:18pt;