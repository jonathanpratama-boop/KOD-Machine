    <TD STYLE="padding: 0pt; text-indent: 0pt">&nbsp;</TD></TR>
  <TR>
    <TD STYLE="padding: 0pt; vertical-align: top; text-indent: 0pt">&nbsp;</TD>
    <TD STYLE="padding: 0pt; vertical-align: bottom; border-bottom: black 1pt solid; text-indent: 0pt"><FONT STYLE="font-size: 10pt"><B>/s/ Min Shu</B></FONT></TD></TR>
