    <td style="width: 1%; font-size: 10pt; text-align: center">&#160;</td><td style="width: 31%; font-size: 10pt; text-align: center">4,873,635</td><td style="width: 1%; font-size: 10pt; text-align: center">&#160;</td><td style="text-align: center; width: 1%; font-size: 10pt">&#160;</td>
