    <td id="xdx_494_20221231__us-gaap--BusinessAcquisitionAxis__custom--RemoteMoreUSAIncMember_z4IM590GfPil" style="font: 10pt Times New Roman, Times, Serif; text-align: right">&#160;</td>
    <td style="font: 10pt Times New Roman, Times, Serif">&#160;</td></tr>
  <tr id="xdx_400_eus-gaap--Goodwill_iI_pp0p0_maBCRIAzRjd_zK5MuvrLfX0e" style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom; background-color: rgb(204,238,255)">
