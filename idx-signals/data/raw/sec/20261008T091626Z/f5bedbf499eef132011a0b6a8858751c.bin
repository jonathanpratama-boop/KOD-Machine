    <td style="font: 10pt Times New Roman, Times, Serif; width: 1%"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">$</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; width: 14%; text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonFraction name="us-gaap:Goodwill" contextRef="AsOf2022-12-31_custom_RemoteMoreUSAIncMember" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">935,334</ix:nonFraction></span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; width: 1%"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></td></tr>
