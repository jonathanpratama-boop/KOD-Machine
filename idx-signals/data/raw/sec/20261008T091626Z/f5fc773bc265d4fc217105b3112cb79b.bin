			<td style="vertical-align: bottom; width: 25.9%; border-bottom: 1px solid rgb(0, 0, 0);">
			<div style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;"><b>Position</b></div>
			</td>
		</tr>
		<tr style="background-color: rgb(204, 238, 255);">
			<td style="vertical-align:top;width:16.2%;">
			<div style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;"><b><i>Executive Officers</i></b></div>
			</td>
			<td style="vertical-align:bottom;width:0.9%;">&#xa0;</td>
