<ix:nonNumeric contextRef="From2025-01-01to2025-12-31" escape="true" id="Fact002306" name="bdrx:DisclosureOfDetailedInformationProvisionExplanatory"><table cellpadding="0" cellspacing="0" id="xdx_88E_ecustom--DisclosureOfDetailedInformationProvisionExplanatory_pn3n3_zvFQRZwQxlMb" summary="xdx: Disclosure - Provisions (Details)" style="font: 10pt Times New Roman, Times, Serif; border-collapse: collapse; width: 90%">
  <tr style="vertical-align: bottom; background-color: White">
