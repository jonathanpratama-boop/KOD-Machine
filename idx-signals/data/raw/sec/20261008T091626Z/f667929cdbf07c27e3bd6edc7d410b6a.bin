    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">14 June 2023</span></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">Share sub-division and <br/>re-designation</td><td style="color: #4D4D4C">&#160;</td>
