    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 15%; text-align: right"><span id="xdx_905_ecustom--NumberOfAdsWarrantsGranted_pid_c20251201__20251231__ifrs-full--ClassesOfShareCapitalAxis__ifrs-full--WarrantsMember_z0G77dDhlDPf" title="Number of ADS warrants granted"><ix:nonFraction name="bdrx:NumberOfAdsWarrantsGranted" contextRef="From2025-12-012025-12-31_ifrs-full_WarrantsMember" id="Fact004442" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">152,439</ix:nonFraction></span></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="text-align: left">Option pricing models used</td><td style="color: #4D4D4C">&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span id="xdx_900_eifrs-full--DescriptionOfOptionPricingModelShareOptionsGranted_c20251201__20251231__ifrs-full--ClassesOfShareCapitalAxis__ifrs-full--WarrantsMember" title="Option pricing models used"><ix:nonNumeric contextRef="From2025-12-012025-12-31_ifrs-full_WarrantsMember" id="Fact004444" name="ifrs-full:DescriptionOfOptionPricingModelShareOptionsGranted">Black-Scholes</ix:nonNumeric></span></td><td style="text-align: left">&#160;</td></tr>
