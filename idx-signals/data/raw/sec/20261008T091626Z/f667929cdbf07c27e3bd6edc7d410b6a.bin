  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 69%; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif"><b>31 December 2025</b></span></td><td style="width: 1%; font-weight: bold; text-align: left">&#160;</td><td style="width: 1%; font-weight: bold">&#160;</td>
    <td style="width: 1%; font-weight: bold; text-align: left">&#160;</td><td style="width: 12%; font-weight: bold; text-align: right"><span id="xdx_905_eifrs-full--NetDeferredTaxLiabilities_iI_pn3n3_c20251231_zyne3c3VEOPe" title="Gross losses"><ix:nonFraction name="ifrs-full:NetDeferredTaxLiabilities" contextRef="AsOf2025-12-31" id="Fact003194" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="GBP">82,168</ix:nonFraction></span></td><td style="width: 1%; font-weight: bold; text-align: left">&#160;</td><td style="width: 1%; font-weight: bold">&#160;</td>
