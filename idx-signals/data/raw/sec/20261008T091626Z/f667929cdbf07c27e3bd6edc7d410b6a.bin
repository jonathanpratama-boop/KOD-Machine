</ix:nonNumeric><ix:nonNumeric contextRef="From2025-01-01to2025-12-31" escape="true" id="Fact003504" name="ifrs-full:DisclosureOfSharebasedPaymentArrangementsExplanatory"><p id="xdx_80B_eifrs-full--DisclosureOfSharebasedPaymentArrangementsExplanatory_zJzvHeWcO2Ji" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify"></p>

