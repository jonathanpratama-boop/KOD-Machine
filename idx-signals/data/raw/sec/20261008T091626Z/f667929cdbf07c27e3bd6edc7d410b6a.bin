</ix:nonNumeric><ix:nonNumeric contextRef="From2025-01-01to2025-12-31" escape="true" id="Fact001993" name="ifrs-full:DisclosureOfCashAndCashEquivalentsExplanatory"><p id="xdx_807_eifrs-full--DisclosureOfCashAndCashEquivalentsExplanatory_zYKupVmNZ6nc" style="font: 10pt Times New Roman; margin: 0pt 0">&#160;</p>

<p style="font: bold 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 27pt; color: #00A3DB; text-indent: -27pt"></p>

<p style="font: bold 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 27pt; color: #00A3DB; text-indent: -27pt"></p>

<table cellpadding="0" cellspacing="0" style="font: bold 10pt Times New Roman, Times, Serif; width: 100%; margin-top: 0pt; margin-bottom: 0pt"><tr style="vertical-align: top">
