    <td colspan="2" style="border-top: Black 1pt solid; border-bottom: Black 1pt solid; white-space: nowrap; font-weight: bold; text-align: right">At 31 <br/> December <br/> 2023</td><td style="border-top: Black 1pt solid; border-bottom: Black 1pt solid; font-weight: bold">&#160;</td><td style="border-top: Black 1pt solid; border-bottom: Black 1pt solid; font-weight: bold">&#160;</td>
    <td colspan="2" style="border-top: Black 1pt solid; border-bottom: Black 1pt solid; white-space: nowrap; font-weight: bold; text-align: right">Lapsed</td><td style="border-top: Black 1pt solid; border-bottom: Black 1pt solid; font-weight: bold">&#160;</td><td style="border-top: Black 1pt solid; border-bottom: Black 1pt solid; font-weight: bold">&#160;</td>
