    <TD STYLE="width: 76%; text-align: justify">Cash</TD><TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 9%; text-align: right">2,475,538</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD><TD STYLE="width: 1%">&nbsp;</TD>
    <TD STYLE="width: 1%; text-align: left">$</TD><TD STYLE="width: 9%; text-align: right">1,766,441</TD><TD STYLE="width: 1%; text-align: left">&nbsp;</TD></TR>
  <TR STYLE="vertical-align: bottom; background-color: White">
