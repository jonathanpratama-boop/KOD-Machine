    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c266" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:CurrentIncomeTaxExpenseBenefit" scale="0" unitRef="usd" id="ixv-9780">139,982</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; ">
    <td style="padding-bottom: 4pt">Total</td><td style="padding-bottom: 4pt">&#160;</td>
