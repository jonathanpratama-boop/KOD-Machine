    <TD STYLE="font: 10pt Times New Roman, Times, Serif; white-space: nowrap"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">&lrm;1.2(iii)
    </FONT></TD></TR>
  <TR STYLE="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom">
