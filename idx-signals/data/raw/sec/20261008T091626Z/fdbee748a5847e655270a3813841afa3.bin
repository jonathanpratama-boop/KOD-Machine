    <td colspan="2" style="vertical-align: bottom; font-weight: bold; text-align: center; border-bottom: Black 1.5pt solid">December 31,<br/> 2023</td><td style="text-align: center; padding-bottom: 1.5pt; font-weight: bold; vertical-align: bottom">&#160;</td></tr>
