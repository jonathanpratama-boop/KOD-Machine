    <td style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 1.5pt solid; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c55" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:ConsiderationPaidReceived" scale="0" unitRef="usd" id="ixv-9787">1,553,750</ix:nonFraction></td><td style="padding-bottom: 1.5pt; font-weight: bold; text-align: left">&#160;</td></tr>
