    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c56" decimals="0" format="ixt:num-dot-decimal" name="ifrs-full:PropertyPlantAndEquipment" scale="0" unitRef="usd" id="ixv-9792">1,769,221</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
