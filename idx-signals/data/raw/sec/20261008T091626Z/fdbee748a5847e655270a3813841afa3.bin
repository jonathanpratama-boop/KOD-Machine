    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c239" decimals="0" format="ixt:num-dot-decimal" name="akan:LoanReceivable" scale="0" unitRef="usd" id="ixv-10039">509,212</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
