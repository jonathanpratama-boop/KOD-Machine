  <tr style="background-color: #CCEEFF">
    <td style="text-align: left; vertical-align: top"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Average rate</span></td>
    <td style="vertical-align: top">&#160;</td>
    <td style="vertical-align: bottom; text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">US$1=RMB <ix:nonFraction contextRef="c123" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-19921">7.1957</ix:nonFraction></span></td>
