    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><ix:nonFraction contextRef="c3" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:FinancingReceivableAllowanceForCreditLosses" scale="0" unitRef="usd" id="ixv-20052">2,817</ix:nonFraction></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left">&#160;</td></tr>
