    <td style="width: 76%; text-align: justify">Operating lease expense</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right">58,524</td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td>
