    <td colspan="2" style="border-bottom: Black 1.5pt solid; white-space: nowrap; font-weight: bold; text-align: center">2023</td><td style="white-space: nowrap; text-align: center; padding-bottom: 1.5pt; font-weight: bold">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 76%; text-align: left">VAT tax payable</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c2" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:SalesAndExciseTaxPayableCurrent" scale="0" unitRef="usd" id="ixv-20158">71,796</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right"><ix:nonFraction contextRef="c3" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:SalesAndExciseTaxPayableCurrent" scale="0" unitRef="usd" id="ixv-20159">72,295</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
