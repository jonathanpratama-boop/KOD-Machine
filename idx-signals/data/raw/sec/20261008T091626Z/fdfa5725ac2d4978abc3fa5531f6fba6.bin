  <tr>
    <td style="text-align: left; vertical-align: top"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Average rate (discontinued operations)</span></td>
    <td style="vertical-align: top">&#160;</td>
    <td style="vertical-align: bottom; text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">US$1=INR <ix:nonFraction contextRef="c126" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-19924">83.66</ix:nonFraction>&#160;</span></td>
    <td style="vertical-align: bottom">&#160;</td>
