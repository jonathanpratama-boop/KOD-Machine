    <td style="width: 1%; text-align: left">$</td><td style="width: 9%; text-align: right">(<ix:nonFraction contextRef="c18" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxReconciliationIncomeTaxExpenseBenefitAtFederalStatutoryIncomeTaxRate" scale="0" sign="-" unitRef="usd" id="ixv-20129">1,631,581</ix:nonFraction></td><td style="width: 1%; text-align: left">)</td><td style="width: 1%">&#160;</td>
