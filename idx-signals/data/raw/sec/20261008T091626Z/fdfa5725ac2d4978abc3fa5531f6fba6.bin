    <td style="vertical-align: bottom; text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">US$1= Indian Rupee (&#8220;INR&#8221;)&#160;<ix:nonFraction contextRef="c120" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ForeignCurrencyExchangeRateTranslation1" scale="0" unitRef="pure" id="ixv-19918">85.55</ix:nonFraction>&#160;</span></td>
