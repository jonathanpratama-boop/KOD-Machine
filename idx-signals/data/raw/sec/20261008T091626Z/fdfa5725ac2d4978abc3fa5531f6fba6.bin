    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c18" decimals="0" format="ixt:num-dot-decimal" id="ix_66_fact" name="us-gaap:IncomeTaxReconciliationNondeductibleExpenseOther" scale="0" unitRef="usd">243</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><div style="-sec-ix-hidden: hidden-fact-261">-</div></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left; padding-bottom: 1.5pt; text-indent: -9pt; padding-left: 9pt">Change in valuation allowance</td><td style="padding-bottom: 1.5pt">&#160;</td>
    <td style="border-bottom: Black 1.5pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; text-align: right"><ix:nonFraction contextRef="c0" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxReconciliationChangeInDeferredTaxAssetsValuationAllowance" scale="0" unitRef="usd" id="ixv-20136">308,186</ix:nonFraction></td><td style="padding-bottom: 1.5pt; text-align: left">&#160;</td><td style="padding-bottom: 1.5pt">&#160;</td>
    <td style="border-bottom: Black 1.5pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; text-align: right"><ix:nonFraction contextRef="c18" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxReconciliationChangeInDeferredTaxAssetsValuationAllowance" scale="0" unitRef="usd" id="ixv-20137">34,833</ix:nonFraction></td><td style="padding-bottom: 1.5pt; text-align: left">&#160;</td><td style="padding-bottom: 1.5pt">&#160;</td>
    <td style="border-bottom: Black 1.5pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1.5pt solid; text-align: right"><ix:nonFraction contextRef="c19" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:IncomeTaxReconciliationChangeInDeferredTaxAssetsValuationAllowance" scale="0" unitRef="usd" id="ixv-20138">10,233</ix:nonFraction></td><td style="padding-bottom: 1.5pt; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="font-weight: bold; text-align: left; padding-bottom: 4pt; text-indent: -9pt; padding-left: 9pt">Effective tax (benefit) expense</td><td style="font-weight: bold; padding-bottom: 4pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><div style="-sec-ix-hidden: hidden-fact-262">-</div></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; padding-bottom: 4pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><div style="-sec-ix-hidden: hidden-fact-263">-</div></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">&#160;</td><td style="font-weight: bold; padding-bottom: 4pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; font-weight: bold; text-align: left">$</td><td style="border-bottom: Black 4pt double; font-weight: bold; text-align: right"><div style="-sec-ix-hidden: hidden-fact-264">-</div></td><td style="padding-bottom: 4pt; font-weight: bold; text-align: left">&#160;</td></tr>
  </table>


<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify">&#160;</p>

<table cellpadding="0" style="font: 10pt Times New Roman, Times, Serif; width: 100%; border-spacing: 0px;"> <tr> <td style="vertical-align: top"><span style="font-size: 10pt">(1)</span></td> <td style="text-align: justify"><ix:footnote id="ix_5_footnote" xml:lang="en-US"><span style="font-size: 10pt">Represents the tax losses incurred from operations outside of China.</span></ix:footnote></td></tr> <tr> <td style="vertical-align: top">&#160;</td> <td style="text-align: justify">&#160;</td></tr> <tr> <td style="vertical-align: top"><span style="font-size: 10pt">(2)</span></td> <td style="text-align: justify"><ix:footnote id="ix_6_footnote" xml:lang="en-US"><span style="font-size: 10pt">Represents expenses incurred by the Company that were not deductible for PRC income tax.</span></ix:footnote></td></tr> </table></ix:nonNumeric>
<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-indent: 0.5in">&#160;</p>

