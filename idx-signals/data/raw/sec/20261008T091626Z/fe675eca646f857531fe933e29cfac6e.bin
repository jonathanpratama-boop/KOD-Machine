style="height:15px;background-color:#cceeff"> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:30px">Section 9.06</p></td> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:0in">WAIVER OF JURY TRIAL</p></td> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:0in">48</p></td></tr> <tr style="height:15px;background-color:#ffffff"> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:30px">Section 9.07</p></td> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:0in">Notices</p></td> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:0in">48</p></td></tr> <tr style="height:15px;background-color:#cceeff"> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:30px">Section 9.08</p></td> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:0in">Amendment</p></td> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:0in">49</p></td></tr> <tr style="height:15px;background-color:#ffffff"> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:30px">Section 9.09</p></td> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:0in">Extension; Waiver</p></td> <td style="vertical-align:top;"> <p style="font-size:10pt;font-family:times new roman;margin:0px 0px 0px 0in;text-indent:0in">49</p></td></tr> <tr style="height:15px;background-color