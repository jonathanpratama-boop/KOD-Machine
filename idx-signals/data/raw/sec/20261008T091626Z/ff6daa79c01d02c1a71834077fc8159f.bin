<P STYLE="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 2.25pt">&nbsp;</P>

<P STYLE="font: bold 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 2.25pt; text-indent: 0in">Schedule A - Seller and Purchased
Shares</P>

<P STYLE="font: bold 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 2.25pt; text-indent: 0in">&nbsp;</P>

<TABLE CELLSPACING="0" CELLPADDING="0" STYLE="width: 100%; font: 10pt Times New Roman, Times, Serif; border-collapse: collapse">
  <TR STYLE="vertical-align: top; background-color: White">
    <TD STYLE="border-bottom: Black 1.5pt solid; width: 22%; font-size: 10pt"><FONT STYLE="font-size: 10pt"><B>Seller</B></FONT></TD>
    <TD STYLE="width: 2%">&nbsp;</TD>
    <TD STYLE="text-align: center; border-bottom: Black 1.5pt solid; width: 25%; font-size: 10pt"><FONT STYLE="font-size: 10pt"><B>Number of Company Shares</B></FONT></TD>
    <TD STYLE="width: 2%">&nbsp;</TD>
    <TD STYLE="text-align: center; border-bottom: Black 1.5pt solid; width: 22%; font-size: 10pt"><FONT STYLE="font-size: 10pt"><B>Percentage Sold</B></FONT></TD>
    <TD STYLE="width: 2%">&nbsp;</TD>
    <TD STYLE="text-align: center; border-bottom: Black 1.5pt solid; width: 25%; font-size: 10pt"><FONT STYLE="font-size: 10pt"><B>Consideration</B></FONT></TD></TR>
  <TR STYLE="vertical-align: top; background-color: rgb(204,238,255)">
    <TD>Kong Yiu CHEUNG &nbsp;</TD>
    <TD>&nbsp;</TD>
    <TD STYLE="font-size: 10pt"><FONT STYLE="font-size: 10pt">1,500 ordinary shares (subject to exact 3% adjustment)</FONT></TD>
    <TD>&nbsp;</TD>
    <TD STYLE="font-size: 10pt"><FONT STYLE="font-size: 10pt">3% fully diluted equity</FONT></TD>
    <TD>&nbsp;</TD>
    <TD>US$3,750,000 cash + 2,500,000 NIVF Class A &nbsp; ordinary shares &nbsp;</TD></TR>
  </TABLE>

<P STYLE="font: bold 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 2.25pt; text-indent: 0in">&nbsp;</P>

