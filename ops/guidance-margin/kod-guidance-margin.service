[Unit]
Description=KOD guidance source reader and paired paper results
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/kod/guidance-margin
EnvironmentFile=/etc/kod/guidance-margin.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kod/venv/bin/python -B ops/guidance-margin/run.py --state /var/lib/kod/guidance-margin --cik-map config/cik_map.csv
UMask=0077
Nice=10
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kod/guidance-margin

