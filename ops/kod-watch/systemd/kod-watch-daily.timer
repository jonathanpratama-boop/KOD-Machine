# Once a day at 01:30 UTC (08:30 WIB), after the 01:00 UTC slot has been judged.
[Unit]
Description=KOD watch: daily cohort summary at 01:30 UTC (08:30 WIB)
Documentation=file:/opt/kod/watch/INSTALL.md

[Timer]
Unit=kod-watch-daily.service
OnCalendar=*-*-* 01:30:00 UTC
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true

[Install]
WantedBy=timers.target
